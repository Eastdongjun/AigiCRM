.pager {
  margin: 20rpx 0 8rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(48, 78, 112, .05);
}
.pager-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8296b3;
  margin-bottom: 16rpx;
}
.pager-page { color: #45618c; font-weight: 600; }
.pager-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.pager-btn {
  flex: 1;
  width: 0;
  height: 68rpx;
  min-height: 68rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid #d7e4f6;
  background: #f7faff;
  color: #1d4fd7;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 66rpx;
}
.pager-btn::after { border: 0; }
.pager-btn.is-disabled {
  background: #f4f6fa;
  border-color: #e8edf5;
  color: #b3c0d3;
}
.pager-sizes {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.pager-size {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  line-height: 1;
}
.pager-size.is-active {
  color: #fff;
  background: #2563eb;
  font-weight: 600;
}
