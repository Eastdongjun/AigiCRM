/* 自定义 tabBar(2026-10-24 用户令"底部做好看"): 毛玻璃底条 + SF Symbols 式双态图标
   —— 未选=灰线框, 选中=蓝实底。图标全部内联 SVG data URI, 零图片资源。
   z-index=50: 在页面内容之上, 但低于各页弹层 mask(z-60), 弹出面板可完整遮住底条。 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  padding: 12rpx 8rpx calc(12rpx + env(safe-area-inset-bottom));
  /* .94: 模拟器/部分安卓不支持 backdrop-filter 时, 滚动内容透字残影不可见 */
  background: rgba(255, 255, 255, .94);
  backdrop-filter: blur(24px) saturate(1.6);
  -webkit-backdrop-filter: blur(24px) saturate(1.6);
  border-top: 1rpx solid rgba(15, 23, 42, .08);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
}
.tab-icon {
  width: 52rpx;
  height: 52rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 52rpx 52rpx;
  transition: transform .18s ease;
}
.tab.active .tab-icon { transform: translateY(-2rpx); }
.tab-label {
  font-size: 20rpx;
  color: #86868b;
  font-weight: 400;
  line-height: 1.2;
}
.tab.active .tab-label { color: #1d4ed8; font-weight: 700; }

