.page{min-height:100vh;padding:40rpx 32rpx;background:#f4f8ff;box-sizing:border-box}.title{display:block;color:#172b4d;font-size:40rpx;font-weight:700}.updated{display:block;margin-top:14rpx;color:#8ea3c0;font-size:24rpx}.section{padding:32rpx 0;border-bottom:1rpx solid #e3ebf5}.heading{display:block;color:#172b4d;font-size:30rpx;font-weight:600;margin-bottom:16rpx}.body{display:block;color:#5f718b;font-size:27rpx;line-height:1.9}
