<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">意见反馈</view>
        <view class="hero-sub">记录问题和改进建议</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>

  <view class="notice feedback-notice">当前版本尚未接入服务端反馈提交。内容会保存在本机草稿中，请复制或转交管理员。</view>

  <view class="card feedback-card">
    <view class="form-section-title">反馈内容</view>
    <textarea class="polished-textarea feedback-textarea" maxlength="{{feedbackView.contentMaxLength}}" value="{{feedbackView.contentValue}}" bindinput="onInput" placeholder="{{feedbackView.contentPlaceholder}}"></textarea>
    <view class="feedback-actions">
      <button class="feedback-clear-action" bindtap="clearDraft">清空</button>
      <button class="feedback-save-action" bindtap="saveDraft">保存草稿</button>
    </view>
  </view>

  <view wx:if="{{feedbackView.showSavedNotice}}" class="card muted feedback-saved">{{feedbackView.savedNoticeText}}</view>
</view>
