.page{min-height:100vh;padding:48rpx 32rpx;background:#f4f8ff;box-sizing:border-box}.brand{display:flex;flex-direction:column;align-items:center;padding:40rpx 0 56rpx}.logo{width:112rpx;height:112rpx;border-radius:24rpx;background:#2563eb;color:#fff;font-size:64rpx;font-weight:700;line-height:112rpx;text-align:center}.title{margin-top:24rpx;font-size:40rpx;font-weight:700;color:#172b4d}.version{margin-top:12rpx;color:#8ea3c0;font-size:24rpx}.section{padding:32rpx 0;border-top:1rpx solid #e3ebf5}.heading{display:block;color:#172b4d;font-size:30rpx;font-weight:600;margin-bottom:18rpx}.body{display:block;color:#5f718b;font-size:27rpx;line-height:1.8}
