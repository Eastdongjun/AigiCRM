.page{min-height:100vh;padding:32rpx;background:#f4f8ff;box-sizing:border-box}.intro,.section{background:#fff;padding:32rpx;margin-bottom:24rpx;border-radius:8rpx}.title{display:block;font-size:36rpx;font-weight:700;color:#172b4d}.body{display:block;margin-top:18rpx;color:#5f718b;font-size:27rpx;line-height:1.8}.heading{display:block;font-size:30rpx;font-weight:600;color:#172b4d;margin-bottom:18rpx}.row{display:flex;padding:22rpx 0;border-top:1rpx solid #eef2f7}.name{width:220rpx;color:#2563eb;font-size:28rpx}.desc{flex:1;color:#5f718b;font-size:26rpx;line-height:1.6}
