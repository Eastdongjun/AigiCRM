.profile-doc-page{min-height:100vh;padding:36rpx 28rpx;background:#f5f8fc;box-sizing:border-box}.doc-section{background:#fff;padding:30rpx;margin-bottom:22rpx;border-radius:24rpx;border:1rpx solid #e5edf6;box-shadow:0 10rpx 26rpx rgba(35,57,96,.05)}.intro-card{background:linear-gradient(135deg,#fff,#f8fbff)}.title{display:block;font-size:38rpx;font-weight:850;color:#172033}.body{display:block;margin-top:18rpx;color:#5f718b;font-size:27rpx;line-height:1.85}.heading{display:block;font-size:30rpx;font-weight:800;color:#172033;margin-bottom:18rpx}.scope-row{display:flex;padding:22rpx 0;border-top:1rpx solid #eef2f7}.scope-row:first-of-type{border-top:0}.name{width:220rpx;color:#2563eb;font-size:28rpx;font-weight:750}.desc{flex:1;color:#5f718b;font-size:26rpx;line-height:1.6}
