<view class="page"><view class="hero"><view class="hero-title">修改密码</view><view class="hero-sub">修改后需要重新登录</view></view><view class="card form-card"><input class="input" password placeholder="原密码" data-field="oldPassword" bindinput="onInput"/><input class="input" password placeholder="新密码（至少 6 位）" data-field="newPassword" bindinput="onInput"/><input class="input" password placeholder="确认新密码" data-field="confirmPassword" bindinput="onInput"/><button class="btn" loading="{{loading}}" bindtap="submit">确认修改</button></view></view>
