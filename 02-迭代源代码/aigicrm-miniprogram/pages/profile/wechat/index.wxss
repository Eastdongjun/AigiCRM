.wechat-page{min-height:100vh;padding:36rpx 28rpx;background:#f5f8fc;box-sizing:border-box}.status-card{padding:56rpx 32rpx;text-align:center;border:1rpx solid #e5edf6}.wechat-icon{margin:0 auto 24rpx;width:104rpx;height:104rpx;border-radius:52rpx;background:#20b46b;color:#fff;font-size:48rpx;line-height:104rpx;font-weight:800;box-shadow:0 14rpx 30rpx rgba(32,180,107,.22)}.title{display:block;color:#172033;font-size:34rpx;font-weight:850}.status{display:block;margin-top:12rpx;color:#d97706;font-size:26rpx}.body{display:block;margin:28rpx 0 36rpx;color:#5f718b;font-size:27rpx;line-height:1.8}.wechat-bind-btn{width:100%;margin-top:4rpx}.wechat-notice{margin-top:22rpx;padding:24rpx;border-radius:20rpx;background:#fff;color:#7b8ca5;font-size:25rpx;line-height:1.7;border:1rpx solid #e5edf6}
