.page{min-height:100vh;padding:32rpx;background:#f4f8ff;box-sizing:border-box}.card{background:#fff;border-radius:8rpx;padding:56rpx 32rpx;text-align:center}.wechat-icon{margin:0 auto 24rpx;width:104rpx;height:104rpx;border-radius:52rpx;background:#20b46b;color:#fff;font-size:48rpx;line-height:104rpx;font-weight:700}.title{display:block;color:#172b4d;font-size:34rpx;font-weight:700}.status{display:block;margin-top:12rpx;color:#d97706;font-size:26rpx}.body{display:block;margin:28rpx 0 36rpx;color:#5f718b;font-size:27rpx;line-height:1.8}.primary{background:#2563eb;color:#fff;font-size:28rpx}.notice{margin-top:24rpx;padding:24rpx;color:#7b8ca5;font-size:25rpx;line-height:1.7}
