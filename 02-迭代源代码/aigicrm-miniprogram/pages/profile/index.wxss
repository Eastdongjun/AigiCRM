.profile-action-row{display:flex;align-items:center;gap:14rpx;margin-top:24rpx}
.profile-action-row button{flex:1;height:64rpx;line-height:62rpx;margin:0;padding:0;border-radius:18rpx;font-size:24rpx;font-weight:740}
.profile-action-row button::after{border:0}
.profile-feedback-action{border:1rpx solid #d8e1ee;background:#f8fafc;color:#475569}
.profile-logout-action{border:0;background:#ef4444;color:#fff}

/* 【2026-10-24 自定义 tabBar】底部留白让位覆盖层(~110rpx+安全区) */
.profile-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

/* 【用户裁决C 2026-10-13】我的页头部紧凑化: 头像80rpx横排+右侧姓名/岗位, 高度对齐其他页 hero;
   原 112rpx 头像三行竖排约 290rpx, 偏大且与全站 hero 语言不齐 */
/* 2026-10-20 用户令：去掉姓名首字大头像，改成「当前账号」overline + 姓名 + 岗位，右侧登录状态 */
/* 【2026-10-25 用户令】三 tab 页(应用/我的/四项服务)顶部卡壳统一: 26rpx 圆角 + 同款渐变
   + 同投影 + 32rpx 标题, 与 ap-hero/hm-bar/files-top 一套规格; 内容与文案不变 */
.profile-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #0d1733 0%, #16337a 58%, #1d4ed8 100%);
  box-shadow: 0 18rpx 38rpx rgba(13, 23, 51, .22);
}
.profile-hero-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.profile-hero-overline { font-size: 18rpx; letter-spacing: .16em; color: rgba(255, 255, 255, .55); }
.profile-hero .profile-name { margin-top: 0; font-size: 32rpx; font-weight: 800; }
.profile-hero .hero-sub { margin-top: 0; font-size: 22rpx; color: rgba(255, 255, 255, .7); }
.profile-hero-status {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, .16);
  background: rgba(255, 255, 255, .1);
  font-size: 19rpx;
  color: rgba(255, 255, 255, .82);
}
.profile-status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #4ade80; }

/* 【2026-10-26 用户令"合并到一个区域"】当前集团+数据范围两卡并一卡: 两行, 细线分隔;
   覆盖 app.wxss 的 .scope-card 单行 flex 布局(仅本页生效) */
.scope-merged { flex-direction: column; align-items: stretch; gap: 18rpx; }
.scope-line { display: flex; align-items: center; min-width: 0; }
.scope-line.with-divider { border-top: 1rpx solid #eef2f7; padding-top: 18rpx; }
