<view class="page"><view class="hero"><view class="profile-avatar">{{userName.slice(0, 1)}}</view><view class="profile-name">{{userName}}</view><view class="hero-sub">{{orgName}} · {{roleName}}</view></view><view class="card scope-card"><text class="muted">当前岗位</text><text class="pill">{{positionNames}}</text><text class="muted" style="margin-left:20rpx">统一岗位上下文</text></view><view wx:if="{{groupIds.length}}" class="card scope-card"><text class="muted">当前集团</text><picker mode="selector" range="{{groupIds}}" value="{{groupIndex}}" bindchange="changeGroup" disabled="{{switchingGroup}}"><text class="pill">{{currentGroupId || '选择集团'}}⌄</text></picker><text class="muted" style="margin-left:20rpx">{{switchingGroup ? '切换中...' : '切换后刷新权限'}}</text></view><view class="card scope-card"><text class="muted">数据范围</text><text class="pill">{{scopeName}}</text><text class="muted" style="margin-left:20rpx">统一权限控制</text></view><view class="card menu-card"><view class="menu-item" bindtap="openCustomers"><text class="menu-icon blue">◉</text><text>我的客户</text><text class="arrow">›</text></view><view class="menu-item" bindtap="openCases"><text class="menu-icon orange">★</text><text>我的价值服务</text><text class="arrow">›</text></view><view class="menu-item" bindtap="openClaims"><text class="menu-icon cyan">↻</text><text>我的捞取记录</text><text class="arrow">›</text></view></view><view class="card menu-card"><view class="menu-item" bindtap="openPassword"><text class="menu-icon purple">⚿</text><text>修改密码</text><text class="arrow">›</text></view><view class="menu-item" bindtap="openScope"><text class="menu-icon blue">◇</text><text>数据权限说明</text><text class="arrow">›</text></view></view><view class="card menu-card"><view class="menu-item" bindtap="openWechat"><text class="menu-icon green">◌</text><text>微信绑定</text><text class="menu-status">待接入</text></view><view class="menu-item" bindtap="clearCache"><text class="menu-icon gray">□</text><text>清除缓存</text><text class="arrow">›</text></view><view class="menu-item" bindtap="openAbout"><text class="menu-icon gray">ⓘ</text><text>关于我们</text><text class="arrow">›</text></view><view class="menu-item" bindtap="openAgreement"><text class="menu-icon gray">▤</text><text>用户协议</text><text class="arrow">›</text></view><view class="menu-item" bindtap="openPrivacy"><text class="menu-icon gray">▧</text><text>隐私政策</text><text class="arrow">›</text></view></view><button class="logout-btn" bindtap="logout">退出登录</button></view>
<button class="secondary-btn" style="margin:20rpx 0" bindtap="openFeedback">意见反馈</button>
