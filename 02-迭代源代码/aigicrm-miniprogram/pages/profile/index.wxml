<view class="page profile-page">
  <!-- 2026-10-20 用户令：去掉姓名首字大头像，姓名/岗位左对齐，右侧只保留登录状态 -->
  <view class="hero profile-hero">
    <view class="profile-hero-main">
      <view class="profile-hero-overline">当前账号</view>
      <view class="profile-name">{{profileView.userNameText}}</view>
      <view class="hero-sub">{{profileView.heroSubText}}</view>
    </view>
    <view class="profile-hero-status"><text class="profile-status-dot"></text>已登录</view>
  </view>
  <!-- 【2026-10-26 用户令"合并到一个区域"】当前集团+数据范围由两张卡并为一张(两行,细线分隔),
       集团切换 picker/说明文案全保留 -->
  <view class="card scope-card scope-merged">
    <view wx:if="{{profileView.showGroupCard}}" class="scope-line">
      <text class="muted">当前集团</text>
      <picker mode="selector" range="{{profileView.groupNamesText}}" value="{{groupIndex}}" bindchange="changeGroup" disabled="{{profileView.groupDisabled}}"><text class="pill">{{profileView.currentGroupText}}⌄</text></picker>
      <text wx:if="{{profileView.groupNoteText}}" class="muted scope-note">{{profileView.groupNoteText}}</text>
    </view>
    <view class="scope-line {{profileView.showGroupCard ? 'with-divider' : ''}}">
      <text class="muted">数据范围</text>
      <text class="pill">{{profileView.scopeText}}</text>
      <text class="muted scope-note">统一权限控制</text>
    </view>
  </view>
  <view class="card menu-card">
    <view class="menu-item" bindtap="openCustomers"><text class="menu-icon blue">◉</text><text>我的客户</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="openIncentive"><text class="menu-icon orange">★</text><text>我的四项服务</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="openClaims"><text class="menu-icon cyan">↻</text><text>我的捞取记录</text><text class="arrow">›</text></view>
  </view>
  <view class="card menu-card">
    <view class="menu-item" bindtap="openPassword"><text class="menu-icon purple">⚿</text><text>修改密码</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="openScope"><text class="menu-icon blue">◇</text><text>数据权限说明</text><text class="arrow">›</text></view>
  </view>
  <view class="card menu-card">
    <view class="menu-item" bindtap="openWechat"><text class="menu-icon green">◌</text><text>微信绑定</text><text class="menu-status">{{profileView.wechatStatusText}}</text></view>
    <view class="menu-item" bindtap="clearCache"><text class="menu-icon gray">□</text><text>清除缓存</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="openAbout"><text class="menu-icon gray">ⓘ</text><text>关于我们</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="openAgreement"><text class="menu-icon gray">▤</text><text>用户协议</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="openPrivacy"><text class="menu-icon gray">▧</text><text>隐私政策</text><text class="arrow">›</text></view>
  </view>
  <view class="profile-action-row">
    <button class="profile-feedback-action" bindtap="openFeedback">意见反馈</button>
    <button class="profile-logout-action" bindtap="logout">退出登录</button>
  </view>
</view>
