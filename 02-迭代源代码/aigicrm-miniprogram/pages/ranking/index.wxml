<view class="page">
  <view class="hero"><view class="row"><view><view class="hero-title">排行中心</view><view class="hero-sub">客户贡献与积分排行统一查看</view></view><button class="ghost-btn" bindtap="refresh" loading="{{rankingView.refreshLoading}}">{{rankingView.refreshText}}</button></view></view>
  <view class="summary-grid">
    <view wx:for="{{rankingView.summaryCards}}" wx:key="key" class="summary-cell"><text>{{item.valueText}}</text><text>{{item.label}}</text></view>
  </view>
  <view class="ranking-context-card">
    <view class="ranking-context-head">
      <text>当前排行口径</text>
      <view>{{rankingView.contextSummary}}</view>
    </view>
    <view class="ranking-context-grid">
      <view wx:for="{{rankingView.contextChips}}" wx:key="label">
        <text>{{item.label}}</text>
        <view>{{item.value}}</view>
      </view>
    </view>
  </view>
  <view class="card score-top-card">{{rankingView.topScoreText}}</view>
  <!-- 【2026-09-23 需求同步】四项激励个人排行(按人员统计, 与 PC 激励统计-个人排行同口径; 周期与积分排行联动) -->
  <view class="section-head">
    <view>
      <view class="section-title">激励个人排行</view>
      <view class="section-sub">按人员统计四项激励总额，公司级口径</view>
    </view>
    <picker mode="selector" range="{{periodOptions}}" range-key="label" value="{{periodIndex}}" bindchange="onPeriodChange">
      <view class="period-chip">{{rankingView.scorePeriodText}}</view>
    </picker>
  </view>
  <block wx:for="{{incentiveBoardView}}" wx:key="rank">
    <view class="card score-rank-card">
      <view class="score-rank-no">{{item.rank}}</view>
      <view class="score-rank-main">
        <view class="score-rank-title">{{item.realName || '未知'}}</view>
        <view class="score-rank-meta">{{item.officeName || '—'}} · {{item.recordCount || 0}}条</view>
      </view>
      <view class="score-rank-value">{{item.totalScore || 0}}<text>分</text></view>
    </view>
  </block>
  <pager wx:if="{{incentiveTotal > 0}}" page="{{incentivePage}}" pageSize="{{incentivePageSize}}" total="{{incentiveTotal}}" loading="{{rankingView.showLoading}}" bind:change="onIncentivePagerChange" />
  <view wx:if="{{!incentiveBoard.length}}" class="card muted">暂无激励个人排行数据</view>
  <view class="section-head">
    <view>
      <view class="section-title">积分排行</view>
      <view class="section-sub">个人/部门排行使用评分周期，与 PC 端同一接口口径</view>
    </view>
    <picker mode="selector" range="{{periodOptions}}" range-key="label" value="{{periodIndex}}" bindchange="onPeriodChange">
      <view class="period-chip">{{rankingView.scorePeriodText}}</view>
    </picker>
  </view>
  <view class="ranking-tabs compact">
    <block wx:for="{{scoreTabsView}}" wx:key="key">
      <view class="{{item.className}}" data-key="{{item.key}}" bindtap="switchScoreTab">{{item.title}}</view>
    </block>
  </view>
  <block wx:for="{{scoreListView}}" wx:key="rank">
    <view class="card score-rank-card" data-index="{{index}}" bindtap="openScoreDetail">
      <view class="score-rank-no">{{item.displayRank}}</view>
      <view class="score-rank-main">
        <view class="score-rank-title">{{item.title}}</view>
        <view class="score-rank-meta">{{item.meta}}</view>
      </view>
      <view class="score-rank-value">{{item.totalScoreText}}<text>分</text></view>
    </view>
  </block>
  <pager wx:if="{{scoreTotal > 0}}" page="{{scorePage}}" pageSize="{{scorePageSize}}" total="{{scoreTotal}}" loading="{{rankingView.showLoading}}" bind:change="onScorePagerChange" />
  <view wx:if="{{rankingView.showScoreEmpty}}" class="card muted">暂无积分排行数据</view>
  <view class="card score-rule-card">
    <view>积分规则</view>
    <text>总积分按周期内评分项汇总；同分优先比较文件数，文件数相同再按姓名排序。</text>
  </view>
  <view class="section-head customer-section-head">
    <view>
      <view class="section-title">客户排行</view>
      <view class="section-sub">四项激励、客情关系、核心指标统一客户口径</view>
    </view>
    <picker mode="selector" range="{{customerPeriodOptions}}" range-key="label" value="{{customerPeriodIndex}}" bindchange="onCustomerPeriodChange">
      <view class="period-chip">{{rankingView.customerPeriodText}}</view>
    </picker>
  </view>
  <view class="ranking-tabs">
    <block wx:for="{{tabsView}}" wx:key="key">
      <view class="{{item.className}}" data-key="{{item.key}}" bindtap="switchTab">{{item.title}}</view>
    </block>
  </view>
  <view wx:if="{{rankingView.showLoading}}" class="card muted">{{rankingView.loadingText}}</view>
  <block wx:for="{{customerListView}}" wx:key="customerId">
    <view class="card ranking-card" data-index="{{index}}" bindtap="openDetail">
      <view class="ranking-card-head">
        <view class="ranking-title">{{item.displayRank}}. {{item.title}}</view>
        <text class="ranking-score">{{item.scoreText}} 分</text>
      </view>
      <!-- 【#8 2026-10-12】负责人/行业小表格(替代一行"·"串联文本) -->
      <view class="rank-kv-table">
        <view wx:for="{{item.ownerIndustryRows}}" wx:for-item="kv" wx:key="label" class="rank-kv-cell">
          <text class="rank-kv-label">{{kv.label}}</text>
          <text class="rank-kv-value">{{kv.value}}</text>
        </view>
      </view>
      <!-- 【#12 2026-10-13】四项激励明细三列表格(类型/条数/得分+合计行),替代两行长文本 -->
      <view wx:if="{{item.showIncentive}}" class="rank-stat-table">
        <view class="rank-stat-row head">
          <text class="rank-stat-name">激励类型</text>
          <text class="rank-stat-num">条数</text>
          <text class="rank-stat-num">得分</text>
        </view>
        <view wx:for="{{item.incentiveRows}}" wx:for-item="row" wx:key="id" class="rank-stat-row">
          <text class="rank-stat-name">{{row.name}}</text>
          <text class="rank-stat-num">{{row.count}}</text>
          <text class="rank-stat-num">{{row.score}}</text>
        </view>
        <view class="rank-stat-row total">
          <text class="rank-stat-name">合计</text>
          <text class="rank-stat-num">{{item.incentiveTotal.count}}</text>
          <text class="rank-stat-num">{{item.incentiveTotal.score}}</text>
        </view>
      </view>
      <!-- 【#8】五项指标: 一行五格, 数字大标签小 -->
      <view wx:if="{{item.showCore}}" class="rank-indicator-strip">
        <view wx:for="{{item.indicatorCells}}" wx:for-item="cell" wx:key="key" class="rank-indicator-cell">
          <text class="rank-indicator-value">{{cell.value}}</text>
          <text class="rank-indicator-label">{{cell.label}}</text>
        </view>
      </view>
      <!-- 【#8】财务两列 + 核心三态徽章(真核心/争核心/非核心, #9d 排行区分) -->
      <view wx:if="{{item.showCore}}" class="rank-finance-row">
        <view class="rank-kv-table">
          <view wx:for="{{item.financeCells}}" wx:for-item="kv" wx:key="key" class="rank-kv-cell">
            <text class="rank-kv-label">{{kv.label}}</text>
            <text class="rank-kv-value">{{kv.value}}</text>
          </view>
        </view>
        <text class="rank-core-badge {{item.coreBadge.className}}">{{item.coreBadge.text}}</text>
      </view>
    </view>
  </block>
  <pager wx:if="{{customerTotal > 0}}" page="{{customerPage}}" pageSize="{{customerPageSize}}" total="{{customerTotal}}" loading="{{rankingView.showLoading}}" bind:change="onCustomerPagerChange" />
  <view wx:if="{{rankingView.showCustomerEmpty}}" class="card muted">暂无排行数据</view>
</view>
