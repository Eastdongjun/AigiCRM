<view class="page">
  <view class="hero"><view class="row"><view><view class="hero-title">客户排行</view><view class="hero-sub">四项激励、客情关系、核心指标统一客户口径</view></view><button class="ghost-btn" bindtap="refresh" loading="{{loading}}">刷新</button></view></view>
  <view class="row" style="margin:24rpx 0 16rpx"><block wx:for="{{tabs}}" wx:key="key"><view class="pill" data-key="{{item.key}}" bindtap="switchTab" style="margin-right:12rpx;{{activeTab===item.key?'background:#2563eb;color:#fff':''}}">{{item.title}}</view></block></view>
  <view wx:if="{{loading}}" class="card muted">加载中...</view>
  <block wx:for="{{list}}" wx:key="customerId">
    <view class="card" style="margin-bottom:16rpx" data-index="{{index}}" bindtap="openDetail">
      <view class="row"><view style="font-size:30rpx;font-weight:700;flex:1">{{index + 1}}. {{item.customerName || '未命名客户'}}</view><text class="pill">{{activeTab==='relationship' ? item.relationshipScore : item.totalScore || 0}} 分</text></view>
      <view class="muted" style="margin-top:10rpx">{{item.ownerName || '未分配负责人'}} · {{item.industry || '未填写行业'}}</view>
      <view wx:if="{{activeTab==='incentive'}}" class="muted" style="margin-top:10rpx">上传 {{item.recordCount || 0}} 条</view>
      <view wx:if="{{activeTab==='incentive'}}" class="muted" style="margin-top:10rpx">
        <block wx:for="{{incentiveParents}}" wx:for-item="parent" wx:for-index="parentIndex" wx:key="id">
          {{item.byParent && item.byParent[parent.id] ? item.byParent[parent.id].count : 0}} 条/{{item.byParent && item.byParent[parent.id] ? item.byParent[parent.id].score : 0}} 分 {{parent.categoryName}}{{parentIndex < incentiveParents.length - 1 ? ' · ' : ''}}
        </block>
      </view>
      <view wx:if="{{activeTab==='core'}}" class="muted" style="margin-top:10rpx">高层 {{item.relationshipScore || 0}} · 渠道 {{item.indicator02 || 0}} · 基层 {{item.indicator03 || 0}} · 产品 {{item.indicator04 || 0}} · 项目 {{item.indicator05 || 0}}</view>
      <view wx:if="{{activeTab==='core'}}" class="muted" style="margin-top:10rpx">开票 {{item.invoiceTotal || 0}} 万 · 回款 {{item.paymentTotal || 0}} 万 · 核心 {{item.core ? '是' : '否'}}</view>
    </view>
  </block>
  <view wx:if="{{!loading && list.length===0}}" class="card muted">暂无排行数据</view>
</view>
