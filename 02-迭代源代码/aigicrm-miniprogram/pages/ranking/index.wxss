.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin:18rpx 0}
.summary-cell{min-height:112rpx;border-radius:22rpx;background:#fff;border:1rpx solid #e5edf6;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 8rpx 24rpx rgba(35,57,96,.05)}
.summary-cell text:first-child{font-size:34rpx;font-weight:850;color:#172033}
.summary-cell text:last-child{margin-top:6rpx;font-size:22rpx;color:#7c8ba1}
.ranking-context-card{margin:0 0 16rpx;padding:20rpx 22rpx;border:1rpx solid #dce8f6;border-radius:20rpx;background:#f8fbff}
.ranking-context-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.ranking-context-head text{flex:none;color:#2563eb;font-size:22rpx;font-weight:850;line-height:30rpx}
.ranking-context-head view{min-width:0;overflow:hidden;color:#172033;font-size:25rpx;font-weight:850;line-height:32rpx;text-align:right;text-overflow:ellipsis;white-space:nowrap}
.ranking-context-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:16rpx}
.ranking-context-grid>view{min-width:0;padding:12rpx 14rpx;border-radius:14rpx;background:#fff}
.ranking-context-grid text{display:block;color:#7c8ba1;font-size:20rpx;line-height:26rpx}
.ranking-context-grid view view{margin-top:4rpx;overflow:hidden;color:#334155;font-size:23rpx;font-weight:800;line-height:30rpx;text-overflow:ellipsis;white-space:nowrap}
.score-top-card{margin-bottom:18rpx;color:#52657f;font-size:24rpx;font-weight:750}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:22rpx 0 14rpx}
.customer-section-head{margin-top:28rpx}
.section-title{font-size:30rpx;font-weight:850;color:#172033;line-height:1.25}
.section-sub{margin-top:6rpx;font-size:22rpx;color:#7c8ba1;line-height:1.35}
.period-chip{min-width:132rpx;height:56rpx;padding:0 20rpx;border-radius:12rpx;border:1rpx solid #d8e2ef;background:#fff;color:#52657f;font-size:23rpx;font-weight:750;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.ranking-tabs.compact{margin-bottom:12rpx}
.score-rank-card{display:grid;grid-template-columns:52rpx 1fr auto;align-items:center;gap:16rpx;margin-bottom:12rpx;padding:20rpx 22rpx}
.score-rank-no{width:52rpx;height:52rpx;border-radius:14rpx;background:#eef5ff;color:#2563eb;font-size:24rpx;font-weight:850;display:flex;align-items:center;justify-content:center}
.score-rank-main{min-width:0}
.score-rank-title{font-size:28rpx;font-weight:850;color:#172033;line-height:1.35;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.score-rank-meta{margin-top:6rpx;font-size:22rpx;color:#7c8ba1;line-height:1.35}
.score-rank-value{font-size:32rpx;font-weight:900;color:#172033;line-height:1}
.score-rank-value text{margin-left:3rpx;font-size:20rpx;color:#7c8ba1;font-weight:750}
.score-rule-card{margin:14rpx 0 4rpx;padding:20rpx 22rpx}
.score-rule-card view{font-size:25rpx;font-weight:850;color:#172033;margin-bottom:8rpx}
.score-rule-card text{display:block;font-size:22rpx;color:#7c8ba1;line-height:1.55}

/* 【#8 2026-10-12】客户卡片小表格化: kv 两列表 + 五项指标条 + 财务行 + 核心徽章 */
.rank-kv-table { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 16rpx; }
.rank-kv-cell { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; background: #f6f8fc; border-radius: 12rpx; padding: 12rpx 16rpx; }
.rank-kv-label { flex-shrink: 0; color: #94a3b8; font-size: 21rpx; }
.rank-kv-value { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #172033; font-size: 24rpx; font-weight: 700; }
.rank-indicator-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10rpx; margin-top: 16rpx; }
.rank-indicator-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
  background: #f6f8fc; border-radius: 12rpx; padding: 14rpx 0 10rpx; }
.rank-indicator-value { color: #0f172a; font-size: 32rpx; font-weight: 800; line-height: 1.1; }
.rank-indicator-label { color: #94a3b8; font-size: 20rpx; }
.rank-finance-row { display: flex; align-items: stretch; gap: 10rpx; margin-top: 16rpx; }
.rank-finance-row .rank-kv-table { flex: 1; margin-top: 0; }
.rank-finance-row .rank-kv-table .rank-kv-cell { flex-direction: column; align-items: flex-start; gap: 4rpx; }
.rank-core-badge { flex-shrink: 0; align-self: center; border-radius: 999rpx; padding: 10rpx 22rpx; font-size: 23rpx; font-weight: 800; border: 1rpx solid transparent; }
.rank-core-badge.core { background: #dcfce7; color: #047857; border-color: #bbf7d0; }
.rank-core-badge.quasi { background: #ffedd5; color: #c2410c; border-color: #fed7aa; }
.rank-core-badge.none { background: #f1f5f9; color: #64748b; border-color: #e2e8f0; }

/* 【#12 2026-10-13】四项激励明细三列表格(类型/条数/得分+合计行) */
.rank-stat-table { margin-top: 16rpx; background: #f6f8fc; border-radius: 12rpx; overflow: hidden; }
.rank-stat-row { display: grid; grid-template-columns: minmax(0, 1fr) 110rpx 110rpx; align-items: center; padding: 10rpx 16rpx; }
.rank-stat-row + .rank-stat-row { border-top: 1rpx solid #e8edf5; }
.rank-stat-row.head { padding: 8rpx 16rpx; background: #eef2f9; }
.rank-stat-row.head text { color: #94a3b8; font-size: 20rpx; font-weight: 500; }
.rank-stat-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #475569; font-size: 22rpx; }
.rank-stat-num { text-align: right; color: #172033; font-size: 24rpx; font-weight: 700; }
.rank-stat-row.total { border-top: 1rpx solid #d6deeb; }
.rank-stat-row.total text { color: #172033; font-weight: 800; }
