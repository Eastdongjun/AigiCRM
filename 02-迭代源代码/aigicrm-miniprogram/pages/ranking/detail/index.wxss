/* 【2026-11-06 用户令"学分排行明细很丑, 好好设计 UI 注意页面骨架"】页级样式:
   紧凑头卡 + 得分明细列表, 沿用全局 hero/card 语言, 分值右对齐蓝字。 */
.rd-head-card{display:flex;align-items:center;gap:20rpx;padding:24rpx}
.rd-avatar{width:88rpx;height:88rpx;border-radius:50%;background:linear-gradient(135deg,#16337a,#1d4ed8);color:#fff;font-size:40rpx;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rd-main{flex:1;min-width:0}
.rd-name-row{display:flex;align-items:center;gap:12rpx;min-width:0}
.rd-name{font-size:30rpx;font-weight:800;color:#172033;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rd-rank-badge{flex-shrink:0;background:#eef4ff;color:#1d4ed8;font-size:20rpx;font-weight:700;padding:4rpx 12rpx;border-radius:999rpx}
.rd-meta{margin-top:8rpx;color:#677892;font-size:22rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rd-score-box{display:flex;align-items:baseline;gap:4rpx;flex-shrink:0}
.rd-score-num{font-size:52rpx;font-weight:800;color:#1d4ed8}
.rd-score-unit{font-size:22rpx;color:#94a3b8}
.rd-item-row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:18rpx 4rpx;border-bottom:1rpx solid #eef2f7}
.rd-item-row:last-child{border-bottom:0}
.rd-item-name{color:#334155;font-size:26rpx;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rd-item-score{flex-shrink:0;color:#1d4ed8;font-size:26rpx;font-weight:800}
.rd-empty{padding:36rpx 4rpx;text-align:center}
.rd-items-card{padding:10rpx 24rpx}
