<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">排行明细</view>
        <view class="hero-sub">个人四项激励积分表现</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>

  <view class="card ranking-detail-card">
    <view class="profile-avatar">{{rankingDetailView.nameInitialText}}</view>
    <view class="ranking-detail-name">{{rankingDetailView.nameText}}</view>
    <view class="ranking-detail-score">{{rankingDetailView.scoreText}}<text>分</text></view>
    <view class="detail-row"><text>统计周期</text><text>{{rankingDetailView.periodText}}</text></view>
    <view class="detail-row"><text>组织范围</text><text>{{rankingDetailView.deptText}}</text></view>
  </view>
</view>
