<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">学分明细</view>
        <view class="hero-sub">{{header.subText}}</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>

  <!-- 紧凑头卡: 头像首字 + 姓名 + 名次徽标 | 总分右对齐大字; 周期/组织一行 meta -->
  <view class="card rd-head-card">
    <view class="rd-avatar">{{header.nameInitialText}}</view>
    <view class="rd-main">
      <view class="rd-name-row">
        <text class="rd-name">{{header.nameText}}</text>
        <view wx:if="{{header.rankText}}" class="rd-rank-badge">第 {{header.rankText}} 名</view>
      </view>
      <view class="rd-meta">{{header.metaText}}</view>
    </view>
    <view class="rd-score-box">
      <text class="rd-score-num">{{header.scoreText}}</text>
      <text class="rd-score-unit">分</text>
    </view>
  </view>

  <!-- 部门模式: 成员明细(点成员行钻到该成员的学分明细) -->
  <block wx:if="{{mode === 'dept'}}">
    <view class="section-title">成员明细</view>
    <view class="card rd-items-card">
      <view wx:if="{{membersView.summaryText}}" class="rd-members-summary">{{membersView.summaryText}}</view>
      <view wx:for="{{membersView.rows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="key" class="rd-item-row rd-member-row" data-user-id="{{row.userId}}" data-name="{{row.name}}" data-score="{{row.score}}" bindtap="onMemberTap">
        <view class="rd-member-main">
          <view class="rd-item-name">{{row.name}}</view>
          <view class="rd-member-meta">{{row.meta}}</view>
        </view>
        <text class="rd-item-score">{{row.scoreText}}</text>
      </view>
      <view wx:if="{{!membersView.rows.length}}" class="rd-empty muted">该部门暂无成员学分</view>
    </view>
  </block>

  <!-- 个人模式: 得分明细表格(与 PC 明细弹窗/录入网格同构: #/大类/产品/得分, 全部学分项按录入顺序) -->
  <block wx:else>
  <view class="section-title">得分明细</view>
  <view class="card rd-items-card">
    <block wx:if="{{itemsView.rows.length}}">
      <view class="rd-table-head">
        <text class="rd-th rd-th-idx">#</text>
        <text class="rd-th rd-th-cat">大类</text>
        <text class="rd-th rd-th-prod">产品</text>
        <text class="rd-th rd-th-score">得分</text>
      </view>
      <view wx:for="{{itemsView.rows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="key" class="rd-table-row">
        <text class="rd-td rd-th-idx">{{rowIndex + 1}}</text>
        <text class="rd-td rd-th-cat">{{row.catName}}</text>
        <text class="rd-td rd-th-prod">{{row.name}}</text>
        <text class="rd-td rd-th-score {{row.scoreNum > 0 ? 'rd-score-hi' : 'rd-score-zero'}}">{{row.scoreText}}</text>
      </view>
    </block>
    <view wx:else class="rd-empty muted">{{itemsView.emptyText}}</view>
  </view>
  </block>
</view>
