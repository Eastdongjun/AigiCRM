<view class="page app-page">
  <view class="ap-hero">
    <view class="ap-hero-glow"></view>
    <view class="ap-hero-eyebrow">APPLICATION CENTER</view>
    <view class="ap-hero-title">应用中心</view>
    <view class="ap-hero-sub">按业务模块组织，快速找到要用的工具</view>
    <view class="ap-hero-meta">已开通 {{appView.totalText}} 个应用 · {{appView.groupText}}</view>
  </view>

  <block wx:for="{{appView.groups}}" wx:for-item="module" wx:key="key">
    <view class="ap-module">
      <view class="ap-module-head">
        <view class="ap-module-index">{{module.indexText}}</view>
        <view class="ap-module-copy">
          <view class="ap-module-title">{{module.title}}</view>
          <view class="ap-module-sub">{{module.subtitle}}</view>
        </view>
        <view class="ap-module-count">{{module.countText}}</view>
      </view>
      <view class="ap-grid">
        <view
          wx:for="{{module.entries}}"
          wx:for-item="app"
          wx:key="key"
          class="ap-tile {{app.wide ? 'ap-tile-wide' : ''}}"
          hover-class="ap-tile-active"
          bindtap="openApp"
          data-key="{{app.key}}"
        >
          <view class="ap-icon">{{app.iconText}}</view>
          <view class="ap-tile-main">
            <view class="ap-tile-title">{{app.title}}</view>
            <view class="ap-tile-sub">{{app.tileSubtitle}}</view>
          </view>
          <view class="ap-arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{appView.showEmpty}}" class="card muted ap-empty">暂无可用应用</view>
</view>
