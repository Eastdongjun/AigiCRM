/* 首页 2026-10-20 改版：深蓝驾驶舱 + 客户结构图 + 单色功能入口 + 预警列表。
   类名统一 hm- 前缀，避免与 app.wxss 旧首页样式互相覆盖。 */

.home-page { padding-bottom: 56rpx; }

.hm-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 4rpx 24rpx;
}
.hm-brand { display: flex; flex-direction: column; gap: 2rpx; }
.hm-brand-name {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #14213d;
}
.hm-brand-sub { font-size: 20rpx; color: #8a9ab3; letter-spacing: 1rpx; }
.hm-bell {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(37, 72, 130, .08);
}
.hm-bell-glyph { font-size: 25rpx; font-weight: 700; color: #33507a; }
.hm-bell-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 17rpx;
  line-height: 28rpx;
  text-align: center;
  font-weight: 700;
}

.hm-hero {
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  padding: 30rpx 30rpx 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #0d1733 0%, #16337a 55%, #1d4ed8 100%);
  box-shadow: 0 22rpx 46rpx rgba(13, 23, 51, .26);
}
.hm-hero-glow {
  position: absolute;
  top: -150rpx;
  right: -110rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, .34) 0%, rgba(96, 165, 250, 0) 68%);
}
.hm-hero-head {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}
.hm-hero-copy { flex: 1; min-width: 0; }
.hm-hero-greet { font-size: 30rpx; font-weight: 700; letter-spacing: .5rpx; }
.hm-hero-meta {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, .62);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.hm-hero-date {
  flex-shrink: 0;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, .9);
}
.hm-hero-date text {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, .55);
}
.hm-hero-metric { position: relative; margin-top: 30rpx; }
.hm-hero-value {
  font-size: 74rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
}
.hm-hero-value text {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0;
  color: rgba(255, 255, 255, .62);
}
.hm-hero-label { margin-top: 8rpx; font-size: 21rpx; color: rgba(255, 255, 255, .58); }
.hm-hero-rate {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .2);
  border-radius: 999rpx;
  font-size: 19rpx;
  color: rgba(255, 255, 255, .82);
  background: rgba(255, 255, 255, .07);
}
.hm-hero-chips {
  position: relative;
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}
.hm-hero-chip {
  flex: 1;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(255, 255, 255, .1);
}
.hm-chip-value { display: block; font-size: 30rpx; font-weight: 700; line-height: 1.1; }
.hm-chip-label { display: block; margin-top: 6rpx; font-size: 18rpx; color: rgba(255, 255, 255, .56); }

.hm-task {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #dbe7fb;
  background: #eef4ff;
  color: #1d4ed8;
  font-size: 22rpx;
}
.hm-task-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #f59e0b; flex-shrink: 0; }

.hm-section { margin-top: 32rpx; }
.hm-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}
.hm-section-title { font-size: 27rpx; font-weight: 800; color: #172033; letter-spacing: .5rpx; }
.hm-section-sub { font-size: 20rpx; color: #94a3b8; }
.hm-section-right { display: flex; align-items: baseline; gap: 18rpx; }
.hm-link { font-size: 21rpx; color: #2563eb; font-weight: 500; }

.hm-chart { padding: 14rpx 26rpx; border-radius: 24rpx; }
.hm-chart-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.hm-chart-label {
  width: 138rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #5b6b82;
}
.hm-chart-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.hm-chart-dot.primary { background: #2563eb; }
.hm-chart-dot.warn { background: #f59e0b; }
.hm-chart-dot.danger { background: #ef4444; }
.hm-chart-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  overflow: hidden;
}
.hm-chart-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width .45s cubic-bezier(.16, 1, .3, 1);
}
.hm-chart-fill.has-bar { min-width: 6rpx; }
.hm-chart-fill.primary { background: linear-gradient(90deg, #1d4ed8, #60a5fa); }
.hm-chart-fill.warn { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
.hm-chart-fill.danger { background: linear-gradient(90deg, #ef4444, #f87171); }
.hm-chart-value {
  width: 126rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 24rpx;
  font-weight: 700;
  color: #172033;
}
.hm-chart-value text {
  margin-left: 8rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: #94a3b8;
}

.hm-quick {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 10rpx 22rpx;
  border-radius: 24rpx;
}
.hm-quick-item {
  position: relative;
  width: 33.333%;
  padding: 16rpx 0 14rpx;
  text-align: center;
}
.hm-quick-active { opacity: .72; }
.hm-quick-icon {
  width: 66rpx;
  height: 66rpx;
  margin: 0 auto 12rpx;
  border-radius: 18rpx;
  background: #eef4ff;
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(29, 78, 216, .08);
}
.hm-quick-title { font-size: 21rpx; color: #46556d; font-weight: 500; }
.hm-quick-badge {
  display: inline-block;
  margin-left: 6rpx;
  padding: 1rpx 8rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 16rpx;
  line-height: 24rpx;
  vertical-align: 2rpx;
}

.hm-warnings { padding: 6rpx 24rpx; border-radius: 24rpx; }
.hm-warning {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
}
.hm-warning + .hm-warning { border-top: 1rpx solid #f1f5fb; }
.hm-warning-days {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #fff7e8;
  color: #b45309;
  font-size: 19rpx;
  font-weight: 600;
}
.hm-warning-copy { flex: 1; min-width: 0; }
.hm-warning-name {
  font-size: 24rpx;
  font-weight: 650;
  color: #172033;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hm-warning-meta { margin-top: 6rpx; font-size: 19rpx; color: #94a3b8; }
.hm-warning-arrow { flex-shrink: 0; font-size: 28rpx; color: #c1ccdc; font-weight: 600; }
