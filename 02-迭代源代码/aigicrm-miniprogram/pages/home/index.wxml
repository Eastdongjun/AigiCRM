<view class="page home-page">
  <!-- 【2026-10-23 Apple 风改版】顶栏并入 hero：品牌+铃铛一行、问候+日期一行、
       大数字与标签并排、三块预警 chip 卡压成一条细行（原顶部占高过多，用户反馈）。 -->
  <view class="hm-hero">
    <view class="hm-hero-glow"></view>
    <view class="hm-hero-top">
      <view class="hm-brand">
        <text class="hm-brand-name">{{appName}}</text>
        <text class="hm-brand-sub">移动客户经营驾驶舱</text>
      </view>
      <view class="hm-bell" bindtap="openReminder">
        <view class="hm-bell-icon"></view>
        <view wx:if="{{pendingCount}}" class="hm-bell-dot">{{pendingCount}}</view>
      </view>
    </view>
    <view class="hm-hero-line">
      <view class="hm-hero-copy">
        <view class="hm-hero-greet">{{today.greeting}}，{{userName}}</view>
        <view class="hm-hero-meta">{{orgName}}<text wx:if="{{roleName}}"> · {{roleName}}</text></view>
      </view>
      <view class="hm-hero-date">{{today.date}} {{today.weekday}}</view>
    </view>
    <view class="hm-hero-metric">
      <view class="hm-hero-value">{{overview.totalText}}<text>家</text></view>
      <view class="hm-hero-side">
        <view class="hm-hero-label">我的客户</view>
        <view wx:if="{{overview.total}}" class="hm-hero-rate">保护率 {{overview.protectionRate}}%</view>
      </view>
    </view>
    <view class="hm-hero-stats">
      <view class="hm-stat"><text class="hm-stat-value">{{overview.warnText}}</text><text class="hm-stat-label">即将到期</text></view>
      <view class="hm-stat-sep"></view>
      <view class="hm-stat"><text class="hm-stat-value">{{overview.expiredText}}</text><text class="hm-stat-label">已超期</text></view>
      <view class="hm-stat-sep"></view>
      <view class="hm-stat"><text class="hm-stat-value">{{overview.todayExpiringText}}</text><text class="hm-stat-label">今日到期</text></view>
    </view>
  </view>

  <view wx:if="{{taskSummary}}" class="hm-task"><text class="hm-task-dot"></text><text>{{taskSummary}}</text></view>

  <view wx:if="{{showDashboardCards}}" class="hm-section">
    <view class="hm-section-head">
      <text class="hm-section-title">客户结构</text>
      <text class="hm-section-sub">按状态分布</text>
    </view>
    <view class="card hm-chart">
      <view wx:for="{{overview.rows}}" wx:key="label" class="hm-chart-row">
        <view class="hm-chart-label"><text class="hm-chart-dot {{item.tone}}"></text><text>{{item.label}}</text></view>
        <view class="hm-chart-track"><view class="hm-chart-fill {{item.tone}} {{item.showBar ? 'has-bar' : ''}}" style="width: {{item.barWidth}}"></view></view>
        <view class="hm-chart-value">{{item.valueText}}<text>{{item.percentText}}</text></view>
      </view>
    </view>
  </view>

  <view class="hm-section">
    <view class="hm-section-head">
      <text class="hm-section-title">常用功能</text>
      <text class="hm-link" bindtap="openAppCenter">全部应用 ›</text>
    </view>
    <view class="card hm-quick">
      <view class="hm-quick-item" hover-class="hm-quick-active" bindtap="openNewCustomer">
        <view class="hm-quick-icon ic-customer"></view><text class="hm-quick-title">新客户</text>
      </view>
      <view class="hm-quick-item" hover-class="hm-quick-active" bindtap="openIncentive">
        <view class="hm-quick-icon ic-service"></view><text class="hm-quick-title">四项服务</text>
      </view>
      <view class="hm-quick-item" hover-class="hm-quick-active" bindtap="openIncentiveUpload">
        <view class="hm-quick-icon ic-upload"></view><text class="hm-quick-title">四项服务上传</text>
      </view>
      <view class="hm-quick-item" hover-class="hm-quick-active" bindtap="openApproval">
        <view class="hm-quick-icon ic-approval"></view><text class="hm-quick-title">审批管理</text>
      </view>
      <view class="hm-quick-item" hover-class="hm-quick-active" bindtap="openReminder">
        <view class="hm-quick-icon ic-reminder"></view><text class="hm-quick-title">提醒</text>
      </view>
      <view class="hm-quick-item" hover-class="hm-quick-active" bindtap="openStatistics">
        <view class="hm-quick-icon ic-stats"></view><text class="hm-quick-title">客户统计</text>
      </view>
    </view>
  </view>

  <view class="hm-section">
    <view class="hm-section-head">
      <text class="hm-section-title">到期预警</text>
      <view class="hm-section-right">
        <text class="hm-section-sub">{{homeView.expiringCountText}} 条</text>
        <text class="hm-link" bindtap="openReminder">全部提醒 ›</text>
      </view>
    </view>
    <view class="card hm-warnings">
      <block wx:for="{{homeView.expiringRows}}" wx:key="viewId">
        <view class="hm-warning" bindtap="openCustomer" data-index="{{index}}">
          <view class="hm-warning-days">{{item.remainingText}}</view>
          <view class="hm-warning-copy">
            <view class="hm-warning-name">{{item.customerName}}</view>
            <view class="hm-warning-meta">{{item.ownerExpireText}}</view>
          </view>
          <view class="hm-warning-arrow">›</view>
        </view>
      </block>
      <view wx:if="{{homeView.showExpiringEmpty}}" class="empty-state compact-empty"><view class="empty-icon">✓</view><text>暂无到期预警</text></view>
    </view>
  </view>
</view>
