<view class="page home-page">
  <view class="home-title-row">
    <view class="home-title-side"></view>
    <view class="home-title-center">
      <view class="home-title">{{appName}}</view>
      <view class="page-caption">移动客户经营驾驶舱</view>
    </view>
    <view class="home-actions">
      <text class="home-icon" bindtap="openReminder">♧</text>
    </view>
  </view>
  <view class="welcome-card">
    <view class="welcome-glow"></view>
    <view class="avatar">{{userInitial}}</view>
    <view class="welcome-copy">
      <view class="welcome-sub">{{today.greeting}}，欢迎回来</view>
      <view class="welcome-name">{{userName}}</view>
      <view class="welcome-meta">{{orgName}} · {{roleName}}</view>
    </view>
    <view class="welcome-date">{{today.date}}<text>{{today.weekday}}</text></view>
  </view>
  <!-- 【PR-10 前端】我的待办任务摘要(数据来自 loadHomeData 的 taskSummary);
       小程序端暂无任务列表页, 仅展示待办/逾期数量, 不接跳转入口(避免制造死入口) -->
  <view wx:if="{{taskSummary}}" class="home-task-summary">
    <text>{{taskSummary}}</text>
  </view>
  <view wx:if="{{showDashboardCards}}" class="grid home-stats">
    <block wx:for="{{cards}}" wx:key="*this">
      <view class="card stat-card">
        <view class="stat-topline"></view>
        <view class="stat-value">{{item[0]}}<text>家</text></view>
        <view class="stat-label">{{item[1]}}</view>
      </view>
    </block>
  </view>
  <view class="section-heading"><text>快捷入口</text></view>
  <view class="card quick-grid">
    <view class="quick-item" bindtap="openNewCustomer"><view class="quick-icon blue">＋</view><text>新客户</text></view>
    <view class="quick-item" bindtap="openIncentive"><view class="quick-icon cyan">♜</view><text>四项激励</text></view>
    <view class="quick-item" bindtap="openIncentiveUpload"><view class="quick-icon orange">▣</view><text>四项激励上传</text></view>
    <view class="quick-item" bindtap="openApproval"><view class="quick-icon green">✓</view><text>审批中心<em wx:if="{{pendingCount}}">{{pendingCount}}</em></text></view>
    <view class="quick-item" bindtap="openReminder"><view class="quick-icon red">♧</view><text>提醒</text></view>
    <view class="quick-item" bindtap="openStatistics"><view class="quick-icon purple">▥</view><text>客户统计</text></view>
  </view>
  <view class="section-heading"><text>到期预警 <em>{{homeView.expiringCountText}}</em></text><text class="muted" bindtap="openReminder">全部提醒 ›</text></view>
  <view class="card warning-list">
    <block wx:for="{{homeView.expiringRows}}" wx:key="viewId">
      <view class="warning-row" bindtap="openCustomer" data-index="{{index}}">
        <view class="warning-dot"></view>
        <view class="warning-copy"><view>{{item.customerName}}</view><text>{{item.ownerExpireText}}</text></view>
        <text class="warning-days">{{item.remainingText}}</text>
      </view>
    </block>
    <view wx:if="{{homeView.showExpiringEmpty}}" class="empty-state compact-empty"><view class="empty-icon">✓</view><text>暂无到期预警</text></view>
  </view>
</view>
