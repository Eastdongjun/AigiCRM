<view class="page home-page"><view class="home-title-row"><view class="home-title">{{appName}}</view><view class="home-actions"><text class="home-icon" bindtap="openReminder">♧</text><text class="home-icon">⚙</text></view></view><view class="welcome-card"><view class="avatar">{{userName.slice(0, 1)}}</view><view class="welcome-copy"><view class="welcome-sub">{{today.greeting}}，欢迎回来</view><view class="welcome-name">{{userName}}</view><view class="welcome-meta">{{orgName}} · {{roleName}}</view></view><view class="welcome-date">{{today.date}}<text>{{today.weekday}}</text></view></view><view wx:if="{{showDashboardCards}}" class="grid home-stats"><block wx:for="{{cards}}" wx:key="*this"><view class="card stat-card"><view class="stat-value">{{item[0]}}<text>家</text></view><view class="stat-label">{{item[1]}}</view><view class="stat-trend">▲ 本月新增</view></view></block></view><view class="section-heading"><text>快捷入口</text><text class="muted">应用中心 ›</text></view><view class="card quick-grid"><view class="quick-item" bindtap="openNewCustomer"><view class="quick-icon blue">＋</view><text>新客户</text></view><view class="quick-item" bindtap="openIncentive"><view class="quick-icon cyan">♜</view><text>价值服务案例</text></view><view class="quick-item" bindtap="openIncentive"><view class="quick-icon orange">▣</view><text>价值服务上报</text></view><view class="quick-item" bindtap="openApproval"><view class="quick-icon green">✓</view><text>审批中心<em wx:if="{{pendingCount}}">{{pendingCount}}</em></text></view><view class="quick-item" bindtap="openReminder"><view class="quick-icon red">♧</view><text>提醒</text></view><view class="quick-item" bindtap="openStatistics"><view class="quick-icon purple">▥</view><text>客户统计</text></view></view><view class="section-heading"><text>到期预警 <em>{{expiring.length}}</em></text><text class="muted" bindtap="openReminder">全部提醒 ›</text></view><view class="card warning-list"><block wx:for="{{expiring}}" wx:key="id"><view class="warning-row" bindtap="openCustomer" data-index="{{index}}"><view class="warning-dot"></view><view class="warning-copy"><view>{{item.customerName}}</view><text>{{item.ownerName || '负责人'}} · 到期 {{item.expireDate || '-'}}</text></view><text class="warning-days">剩 {{item.remainingDays || '--'}} 天</text></view></block><view wx:if="{{expiring.length===0}}" class="muted">暂无到期预警</view></view></view>
