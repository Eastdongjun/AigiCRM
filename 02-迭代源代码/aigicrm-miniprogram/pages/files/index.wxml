<view class="page files-page">
  <!-- 2026-10-23 二轮压缩(用户令"文件管理/存储空间区域太大"): 两行细条——
       标题+容量+上传一行, 进度条+申请扩容一行; 删副标题/「存储空间」标签/提示语 -->
  <view class="files-top">
    <view class="files-top-row">
      <view class="files-top-title">文件管理</view>
      <view class="files-top-cap">{{capacity.used}}<text> / {{capacity.total}}</text></view>
      <button wx:if="{{fileView.showUploadAction}}" class="files-top-upload" loading="{{uploading}}" bindtap="uploadFile">＋ 上传</button>
    </view>
    <view class="files-top-meter">
      <view class="files-top-progress"><view style="width:{{capacity.percent}}%"></view></view>
      <!-- 【D1-A 2026-10-18】仅 canApply 显示入口; 不可申请时透出后端短原因(未授权/在途/已上限) -->
      <button wx:if="{{storageApplyView.showApplyAction}}" class="files-top-apply" bindtap="openStorageApply">申请扩容 ›</button>
      <text wx:elif="{{storageApplyView.showReason}}" class="files-top-reason">{{storageApplyView.reasonText}}</text>
    </view>
  </view>
  <button wx:if="{{canDevUploadSmoke}}" class="btn files-smoke-btn" loading="{{uploading}}" bindtap="runDevUploadSmoke">本地上传自测</button>
  <view class="search-box"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="searchFiles" confirm-type="search" placeholder="{{activeTab === '四项服务' ? '搜索文件名 / 客户 / 人员 / 时间' : '搜索文件名或文件夹'}}" /><button class="search-action" bindtap="searchFiles">搜索</button></view>
  <scroll-view scroll-x class="file-tabs" enable-flex>
    <view class="file-tab-list"><view wx:for="{{fileView.tabs}}" wx:key="key" class="file-tab {{item.activeClass}}" data-tab="{{item.key}}" bindtap="onTabTap">{{item.label}}<text class="tab-count">{{item.countText}}</text></view></view>
  </scroll-view>
  <view wx:if="{{fileView.showFolderCard}}" class="card files-folder-card">
    <view class="folder-title"><text>{{fileView.folderTitle}}</text><button wx:if="{{fileView.showClearFolder}}" class="text-btn" bindtap="clearFolder">返回全部</button><text wx:else class="muted">{{fileView.folderCountText}}</text></view>
    <scroll-view wx:if="{{fileView.showFolderList}}" scroll-x class="folder-scroll" enable-flex>
    <view class="folder-list">
      <view wx:for="{{fileView.folders}}" wx:key="id" class="folder-card" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openFolder"><view class="folder-icon"></view><text>{{item.name}}</text></view>
      <view wx:if="{{fileView.showFallbackFolders}}" class="folder-card" data-name="客户文档" bindtap="openFolder"><view class="folder-icon"></view><text>客户文档</text></view>
      <view wx:if="{{fileView.showFallbackFolders}}" class="folder-card" data-name="团队共享" bindtap="openFolder"><view class="folder-icon"></view><text>团队共享</text></view>
      </view>
    </scroll-view>
  </view>
  <view class="section-row">
    <view class="section-title" wx:if="{{fileView.listTitle}}">{{fileView.listTitle}}</view>
    <view class="breadcrumb" wx:if="{{fileView.breadcrumbText}}">{{fileView.breadcrumbText}}</view>
    <view class="section-count">{{fileView.fileCountText}}</view>
  </view>
  <view wx:if="{{fileView.showLoading}}" class="muted">{{fileView.loadingText}}</view>
  <view wx:if="{{fileView.showFileList}}" class="file-list">
    <block wx:for="{{fileView.fileGroups}}" wx:key="key" wx:for-item="group" wx:for-index="groupIdx">
      <view class="file-group-head">{{group.label}} · {{group.count}}</view>
      <view wx:for="{{group.files}}" wx:key="id" wx:for-item="file" class="file-row" data-index="{{file.flatIndex}}" bindtap="openFile" bind:longpress="openActionSheet">
        <view class="file-type {{file.tone}}">{{file.typeText}}</view>
        <view class="file-info">
          <view class="file-name">{{file.nameText}}</view>
          <view class="file-meta">{{file.metaBrief}}</view>
          <view class="file-meta sub">{{file.metaExtra}}</view>
        </view>
        <view class="file-more-btn" catchtap="openActionSheet" data-index="{{file.flatIndex}}">···</view>
      </view>
    </block>
  </view>
  <video wx:if="{{previewVideoPath}}" src="{{previewVideoPath}}" controls class="file-preview-video"></video>
  <!-- 【分页 2026-10-18】最近文件改为显式分页（10/30 条一页），翻页/切换每页条数走 pager 事件 -->
  <pager wx:if="{{total > 10}}" page="{{page}}" pageSize="{{pageSize}}" total="{{total}}" loading="{{fileView.pagerLoading}}" bind:change="onPagerChange" />
  <view wx:if="{{fileView.showEmpty}}" class="empty-state"><text class="empty-icon">⌁</text><text>暂未找到匹配文件</text></view>
  <!-- 【需求A 2026-10-16】操作面板: 行尾「···」或长按呼出, 打开/下载/分享/替换/删除按权限显隐 -->
  <view wx:if="{{actionSheet.visible}}" class="sheet-mask" catchtap="closeActionSheet">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-file-name">{{actionSheet.name}}</view>
      <view class="sheet-grid">
        <view wx:for="{{actionSheet.actions}}" wx:key="key" wx:for-item="act" class="sheet-act {{act.key === 'delete' ? 'danger' : ''}}" data-act="{{act.key}}" catchtap="onSheetAction">
          <text class="sheet-act-icon">{{act.key === 'open' ? '▸' : act.key === 'download' ? '⇣' : act.key === 'share' ? '↗' : '✕'}}</text>
          <text>{{act.label}}</text>
        </view>
      </view>
      <view class="sheet-cancel" catchtap="closeActionSheet">取消</view>
    </view>
  </view>
  <view wx:if="{{canManageFolder && fileView.showFolderCard}}" class="files-manage-card">
    <view class="files-manage-head"><text>文件夹管理</text><button class="folder-new-action" bindtap="openFolderForm">＋ 新建</button></view>
    <block wx:if="{{fileView.showManageFolders}}">
      <view wx:for="{{fileView.folders}}" wx:key="id" class="folder-manage-row">
        <view class="folder-manage-icon"><view class="folder-icon"></view></view>
        <text class="folder-manage-name">{{item.name}}</text>
        <view class="folder-manage-more" data-id="{{item.id}}" data-name="{{item.name}}" data-raw-name="{{item.rawName}}" catchtap="openFolderActions">···</view>
      </view>
    </block>
    <view wx:if="{{fileView.showManageEmpty}}" class="muted">暂无可管理文件夹</view>
  </view>
  <view wx:if="{{aclVisible}}" class="modal-mask" catchtap="closeFolderAcl">
    <view class="card modal-card" catchtap="noop">
      <view class="modal-head"><view class="modal-title">权限：{{aclFolderName}}</view><button class="ghost-btn" bindtap="closeFolderAcl">关闭</button></view>
      <view wx:if="{{aclLoading}}" class="muted">加载中...</view>
      <block wx:elif="{{fileView.showAclRows}}">
        <view wx:for="{{fileView.aclRows}}" wx:key="roleId" class="files-manage-row">
          <text>{{item.roleName}}</text>
          <view class="tag-list">
            <text wx:for="{{item.permLabels}}" wx:for-item="perm" wx:key="*this" class="mini-tag">{{perm}}</text>
          </view>
        </view>
      </block>
      <view wx:else class="muted">暂无授权角色</view>
    </view>
  </view>
  <!-- 【D1-A 2026-10-18】申请扩容弹窗: 当前配额/上限 + 申请后总配额(GB) + 理由, 页面内自定义样式 -->
  <view wx:if="{{storageApplyView.visible}}" class="modal-mask" catchtap="closeStorageApply">
    <view class="card modal-card storage-apply-modal" catchtap="noop">
      <view class="modal-head">
        <view class="modal-title">申请扩容</view>
        <button class="storage-apply-close" bindtap="closeStorageApply">关闭</button>
      </view>
      <view class="storage-apply-meta">
        <view class="storage-apply-meta-row"><text>当前配额</text><text>{{storageApplyView.currentQuotaText}}</text></view>
        <view class="storage-apply-meta-row"><text>可申请上限</text><text>{{storageApplyView.maxQuotaText}}</text></view>
      </view>
      <view class="storage-apply-field">
        <view class="storage-apply-label">申请后总配额（GB）</view>
        <input class="storage-apply-input" type="digit" value="{{storageApplyView.quotaInput}}" bindinput="onStorageQuotaInput" placeholder="{{storageApplyView.quotaPlaceholder}}" />
        <view class="storage-apply-hint">{{storageApplyView.quotaHint}}</view>
      </view>
      <view class="storage-apply-field">
        <view class="storage-apply-label">申请理由</view>
        <textarea class="storage-apply-textarea" value="{{storageApplyView.reasonInput}}" bindinput="onStorageReasonInput" maxlength="200" placeholder="请说明扩容用途（必填，200字以内）" />
        <view class="storage-apply-count">{{storageApplyView.reasonCountText}}</view>
      </view>
      <view wx:if="{{storageApplyView.errorText}}" class="storage-apply-error">{{storageApplyView.errorText}}</view>
      <view class="storage-apply-actions">
        <button class="storage-apply-cancel" bindtap="closeStorageApply" disabled="{{storageApplyView.submitting}}">取消</button>
        <button class="storage-apply-submit" loading="{{storageApplyView.submitting}}" disabled="{{storageApplyView.submitting}}" bindtap="submitStorageApply">提交申请</button>
      </view>
    </view>
  </view>
</view>
