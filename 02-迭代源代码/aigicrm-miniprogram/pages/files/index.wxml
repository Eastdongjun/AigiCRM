<view class="page files-page">
  <!-- 顶部骨架卡: 一张边框卡承载 标题区 + 容量区(骨架→边框→元素 三层结构) -->
  <view class="card files-head-card">
    <view class="files-head-top">
      <view class="files-head-copy">
        <view class="files-head-overline">DOCUMENT CENTER</view>
        <view class="files-head-title">文件管理</view>
        <view class="files-head-sub">资料统一管理，协作随时可见</view>
      </view>
      <button wx:if="{{fileView.showUploadAction}}" class="head-add" loading="{{uploading}}" bindtap="uploadFile">＋</button>
    </view>
    <view class="files-capacity-divider"></view>
    <view class="files-capacity-row">
      <view class="capacity-copy">
        <view class="capacity-label">存储空间</view>
        <view class="capacity-value">{{capacity.used}} <text>/ {{capacity.total}}</text></view>
        <view class="capacity-progress"><view style="width:{{capacity.percent}}%"></view></view>
        <view class="capacity-hint">{{capacity.hint}}</view>
      </view>
      <view class="capacity-icon">▣</view>
    </view>
  </view>
  <button wx:if="{{canDevUploadSmoke}}" class="btn files-smoke-btn" loading="{{uploading}}" bindtap="runDevUploadSmoke">本地上传自测</button>
  <view class="search-box"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="searchFiles" confirm-type="search" placeholder="搜索文件名或文件夹" /><button class="search-action" bindtap="searchFiles">搜索</button></view>
  <scroll-view scroll-x class="file-tabs" enable-flex>
    <view class="file-tab-list"><view wx:for="{{fileView.tabs}}" wx:key="key" class="file-tab {{item.activeClass}}" data-tab="{{item.key}}" bindtap="onTabTap">{{item.label}}<text class="tab-count">{{item.countText}}</text></view></view>
  </scroll-view>
  <view class="card files-folder-card">
    <view class="folder-title"><text>{{fileView.folderTitle}}</text><button wx:if="{{fileView.showClearFolder}}" class="text-btn" bindtap="clearFolder">返回全部</button><text wx:else class="muted">{{fileView.folderCountText}}</text></view>
    <scroll-view wx:if="{{fileView.showFolderList}}" scroll-x class="folder-scroll" enable-flex>
    <view class="folder-list">
      <view wx:for="{{fileView.folders}}" wx:key="id" class="folder-card" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openFolder"><text class="folder-icon">▱</text><text>{{item.name}}</text></view>
      <view wx:if="{{fileView.showFallbackFolders}}" class="folder-card" data-name="客户文档" bindtap="openFolder"><text class="folder-icon">▱</text><text>客户文档</text></view>
      <view wx:if="{{fileView.showFallbackFolders}}" class="folder-card" data-name="团队共享" bindtap="openFolder"><text class="folder-icon">▱</text><text>团队共享</text></view>
      </view>
    </scroll-view>
  </view>
  <view class="section-row">
    <view class="section-title" wx:if="{{fileView.listTitle}}">{{fileView.listTitle}}</view>
    <view class="breadcrumb" wx:if="{{fileView.breadcrumbText}}">{{fileView.breadcrumbText}}</view>
    <view class="section-count">{{fileView.fileCountText}}</view>
  </view>
  <view wx:if="{{fileView.showLoading}}" class="muted">{{fileView.loadingText}}</view>
  <view wx:if="{{fileView.showFileList}}" class="file-list">
    <block wx:for="{{fileView.fileGroups}}" wx:key="key" wx:for-item="group" wx:for-index="groupIdx">
      <view class="file-group-head">{{group.label}} · {{group.count}}</view>
      <view wx:for="{{group.files}}" wx:key="id" wx:for-item="file" class="file-row" data-index="{{file.flatIndex}}" bindtap="openFile" bind:longpress="openActionSheet">
        <view class="file-type {{file.tone}}">{{file.typeText}}</view>
        <view class="file-info">
          <view class="file-name">{{file.nameText}}</view>
          <view class="file-meta">{{file.metaBrief}}</view>
          <view class="file-meta sub">{{file.metaExtra}}</view>
        </view>
        <view class="file-more-btn" catchtap="openActionSheet" data-index="{{file.flatIndex}}">···</view>
      </view>
    </block>
  </view>
  <video wx:if="{{previewVideoPath}}" src="{{previewVideoPath}}" controls class="file-preview-video"></video>
  <!-- 【mp-1】分页反馈：追加加载/无更多；首屏空态仍走下面的 showEmpty -->
  <view wx:if="{{fileView.showLoadMore}}" class="muted">{{fileView.loadMoreText}}</view>
  <view wx:if="{{fileView.showNoMore}}" class="muted">{{fileView.noMoreText}}</view>
  <view wx:if="{{fileView.showEmpty}}" class="empty-state"><text class="empty-icon">⌁</text><text>暂未找到匹配文件</text></view>
  <!-- 【需求A 2026-10-16】操作面板: 行尾「···」或长按呼出, 打开/下载/分享/替换/删除按权限显隐 -->
  <view wx:if="{{actionSheet.visible}}" class="sheet-mask" catchtap="closeActionSheet">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-file-name">{{actionSheet.name}}</view>
      <view class="sheet-grid">
        <view wx:for="{{actionSheet.actions}}" wx:key="key" wx:for-item="act" class="sheet-act {{act.key === 'delete' ? 'danger' : ''}}" data-act="{{act.key}}" catchtap="onSheetAction">
          <text class="sheet-act-icon">{{act.key === 'open' ? '▸' : act.key === 'download' ? '⇣' : act.key === 'share' ? '↗' : act.key === 'replace' ? '⇄' : '✕'}}</text>
          <text>{{act.label}}</text>
        </view>
      </view>
      <view class="sheet-cancel" catchtap="closeActionSheet">取消</view>
    </view>
  </view>
  <view wx:if="{{canManageFolder}}" class="files-manage-card">
    <view class="files-manage-head"><text>文件夹管理</text><button class="folder-new-action" bindtap="openFolderForm">新建</button></view>
    <block wx:if="{{fileView.showManageFolders}}">
      <view wx:for="{{fileView.folders}}" wx:key="id" class="files-manage-row">
        <text>{{item.name}}</text>
        <view>
          <button wx:if="{{canViewFolderAcl}}" class="text-btn" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="viewFolderAcl">权限</button>
          <button class="text-btn" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openFolderEdit">重命名</button>
          <button class="text-btn danger-text" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="removeFolder">删除</button>
        </view>
      </view>
    </block>
    <view wx:if="{{fileView.showManageEmpty}}" class="muted">暂无可管理文件夹</view>
  </view>
  <view wx:if="{{aclVisible}}" class="modal-mask" catchtap="closeFolderAcl">
    <view class="card modal-card" catchtap="noop">
      <view class="modal-head"><view class="modal-title">权限：{{aclFolderName}}</view><button class="ghost-btn" bindtap="closeFolderAcl">关闭</button></view>
      <view wx:if="{{aclLoading}}" class="muted">加载中...</view>
      <block wx:elif="{{fileView.showAclRows}}">
        <view wx:for="{{fileView.aclRows}}" wx:key="roleId" class="files-manage-row">
          <text>{{item.roleName}}</text>
          <view class="tag-list">
            <text wx:for="{{item.permLabels}}" wx:for-item="perm" wx:key="*this" class="mini-tag">{{perm}}</text>
          </view>
        </view>
      </block>
      <view wx:else class="muted">暂无授权角色</view>
    </view>
  </view>
</view>
