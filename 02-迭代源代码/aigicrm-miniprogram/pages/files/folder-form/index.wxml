<view class="page"><view class="hero"><view class="hero-title">{{id ? '重命名文件夹' : '新建文件夹'}}</view><view class="hero-sub">创建后可在文件库中上传和管理资料</view></view><view class="card form-card"><view class="label">文件夹名称</view><input class="input" value="{{name}}" bindinput="input" placeholder="请输入文件夹名称" maxlength="60"/><button class="btn submit-btn" loading="{{saving}}" bindtap="submit">{{id ? '保存名称' : '创建文件夹'}}</button><button class="text-btn back-btn" bindtap="back">取消</button></view></view>
