<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">文件详情</view><view class="hero-sub">查看文件信息与预览</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view class="card"><view class="file-type blue">{{type}}</view><view class="section-title" style="margin-top:18rpx">{{name}}</view><view class="detail-row"><text>所在文件夹</text><text>{{folder || '-'}}</text></view><view class="detail-row"><text>文件大小</text><text>{{size || '-'}}</text></view><video wx:if="{{previewVideoPath}}" src="{{previewVideoPath}}" controls style="width:100%;margin-top:24rpx;border-radius:12rpx;background:#000"></video><button class="btn" style="margin-top:28rpx" loading="{{previewing}}" bindtap="preview">打开并预览</button></view></view>
