<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">文件详情</view>
        <view class="hero-sub">查看文件信息与预览</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>
  <view class="card file-detail-card">
    <view class="file-type blue">{{detailView.typeText}}</view>
    <view class="section-title file-detail-name">{{detailView.nameText}}</view>
    <view class="detail-row"><text>文件类型</text><text>{{detailView.typeText}}</text></view>
    <view class="detail-row"><text>所在文件夹</text><text>{{detailView.folderText}}</text></view>
    <view class="detail-row"><text>文件大小</text><text>{{detailView.sizeText}}</text></view>
    <view class="detail-row"><text>上传者</text><text>{{detailView.uploaderNameText}}</text></view>
    <view class="detail-row"><text>更新时间</text><text>{{detailView.updatedAtText}}</text></view>
    <video wx:if="{{detailView.showVideo}}" src="{{previewVideoPath}}" controls class="file-preview-video"></video>
    <button class="btn file-preview-btn" loading="{{previewing}}" bindtap="preview">打开并预览</button>
  </view>
</view>
