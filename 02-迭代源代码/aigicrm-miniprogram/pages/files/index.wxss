.file-row-actions{display:flex;align-items:center;gap:8rpx;margin-left:auto;flex-shrink:0}
.files-page .search-box{display:flex;align-items:center;gap:14rpx;height:76rpx;margin:20rpx 0 18rpx;padding:0 18rpx;border:1rpx solid #dbeafe;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(41,72,125,.06)}
.files-page .search-box input{flex:1;min-width:0;font-size:26rpx;color:#172033}
.search-icon{color:#7c8aa5;font-size:30rpx;line-height:1}
.search-action{width:92rpx;height:48rpx;line-height:48rpx;margin:0;padding:0;border-radius:999rpx;background:#2563eb;color:#fff;font-size:22rpx}
.search-action::after{border:0}
.mini-action{height:48rpx;line-height:46rpx;margin:0;padding:0 14rpx;border:1rpx solid #bfdbfe;border-radius:999rpx;background:#eff6ff;color:#2563eb;font-size:21rpx}
.mini-action::after{border:0}
.mini-action.secondary{border-color:#d9e2ec;background:#fff;color:#475569}
.mini-action.danger{border-color:#fecaca;background:#fff7f7;color:#b91c1c}
.file-share-action,.folder-new-action{height:48rpx;line-height:46rpx;margin:0;padding:0 16rpx;border:1rpx solid #d9e2ec;border-radius:999rpx;background:#fff;color:#475569;font-size:21rpx;font-weight:700}
.file-share-action::after,.folder-new-action::after{border:0}
.file-share-action{margin-left:10rpx;flex-shrink:0}
.folder-new-action{color:#2563eb;border-color:#bfdbfe;background:#eff6ff}
.file-preview-video{width:100%;height:360rpx;margin-top:18rpx;border-radius:20rpx;overflow:hidden;background:#0f172a}
.tab-count{display:inline-flex;min-width:34rpx;height:30rpx;margin-left:8rpx;padding:0 9rpx;align-items:center;justify-content:center;border-radius:999rpx;background:#eef2ff;color:#2563eb;font-size:20rpx;font-weight:700;line-height:30rpx}
.file-tab.active .tab-count{background:#2563eb;color:#fff}

/* 顶部骨架卡: 标题区 + 分隔线 + 容量区 同卡承载 */
.files-head-card { padding: 26rpx 26rpx 24rpx; }
.files-head-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.files-head-overline { color: #94a3b8; font-size: 19rpx; letter-spacing: 4rpx; font-weight: 700; }
.files-head-title { margin-top: 6rpx; color: #172033; font-size: 40rpx; font-weight: 900; line-height: 1.2; }
.files-head-sub { margin-top: 8rpx; color: #7c8ba1; font-size: 23rpx; }
.files-capacity-divider { height: 1rpx; background: #eef2f7; margin: 22rpx 0; }
.files-capacity-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }

/* 【骨架→边框→元素 2026-09-21】tab 条/文件夹区/空态补白色容器背景(此前裸浮灰底) */
.files-page .file-tabs{background:#fff;border:1rpx solid #dbeafe;border-radius:20rpx;padding:12rpx;margin:22rpx 0 20rpx}
.files-folder-card{margin-top:20rpx}
.files-page .folder-scroll{margin:16rpx 0 6rpx}
.files-page .empty-state{background:#fff;border:1rpx solid #dbeafe;border-radius:24rpx;padding:34rpx 24rpx;margin-top:8rpx;display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#94a3b8;font-size:24rpx}

/* 【顶部 hero 背景恢复 2026-09-21】对齐其他页 blue 渐变 hero; 容量区文字/进度本就按白底蓝卡设计(app.wxss capacity-*), 白卡合并时丢了渐变 */
.files-head-card { background: linear-gradient(135deg, #2348bf, #4285f4); color: #fff; border: none; box-shadow: 0 18rpx 42rpx #b8cdf8; padding: 32rpx 30rpx 28rpx; }
.files-head-overline { color: rgba(255, 255, 255, .72); }
.files-head-title { color: #fff; }
.files-head-sub { color: rgba(255, 255, 255, .85); }
.files-capacity-divider { background: rgba(255, 255, 255, .28); }
.files-head-card .head-add { margin: 0; width: 68rpx; height: 68rpx; line-height: 64rpx; padding: 0; border-radius: 22rpx; background: rgba(255, 255, 255, .16); border: 1rpx solid rgba(255, 255, 255, .35); color: #fff; font-size: 36rpx; }
.files-head-card .capacity-icon { color: rgba(255, 255, 255, .45); }

/* 【需求A 2026-10-16】文件行改版: 两行全名 + 双 meta + 行尾「···」,时间分组标题,面包屑 */
.files-page .breadcrumb { color: #2563eb; font-size: 27rpx; font-weight: 700; }
.file-group-head { margin: 22rpx 4rpx 12rpx; color: #172033; font-size: 24rpx; font-weight: 800; }
.file-group-head::before { content: ''; display: inline-block; width: 8rpx; height: 22rpx; margin-right: 12rpx; border-radius: 4rpx; background: linear-gradient(180deg, #2348bf, #4285f4); vertical-align: -4rpx; }
.file-list .file-group-head:first-child { margin-top: 4rpx; }
.file-row .file-name { white-space: normal; word-break: break-all; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; text-overflow: clip; font-size: 27rpx; font-weight: 700; line-height: 1.4; }
.file-row .file-meta.sub { margin-top: 2rpx; color: #a8b4c2; }
.file-more-btn { flex-shrink: 0; margin-left: 12rpx; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #f1f5fb; color: #64748b; font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; }
.file-more-btn:active { background: #e2e9f5; }

/* 【需求A】半屏操作面板: 自绘(带图标/删除红),点遮罩或取消关闭 */
.sheet-mask { position: fixed; inset: 0; z-index: 60; background: rgba(15, 23, 42, .5); }
.sheet-panel { position: absolute; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 30rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); animation: sheet-up .22s ease-out; }
@keyframes sheet-up { from { transform: translateY(40%); opacity: .4; } to { transform: translateY(0); opacity: 1; } }
.sheet-file-name { color: #172033; font-size: 26rpx; font-weight: 800; padding: 0 8rpx 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sheet-grid { display: flex; flex-wrap: wrap; }
.sheet-act { width: 25%; box-sizing: border-box; padding: 18rpx 0 16rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #334155; font-size: 23rpx; font-weight: 600; }
.sheet-act-icon { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 700; }
.sheet-act.danger { color: #b91c1c; }
.sheet-act.danger .sheet-act-icon { background: #fef2f2; color: #dc2626; }
.sheet-act:active .sheet-act-icon { opacity: .7; }
.sheet-cancel { margin-top: 20rpx; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 22rpx; background: #f1f5fb; color: #475569; font-size: 26rpx; font-weight: 700; }
