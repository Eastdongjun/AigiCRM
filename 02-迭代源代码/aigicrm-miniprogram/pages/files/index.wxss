.file-row-actions{display:flex;align-items:center;gap:8rpx;margin-left:auto;flex-shrink:0}
.files-page .search-box{display:flex;align-items:center;gap:14rpx;height:76rpx;margin:20rpx 0 18rpx;padding:0 18rpx;border:1rpx solid #dbeafe;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(41,72,125,.06)}
.files-page .search-box input{flex:1;min-width:0;font-size:26rpx;color:#172033}
.search-icon{color:#7c8aa5;font-size:30rpx;line-height:1}
.search-action{width:92rpx;height:48rpx;line-height:48rpx;margin:0;padding:0;border-radius:999rpx;background:#2563eb;color:#fff;font-size:22rpx}
.search-action::after{border:0}
.mini-action{height:48rpx;line-height:46rpx;margin:0;padding:0 14rpx;border:1rpx solid #bfdbfe;border-radius:999rpx;background:#eff6ff;color:#2563eb;font-size:21rpx}
.mini-action::after{border:0}
.mini-action.secondary{border-color:#d9e2ec;background:#fff;color:#475569}
.mini-action.danger{border-color:#fecaca;background:#fff7f7;color:#b91c1c}
.file-share-action,.folder-new-action{height:48rpx;line-height:46rpx;margin:0;padding:0 16rpx;border:1rpx solid #d9e2ec;border-radius:999rpx;background:#fff;color:#475569;font-size:21rpx;font-weight:700}
.file-share-action::after,.folder-new-action::after{border:0}
.file-share-action{margin-left:10rpx;flex-shrink:0}
.folder-new-action{color:#2563eb;border-color:#bfdbfe;background:#eff6ff}
.file-preview-video{width:100%;height:360rpx;margin-top:18rpx;border-radius:20rpx;overflow:hidden;background:#0f172a}
.tab-count{display:inline-flex;min-width:34rpx;height:30rpx;margin-left:8rpx;padding:0 9rpx;align-items:center;justify-content:center;border-radius:999rpx;background:#eef2ff;color:#2563eb;font-size:20rpx;font-weight:700;line-height:30rpx}
.file-tab.active .tab-count{background:#2563eb;color:#fff}

/* 顶部骨架卡: 标题区 + 分隔线 + 容量区 同卡承载 */
.files-head-card { padding: 26rpx 26rpx 24rpx; }
.files-head-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.files-head-overline { color: #94a3b8; font-size: 19rpx; letter-spacing: 4rpx; font-weight: 700; }
.files-head-title { margin-top: 6rpx; color: #172033; font-size: 40rpx; font-weight: 900; line-height: 1.2; }
.files-head-sub { margin-top: 8rpx; color: #7c8ba1; font-size: 23rpx; }
/* 【P2-7 2026-10-19】头部文案列/容量文案列容器: 纵向堆叠占位(子项自带 margin, 容器只兜底防塌陷) */
.files-head-copy { min-width: 0; }
.capacity-copy { min-width: 0; flex: 1; }
.files-capacity-divider { height: 1rpx; background: #eef2f7; margin: 22rpx 0; }
.files-capacity-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }

/* 【骨架→边框→元素 2026-09-21】tab 条/文件夹区/空态补白色容器背景(此前裸浮灰底) */
.files-page .file-tabs{background:#fff;border:1rpx solid #dbeafe;border-radius:20rpx;padding:12rpx;margin:22rpx 0 20rpx}
.files-folder-card{margin-top:20rpx}
.files-page .folder-scroll{margin:16rpx 0 6rpx}
.files-page .empty-state{background:#fff;border:1rpx solid #dbeafe;border-radius:24rpx;padding:34rpx 24rpx;margin-top:8rpx;display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#94a3b8;font-size:24rpx}

/* 【顶部 hero 背景恢复 2026-09-21】对齐其他页 blue 渐变 hero; 容量区文字/进度本就按白底蓝卡设计(app.wxss capacity-*), 白卡合并时丢了渐变 */
.files-head-card { background: linear-gradient(135deg, #2348bf, #4285f4); color: #fff; border: none; box-shadow: 0 18rpx 42rpx #b8cdf8; padding: 32rpx 30rpx 28rpx; }
.files-head-overline { color: rgba(255, 255, 255, .72); }
.files-head-title { color: #fff; }
.files-head-sub { color: rgba(255, 255, 255, .85); }
.files-capacity-divider { background: rgba(255, 255, 255, .28); }
.files-head-card .head-add { margin: 0; width: 68rpx; height: 68rpx; line-height: 64rpx; padding: 0; border-radius: 22rpx; background: rgba(255, 255, 255, .16); border: 1rpx solid rgba(255, 255, 255, .35); color: #fff; font-size: 36rpx; }
.files-head-card .capacity-icon { color: rgba(255, 255, 255, .45); }

/* 【需求A 2026-10-16】文件行改版: 两行全名 + 双 meta + 行尾「···」,时间分组标题,面包屑 */
.files-page .breadcrumb { color: #2563eb; font-size: 27rpx; font-weight: 700; }
.file-group-head { margin: 22rpx 4rpx 12rpx; color: #172033; font-size: 24rpx; font-weight: 800; }
.file-group-head::before { content: ''; display: inline-block; width: 8rpx; height: 22rpx; margin-right: 12rpx; border-radius: 4rpx; background: linear-gradient(180deg, #2348bf, #4285f4); vertical-align: -4rpx; }
.file-list .file-group-head:first-child { margin-top: 4rpx; }
.file-row .file-name { white-space: normal; word-break: break-all; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; text-overflow: clip; font-size: 27rpx; font-weight: 700; line-height: 1.4; }
.file-row .file-meta.sub { margin-top: 2rpx; color: #a8b4c2; }
.file-more-btn { flex-shrink: 0; margin-left: 12rpx; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #f1f5fb; color: #64748b; font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; }
.file-more-btn:active { background: #e2e9f5; }

/* 【需求A】半屏操作面板: 自绘(带图标/删除红),点遮罩或取消关闭 */
.sheet-mask { position: fixed; inset: 0; z-index: 60; background: rgba(15, 23, 42, .5); }
.sheet-panel { position: absolute; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 30rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); animation: sheet-up .22s ease-out; }
@keyframes sheet-up { from { transform: translateY(40%); opacity: .4; } to { transform: translateY(0); opacity: 1; } }
.sheet-file-name { color: #172033; font-size: 26rpx; font-weight: 800; padding: 0 8rpx 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sheet-grid { display: flex; flex-wrap: wrap; }
.sheet-act { width: 25%; box-sizing: border-box; padding: 18rpx 0 16rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #334155; font-size: 23rpx; font-weight: 600; }
.sheet-act-icon { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 700; }
.sheet-act.danger { color: #b91c1c; }
.sheet-act.danger .sheet-act-icon { background: #fef2f2; color: #dc2626; }
.sheet-act:active .sheet-act-icon { opacity: .7; }
.sheet-cancel { margin-top: 20rpx; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 22rpx; background: #f1f5fb; color: #475569; font-size: 26rpx; font-weight: 700; }

/* 【D1-A 2026-10-18】容量卡申请扩容入口(仅 canApply) + 不可申请短原因 */
.storage-apply-btn { display: inline-block; width: auto; height: 56rpx; line-height: 54rpx; margin: 16rpx 0 0; padding: 0 24rpx; border-radius: 999rpx; border: 1rpx solid rgba(255, 255, 255, .5); background: rgba(255, 255, 255, .18); color: #fff; font-size: 23rpx; font-weight: 700; }
.storage-apply-btn::after { border: 0; }
.storage-apply-btn:active { background: rgba(255, 255, 255, .3); }
.storage-apply-reason { margin-top: 12rpx; color: rgba(255, 255, 255, .78); font-size: 22rpx; line-height: 1.45; }

/* 【D1-A】申请扩容弹窗: 沿用页内 modal-mask + card 结构, 表单字号/间距对齐现有 polished 表单 */
.storage-apply-modal { width: 100%; max-height: 90vh; box-sizing: border-box; margin: 0; overflow-y: auto; }
.storage-apply-close { height: 52rpx; line-height: 50rpx; margin: 0; padding: 0 20rpx; border-radius: 999rpx; border: 1rpx solid #d9e2ec; background: #f8fafc; color: #475569; font-size: 23rpx; font-weight: 700; }
.storage-apply-close::after { border: 0; }
.storage-apply-meta { margin-top: 20rpx; padding: 14rpx 20rpx; border: 1rpx solid #e5edf6; border-radius: 18rpx; background: #f8fbff; }
.storage-apply-meta-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; color: #52627a; font-size: 24rpx; line-height: 1.9; }
.storage-apply-meta-row text:last-child { color: #172033; font-weight: 750; }
.storage-apply-field { margin-top: 22rpx; }
.storage-apply-label { margin-bottom: 12rpx; color: #34445c; font-size: 24rpx; font-weight: 700; }
.storage-apply-input { height: 80rpx; padding: 0 22rpx; border: 1rpx solid #d8e3f1; border-radius: 18rpx; background: #f8fbff; color: #172033; font-size: 28rpx; }
.storage-apply-textarea { width: 100%; box-sizing: border-box; min-height: 150rpx; padding: 20rpx 22rpx; border: 1rpx solid #d8e3f1; border-radius: 18rpx; background: #f8fbff; color: #172033; font-size: 26rpx; line-height: 1.6; }
.storage-apply-hint { margin-top: 10rpx; color: #94a3b8; font-size: 22rpx; line-height: 1.45; }
.storage-apply-count { margin-top: 8rpx; text-align: right; color: #94a3b8; font-size: 22rpx; }
.storage-apply-error { margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: #fef2f2; color: #b91c1c; font-size: 23rpx; line-height: 1.5; }
.storage-apply-actions { display: flex; gap: 16rpx; margin-top: 26rpx; }
.storage-apply-actions button { flex: 1; height: 80rpx; line-height: 78rpx; margin: 0; border-radius: 20rpx; font-size: 26rpx; font-weight: 750; }
.storage-apply-actions button::after { border: 0; }
.storage-apply-cancel { background: #f1f5fb; color: #475569; }
.storage-apply-submit { background: #2563eb; color: #fff; box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, .2); }
.storage-apply-actions button[disabled] { opacity: .6; }

/* 【P2-7 2026-10-19】ACL 弹窗: 卡片限宽居中(与 storage-apply-modal 同款口径) + 权限标签组 */
.modal-card { width: 100%; max-width: 620rpx; }
.tag-list { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; }
.mini-tag { background: #eef5ff; color: #2563eb; border-radius: 8rpx; padding: 4rpx 12rpx; font-size: 20rpx; font-weight: 600; }

/* 2026-10-20 顶部重设计：深蓝紧凑身份条 + 单行容量，替代原来占屏过高的大蓝卡 */
.files-top {
  position: relative;
  overflow: hidden;
  padding: 26rpx 28rpx 22rpx;
  border-radius: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #0d1733 0%, #16337a 58%, #1d4ed8 100%);
  box-shadow: 0 18rpx 38rpx rgba(13, 23, 51, .22);
}
.files-top-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.files-top-copy { flex: 1; min-width: 0; }
.files-top-title { font-size: 32rpx; font-weight: 800; letter-spacing: 1rpx; }
.files-top-sub { margin-top: 6rpx; font-size: 20rpx; color: rgba(255, 255, 255, .62); }
.files-top-upload {
  flex-shrink: 0;
  height: 58rpx;
  min-height: 58rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  margin: 0;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, .24);
  background: rgba(255, 255, 255, .14);
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
}
.files-top-upload::after { border: 0; }
.files-top-storage {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .12);
}
.files-top-storage-meta { display: flex; align-items: center; gap: 12rpx; }
.files-top-storage-label { font-size: 19rpx; color: rgba(255, 255, 255, .55); }
.files-top-storage-value { font-size: 24rpx; font-weight: 700; }
.files-top-storage-value text { font-size: 19rpx; font-weight: 400; color: rgba(255, 255, 255, .55); }
.files-top-apply {
  margin-left: auto;
  padding: 0;
  background: transparent;
  color: rgba(255, 255, 255, .84);
  font-size: 19rpx;
  line-height: 1.4;
}
.files-top-apply::after { border: 0; }
.files-top-reason { margin-left: auto; font-size: 18rpx; color: rgba(255, 255, 255, .5); }
.files-top-progress {
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .18);
  overflow: hidden;
}
.files-top-progress view {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #93c5fd, #fff);
}
.files-top-hint { margin-top: 8rpx; font-size: 18rpx; color: rgba(255, 255, 255, .5); }

/* 2026-10-20 文件夹管理：从「一行三个小按钮」改为紧凑行 + ··· 操作菜单 */
.folder-manage-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; border-top: 1rpx solid #eef2f7; }
.folder-manage-row:first-of-type { border-top: 0; }
.folder-manage-icon { width: 48rpx; height: 48rpx; flex-shrink: 0; border-radius: 14rpx; background: #fff7e8; color: #d98523; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.folder-manage-name { flex: 1; min-width: 0; color: #334155; font-size: 25rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.folder-manage-more { width: 56rpx; height: 56rpx; flex-shrink: 0; border-radius: 14rpx; background: #f5f8fd; color: #64748b; font-size: 26rpx; display: flex; align-items: center; justify-content: center; letter-spacing: 1rpx; }

/* 2026-10-20 文件夹图标：CSS 画的琥珀色立体文件夹（标签 + 主体 + 高光），替代 ▱ 字符 */
.folder-icon {
  position: relative;
  width: 40rpx;
  height: 30rpx;
  flex-shrink: 0;
  border-radius: 5rpx 7rpx 8rpx 8rpx;
  background: linear-gradient(180deg, #f8c15d 0%, #e99a2c 100%);
  box-shadow: 0 4rpx 8rpx rgba(217, 133, 35, .18), inset 0 1rpx 0 rgba(255, 255, 255, .5);
}
.folder-icon::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: 0;
  width: 20rpx;
  height: 12rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #f4b24a;
}
.folder-icon::after {
  content: '';
  position: absolute;
  top: 9rpx;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, .32);
}
.folder-manage-icon .folder-icon { width: 34rpx; height: 26rpx; }
.folder-manage-icon .folder-icon::before { width: 17rpx; height: 10rpx; top: -6rpx; }



