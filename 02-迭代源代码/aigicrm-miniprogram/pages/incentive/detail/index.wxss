.incentive-detail-page{padding-bottom:40rpx;background:#f4f7fc;min-height:100vh}
.incentive-detail-page .hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#1d3fae,#2f6bf0 60%,#4d8cf5)}
.incentive-detail-page .hero .row{align-items:flex-start}
.incentive-detail-page .hero-title{font-size:44rpx;letter-spacing:2rpx}
.incentive-detail-page .hero-sub{opacity:.88}
.incentive-detail-card{border:0;box-shadow:0 14rpx 34rpx rgba(35,72,125,.1)}
.incentive-detail-page .ranking-score{background:linear-gradient(135deg,#2364d8,#4d8cf5);color:#fff;font-size:24rpx;padding:10rpx 20rpx;box-shadow:0 8rpx 18rpx rgba(35,100,216,.28)}
.detail-info-group{margin-top:20rpx;border-radius:20rpx;background:#f8fbff;padding:4rpx 22rpx}
.detail-info-group .detail-row{margin-top:0;padding:18rpx 0;border-bottom:1rpx solid #e8eef7}
.detail-info-group .detail-row:last-child{border-bottom:0}
.detail-info-group .detail-row text:first-child{color:#8ea3c0;font-size:24rpx;flex-shrink:0;margin-right:24rpx}
.detail-info-group .detail-row text:last-child{color:#172033;font-weight:750;text-align:right;word-break:break-all}
.attachment-timeline{margin-top:18rpx}
.attachment-group{position:relative;padding-left:30rpx;padding-bottom:20rpx}
.attachment-group:last-child{padding-bottom:0}
.attachment-group-line{position:absolute;left:10rpx;top:24rpx;bottom:-8rpx;width:4rpx;border-radius:4rpx;background:linear-gradient(180deg,#2f6bf0,#bfdbfe)}
.attachment-group:last-child .attachment-group-line{display:none}
.attachment-group-dot{position:absolute;left:0;top:22rpx;width:22rpx;height:22rpx;border-radius:50%;background:#2563eb;box-shadow:0 0 0 8rpx #e2edff,0 4rpx 10rpx rgba(37,99,235,.35)}
.attachment-group.mid .attachment-group-dot{background:#d97706;box-shadow:0 0 0 8rpx #fff3e2,0 4rpx 10rpx rgba(217,119,6,.3)}
.attachment-group.post .attachment-group-dot{background:#059669;box-shadow:0 0 0 8rpx #dcf7e9,0 4rpx 10rpx rgba(5,150,105,.3)}
.attachment-group.track .attachment-group-dot{background:#7c3aed;box-shadow:0 0 0 8rpx #ece4ff,0 4rpx 10rpx rgba(124,58,237,.3)}
.attachment-group.evidence .attachment-group-dot{background:#64748b;box-shadow:0 0 0 8rpx #e8eef5,0 4rpx 10rpx rgba(100,116,139,.3)}
.attachment-group-card{border:1rpx solid #e5edf6;border-radius:24rpx;overflow:hidden;background:#fff;box-shadow:0 10rpx 26rpx rgba(35,72,125,.07)}
.attachment-group-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 22rpx;background:linear-gradient(180deg,#f4f9ff,#f8fbff);border-bottom:1rpx solid #eef3f9}
.attachment-group-title{font-size:27rpx;font-weight:900;color:#172033}
.attachment-group-hint{margin-top:6rpx;font-size:22rpx;color:#7c8ba1}
.attachment-count{padding:6rpx 14rpx;border-radius:999rpx;background:#e8f1ff;color:#1d4fd7;font-size:22rpx;font-weight:800;white-space:nowrap}
.attachment-row{display:flex;align-items:center;gap:18rpx;padding:20rpx 22rpx;border-top:1rpx solid #eef3f9}
.attachment-group-head+.attachment-row{border-top:0}
.attachment-icon{width:76rpx;height:76rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#e8f1ff;color:#1d4fd7;font-size:22rpx;font-weight:800;box-shadow:inset 0 0 0 1rpx rgba(29,79,215,.12)}
.attachment-icon.image{background:#dcf7e9;color:#047857;box-shadow:inset 0 0 0 1rpx rgba(4,120,87,.14)}
.attachment-icon.video{background:#fff3e2;color:#c26a06;box-shadow:inset 0 0 0 1rpx rgba(194,106,6,.14)}
.attachment-icon.document{background:#e8f1ff;color:#1d4fd7}
.attachment-thumb{width:76rpx;height:76rpx;border-radius:22rpx;flex-shrink:0;background:#eef3f9}
.attachment-main{flex:1;min-width:0}
.attachment-name{font-size:27rpx;font-weight:800;color:#172033;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.attachment-meta{margin-top:8rpx;font-size:23rpx;color:#7c8ba1}
.attachment-actions{display:flex;gap:10rpx;flex-shrink:0}
.mini-action{width:84rpx;height:56rpx;padding:0;border-radius:16rpx;background:linear-gradient(135deg,#2364d8,#3e8df3);color:#fff;font-size:22rpx;font-weight:700;line-height:56rpx;box-shadow:0 8rpx 16rpx rgba(35,100,216,.25)}
.mini-action.secondary{background:#eef3f9;color:#1f3f7a;box-shadow:none}
.mini-action.danger{width:auto;padding:0 22rpx;background:#fff5f5;color:#dc2626;border:1rpx solid #fecaca}
.detail-action-row{display:flex;justify-content:flex-end;margin:18rpx 0 4rpx}
.detail-field-block{margin-top:18rpx;padding:20rpx 22rpx;border-left:6rpx solid #2563eb;border-radius:18rpx;background:#f4f9ff;box-shadow:inset 0 0 0 1rpx #e2ecfa}
.detail-field-block.remark{border-left-color:#f59e0b;background:#fffaf3;box-shadow:inset 0 0 0 1rpx #fbeecd}
.detail-field-label{color:#334155;font-size:24rpx;font-weight:850}
.detail-field-text{margin-top:10rpx;color:#172033;font-size:26rpx;line-height:1.65;word-break:break-word}
.attachment-empty{margin-top:16rpx;padding:26rpx;border-radius:20rpx;background:#f4f8ff;color:#8ea3c0;font-size:25rpx;text-align:center;border:1rpx dashed #c9d8ec}
.attachment-video{width:100%;height:360rpx;margin-top:18rpx;border-radius:24rpx;overflow:hidden;background:#0f172a}
