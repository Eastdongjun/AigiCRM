/* 四项服务客户详情 —— PC 定稿设计的小程序同步版(2026-09-20)
   色板与 PC search.vue 对齐:主蓝 #1d4ed8/#2563eb、阶段色 visit 橙 / exchange 蓝 / plan 紫 / trial 绿 */
.incentive-detail-page { padding-bottom: 48rpx; background: #f4f7fc; min-height: 100vh; }
.incentive-detail-page .hero { position: relative; overflow: hidden; background: linear-gradient(135deg, #1d3fae, #2f6bf0 60%, #4d8cf5); }
.incentive-detail-page .hero .row { align-items: flex-start; }
.incentive-detail-page .hero-title { font-size: 36rpx; letter-spacing: 2rpx; }
.incentive-detail-page .hero-sub { opacity: .82; font-size: 22rpx; }

/* 客户台账卡:独立白底边框卡(骨架图独立框),左身份右合计,大分值是卡内唯一的大胆元素 */
.customer-card { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 26rpx 24rpx; }
.customer-avatar { width: 92rpx; height: 92rpx; border-radius: 26rpx; flex-shrink: 0; color: #fff; font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #2364d8, #4d8cf5);
  box-shadow: 0 8rpx 18rpx rgba(35, 100, 216, .28); }
.customer-main { flex: 1; min-width: 0; }
/* white-space:normal 显式声明:覆盖 app.wxss .customer-name 的全局 nowrap+ellipsis,保住本页 2 行截断 */
.customer-name { font-size: 30rpx; font-weight: 800; color: #172033; line-height: 1.4; word-break: break-all; white-space: normal;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.customer-tags { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin-top: 12rpx; }
.customer-pill { font-size: 20rpx; border-radius: 999rpx; padding: 4rpx 16rpx; white-space: nowrap; }
.customer-pill.blue { color: #1d4fd7; background: #e8f1ff; }
.customer-pill.grey { color: #64748b; background: #f1f5f9; }
.customer-score { margin-left: 4rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; }
.customer-score-line { display: flex; align-items: baseline; gap: 4rpx; }
.customer-score-big { font-size: 56rpx; font-weight: 800; color: #1d4ed8; line-height: 1; letter-spacing: -1rpx; }
.customer-score-unit { font-size: 22rpx; font-weight: 700; color: #f5b94b; }
.customer-score-caption { font-size: 18rpx; color: #94a3b8; margin-top: 8rpx; letter-spacing: 3rpx; }
.customer-score-sub { display: flex; gap: 12rpx; margin-top: 8rpx; font-size: 20rpx; color: #94a3b8; }
.customer-score-sub text { padding-left: 12rpx; border-left: 1rpx solid #e2e8f0; }
.customer-score-sub text:first-child { padding-left: 0; border-left: none; }
.customer-unread { color: #d97706; font-weight: 700; }

/* 三联拨盘:原生 picker-view(iOS 滚轮),indicator 自定义选中带 —— 紧凑版(72rpx 行距/收窄居中) */
.dial-card { margin-top: 24rpx; padding: 16rpx 16rpx 4rpx; }
.dial-now { display: flex; align-items: baseline; gap: 12rpx; padding: 0 8rpx 12rpx; }
.dial-now-date { font-size: 21rpx; color: #6b7280; }
.dial-now-time { font-size: 30rpx; font-weight: 800; color: #1d4ed8; letter-spacing: 1rpx; line-height: 1; }
.dial-today-btn { margin-left: auto; font-size: 21rpx; font-weight: 600; color: #2563eb; padding: 5rpx 16rpx;
  border-radius: 999rpx; background: #eff4fe; }
.dial-picker { width: 86%; height: 324rpx; margin: 0 auto; }
.dial-item { position: relative; height: 72rpx; line-height: 72rpx; text-align: center;
  font-size: 27rpx; font-weight: 700; color: #172033; }
.dial-item.dim { color: #94a3b8; }
.dial-today-dot { position: absolute; bottom: 6rpx; left: 50%; margin-left: -4rpx; width: 8rpx; height: 8rpx;
  border-radius: 50%; background: #2563eb; }
.dial-unread-dot { position: absolute; left: 50%; top: 50%; margin-left: 32rpx; transform: translateY(-50%);
  width: 11rpx; height: 11rpx; border-radius: 50%; background: #e11d48; }

/* 位置语义空态:拨到哪显示哪,无数据只置暗仍可选 */
.pane-empty { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 60rpx 30rpx; margin-top: 24rpx; }
.pane-empty-title { font-size: 28rpx; font-weight: 650; color: #6b7280; }
.pane-empty-hint { font-size: 23rpx; color: #9ca3af; }

.pane-head { display: flex; align-items: baseline; gap: 16rpx; margin: 28rpx 8rpx 16rpx; }
.pane-label { font-size: 31rpx; font-weight: 800; color: #172033; }
.pane-count { font-size: 23rpx; color: #6b7280; }

/* 记录卡:单行元信息条(时间蓝色加大)+ 正文大字 + 备注 + 附件凭证大瓦片 */
.record-card { margin-top: 20rpx; padding: 26rpx 24rpx; }
.metabar { display: flex; flex-direction: column; gap: 12rpx; }
.meta-time { display: flex; align-items: baseline; gap: 12rpx; flex-wrap: wrap; }
.unread-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #e11d48; box-shadow: 0 0 0 4rpx rgba(225, 29, 72, .12); align-self: center; }
.meta-day { font-size: 32rpx; font-weight: 800; color: #1d4ed8; letter-spacing: .5rpx; }
.meta-clock { font-size: 30rpx; font-weight: 800; color: #1d4ed8; }
.meta-relative { font-size: 21rpx; color: #8a94a3; }
.meta-stage { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.stage-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.stage-main { font-size: 26rpx; font-weight: 700; color: #1f2937; }
.stage-sub { font-size: 24rpx; font-weight: 600; color: #6b7280; }
.meta-score { font-size: 29rpx; font-weight: 800; letter-spacing: -.5rpx; margin-left: auto; }
.meta-chips { display: flex; align-items: baseline; gap: 10rpx 26rpx; flex-wrap: wrap; }
.meta-chip { display: inline-flex; align-items: baseline; gap: 6rpx; min-width: 0; }
.chip-label { font-size: 20rpx; color: #8a94a3; letter-spacing: 1rpx; flex-shrink: 0; }
.chip-text { font-size: 24rpx; font-weight: 600; color: #1f2937; word-break: break-all; }

/* 详情正文大字(15px/1.9 → 30rpx/1.9) */
.eblock { margin-top: 20rpx; padding: 24rpx 26rpx; background: #f8fafd; border: 1rpx solid #edf1f7; border-radius: 20rpx; }
.eblock.remark { background: #fffaf2; border-color: #f3e4c8; }
.eblock-label { font-size: 22rpx; font-weight: 600; color: #4b5563; margin-bottom: 10rpx; letter-spacing: 2rpx; }
.eblock.remark .eblock-label { color: #a16207; }
.eblock-text { font-size: 30rpx; color: #172033; line-height: 1.9; white-space: pre-wrap; word-break: break-word; }

/* 附件凭证:3:2 大瓦片,2 列网格;标签角标 + 打开/下载悬浮操作 */
.files-block { padding: 24rpx; }
.files-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.file-tile { position: relative; min-width: 0; }
.file-thumb { width: 100%; height: 200rpx; border-radius: 16rpx; background: #eef3f9; display: block; }
.file-video-face, .file-doc-face { width: 100%; height: 200rpx; border-radius: 16rpx; background: #f2f4f8;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; box-sizing: border-box; padding: 12rpx; }
.file-video-face { background: linear-gradient(135deg, #16213e, #2d2d44); color: #fff; }
.video-play-icon { width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255, 255, 255, .2);
  display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.file-doc-face .doc-type { font-size: 22rpx; font-weight: 800; color: #1d4fd7; background: #e8f1ff; border-radius: 999rpx; padding: 4rpx 18rpx; }
.file-face-name { max-width: 100%; font-size: 22rpx; color: #646a73; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.file-video-face .file-face-name { color: rgba(255, 255, 255, .85); }
.file-tag { position: absolute; top: 10rpx; left: 10rpx; z-index: 2; font-size: 19rpx; font-weight: 600;
  background: rgba(255, 255, 255, .94); padding: 2rpx 12rpx; border-radius: 999rpx; border: 1rpx solid transparent; }
.file-acts { position: absolute; right: 10rpx; bottom: 10rpx; z-index: 2; display: flex; gap: 8rpx; }
.tile-btn { width: 92rpx; height: 48rpx; padding: 0; border-radius: 12rpx; background: rgba(23, 32, 51, .78); color: #fff;
  font-size: 20rpx; font-weight: 700; line-height: 48rpx; display: flex; align-items: center; justify-content: center; }
.tile-btn.secondary { background: rgba(255, 255, 255, .9); color: #1f3f7a; }
.tile-btn::after { border: none; }

.record-action-row { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 20rpx; }
.mini-action.primary { width: auto; padding: 0 26rpx; height: 58rpx; line-height: 58rpx; border-radius: 16rpx;
  background: #eff6ff; color: #2563eb; border: 1rpx solid #bfdbfe; font-size: 23rpx; font-weight: 700; }
.mini-action.primary::after { border: none; }
.mini-action.danger { width: auto; padding: 0 26rpx; height: 58rpx; line-height: 58rpx; border-radius: 16rpx;
  background: #fff5f5; color: #dc2626; border: 1rpx solid #fecaca; font-size: 23rpx; font-weight: 700; }
.mini-action.danger::after { border: none; }

/* 视频预览:底部浮层播放器(bottom 叠加 safe-area,避免全面屏 Home 条遮挡关闭按钮) */
.video-layer { position: fixed; left: 28rpx; right: 28rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); z-index: 9; display: flex; flex-direction: column; gap: 14rpx; }
.video-player { width: 100%; height: 420rpx; border-radius: 24rpx; overflow: hidden; background: #0f172a; }
.video-close { align-self: center; background: rgba(23, 32, 51, .82); color: #fff; font-size: 24rpx;
  padding: 12rpx 44rpx; border-radius: 999rpx; }
