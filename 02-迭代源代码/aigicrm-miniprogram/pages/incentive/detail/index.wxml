<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">价值服务详情</view><view class="hero-sub">文件 · 说明 · 分值 · 上传记录</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view wx:if="{{loading}}" class="card muted">加载中...</view><view wx:if="{{record}}" class="card"><view class="section-title">{{record.name || record.title || record.customerName || '价值服务记录'}}</view><view class="detail-row"><text>客户</text><text>{{record.customerName || record.name || '-'}}</text></view><view class="detail-row"><text>行业</text><text>{{record.industry || '-'}}</text></view><view class="detail-row"><text>分类</text><text>{{record.category || record.categoryName || '-'}}</text></view><view class="detail-row"><text>服务分值</text><text>{{record.score || record.points || 0}}</text></view><view class="detail-row"><text>上传人</text><text>{{record.userName || record.updatedByName || '-'}}</text></view><view class="detail-row"><text>上传时间</text><text>{{record.createdAt || record.createTime || '-'}}</text></view><view class="detail-content">{{record.description || record.remark || record.summary || record.product || '暂无详情描述'}}</view><view class="section-title" style="margin-top:28rpx">关联文件</view><view class="detail-row"><text>主要文件</text><text>{{record.filePreName || record.fileName || '-'}}</text></view><view class="detail-row"><text>过程文件</text><text>{{record.fileMidName || '-'}}</text></view><view class="detail-row"><text>结果文件</text><text>{{record.filePostName || '-'}}</text></view><view class="detail-row"><text>跟踪文件</text><text>{{record.fileTrackName || '-'}}</text></view></view><view wx:if="{{!loading && !record}}" class="card muted">暂无价值服务详情</view></view>
