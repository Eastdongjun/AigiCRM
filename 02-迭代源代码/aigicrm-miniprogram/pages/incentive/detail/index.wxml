<view class="page incentive-detail-page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">四项激励详情</view>
        <view class="hero-sub">四项激励 · 文件 · 说明 · 分值</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>

  <view wx:if="{{detailView.showLoading}}" class="card muted">{{detailView.loadingText}}</view>

  <view wx:if="{{detailView.hasRecord}}" class="card incentive-detail-card">
    <view class="incentive-detail-head">
      <view class="incentive-detail-title">{{detailView.title}}</view>
      <text class="ranking-score">{{detailView.scoreText}} 分</text>
    </view>
    <view class="detail-info-group">
      <view wx:for="{{detailView.infoRows}}" wx:key="label" class="detail-row"><text>{{item.label}}</text><text>{{item.valueText}}</text></view>
    </view>
    <view wx:if="{{detailView.showPreInstallQuestion}}" class="detail-field-block">
      <view class="detail-field-label">{{detailView.detailLabel}}</view>
      <view class="detail-field-text">{{detailView.preInstallQuestionText}}</view>
    </view>
    <view wx:if="{{detailView.showTrialRemark}}" class="detail-field-block remark">
      <view class="detail-field-label">{{detailView.remarkLabel}}</view>
      <view class="detail-field-text">{{detailView.remarkText}}</view>
    </view>
    <view wx:if="{{detailView.showFallbackDescription}}" class="detail-content refined-reason">{{detailView.fallbackDescription}}</view>
    <view wx:if="{{detailView.showDeleteAction}}" class="detail-action-row">
      <button class="mini-action danger" bindtap="removeRecord">删除记录</button>
    </view>
    <view class="form-section-title file-section-title">安装文件时间轴</view>
    <view wx:if="{{detailView.showFileGroups}}" class="attachment-timeline">
      <view wx:for="{{detailView.fileGroups}}" wx:for-item="group" wx:key="key" class="attachment-group {{group.key}}">
        <view class="attachment-group-line"></view>
        <view class="attachment-group-dot"></view>
        <view class="attachment-group-card">
          <view class="attachment-group-head">
            <view>
              <view class="attachment-group-title">{{group.label}}</view>
              <view class="attachment-group-hint">{{group.hint}}</view>
            </view>
            <text class="attachment-count">{{group.countText}}</text>
          </view>
          <view wx:for="{{group.files}}" wx:for-item="file" wx:key="id" class="attachment-row">
            <image wx:if="{{file.thumbUrl}}" class="attachment-thumb" src="{{file.thumbUrl}}" mode="aspectFill" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}" bindtap="previewAttachment" />
            <view wx:else class="attachment-icon {{file.type}}">{{file.typeText}}</view>
            <view class="attachment-main">
              <view class="attachment-name">{{file.name}}</view>
              <view class="attachment-meta">可预览 / 可下载</view>
            </view>
            <view class="attachment-actions">
              <button class="mini-action" loading="{{detailView.previewLoading}}" catchtap="previewAttachment" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">打开</button>
              <button class="mini-action secondary" loading="{{detailView.previewLoading}}" catchtap="downloadAttachment" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">下载</button>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="attachment-empty">暂无上传图片或文件</view>
    <video wx:if="{{previewVideoPath}}" src="{{previewVideoPath}}" controls class="attachment-video"></video>
  </view>

  <view wx:if="{{detailView.showEmpty}}" class="card muted">暂无四项激励详情</view>
</view>
