<view class="page incentive-detail-page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">四项服务详情</view>
        <view class="hero-sub">客户台账 · 年月日转盘 · 记录明细</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>

  <view wx:if="{{detailView.hasRecord}}" class="card customer-card">
    <view class="customer-avatar">{{detailView.heroInitial}}</view>
    <view class="customer-main">
      <view class="customer-name">{{detailView.customerName}}</view>
      <view class="customer-tags">
        <text wx:if="{{detailView.industryText}}" class="customer-pill blue">{{detailView.industryText}}</text>
        <text class="customer-pill grey">最近更新 {{detailView.lastUpdateText}}</text>
      </view>
    </view>
    <view class="customer-score">
      <view class="customer-score-line">
        <text class="customer-score-big">{{detailView.scoreText}}</text>
        <text class="customer-score-unit">分</text>
      </view>
      <view class="customer-score-caption">{{detailView.scoreCaption}}</view>
      <view class="customer-score-sub">
        <text>{{detailView.recordCountText}}</text>
        <text>{{detailView.monthCountText}}</text>
        <text wx:if="{{detailView.showUnread}}" class="customer-unread">{{detailView.unreadCountText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{detailView.showLoading}}" class="card muted">{{detailView.loadingText}}</view>

  <block wx:if="{{detailView.hasRecord}}">
    <view wx:if="{{detailView.showDial}}" class="card dial-card">
      <view class="dial-now">
        <text class="dial-now-date">{{detailView.nowDateText}}</text>
        <text class="dial-now-time">{{detailView.nowTimeText}}</text>
        <text class="dial-today-btn" bindtap="goToday">回到今天</text>
      </view>
      <picker-view
        class="dial-picker"
        value="{{detailView.dialValue}}"
        indicator-style="height: 72rpx; background: rgba(234, 241, 254, .45); border-top: 2rpx solid #dbe6fb; border-bottom: 2rpx solid #dbe6fb;"
        bindchange="onDialChange"
      >
        <picker-view-column>
          <view
            wx:for="{{detailView.dialYears}}"
            wx:key="key"
            class="dial-item {{item.dim ? 'dim' : ''}} {{item.today ? 'today' : ''}}"
            style="height: 72rpx; line-height: 72rpx;"
          >{{item.label}}<view wx:if="{{item.today}}" class="dial-today-dot"></view></view>
        </picker-view-column>
        <picker-view-column>
          <view
            wx:for="{{detailView.dialMonths}}"
            wx:key="m"
            class="dial-item {{item.dim ? 'dim' : ''}} {{item.today ? 'today' : ''}}"
            style="height: 72rpx; line-height: 72rpx;"
          >{{item.label}}<view wx:if="{{item.hasUnread}}" class="dial-unread-dot"></view><view wx:if="{{item.today}}" class="dial-today-dot"></view></view>
        </picker-view-column>
        <picker-view-column>
          <view
            wx:for="{{detailView.dialDays}}"
            wx:key="d"
            class="dial-item {{item.dim ? 'dim' : ''}} {{item.today ? 'today' : ''}}"
            style="height: 72rpx; line-height: 72rpx;"
          >{{item.label}}<view wx:if="{{item.today}}" class="dial-today-dot"></view></view>
        </picker-view-column>
      </picker-view>
    </view>

    <view wx:if="{{detailView.showPaneEmpty}}" class="card pane-empty">
      <view class="pane-empty-title">{{detailView.paneEmptyTitle}}</view>
      <view class="pane-empty-hint">{{detailView.paneEmptyHint}}</view>
    </view>

    <block wx:if="{{detailView.items.length}}">
      <view class="pane-head">
        <text class="pane-label">{{detailView.paneLabelText}}</text>
        <text class="pane-count">{{detailView.paneCountText}}</text>
      </view>

      <view wx:for="{{detailView.items}}" wx:for-item="item" wx:for-index="itemIndex" wx:key="id" class="card record-card">
        <view class="metabar">
          <view class="meta-time">
            <view wx:if="{{item.showUnreadDot}}" class="unread-dot"></view>
            <text class="meta-day">{{item.dayText}}</text>
            <text class="meta-clock">{{item.timeText}}</text>
            <text wx:if="{{item.relativeText}}" class="meta-relative">{{item.relativeText}}</text>
          </view>
          <view class="meta-stage">
            <view class="stage-dot" style="background: {{item.stageColor}};"></view>
            <text class="stage-main">{{item.stageText}}</text>
            <text wx:if="{{item.stageSub}}" class="stage-sub">{{item.stageSub}}</text>
            <text class="meta-score" style="color: {{item.scoreColor}};">{{item.scoreText}}</text>
          </view>
          <view class="meta-chips">
            <view wx:for="{{item.chips}}" wx:for-item="chip" wx:key="label" class="meta-chip">
              <text class="chip-label">{{chip.label}}</text>
              <text class="chip-text">{{chip.text}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{item.showDetailBlock}}" class="eblock">
          <view class="eblock-label">{{item.detailLabel}}</view>
          <view class="eblock-text">{{item.preInstallQuestionText}}</view>
        </view>

        <view wx:if="{{item.showTrialRemark}}" class="eblock remark">
          <view class="eblock-label">{{item.remarkLabel}}</view>
          <view class="eblock-text">{{item.remarkText}}</view>
        </view>

        <view wx:if="{{item.showFilesBlock}}" class="eblock files-block">
          <view class="eblock-label">{{item.countText}}</view>
          <view class="files-grid">
            <view wx:for="{{item.files}}" wx:for-item="file" wx:key="fileIndex" class="file-tile">
              <image
                wx:if="{{file.showThumb}}"
                class="file-thumb"
                src="{{file.thumbUrl}}"
                mode="aspectFill"
                lazy-load="{{true}}"
                data-item-index="{{itemIndex}}"
                data-file-index="{{file.fileIndex}}"
                bindtap="previewAttachment"
              />
              <view
                wx:elif="{{file.type === 'video'}}"
                class="file-video-face"
                data-item-index="{{itemIndex}}"
                data-file-index="{{file.fileIndex}}"
                bindtap="previewAttachment"
              >
                <view class="video-play-icon">▶</view>
                <text class="file-face-name">{{file.nameDisplay}}</text>
              </view>
              <view
                wx:else
                class="file-doc-face"
                data-item-index="{{itemIndex}}"
                data-file-index="{{file.fileIndex}}"
                bindtap="previewAttachment"
              >
                <text class="doc-type">{{file.typeText}}</text>
                <text class="file-face-name">{{file.nameDisplay}}</text>
              </view>
              <text wx:if="{{file.showTag}}" class="file-tag" style="color: {{file.tagColor}}; border-color: {{file.tagColor}};">{{file.tagText}}</text>
              <view class="file-acts">
                <button class="tile-btn" loading="{{detailView.previewLoading}}" catchtap="previewAttachment" data-item-index="{{itemIndex}}" data-file-index="{{file.fileIndex}}">打开</button>
                <button class="tile-btn secondary" loading="{{detailView.previewLoading}}" catchtap="downloadAttachment" data-item-index="{{itemIndex}}" data-file-index="{{file.fileIndex}}">下载</button>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{item.showDeleteAction || item.showEditAction}}" class="record-action-row">
          <button wx:if="{{item.showEditAction}}" class="mini-action primary" bindtap="editRecord" data-item-index="{{itemIndex}}">编辑 / 追加文件</button>
          <button wx:if="{{item.showDeleteAction}}" class="mini-action danger" bindtap="removeRecord" data-item-index="{{itemIndex}}">删除记录</button>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{detailView.showEmpty}}" class="card muted">暂无四项服务详情</view>

  <view wx:if="{{previewVideoPath}}" class="video-layer">
    <video src="{{previewVideoPath}}" controls class="video-player"></video>
    <view class="video-close" bindtap="closeVideoPreview">关闭视频</view>
  </view>
</view>
