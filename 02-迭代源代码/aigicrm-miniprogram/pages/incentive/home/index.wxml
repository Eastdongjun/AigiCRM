<wxs src="../thumb.wxs" module="thumb" />
<!-- 【2026-10-23 四项服务拆分·用户令】tabBar「四项服务」=轻量客户记录快查视图:
     只显示客户与记录(搜索/筛选/上传入口保留), 不含分类树/统计/排行/阅读;
     完整能力(分类树/统计/排行/阅读/一客一册档案)在应用中心「四项服务应用」(pages/incentive/index)。 -->
<view class="page incentive-workbench">
  <!-- 【2026-10-23 用户反馈: 顶部太占空间】hero 大卡压成单行细条: 标题+刷新+上传同行,
       删副标题与上传提示语; 搜索卡/筛选胶囊同步收紧(见本页 wxss 覆盖段) -->
  <view class="hm-bar">
    <text class="hm-bar-title">四项服务</text>
    <view class="hm-bar-actions">
      <button class="hm-bar-btn ghost" bindtap="refresh" loading="{{incentiveView.refreshLoading}}">↻ 刷新</button>
      <button wx:if="{{canUploadEvidence}}" class="hm-bar-btn solid" bindtap="goUpload">＋ 上传</button>
    </view>
  </view>

  <view class="card incentive-search-card">
    <view class="incentive-search-row">
      <input class="incentive-search-input" value="{{keyword}}" placeholder="搜索客户 / 产品 / 关键字" confirm-type="search" bindinput="inputKeyword" bindconfirm="searchRecords" />
      <button class="mini-action" bindtap="searchRecords" loading="{{incentiveView.searchLoading}}">{{incentiveView.searchText}}</button>
      <button class="mini-action secondary" bindtap="resetRecordFilters">清空</button>
    </view>
    <view class="incentive-advanced-filters">
      <!-- 【2026-11-02 用户令·平铺直选】行业平铺(数据=系统字典 industry 动态拉取, 后台新增行业自动呈现, 不写死);
           点击哪个行业就筛哪个行业 -->
      <scroll-view class="flat-chip-row" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="flat-chip-row-inner">
          <view wx:for="{{industries}}" wx:key="*this"
                class="flat-chip {{index === selectedIndustryIndex ? 'on' : ''}}"
                data-index="{{index}}" bindtap="chooseIndustry">{{item}}</view>
        </view>
      </scroll-view>
      <!-- 【2026-11-02 用户令·平铺直选】产品平铺(数据=分类树"产品试点"分支动态派生, 新增产品自动呈现);
           点击哪个产品就筛哪个产品的记录 -->
      <scroll-view class="flat-chip-row" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="flat-chip-row-inner">
          <view wx:for="{{productOptions}}" wx:key="*this"
                class="flat-chip {{index === selectedProductIndex ? 'on' : ''}}"
                data-index="{{index}}" bindtap="chooseProduct">{{item}}</view>
        </view>
      </scroll-view>
      <!-- 【2026-11-02 用户令】类型/组织/日期范围筛选退役: 筛选只留顶部全局检索+行业/产品平铺 -->
    </view>
  </view>
  <!-- 【2026-10-26 用户令"客户维度明细几个字不要了"】标题移除, 筛选行骨架(pickers)原位保留;
       【同日打散令】前置双视图切换: time=打散记录流(默认, 按上传时间) / customer=按客户归集封面卡 -->
  <view class="incentive-filter-head">
    <view class="incentive-filter-actions">
      <view class="mode-switch">
        <view class="mode-chip {{listMode === 'time' ? 'active' : ''}}" data-mode="time" bindtap="switchListMode">按时间</view>
        <view class="mode-chip {{listMode === 'customer' ? 'active' : ''}}" data-mode="customer" bindtap="switchListMode">按客户</view>
      </view>
      <!-- 【B 案 2026-10-27】分类筛选两级化: 双列滚轮(大类=产品试点/交流拜访/外出参观/两谈两做方案,
           子类=该大类下涂层类/使用报告/高层拜访…), 替代原只列子类名的单列 picker -->
      <picker mode="multiSelector" range="{{categoryRange}}" value="{{categoryValue}}" bindcolumnchange="onCategoryColumnChange" bindchange="chooseCategory" bindcancel="onCategoryCancel">
        <view class="ranking-tab">{{incentiveView.categoryText}}⌄</view>
      </picker>
      <picker mode="selector" range="{{userNames}}" value="{{selectedUserIndex}}" bindchange="chooseUser">
        <view class="ranking-tab">{{incentiveView.userText}}</view>
      </picker>
      <picker mode="selector" range="{{orderOptions}}" value="{{selectedOrderIndex}}" bindchange="chooseOrder">
        <view class="ranking-tab">{{incentiveView.orderText}}</view>
      </picker>
    </view>
  </view>
  <view wx:if="{{incentiveView.showLoading}}" class="card muted">{{incentiveView.loadingText}}</view>

  <!-- 打散记录流(轻量页默认): 一次上传=一条记录, 不绑客户归集, 按上传时间排(排序胶囊四档通用);
       【同日令"不呈现客户名称,呈现图片"】行首=该记录首图缩略(无图退分类首字面), 客户名只留检索;
       点行直达该条记录的拨盘详情页 -->
  <block wx:if="{{listMode === 'time'}}">
    <view wx:for="{{pagedFlatRecords}}" wx:key="id" class="flat-rec" data-index="{{index}}" bindtap="openFlatRecord">
      <view class="flat-cover">
        <image wx:if="{{item.coverFile.id && apiBase && dlToken}}" class="flat-cover-img" src="{{thumb.thumbSrc(item.coverFile, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" />
        <view wx:else class="flat-cover-fallback">{{item.coverChar}}</view>
      </view>
      <view class="flat-rec-main">
        <view class="flat-rec-meta">
          <text wx:if="{{item.categoryName}}" class="flat-rec-pill">{{item.categoryName}}</text>
          <text wx:if="{{item.productText}}" class="flat-rec-product">{{item.productText}}</text>
        </view>
        <view class="flat-rec-sub">
          <text>{{item.timeText}}</text>
          <text wx:if="{{item.uploaderName}}"> · {{item.uploaderName}}</text>
          <text wx:if="{{item.fileCount}}"> · {{item.fileCount}}个文件</text>
        </view>
      </view>
      <!-- 【2026-11-02 用户令】展示页不呈现分值, flat-rec-side(分数+单位)移除 -->
      <view class="cust-arrow">›</view>
    </view>
  </block>

  <!-- 按客户归集(可切换回归): 与完整版同卡型, 但无「档案」角标/未读红点(阅读机制只在完整应用),
       点卡进拨盘详情页 -->
  <block wx:else>
  <block wx:for="{{pagedRecords}}" wx:key="id">
    <view class="cust-card" data-index="{{index}}" bindtap="openCustomer">
      <view class="cust-cover">
        <image wx:if="{{item.coverFile.id && apiBase && dlToken}}" class="cust-cover-img" src="{{thumb.thumbSrc(item.coverFile, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" />
        <view wx:else class="cust-cover-fallback">{{item.coverChar}}</view>
      </view>
      <view class="cust-body">
        <view class="cust-name-row">
          <text class="cust-name">{{item.name}}</text>
        </view>
        <view class="cust-meta">
          <text class="cust-pill">{{item.industry}}</text>
          <text wx:if="{{item.category}}" class="cust-pill blue">{{item.category}}</text>
        </view>
        <view class="cust-nums">{{item.countText}} · {{item.fileCountText}}</view>
      </view>
      <!-- 【2026-11-02 用户令】展示页不呈现分值, cust-score(封面卡分数)移除 -->
      <view class="cust-arrow">›</view>
    </view>
  </block>
  </block>
  <view class="incentive-pager">
    <pager wx:if="{{(listMode === 'time' ? flatPagerTotal : pagerTotal) > 10}}" page="{{page}}" pageSize="{{pageSize}}" total="{{listMode === 'time' ? flatPagerTotal : pagerTotal}}" loading="{{incentiveView.pagerLoading}}" bind:change="onPagerChange" />
  </view>
  <view wx:if="{{incentiveView.showRecordEmpty}}" class="card muted">暂无四项服务记录</view>
</view>
