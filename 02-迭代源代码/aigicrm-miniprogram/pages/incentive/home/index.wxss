/* 【2026-10-23 四项服务拆分】tabBar 轻量视图(客户记录快查)复用完整工作台的样式集——
   完整版(pages/incentive/index.wxss)是样式的单一事实源, 本页只挑用其中 hero/搜索/封面卡/分页
   相关类; 分类树/统计/排行/阅读的样式在本页无对应 WXML 节点, 引入亦不生效。 */
@import "../index.wxss";

/* ===== 【2026-10-23 用户反馈: 顶部太占空间】轻量页顶部压缩覆盖 =====
   hero 大卡(标题+副标题+刷新+上传+提示语 5 行)压成单行细条; 搜索卡与筛选胶囊收紧。
   覆盖声明置于 @import 之后, 同特异性时后者生效——只影响本页, 完整版工作台不受影响。 */
/* 【2026-10-25 用户令"边框做圆的,参考文件页"】与 files-top 同款: 深蓝渐变圆角卡+投影 */
.hm-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #0d1733 0%, #16337a 58%, #1d4ed8 100%);
  box-shadow: 0 18rpx 38rpx rgba(13, 23, 51, .22);
  color: #fff;
}
.hm-bar-title { font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx; }
.hm-bar-actions { display: flex; align-items: center; gap: 14rpx; }
.hm-bar-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  border: none;
}
.hm-bar-btn::after { border: none; }
.hm-bar-btn.ghost { background: rgba(255, 255, 255, .16); color: #fff; border: 1rpx solid rgba(255, 255, 255, .55); }
.hm-bar-btn.solid { background: #fff; color: #1d4ed8; font-weight: 700; }

.incentive-search-card { padding: 12rpx 16rpx; margin-top: 14rpx; }
.incentive-search-row .incentive-search-input { height: 58rpx; }
.incentive-advanced-filters { margin-top: 10rpx; }
.filter-chip { padding: 6rpx 16rpx; font-size: 20rpx; }
.incentive-filter-head { margin: 14rpx 0 10rpx; }
.cust-card { margin-bottom: 14rpx; }

/* ===== 【2026-10-26 用户令·打散视图】轻量页双视图 =====
   time=打散记录流(默认, 不绑客户按上传时间排) / customer=按客户归集封面卡(完整版排法) */
.mode-switch { display: inline-flex; padding: 4rpx; gap: 4rpx; border-radius: 999rpx; background: #e8eef7; }
.mode-chip { height: 44rpx; line-height: 44rpx; padding: 0 22rpx; border-radius: 999rpx; color: #64748b; font-size: 21rpx; font-weight: 700; }
.mode-chip.active { background: #fff; color: #1d4ed8; box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, .08); }

.flat-rec { display: flex; align-items: center; gap: 16rpx; background: #fff; border-radius: 20rpx; padding: 18rpx 20rpx; margin-bottom: 14rpx; box-shadow: 0 8rpx 22rpx rgba(48, 78, 112, .05); }
.flat-rec:active { background: #f8fbff; }
.flat-rec-main { flex: 1; min-width: 0; }
.flat-rec-name { color: #172033; font-size: 26rpx; font-weight: 800; line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.flat-rec-meta { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; margin-top: 8rpx; }
.flat-rec-pill { flex-shrink: 0; font-size: 19rpx; padding: 3rpx 14rpx; border-radius: 999rpx; background: #eef4ff; color: #1d4fd7; }
.flat-rec-product { min-width: 0; font-size: 20rpx; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.flat-rec-sub { margin-top: 8rpx; font-size: 20rpx; color: #94a3b8; }
.flat-rec-side { flex-shrink: 0; display: flex; align-items: baseline; gap: 4rpx; background: #f4f8ff; border: 1rpx solid #dce8fb; border-radius: 16rpx; padding: 10rpx 16rpx; }
.flat-rec-score { font-size: 30rpx; font-weight: 900; color: #1d4fd7; line-height: 1; }
.flat-rec-unit { font-size: 18rpx; color: #7d9bd8; }

/* 【2026-10-26 用户令"就显示客户名称列表"】按客户=纯名称清单: 一行一客户(名+条数+箭头),
   封面卡从轻量页退役(完整版四项服务应用的客户封面卡不受影响) */
.cust-list-row { display: flex; align-items: center; gap: 14rpx; background: #fff; border-radius: 18rpx; padding: 22rpx; margin-bottom: 12rpx; box-shadow: 0 6rpx 18rpx rgba(48, 78, 112, .04); }
.cust-list-row:active { background: #f8fbff; }
.cust-list-name { flex: 1; min-width: 0; color: #172033; font-size: 26rpx; font-weight: 700; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.cust-list-count { flex-shrink: 0; color: #94a3b8; font-size: 20rpx; }

/* 底部留白让位自定义 tabBar(覆盖层 ~110rpx+安全区); 覆盖完整版导入的 36rpx */
.incentive-workbench { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
