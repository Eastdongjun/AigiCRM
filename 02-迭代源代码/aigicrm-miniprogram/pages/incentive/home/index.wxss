/* 【2026-10-23 四项服务拆分】tabBar 轻量视图(客户记录快查)复用完整工作台的样式集——
   完整版(pages/incentive/index.wxss)是样式的单一事实源, 本页只挑用其中 hero/搜索/封面卡/分页
   相关类; 分类树/统计/排行/阅读的样式在本页无对应 WXML 节点, 引入亦不生效。 */
@import "../index.wxss";

/* ===== 【2026-10-23 用户反馈: 顶部太占空间】轻量页顶部压缩覆盖 =====
   hero 大卡(标题+副标题+刷新+上传+提示语 5 行)压成单行细条; 搜索卡与筛选胶囊收紧。
   覆盖声明置于 @import 之后, 同特异性时后者生效——只影响本页, 完整版工作台不受影响。 */
/* 【2026-10-25 用户令"边框做圆的,参考文件页"】与 files-top 同款: 深蓝渐变圆角卡+投影 */
.hm-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #0d1733 0%, #16337a 58%, #1d4ed8 100%);
  box-shadow: 0 18rpx 38rpx rgba(13, 23, 51, .22);
  color: #fff;
}
.hm-bar-title { font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx; }
.hm-bar-actions { display: flex; align-items: center; gap: 14rpx; }
.hm-bar-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  border: none;
}
.hm-bar-btn::after { border: none; }
.hm-bar-btn.ghost { background: rgba(255, 255, 255, .16); color: #fff; border: 1rpx solid rgba(255, 255, 255, .55); }
.hm-bar-btn.solid { background: #fff; color: #1d4ed8; font-weight: 700; }

/* 【2026-11-03 用户令"顶部区域边框面太大"】搜索/筛选白卡两刀收紧: 卡内距/行距/输入框高降档,
   卡下外距(完整版基础 18rpx)收到 8rpx, 圆角同步收小; 胶囊切换器(mode-chip)尺寸不动
   (2026-10-26"做醒目"用户裁决)。 */
.incentive-search-card { padding: 6rpx 12rpx; margin-top: 10rpx; margin-bottom: 8rpx; border-radius: 18rpx; }
.incentive-search-row .incentive-search-input { height: 48rpx; }
.incentive-advanced-filters { margin-top: 6rpx; }
.incentive-filter-head { margin: 8rpx 0 6rpx; }
.cust-card { margin-bottom: 14rpx; }

/* ===== 【2026-11-02 用户令·平铺直选】行业/产品 chips 行 =====
   行业=系统字典动态(新增行业自动呈现); 产品=分类树"产品试点"分支动态派生。
   横向滚动一行(scroll-x), 胶囊样式与 10-26 醒目化切换器同语言: 选中=品牌蓝实底白字。 */
.flat-chip-row { width: 100%; white-space: nowrap; }
.flat-chip-row + .flat-chip-row { margin-top: 4rpx; }
.flat-chip-row-inner { display: inline-flex; gap: 10rpx; padding: 2rpx 2rpx 2rpx 0; }
.flat-chip {
  flex: none; padding: 5rpx 18rpx; font-size: 22rpx; line-height: 1.4;
  color: #1f3b73; background: #fff; border: 2rpx solid #c9d6f2; border-radius: 999rpx;
  transition: all .12s ease;
}
.flat-chip.on { color: #fff; background: #2f6bff; border-color: #2f6bff; font-weight: 500; box-shadow: 0 4rpx 10rpx rgba(47,107,255,.25); }
/* 剩余下拉(类型/组织/起止日期)与平铺两行同区排版 */
.flat-picker-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }

/* ===== 【2026-10-26 用户令·打散视图】轻量页双视图 =====
   time=打散记录流(默认, 不绑客户按上传时间排) / customer=按客户归集封面卡(完整版排法)
   【同日令"这俩胶囊做醒目一些"】切换器加大加实底: 选中=品牌蓝实底白字, 未选=白底描边 */
/* 【同日修正"按时间/按客户字没显示全"】app.wxss 的 filter-actions 是横向滚动条(flex 子项可被压缩,
   定高胶囊内文字换行即被裁); 本页改允许换行 + 切换器/胶囊禁收缩不换行, 四胶囊自动分两行 */
.incentive-filter-actions { flex-wrap: wrap; overflow-x: visible; }
.mode-switch { display: inline-flex; flex-shrink: 0; padding: 6rpx; gap: 6rpx; border-radius: 999rpx; background: #e3ebf6; box-shadow: inset 0 2rpx 6rpx rgba(15, 23, 42, .05); }
.mode-chip { height: 56rpx; line-height: 56rpx; padding: 0 30rpx; border-radius: 999rpx; background: #fff; color: #52657f; font-size: 24rpx; font-weight: 800; border: 1rpx solid #dbe4f0; white-space: nowrap; }
.mode-chip.active { background: #1d4ed8; border-color: #1d4ed8; color: #fff; box-shadow: 0 8rpx 18rpx rgba(29, 78, 216, .32); }

.flat-rec { display: flex; align-items: center; gap: 16rpx; background: #fff; border-radius: 20rpx; padding: 16rpx 18rpx; margin-bottom: 14rpx; box-shadow: 0 8rpx 22rpx rgba(48, 78, 112, .05); }
.flat-rec:active { background: #f8fbff; }
/* 【同日令"不要呈现客户名称,呈现图片"】行首=记录首图缩略方块(与客户封面卡同款渐变兜底面) */
.flat-cover { position: relative; flex-shrink: 0; width: 108rpx; height: 108rpx; border-radius: 16rpx; overflow: hidden; background: linear-gradient(150deg, #0d1733, #13255e 58%, #1d4ed8); }
.flat-cover-img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.flat-cover-fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #dbe6ff; font-size: 44rpx; font-weight: 900; }
.flat-rec-main { flex: 1; min-width: 0; }
.flat-rec-meta { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.flat-rec-pill { flex-shrink: 0; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; background: #eef4ff; color: #1d4fd7; font-weight: 700; }
.flat-rec-product { min-width: 0; font-size: 21rpx; color: #475569; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.flat-rec-sub { margin-top: 10rpx; font-size: 20rpx; color: #94a3b8; }
.flat-rec-side { flex-shrink: 0; display: flex; align-items: baseline; gap: 4rpx; background: #f4f8ff; border: 1rpx solid #dce8fb; border-radius: 16rpx; padding: 10rpx 16rpx; }
.flat-rec-score { font-size: 30rpx; font-weight: 900; color: #1d4fd7; line-height: 1; }
.flat-rec-unit { font-size: 18rpx; color: #7d9bd8; }

/* 底部留白让位自定义 tabBar(覆盖层 ~110rpx+安全区); 覆盖完整版导入的 36rpx */
.incentive-workbench { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
