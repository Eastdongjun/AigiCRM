<wxs src="../thumb.wxs" module="thumb" />
<view class="page cd-page">
  <block wx:if="{{!loaded}}">
    <view class="cd-skeleton">
      <view class="cd-sk cd-sk-spine"></view>
      <view class="cd-sk-body">
        <view class="cd-sk cd-sk-kicker"></view>
        <view class="cd-sk cd-sk-title"></view>
        <view class="cd-sk cd-sk-sub"></view>
        <view class="cd-sk-chips">
          <view class="cd-sk cd-sk-chip"></view>
          <view class="cd-sk cd-sk-chip"></view>
          <view class="cd-sk cd-sk-chip"></view>
        </view>
        <view class="cd-sk cd-sk-rule"></view>
        <view class="cd-sk cd-sk-score"></view>
        <view class="cd-sk cd-sk-stats"></view>
        <view class="cd-sk cd-sk-meta"></view>
        <view class="cd-sk cd-sk-quote"></view>
        <view class="cd-sk cd-sk-button"></view>
      </view>
    </view>
  </block>
  <view wx:elif="{{!record}}" class="cd-empty-page">客户激励数据不存在</view>
  <block wx:else>
    <view wx:if="{{!inside}}" class="cd-cover">
      <view class="cd-spine"><text>四项激励档案 · {{coverYear}}</text></view>
      <view wx:if="{{coverUnread}}" class="cd-ribbon">未读 {{coverUnread}}</view>
      <view class="cd-cover-body">
        <view class="cd-kicker">FOUR INCENTIVE ARCHIVE</view>
        <view class="cd-cover-title">{{record.name}}</view>
        <view class="cd-cover-sub">客户激励档案 · 一客一册</view>
        <view class="cd-chips">
          <text>{{record.industry}}</text>
          <text wx:if="{{record.category}}" class="cd-chip-solid">{{record.category}}</text>
          <text>{{coverYear}} 年</text>
        </view>
        <view class="cd-cover-rule"></view>
        <view class="cd-score-row">
          <text class="cd-score">{{record.score}}</text>
          <text class="cd-score-unit">分</text>
          <text class="cd-score-cap">累计积分</text>
        </view>
        <view class="cd-cover-stats">
          <view><b>{{record.countText}}</b><text>记录</text></view>
          <view><b>{{groups.length}}</b><text>月份</text></view>
          <view><b>{{record.fileCountText}}</b><text>文件</text></view>
          <view><b>{{coverLatest}}</b><text>最近更新</text></view>
        </view>
        <view class="cd-cover-meta">负责人 {{coverOwner}} · 档案编号 {{coverCode}}</view>
        <view wx:if="{{coverRecent.length}}" class="cd-cover-recent">
          <view class="cd-cover-recent-title">最近记录</view>
          <view wx:for="{{coverRecent}}" wx:key="recentKey" class="cd-cover-recent-row">
            <text class="cd-cover-recent-date">{{item.dateText}}</text>
            <text class="cd-cover-recent-cat">{{item.titleText}}</text>
            <text class="cd-cover-recent-score">{{item.scoreText}}</text>
          </view>
        </view>
        <view class="cd-cover-quote">“{{coverSummary}}”</view>
        <button class="cd-open" bindtap="openArchive">打开档案 →</button>
      </view>
    </view>

    <view wx:else class="cd-inside">
      <view class="cd-top">
        <button class="cd-back" bindtap="closeArchive" aria-label="合上档案">←</button>
        <view class="cd-top-main">
          <b>{{record.name}}</b>
          <text>四项激励档案 · {{coverYear}}</text>
        </view>
        <button wx:if="{{totalUnread}}" class="cd-unread-chip" bindtap="openUnread">未读 {{totalUnread}} ›</button>
      </view>

      <view class="cd-body">
        <scroll-view scroll-y class="cd-timeline">
          <view class="cd-timeline-head">
            <text>时间轴</text>
            <button class="cd-latest" bindtap="latestMonth">最新</button>
          </view>
          <block wx:for="{{groups}}" wx:key="key">
            <view wx:if="{{item.showYear}}" class="cd-year">{{item.year}}</view>
            <view class="cd-month {{selectedKey === item.key ? 'cd-month-active' : ''}}" data-key="{{item.key}}" bindtap="selectMonth">
              <view class="cd-month-dot"></view>
              <view class="cd-month-main"><b>{{item.monthLabel}}</b><text>{{item.count}} 条</text></view>
              <view wx:if="{{item.unreadCount}}" class="cd-month-unread"></view>
            </view>
          </block>
        </scroll-view>

        <scroll-view scroll-y class="cd-pane" scroll-into-view="{{paneAnchor}}">
          <view id="cd-pane-top"></view>
          <view wx:if="{{currentGroup}}" class="cd-pane-head">
            <text>{{currentGroup.label}}</text>
            <text>{{currentGroup.count}} 条</text>
          </view>
          <view wx:if="{{!currentRecord}}" class="cd-empty">本时间暂无激励记录</view>
          <block wx:else>
            <view class="cd-record-date">
              <text class="cd-date">{{currentRecord.dateText}}</text>
              <text class="cd-week">{{currentRecord.weekday}}</text>
              <text class="cd-score-badge">{{currentRecord.scoreText}}</text>
            </view>
            <view class="cd-cat">
              <view class="cd-cat-dot"></view>
              <text class="cd-cat-name">{{currentRecord.titleText}}</text>
              <text wx:if="{{currentRecord.unread}}" class="cd-unread-tag">未读</text>
            </view>
            <view class="cd-meta">{{currentRecord.metaText}}</view>
            <view class="cd-record-title">{{currentRecord.titleText}}</view>
            <view class="cd-record-body">{{currentRecord.bodyText}}</view>

            <view wx:if="{{currentRecord.photos.length}}" class="cd-photo-grid">
              <view wx:for="{{currentRecord.photos}}" wx:key="id" class="cd-photo" data-index="{{index}}" bindtap="previewPhoto">
                <image wx:if="{{apiBase && dlToken}}" class="cd-photo-img" src="{{thumb.thumbSrc(item, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" />
                <view wx:else class="cd-photo-fallback"><text>{{item.name || '照片'}}</text></view>
                <text wx:if="{{item.tag}}" class="cd-photo-tag">{{item.tag}}</text>
                <text class="cd-photo-zoom">⤢</text>
              </view>
            </view>
            <view wx:if="{{currentRecord.photos.length}}" class="cd-photo-hint">点击图片可放大查看</view>

            <view wx:if="{{currentRecord.videos.length}}" class="cd-video" bindtap="previewVideo">
              <view class="cd-video-play">▶</view>
              <view class="cd-video-copy"><b>现场安装视频</b><text>{{currentRecord.videos[0].name || '视频'}}</text></view>
            </view>

            <view wx:if="{{currentRecord.attachments.length}}" class="cd-attach">
              <view class="cd-attach-head">附件凭证 · {{currentRecord.attachments.length}} 项</view>
              <view class="cd-attach-list">
                <button wx:for="{{currentRecord.attachments}}" wx:key="id" class="cd-file" data-group="{{item.groupIndex}}" data-file="{{item.fileIndex}}" bindtap="previewAttachment">{{item.name}}</button>
              </view>
            </view>

            <view class="cd-record-foot">
              <text>第 {{currentIndex + 1}} / {{currentGroup.count}} 页</text>
              <button class="cd-more" bindtap="onRecordMore">···</button>
            </view>
          </block>
          <view class="cd-pane-bottom"></view>
        </scroll-view>
      </view>

      <view wx:if="{{currentGroup}}" class="cd-page-nav">
        <button disabled="{{currentIndex === 0}}" bindtap="prevRecord" aria-label="上一页">‹</button>
        <text>{{currentIndex + 1}} / {{currentGroup.count}}</text>
        <button disabled="{{currentIndex >= currentGroup.count - 1}}" bindtap="nextRecord" aria-label="下一页">›</button>
      </view>
    </view>

    <view wx:if="{{unreadOpen}}" class="cd-mask" bindtap="closeUnread">
      <view class="cd-unread-panel" catchtap="noop">
        <view class="cd-unread-head">
          <view><b>未读激励</b><text>{{unreadRows.length}} 条待查看</text></view>
          <button class="cd-unread-close" bindtap="closeUnread" aria-label="关闭未读列表">×</button>
        </view>
        <view wx:if="{{!unreadRows.length}}" class="cd-unread-empty">暂无未读激励</view>
        <scroll-view wx:else scroll-y class="cd-unread-list">
          <button wx:for="{{unreadRows}}" wx:key="rowKey" class="cd-unread-row" data-key="{{item.key}}" data-index="{{item.index}}" bindtap="jumpUnread">
            <text class="cd-unread-date">{{item.dateText}}</text>
            <view class="cd-unread-main"><b>{{item.titleText}}</b><text>{{item.groupLabel}} · {{item.scoreText}}</text></view>
            <text class="cd-unread-go">›</text>
          </button>
        </scroll-view>
        <button class="cd-unread-all" disabled="{{!unreadRows.length}}" bindtap="markAllRead">全部标为已读</button>
      </view>
    </view>
  </block>
</view>
