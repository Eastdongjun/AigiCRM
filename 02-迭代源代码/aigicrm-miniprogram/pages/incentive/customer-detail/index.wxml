<wxs src="../thumb.wxs" module="thumb" />
<view class="page cd-page">
  <view wx:if="{{!loaded}}" class="cd-empty">加载中...</view>
  <view wx:if="{{loaded && !record}}" class="cd-empty">客户激励数据不存在</view>
  <block wx:if="{{loaded && record}}">
    <!-- 客户头部: 名称/行业·最新大类/记录·文件数 + 总分 -->
    <view class="cd-hero">
      <view class="cd-hero-main">
        <view class="cd-name">{{record.name}}</view>
        <view class="cd-chips">
          <text class="cd-chip">{{record.industry}}</text>
          <text wx:if="{{record.category}}" class="cd-chip blue">{{record.category}}</text>
        </view>
        <view class="cd-statline">{{record.countText}} · {{record.fileCountText}}</view>
      </view>
      <view class="cd-score">
        <text class="cd-score-num">{{record.score}}</text>
        <text class="cd-score-unit">分</text>
      </view>
    </view>

    <!-- 分类锚点(原红圈①汇总行的新家): 点击滚动到对应分组 -->
    <view wx:if="{{record.showFiles}}" class="card cd-anchor-card">
      <scroll-view scroll-x class="cd-anchor-scroll" enable-flex>
        <view class="cd-anchor-row">
          <view wx:for="{{record.fileGroupsView}}" wx:key="groupIndex" wx:for-item="group" wx:for-index="anchorIdx" class="cd-anchor-chip" data-idx="{{anchorIdx}}" bindtap="scrollToGroup">{{group.slotText}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 【导航契约】页级滚动改 scroll-view 承载: wx.pageScrollTo 会破坏回退时的原生滚动位置保持,
         锚点定位用 scroll-into-view(头部 hero/锚点固定, 照片墙+历史记录为滚动体) -->
    <scroll-view scroll-y class="cd-body" scroll-into-view="{{scrollAnchor}}" scroll-with-animation>
      <!-- 分组照片墙(原红圈②角标职责由分组标题承担,原③按钮删除: 点图预览/长按下载) -->
      <view wx:if="{{record.showFiles}}" class="card">
        <view wx:for="{{record.fileGroupsView}}" wx:for-item="group" wx:for-index="wallGroupIdx" wx:key="groupIndex" class="record-file-group" id="cd-group-{{wallGroupIdx}}">
          <view class="record-file-group-head"><text>{{group.label}}</text><text>{{group.countText}}</text></view>
          <view class="wall-grid">
            <view wx:for="{{group.files}}" wx:for-item="file" wx:for-index="wallFileIdx" wx:key="id" class="wall-tile" catchtap="onTileTap" catchlongpress="onTileLongPress" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">
              <!-- 【I4】token/apiBase 缺失时 thumbSrc 返回空串→空灰块; 条件带上凭证, 缺失时落到下方文件面卡 -->
              <image wx:if="{{file.type === 'image' && file.id && apiBase && dlToken}}" class="wall-thumb" src="{{thumb.thumbSrc(file, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" />
              <view wx:elif="{{file.type === 'video'}}" class="wall-video-face">
                <view class="wall-play-icon">▶</view>
                <text class="wall-face-name">{{file.name}}</text>
              </view>
              <view wx:else class="wall-doc-face">
                <text class="wall-doc-type">{{file.typeText}}</text>
                <text class="wall-face-name">{{file.name}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 历史记录(默认展开,原列表页折叠区移入): 点行=详情, 行尾···=追加/删除 -->
      <view class="card">
        <view class="cd-section-title">历史记录 · {{children.length}}</view>
        <view wx:if="{{!children.length}}" class="cd-empty slim">暂无历史记录</view>
        <view wx:for="{{children}}" wx:for-item="child" wx:for-index="childIdx" wx:key="id" class="cd-child-row">
          <view class="cd-child-main" data-index="{{childIdx}}" catchtap="onChildDetail">
            <view class="cd-child-title"><text class="cd-child-cat">{{child.titleText}}</text><text class="{{child.readStatusClass}}">{{child.readStatusText}}</text></view>
            <view class="cd-child-meta">{{child.metaText}}</view>
          </view>
          <view class="cd-child-side">
            <text class="cd-child-score">{{child.scoreText}}</text>
            <view class="cd-child-more" data-index="{{childIdx}}" catchtap="onChildMore">···</view>
          </view>
        </view>
      </view>

      <video wx:if="{{previewVideoPath}}" src="{{previewVideoPath}}" controls class="cd-video"></video>
      <view class="cd-bottom-space"></view>
    </scroll-view>

    <!-- 吸底操作栏(原红圈④收敛为两个: 追加激励/客户档案) -->
    <view class="cd-bottom-bar">
      <view wx:if="{{record.showAppendAction}}" class="cd-bottom-btn primary" bindtap="onAppend">＋ 追加激励</view>
      <view wx:if="{{record.showCustomerAction}}" class="cd-bottom-btn ghost" bindtap="onOpenCustomer">客户档案</view>
    </view>
  </block>
</view>
