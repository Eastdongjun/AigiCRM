<wxs src="../thumb.wxs" module="thumb" />
<view class="page cd-page">
  <!-- 骨架: 与 PC 主从布局同构(头部 + 左侧日期轨 + 右侧内容卡), 加载完成前不闪空白 -->
  <block wx:if="{{!loaded}}">
    <view class="cd-skel cd-skel-hero"></view>
    <view class="cd-skel cd-skel-tabs"></view>
    <view class="cd-skel-layout">
      <view class="cd-skel cd-skel-dial">
        <view class="cd-skel cd-skel-dial-head"></view>
        <view class="cd-skel-dial-cols">
          <view wx:for="{{[1,2,3]}}" wx:key="*this" class="cd-skel cd-skel-dial-col"></view>
        </view>
      </view>
      <view class="cd-skel-pane">
        <view wx:for="{{[1,2,3]}}" wx:key="*this" class="cd-skel cd-skel-row"></view>
      </view>
    </view>
  </block>
  <view wx:elif="{{!record}}" class="cd-empty">客户激励数据不存在</view>
  <block wx:else>
    <!-- 客户头部: 名称/行业·最新大类/记录·文件数 + 总分 -->
    <view class="cd-hero">
      <view class="cd-hero-main">
        <view class="cd-name">{{record.name}}</view>
        <view class="cd-chips">
          <text class="cd-chip">{{record.industry}}</text>
          <text wx:if="{{record.category}}" class="cd-chip blue">{{record.category}}</text>
        </view>
        <view class="cd-statline">{{record.countText}} · {{record.fileCountText}}</view>
      </view>
      <view class="cd-score">
        <text class="cd-score-num">{{record.score}}</text>
        <text class="cd-score-unit">分</text>
      </view>
    </view>

    <!-- 与 PC 详情一致: 默认按日期主从(左日期轨/右内容), 照片墙保留为次要视图 -->
    <view wx:if="{{record.showFiles}}" class="cd-view-tabs">
      <view class="cd-view-tab {{viewMode === 'date' ? 'active' : ''}}" data-mode="date" bindtap="switchViewMode">按日期</view>
      <view class="cd-view-tab {{viewMode === 'wall' ? 'active' : ''}}" data-mode="wall" bindtap="switchViewMode">照片墙</view>
    </view>

    <block wx:if="{{viewMode === 'date'}}">
      <view class="cd-date-layout">
        <!-- 左栏: 与 PC 一致的三联日期拨盘(年/月/日), picker-view 原生滚轮 + 中间高亮带 -->
        <view class="cd-dial">
          <view class="cd-dial-head">
            <view class="cd-dial-now">
              <text class="cd-dial-date">{{nowDateText}}</text>
              <text class="cd-dial-time">{{nowTimeText}}</text>
            </view>
            <view class="cd-dial-today" bindtap="goToday">回到今天</view>
          </view>
          <view class="cd-dial-cols">
            <view class="cd-dial-wheel">
              <view class="cd-dial-band"></view>
              <picker-view class="cd-dial-picker" indicator-style="height: 72rpx;" value="{{dialValue}}" bindchange="onDialChange">
                <picker-view-column>
                  <view wx:for="{{dialYears}}" wx:key="value" class="cd-dial-item {{item.hasData ? '' : 'dim'}}">{{item.label}}</view>
                </picker-view-column>
                <picker-view-column>
                  <view wx:for="{{dialMonths}}" wx:key="value" class="cd-dial-item {{item.hasData ? '' : 'dim'}}">{{item.label}}<view wx:if="{{item.unread}}" class="cd-dial-dot"></view></view>
                </picker-view-column>
                <picker-view-column>
                  <view wx:for="{{dialDays}}" wx:key="value" class="cd-dial-item {{item.hasData ? '' : 'dim'}}">{{item.label}}<view wx:if="{{item.hasData && item.value}}" class="cd-dial-dot"></view></view>
                </picker-view-column>
              </picker-view>
            </view>
          </view>
        </view>

        <!-- 右栏: 所选年/月/日激励内容, 每页 6 条, 加载更多 -->
        <scroll-view scroll-y class="cd-pane">
          <view wx:if="{{paneTitle}}" class="cd-pane-head">
            <view class="cd-pane-title">{{paneTitle}}</view>
            <view class="cd-pane-sub">{{paneTotal}} 条</view>
          </view>
          <view wx:if="{{!paneRows.length}}" class="cd-empty slim">此时间暂无记录</view>
          <view wx:for="{{paneRows}}" wx:key="id" wx:for-item="child" class="cd-rec-card">
            <view class="cd-rec-main" data-index="{{child.childIndex}}" catchtap="onChildDetail">
              <view class="cd-rec-top">
                <text class="cd-rec-cat">{{child.titleText}}</text>
                <text class="{{child.readStatusClass}}">{{child.readStatusText}}</text>
                <text class="cd-rec-score">{{child.scoreText}}</text>
              </view>
              <view class="cd-rec-meta">{{child.metaText}}</view>
              <view wx:if="{{child.fileCountText}}" class="cd-rec-fileline">
                <image wx:if="{{child.coverFile && apiBase && dlToken}}" class="cd-rec-thumb" src="{{thumb.thumbSrc(child.coverFile, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" />
                <text class="cd-rec-filecount">{{child.fileCountText}}</text>
              </view>
            </view>
            <view class="cd-rec-more" data-index="{{child.childIndex}}" catchtap="onChildMore">···</view>
          </view>
          <view wx:if="{{hasMore}}" class="cd-load-more" bindtap="loadMore">加载更多（{{paneRows.length}}/{{paneTotal}}）</view>
          <view wx:elif="{{paneRows.length}}" class="cd-load-end">— 已显示全部 —</view>
          <view class="cd-bottom-space"></view>
        </scroll-view>
      </view>
    </block>

    <block wx:else>
      <!-- 照片墙(保留): 分类锚点 + 分组缩略图, 点图预览/长按下载 -->
      <scroll-view scroll-y class="cd-wall-body" scroll-into-view="{{scrollAnchor}}" scroll-with-animation>
        <view wx:if="{{record.showFiles}}" class="card cd-anchor-card">
          <scroll-view scroll-x class="cd-anchor-scroll" enable-flex>
            <view class="cd-anchor-row">
              <view wx:for="{{record.fileGroupsView}}" wx:key="groupIndex" wx:for-item="group" wx:for-index="anchorIdx" class="cd-anchor-chip" data-idx="{{anchorIdx}}" bindtap="scrollToGroup">{{group.slotText}}</view>
            </view>
          </scroll-view>
        </view>
        <view wx:if="{{record.showFiles}}" class="card">
          <view wx:for="{{record.fileGroupsView}}" wx:for-item="group" wx:for-index="wallGroupIdx" wx:key="groupIndex" class="record-file-group" id="cd-group-{{wallGroupIdx}}">
            <view class="record-file-group-head"><text>{{group.label}}</text><text>{{group.countText}}</text></view>
            <view class="wall-grid">
              <view wx:for="{{group.files}}" wx:for-item="file" wx:for-index="wallFileIdx" wx:key="id" class="wall-tile" catchtap="onTileTap" catchlongpress="onTileLongPress" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">
                <image wx:if="{{file.type === 'image' && file.id && apiBase && dlToken}}" class="wall-thumb" src="{{thumb.thumbSrc(file, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" />
                <view wx:elif="{{file.type === 'video'}}" class="wall-video-face">
                  <view class="wall-play-icon">▶</view>
                  <text class="wall-face-name">{{file.name}}</text>
                </view>
                <view wx:else class="wall-doc-face">
                  <text class="wall-doc-type">{{file.typeText}}</text>
                  <text class="wall-face-name">{{file.name}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{!record.showFiles}}" class="cd-empty slim">暂无附件凭证</view>
        <video wx:if="{{previewVideoPath}}" src="{{previewVideoPath}}" controls class="cd-video"></video>
        <view class="cd-bottom-space"></view>
      </scroll-view>
    </block>

    <!-- 吸底操作栏(原红圈④收敛为两个: 追加激励/客户档案) -->
    <view class="cd-bottom-bar">
      <view wx:if="{{record.showAppendAction}}" class="cd-bottom-btn primary" bindtap="onAppend">＋ 追加激励</view>
      <view wx:if="{{record.showCustomerAction}}" class="cd-bottom-btn ghost" bindtap="onOpenCustomer">客户档案</view>
    </view>
  </block>
</view>
