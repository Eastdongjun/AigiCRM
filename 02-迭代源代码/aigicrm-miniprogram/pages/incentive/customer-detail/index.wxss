/* 【需求C 2026-10-16】客户激励详情页: 延续全局设计语言(蓝渐变 hero/白卡/chip/三色语义)。
   照片墙样式自 incentive/index.wxss 拷贝必需子集(wall-* 为页级样式不跨页生效)。 */
.cd-page { background: #f4f8ff; min-height: 100vh; padding: 24rpx 28rpx 0; box-sizing: border-box; color: #1c2b3a; }
.cd-empty { padding: 80rpx 0; text-align: center; color: #94a3b8; font-size: 26rpx; }
.cd-empty.slim { padding: 24rpx 0; }

.cd-hero { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; background: linear-gradient(135deg, #2348bf, #4285f4); color: #fff; border-radius: 24rpx; padding: 30rpx 28rpx; box-shadow: 0 14rpx 32rpx #b8cdf8; }
.cd-name { font-size: 36rpx; font-weight: 900; line-height: 1.35; }
.cd-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.cd-chip { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .18); border: 1rpx solid rgba(255, 255, 255, .35); color: #fff; }
.cd-chip.blue { background: rgba(255, 255, 255, .92); color: #1d4fd7; border-color: transparent; }
.cd-statline { margin-top: 12rpx; font-size: 22rpx; color: rgba(255, 255, 255, .85); }
.cd-score { flex-shrink: 0; display: flex; align-items: baseline; gap: 4rpx; background: rgba(255, 255, 255, .16); border: 1rpx solid rgba(255, 255, 255, .35); border-radius: 20rpx; padding: 14rpx 22rpx; }
.cd-score-num { font-size: 44rpx; font-weight: 900; line-height: 1; }
.cd-score-unit { font-size: 20rpx; opacity: .85; }

.card { background: #fff; border-radius: 22rpx; padding: 22rpx; margin-top: 20rpx; box-shadow: 0 8rpx 22rpx rgba(48, 78, 112, .05); }

.cd-anchor-card { padding: 16rpx 22rpx; }
.cd-anchor-scroll { white-space: nowrap; }
.cd-anchor-row { display: flex; gap: 12rpx; }
.cd-anchor-chip { flex-shrink: 0; font-size: 22rpx; font-weight: 700; color: #1d4fd7; background: #eef4ff; border: 1rpx solid #d3e2fb; padding: 10rpx 20rpx; border-radius: 999rpx; }
.cd-anchor-chip:active { background: #dceaff; }

.cd-section-title { font-size: 27rpx; font-weight: 850; color: #172033; margin-bottom: 6rpx; }

/* 照片墙必需子集(与列表页同款) */
.record-file-group { margin-top: 14rpx; border: 1rpx solid #e6edf7; border-radius: 18rpx; overflow: hidden; background: #fbfdff; }
.record-file-group:first-child { margin-top: 0; }
.record-file-group-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 12rpx 16rpx; background: #f8fbff; border-bottom: 1rpx solid #edf3fa; color: #334155; font-size: 21rpx; font-weight: 850; }
.wall-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; padding: 12rpx; }
.wall-tile { position: relative; min-width: 0; }
.wall-thumb { width: 100%; height: 160rpx; border-radius: 14rpx; background: #eef3f9; display: block; }
.wall-video-face, .wall-doc-face { width: 100%; aspect-ratio: 3/2; border-radius: 14rpx; box-sizing: border-box; padding: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; overflow: hidden; }
.wall-video-face { background: linear-gradient(135deg, #16213e, #2d2d44); color: #fff; }
.wall-doc-face { background: #f2f4f8; }
.wall-play-icon { width: 60rpx; height: 60rpx; border-radius: 50%; background: rgba(255, 255, 255, .2); display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.wall-doc-type { font-size: 20rpx; font-weight: 800; color: #1d4fd7; background: #e8f1ff; border-radius: 999rpx; padding: 4rpx 16rpx; }
.wall-face-name { max-width: 100%; font-size: 20rpx; color: #646a73; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wall-video-face .wall-face-name { color: rgba(255, 255, 255, .85); }

/* 历史记录行 */
.cd-child-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 4rpx; border-bottom: 1rpx solid #f1f5fa; }
.cd-child-row:last-child { border-bottom: 0; }
.cd-child-main { flex: 1; min-width: 0; }
.cd-child-title { display: flex; align-items: center; gap: 10rpx; }
.cd-child-cat { font-size: 25rpx; font-weight: 750; color: #1c2b3a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cd-child-meta { margin-top: 6rpx; font-size: 20rpx; color: #94a3b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cd-child-side { flex-shrink: 0; display: flex; align-items: center; gap: 14rpx; }
.cd-child-score { font-size: 22rpx; font-weight: 800; color: #1d4fd7; }
.cd-child-more { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #f1f5fb; color: #64748b; font-size: 28rpx; font-weight: 700; letter-spacing: 2rpx; }
.cd-child-more:active { background: #e2e9f5; }

/* 吸底操作栏(原红圈④收敛为两个) */
.cd-bottom-space { height: calc(130rpx + env(safe-area-inset-bottom)); }
.cd-bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; gap: 16rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .96); box-shadow: 0 -8rpx 28rpx rgba(30, 60, 114, .08); }
.cd-bottom-btn { flex: 1; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 22rpx; font-size: 27rpx; font-weight: 750; }
.cd-bottom-btn.primary { background: linear-gradient(135deg, #2348bf, #4285f4); color: #fff; }
.cd-bottom-btn.ghost { background: #fff; color: #1d4fd7; border: 1rpx solid #bfd4f5; }
.cd-bottom-btn:active { opacity: .82; }
.cd-video { width: 100%; height: 380rpx; margin-top: 18rpx; border-radius: 20rpx; overflow: hidden; background: #0f172a; }

/* 读态徽章(与列表页同款语义) */
.tag-unread { font-size: 19rpx; font-weight: 700; color: #b45309; background: #fef3c7; padding: 2rpx 12rpx; border-radius: 999rpx; }
.tag-read { font-size: 19rpx; font-weight: 600; color: #94a3b8; background: #f1f5f9; padding: 2rpx 12rpx; border-radius: 999rpx; }
.inline-read-status { flex-shrink: 0; }
