.incentive-search-card{margin-bottom:18rpx;padding:18rpx}
.incentive-search-row{display:flex;align-items:center;gap:10rpx}
.incentive-search-input{flex:1;min-width:0;height:58rpx;padding:0 18rpx;border:1rpx solid #dbe7f5;border-radius:16rpx;background:#f8fbff;color:#172033;font-size:24rpx}
.incentive-advanced-filters{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}
.filter-chip{height:50rpx;line-height:50rpx;padding:0 16rpx;border:1rpx solid #d9e2ec;border-radius:999rpx;background:#fff;color:#475569;font-size:22rpx;font-weight:750}
.slot-row{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}
.slot-pill{padding:6rpx 14rpx;border-radius:999rpx;background:#eef5ff;color:#2563eb;font-size:22rpx;font-weight:700}
.record-file-list{margin-top:14rpx;border:1rpx solid #e6edf7;border-radius:18rpx;overflow:hidden;background:#fbfdff}
.record-file-list.compact{margin-top:12rpx;border-radius:16rpx}
.record-file-list.grouped{border:0;border-radius:0;overflow:visible;background:transparent}
.record-file-group{margin-top:12rpx;border:1rpx solid #e6edf7;border-radius:18rpx;overflow:hidden;background:#fbfdff}
.record-file-group:first-child{margin-top:0}
.record-file-group-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:12rpx 16rpx;background:#f8fbff;border-bottom:1rpx solid #edf3fa;color:#334155;font-size:21rpx;font-weight:850}
.record-file-row{display:flex;align-items:center;gap:12rpx;padding:14rpx;border-top:1rpx solid #edf3fa}
.record-file-group-head+.record-file-row,.record-file-row:first-child{border-top:0}
.record-file-icon{width:58rpx;height:58rpx;border-radius:16rpx;background:#eef2f7;color:#64748b;font-size:20rpx;font-weight:850;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.record-file-icon.image{background:#eff6ff;color:#2563eb}
.record-file-icon.video{background:#fef3c7;color:#b45309}
.record-file-icon.document{background:#ecfdf5;color:#047857}
.record-file-main{flex:1;min-width:0}
.record-file-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#172033;font-size:24rpx;font-weight:800}
.record-file-meta{margin-top:4rpx;color:#7c8ba1;font-size:21rpx}
.record-file-actions{display:flex;align-items:center;gap:8rpx;flex-shrink:0}
.mini-action{height:48rpx;line-height:46rpx;margin:0;padding:0 14rpx;border:1rpx solid #bfdbfe;border-radius:999rpx;background:#eff6ff;color:#2563eb;font-size:21rpx}
.mini-action::after{border:0}
.mini-action.secondary{border-color:#d9e2ec;background:#fff;color:#475569}
.mini-action.danger{border-color:#fecaca;background:#fff5f5;color:#dc2626}
.record-file-video{width:100%;height:360rpx;margin-top:18rpx;border-radius:20rpx;overflow:hidden;background:#0f172a}
.customer-record-list{margin-top:18rpx;border:1rpx solid #e6edf7;border-radius:20rpx;overflow:hidden;background:#f8fbff}
.customer-record-row{padding:18rpx;border-top:1rpx solid #e8eef7}
.customer-record-row:first-child{border-top:0}
.customer-record-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.customer-record-title{color:#172033;font-size:25rpx;font-weight:850}
.customer-record-meta{margin-top:6rpx;color:#7c8ba1;font-size:21rpx;line-height:1.4}
.customer-record-summary{margin-top:12rpx;color:#52657f;font-size:23rpx;line-height:1.55}
.customer-record-actions{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;margin-top:14rpx}
.stats-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-top:1rpx solid #eef3f9;font-size:26rpx;color:#172033}
.stats-row:first-of-type{border-top:0}
.stats-row text:last-child{color:#7c8ba1;font-size:24rpx;text-align:right}

/* 分类树 2026-10-20 重设计：全部分类入口 + 父级卡片 + 子级缩进连接线 + 徽章/选中态 */
.category-panel{padding:26rpx 22rpx 22rpx}
.category-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;padding:0 4rpx 16rpx}
.category-title{color:#172033;font-size:27rpx;font-weight:800;letter-spacing:.5rpx}
.category-sub{margin-top:6rpx;color:#94a3b8;font-size:19rpx}
.category-count{flex-shrink:0;color:#94a3b8;font-size:19rpx}
.category-all{display:flex;align-items:center;gap:14rpx;padding:16rpx 18rpx;border:1rpx solid #e7effa;border-radius:16rpx;background:#f8fbff}
.category-all.is-active{border-color:#cddffb;background:#eef4ff}
.category-all-hover{opacity:.78}
.category-all-icon{width:48rpx;height:48rpx;flex-shrink:0;border-radius:14rpx;background:#1d4ed8;color:#fff;font-size:21rpx;font-weight:700;display:flex;align-items:center;justify-content:center}
.category-all-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}
.category-all-main text:first-child{color:#172033;font-size:24rpx;font-weight:700}
.category-all-main text:last-child{color:#94a3b8;font-size:18rpx}
.category-all.is-active .category-all-main text:first-child{color:#1d4ed8}
.category-tree{margin-top:10rpx}
.category-node{position:relative;display:flex;align-items:center;gap:14rpx;padding:15rpx 18rpx;border-radius:14rpx}
.category-node.level-0{margin-top:14rpx;border:1rpx solid #e7effa;background:#f8fbff}
.category-node.level-1{padding-left:46rpx}
.category-node.level-2{padding-left:78rpx}
.category-node.level-3{padding-left:110rpx}
.category-node.level-1::before,
.category-node.level-2::before,
.category-node.level-3::before{content:'';position:absolute;top:0;bottom:0;width:1rpx;background:#e3ebf7}
.category-node.level-1::before{left:25rpx}
.category-node.level-2::before{left:57rpx}
.category-node.level-3::before{left:89rpx}
.category-node-hover{opacity:.78}
.category-node-dot{position:relative;z-index:1;width:8rpx;height:8rpx;flex-shrink:0;border-radius:50%;background:#c6d4e6}
.category-node.level-0 .category-node-dot{width:12rpx;height:12rpx;background:#1d4ed8}
.category-node-main{flex:1;min-width:0;display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.category-node-name{color:#334155;font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.category-node.level-0 .category-node-name{color:#172033;font-size:26rpx;font-weight:700}
.category-node-meta{display:flex;align-items:center;gap:8rpx;flex-shrink:0}
.category-chip{padding:4rpx 10rpx;border-radius:999rpx;background:#f1f5f9;color:#64748b;font-size:17rpx}
.category-chip.score{background:#eef4ff;color:#1d4ed8}
.category-node.is-active{background:#eef4ff}
.category-node.is-active::after{content:'';position:absolute;left:0;top:12rpx;bottom:12rpx;width:4rpx;border-radius:999rpx;background:#1d4ed8}
.category-node.is-active .category-node-name{color:#1d4ed8;font-weight:750}
.category-active-tag{flex-shrink:0;padding:4rpx 10rpx;border-radius:999rpx;background:#1d4ed8;color:#fff;font-size:16rpx}
.category-chevron{flex-shrink:0;color:#b6c5da;font-size:26rpx}
.stat-drill-row{align-items:flex-start}
.stat-name{color:#172033;font-size:26rpx;font-weight:800}
.stat-parent{margin-top:6rpx;color:#7c8ba1;font-size:21rpx}
.stat-value{color:#2563eb;font-size:24rpx;font-weight:800;text-align:right;white-space:nowrap}
/* 【2026-11-05 层级化】一级分组头: 组名+聚合文件数; 二级行沿用 stats-row 明细行 */
.stat-group-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0 10rpx;margin-top:10rpx;border-top:1rpx solid #eef3f9}
.stat-group-head:first-of-type{border-top:0;margin-top:0}
.stat-group-name{color:#172033;font-size:24rpx;font-weight:800}
.stat-group-value{color:#7c8ba1;font-size:22rpx;font-weight:600;white-space:nowrap}
.stats-detail-panel{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #e7eef8}
/* 2026-10-20 统计明细改为底部抽屉：不再把明细插在统计列表下方，避免上下来回滚动 */
.stats-detail-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:60;display:flex;align-items:flex-end;background:rgba(15,23,42,.42)}
.stats-detail-sheet{width:100%;height:82vh;max-height:82vh;box-sizing:border-box;display:flex;flex-direction:column;padding:18rpx 28rpx calc(110rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;background:#fff}
.stats-sheet-handle{width:64rpx;height:6rpx;margin:0 auto 18rpx;flex-shrink:0;border-radius:999rpx;background:#d5e0ef}
.stats-detail-sheet-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;flex-shrink:0}
.stats-detail-sheet-title{color:#172033;font-size:30rpx;font-weight:800}
.stats-detail-sheet-head .mini-action{flex-shrink:0;margin-top:2rpx}
.stats-detail-scroll{flex:1;min-height:0;margin-top:6rpx}
.stats-detail-panel .section-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.stats-detail-panel .section-row .mini-action{flex-shrink:0;margin-top:2rpx}
.stats-detail-meta{margin-top:6rpx;color:#7c8ba1;font-size:22rpx}
.stats-detail-search{display:flex;align-items:center;gap:10rpx;height:70rpx;margin-top:14rpx;padding:0 18rpx;border:1rpx solid #dfe9f6;border-radius:16rpx;background:#f8fbff}
.stats-detail-search-icon{color:#8aa0bd;font-size:28rpx}
.stats-detail-search input{flex:1;min-width:0;color:#172033;font-size:24rpx}
.stats-detail-clear{flex-shrink:0;color:#2563eb;font-size:21rpx}
.stats-detail-card{padding:18rpx 0;border-top:1rpx solid #eef3f9}
.stats-detail-card:first-of-type{border-top:0}
.stats-detail-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.stats-detail-customer{color:#172033;font-size:25rpx;font-weight:850}
.stats-detail-sub{margin-top:6rpx;color:#7c8ba1;font-size:21rpx;line-height:1.4}
.stats-detail-remark{margin-top:12rpx;color:#52657f;font-size:23rpx;line-height:1.55}
.ranking-panel{margin-bottom:18rpx}
.read-period-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:0 0 18rpx;padding:18rpx 22rpx;border:1rpx solid #e6edf7;border-radius:20rpx;background:#fff;color:#334155;font-size:24rpx;font-weight:800}
.score-row{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-top:1rpx solid #eef3f9}
.score-row:first-of-type{border-top:0}
.score-rank{width:48rpx;height:48rpx;border-radius:16rpx;background:#eff6ff;color:#2563eb;font-size:24rpx;font-weight:850;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.score-rank.dept{background:#ecfdf5;color:#059669}
.score-main{flex:1;min-width:0}
.score-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#172033;font-size:26rpx;font-weight:800}
.score-meta{margin-top:6rpx;color:#7c8ba1;font-size:22rpx}
.score-value{color:#172033;font-size:26rpx;font-weight:850;white-space:nowrap}

/* ===== 【2026-11-02 用户令·PC 同款排行】个人/部门排行表格化 =====
   与 PC PersonRankTableView 同构: 排名列(前3奖牌徽章🥇🥈🥉渐变底, 其余数字)+
   首字头像(前3彩色渐变/其余蓝)+姓名粗体/办事处灰小字+激励总额胶囊(蓝底白字)+合计列
   【二次令追加】四大类+子类列(条数+分), 整表横向滚动 */
/* 旧整表滚动形态样式已随真冻结双栏布局退役, 统一见下方 rank-split 段 */
/* ===== 【2026-11-02 用户令·真冻结】双栏布局 =====
   左栏(冻结)=排名+姓名, 是 scroll-view 的兄弟节点不在其内, 滚动时物理不动;
   右栏=激励总额/合计/子类矩阵在 scroll-view 内横滚; 两栏行高固定值像素级对齐:
   表头行 48rpx + 子类头行 36rpx + 数据行 76rpx(每行 border-bottom 1rpx 计入) */
.rank-split { display: flex; margin-top: 12rpx; border: 1rpx solid #e3ebf7; border-radius: 10rpx; overflow: hidden; }
.rank-frozen { flex: none; width: 158rpx; background: #fff; z-index: 2; }
.fz-head { display: flex; align-items: center; height: 48rpx; padding: 0 6rpx; background: #eef4ff; box-sizing: border-box; }
.fz-th { flex: none; font-size: 20rpx; color: #33507e; font-weight: 700; }
.fz-th:first-child { width: 48rpx; text-align: center; }
.fz-th-name { width: 96rpx; }
.fz-subhead { height: 36rpx; background: #f7fafd; border-bottom: 1rpx solid #e3ebf7; }
.fz-row { display: flex; align-items: center; height: 76rpx; border-bottom: 1rpx solid #eef2f8; box-sizing: border-box; }
.fz-row:last-of-type { border-bottom: 0; }
.fz-rank { flex: none; width: 48rpx; display: flex; justify-content: center; }
.fz-name { flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
.rank-medal-sm { display: inline-flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 50%; font-size: 22rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.1); }
/* 右栏滚动表: 行高与冻结栏逐行对齐(48/36/76) */
.rank-tbl-scroll { flex: 1; min-width: 0; }
.rank-tbl { display: inline-block; min-width: 100%; }
.rank-table-head { display: flex; align-items: center; height: 48rpx; padding: 0 8rpx; background: #eef4ff; box-sizing: border-box; }
.rth { flex: none; font-size: 20rpx; color: #33507e; font-weight: 700; }
.rth-score { width: 130rpx; text-align: center; }
.rth-total { width: 90rpx; text-align: right; padding-right: 8rpx; }
.rth-group-title { font-size: 20rpx; text-align: center; color: #2563eb; padding: 0 4rpx; white-space: nowrap; overflow: hidden; }
.rank-subhead { display: flex; align-items: center; height: 36rpx; padding: 0 8rpx; background: #f7fafd; border-bottom: 1rpx solid #e3ebf7; box-sizing: border-box; }
.rsh { flex: none; font-size: 19rpx; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rth-sub { width: 130rpx; text-align: center; }
.rank-table-row { display: flex; align-items: center; height: 76rpx; padding: 0 8rpx; border-bottom: 1rpx solid #eef2f8; background: #fff; box-sizing: border-box; }
.rank-table-row:last-of-type { border-bottom: 0; }
.rtd { flex: none; }
.rtd-score { width: 130rpx; display: flex; justify-content: center; }
.rtd-total { width: 90rpx; text-align: right; padding-right: 8rpx; color: #64748b; font-size: 21rpx; }
.rtd-cat { width: 130rpx; display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.cat-cnt { font-size: 19rpx; color: #64748b; line-height: 1.3; }
.cat-score { font-size: 20rpx; color: #1d4fd7; font-weight: 700; line-height: 1.3; }
.cat-score.zero { color: #94a3b8; font-weight: 400; }
.cat-dash { font-size: 19rpx; color: #cbd5e1; }
.rtd-score { width: 130rpx; display: flex; justify-content: center; }
.rtd-total { width: 90rpx; text-align: right; padding-right: 8rpx; color: #64748b; font-size: 21rpx; }
.rtd-cat { width: 130rpx; display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.cat-cnt { font-size: 19rpx; color: #64748b; line-height: 1.3; }
.cat-score { font-size: 20rpx; color: #1d4fd7; font-weight: 700; line-height: 1.3; }
.cat-score.zero { color: #94a3b8; font-weight: 400; }
.cat-dash { font-size: 19rpx; color: #cbd5e1; }
.rtd-score { width: 130rpx; display: flex; justify-content: center; }
.rtd-total { width: 90rpx; text-align: right; padding-right: 8rpx; color: #64748b; font-size: 21rpx; }
/* 前三奖牌徽章 */
.rank-medal { display: inline-flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; font-size: 26rpx; box-shadow: 0 3rpx 8rpx rgba(0,0,0,.12); }
.rank-medal-1 { background: linear-gradient(135deg, #fbbf24, #f59e0b); }
.rank-medal-2 { background: linear-gradient(135deg, #e2e8f0, #cbd5e1); }
.rank-medal-3 { background: linear-gradient(135deg, #fcd7b6, #d97706); }
.rank-num { color: #64748b; font-weight: 600; font-size: 24rpx; }
/* 首字头像 */
.name-wrap { display: flex; align-items: center; gap: 12rpx; }
.name-avatar { width: 44rpx; height: 44rpx; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 21rpx; font-weight: 700; color: #fff; flex-shrink: 0; }
.av-1 { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.av-2 { background: linear-gradient(135deg, #94a3b8, #cbd5e1); }
.av-3 { background: linear-gradient(135deg, #d97706, #fcd7b6); }
.av-4 { background: linear-gradient(135deg, #2563eb, #3b82f6); }
.name-col { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.name-top { color: #1f2329; font-size: 22rpx; font-weight: 850; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.name-cell { color: #172033; font-size: 22rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.name-office { color: #7c8ba1; font-size: 17rpx; margin-top: 1rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 96rpx; }
.dept-name { font-weight: 700; }
/* 激励总额/总学分胶囊 */
.score-pill { display: inline-flex; align-items: baseline; gap: 2rpx; background: #2563eb; color: #fff; border-radius: 999rpx; padding: 6rpx 16rpx; font-size: 24rpx; font-weight: 800; }
.score-pill.dept-pill { background: #059669; }
.pill-unit { font-size: 18rpx; opacity: .85; font-weight: 400; }

/* 「更新」重设计: 圆形图标按钮(与统计分析页同款) */
.stats-refresh-btn { width: 56rpx; height: 56rpx; min-width: 0; margin: 0; padding: 0; border-radius: 50%;
  border: 1rpx solid #cfe0f7; background: #f5f9ff; color: #1d4ed8; font-size: 30rpx; line-height: 54rpx;
  display: flex; align-items: center; justify-content: center; }
.stats-refresh-btn::after { border: none; }

/* 【2026-11-03 用户令"参考应用中心顶部边框"】hero 两行大卡压成单行细条:
   应用中心 ap-hero/轻量页 hm-bar 同款深蓝渐变+26rpx 圆角, 左标题+右小胶囊按钮;
   原 upload-entry-row/btn/hint 样式随两行结构一并退役(wxml 零引用) */
.workbench-hero {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; border-radius: 26rpx;
  background: linear-gradient(135deg, #0d1733 0%, #16337a 58%, #1d4ed8 100%);
  box-shadow: 0 18rpx 38rpx rgba(13, 23, 51, .22);
}
.workbench-hero-title { font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx; color: #fff; }
.workbench-hero-actions { display: flex; align-items: center; gap: 14rpx; }
.hero-bar-btn { margin: 0; padding: 0 22rpx; height: 52rpx; line-height: 52rpx; font-size: 22rpx; border-radius: 999rpx; border: none; }
.hero-bar-btn::after { border: none; }
.hero-bar-btn.ghost { background: rgba(255, 255, 255, .16); color: #fff; border: 1rpx solid rgba(255, 255, 255, .55); }
.hero-bar-btn.solid { background: #fff; color: #1d4ed8; font-weight: 700; }

/* 【#4+#7 2026-10-12】佐证照片墙: 图片缩略图/视频封面/文档面卡统一瓦片, 行内底边严格对齐
   【M3 修复 2026-10-19】视频/文档面卡弃 aspect-ratio 改与图片同高 160rpx——
   瓦片宽随屏变, aspect 3/2 的高度永远追不上固定 160rpx, 行内底边恒错齐 */
.wall-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.wall-tile { position: relative; min-width: 0; }
.wall-thumb { width: 100%; height: 160rpx; border-radius: 14rpx; background: #eef3f9; display: block; }
.wall-video-face, .wall-doc-face { width: 100%; height: 160rpx; border-radius: 14rpx; box-sizing: border-box; padding: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; overflow: hidden; }
.wall-video-face { background: linear-gradient(135deg, #16213e, #2d2d44); color: #fff; }
.wall-doc-face { background: #f2f4f8; }
.wall-play-icon { width: 60rpx; height: 60rpx; border-radius: 50%; background: rgba(255, 255, 255, .2);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.wall-doc-type { font-size: 20rpx; font-weight: 800; color: #1d4fd7; background: #e8f1ff; border-radius: 999rpx; padding: 4rpx 16rpx; }
.wall-face-name { max-width: 100%; font-size: 20rpx; color: #646a73; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wall-video-face .wall-face-name { color: rgba(255, 255, 255, .85); }
.wall-tag { position: absolute; top: 8rpx; left: 8rpx; z-index: 2; font-size: 18rpx; font-weight: 600;
  background: rgba(255, 255, 255, .94); padding: 2rpx 10rpx; border-radius: 999rpx; border: 1rpx solid transparent; }
.wall-acts { position: absolute; right: 8rpx; bottom: 8rpx; z-index: 2; display: flex; gap: 6rpx; }
.wall-act-btn { width: 84rpx; height: 44rpx; padding: 0; border-radius: 10rpx; background: rgba(23, 32, 51, .78); color: #fff;
  font-size: 18rpx; font-weight: 700; line-height: 44rpx; display: flex; align-items: center; justify-content: center; }
.wall-act-btn.secondary { background: rgba(255, 255, 255, .9); color: #1f3f7a; }
.wall-act-btn::after { border: none; }
.record-file-wall.compact .wall-grid { grid-template-columns: repeat(3, 1fr); gap: 10rpx; }

/* 【需求C 2026-10-16】客户封面卡: 列表页一客户一卡(封面/名称/行业·大类/学分/未读点),
   整卡点入 customer-detail 详情页;替代原"一卡近一屏"的巨卡 */
/* 【2026-11-02 共享标注】完整版查询区已翻案为下方横向表格(本页不再用封面卡),
   但轻量页(home)「按客户」模式经 @import 本文件复用封面卡全套样式——保留, 勿删 */
.cust-card { position: relative; display: flex; align-items: center; gap: 18rpx; background: #fff; border-radius: 22rpx; padding: 20rpx; margin-top: 16rpx; box-shadow: 0 8rpx 22rpx rgba(48, 78, 112, .05); }
.cust-card:active { background: #f8fbff; }
.cust-cover { position: relative; flex-shrink: 0; width: 128rpx; height: 128rpx; border-radius: 18rpx; overflow: hidden; background: linear-gradient(150deg, #0d1733, #13255e 58%, #1d4ed8); }
.cust-cover-img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.cust-cover-fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #dbe6ff; font-size: 52rpx; font-weight: 900; letter-spacing: 2rpx; }
.cust-cover-badge { position: absolute; left: 8rpx; bottom: 8rpx; z-index: 2; background: rgba(236, 229, 214, .92); color: #13255e; border-radius: 999rpx; padding: 2rpx 10rpx; font-size: 16rpx; font-weight: 800; line-height: 1.5; }
.cust-body { flex: 1; min-width: 0; }
.cust-name-row { display: flex; align-items: flex-start; gap: 8rpx; }
.cust-unread-dot { flex-shrink: 0; width: 12rpx; height: 12rpx; margin-top: 12rpx; border-radius: 50%; background: #e05252; box-shadow: 0 0 0 4rpx rgba(224, 82, 82, .12); }
.cust-name { flex: 1; min-width: 0; color: #172033; font-size: 27rpx; font-weight: 850; line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.cust-meta { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.cust-pill { font-size: 19rpx; padding: 3rpx 14rpx; border-radius: 999rpx; background: #f1f5f9; color: #64748b; }
.cust-pill.blue { background: #eef4ff; color: #1d4fd7; }
.cust-nums { margin-top: 8rpx; font-size: 20rpx; color: #94a3b8; }
.cust-score { flex-shrink: 0; display: flex; align-items: baseline; gap: 4rpx; background: #f4f8ff; border: 1rpx solid #dce8fb; border-radius: 16rpx; padding: 10rpx 16rpx; }
.cust-score-num { font-size: 32rpx; font-weight: 900; color: #1d4fd7; line-height: 1; }
.cust-score-unit { font-size: 18rpx; color: #7d9bd8; }
.cust-arrow { flex-shrink: 0; color: #b6c5da; font-size: 34rpx; font-weight: 700; }

/* ===== 【2026-11-02 用户令·PC 同构表格】完整版查询区横向表格 =====
   每行一条记录, 列=客户/分类/产品/时间/上传人/文件/学分, 横滚看全部列, 点行直达记录详情 */
.rec-table-scroll { width: 100%; margin-top: 14rpx; }
.rec-table { display: inline-block; min-width: 100%; border-radius: 14rpx; overflow: hidden; border: 1rpx solid #e3ebf7; background: #fff; }
.rec-tr { display: flex; align-items: stretch; }
.rec-th { background: #eef4ff; }
.rec-th .rec-td { color: #33507e; font-weight: 700; font-size: 21rpx; }
.rec-tr + .rec-tr { border-top: 1rpx solid #eef2f8; }
.rec-tr:not(.rec-th):active { background: #f7faff; }
.rec-td { flex: none; display: flex; align-items: center; padding: 14rpx 12rpx; font-size: 21rpx; color: #2b3a52; line-height: 1.45; box-sizing: border-box; }
.c-cust { width: 210rpx; font-weight: 600; }
.c-cat { width: 150rpx; }
.c-prod { width: 190rpx; }
.c-date { width: 175rpx; color: #64748b; }
.c-user { width: 120rpx; }
.c-file { width: 80rpx; justify-content: flex-end; }
.c-score { width: 90rpx; justify-content: flex-end; color: #1d4fd7; font-weight: 800; }
.incentive-pager { margin-top:  18rpx; }

/* ===== 【2026-11-02】部门排行窄表(无需冻结/横滚) ===== */
.dept-tbl-head { display: flex; align-items: center; height: 48rpx; padding: 0 8rpx; background: #eef4ff; border: 1rpx solid #e3ebf7; border-bottom: 0; border-radius: 10rpx 10rpx 0 0; box-sizing: border-box; }
.dth { flex: none; font-size: 20rpx; color: #33507e; font-weight: 700; }
.dth-rank { width: 56rpx; text-align: center; }
.dth-name { flex: 1; min-width: 0; }
.dth-score { width: 130rpx; text-align: center; }
.dth-total { width: 90rpx; text-align: right; padding-right: 8rpx; }
.dept-tbl-row { display: flex; align-items: center; height: 64rpx; padding: 0 8rpx; background: #fff; border: 1rpx solid #e3ebf7; border-top: 0; box-sizing: border-box; }
.dept-tbl-row:last-of-type { border-radius: 0 0 10rpx 10rpx; }
.dtd { flex: none; }
.dtd-rank { width: 56rpx; display: flex; justify-content: center; }
.dtd-name { flex: 1; min-width: 0; overflow: hidden; }
.dtd-score { width: 130rpx; display: flex; justify-content: center; }
.dtd-total { width: 90rpx; text-align: right; padding-right: 8rpx; color: #64748b; font-size: 21rpx; }

/* ===== 【2026-11-02 用户令】表格细线增强辨识 =====
   纵向列分隔线: 滚动区每个数据格/表头格右缘加竖细线; 冻结栏与滚动区之间加粗分界;
   横向行线加色调深一档; 斑马纹隔行浅底, 行列交叉更易读 */
/* 纵线: 滚动区单元格(激励总额/合计/子类格) */
.rtd-score, .rtd-total, .rtd-cat { border-right: 1rpx solid #edf1f7; }
.rtd-cat:last-child { border-right: 0; }
/* 表头/子类头同样加纵线与数据列对齐 */
.rth-score, .rth-total, .rth-group-title { border-right: 1rpx solid #dde7f3; }
.rsh.rth-score, .rsh.rth-total, .rsh.rth-sub { border-right: 1rpx solid #edf1f7; }
/* 横线加深 + 斑马纹 */
.rank-table-row { border-bottom: 1rpx solid #e4eaf3; }
.rank-table-row:nth-child(odd) { background: #fafcff; }
.fz-row { border-bottom: 1rpx solid #e4eaf3; }
.fz-row:nth-child(odd) { background: #fafcff; }
/* 冻结栏与滚动区交界竖线(加粗半档) */
.rank-frozen { border-right: 1rpx solid #d5e0ee; }
/* 部门排行窄表纵线+斑马纹 */
.dtd-rank, .dtd-name, .dtd-score { border-right: 1rpx solid #edf1f7; }
.dth-rank, .dth-name, .dth-score { border-right: 1rpx solid #dde7f3; }
.dept-tbl-row { border-bottom: 1rpx solid #e4eaf3; }
.dept-tbl-row:nth-child(odd) { background: #fafcff; }

/* ===== 【2026-11-03 用户令】排行 tab 内三页签(客户/个人/部门) =====
   复用 app.wxss .tabs/.tab 胶囊语言, 尺寸降半档以区分主 tab 层级; 切换纯显示不发请求 */
.rank-subtabs { margin: 0 0 16rpx; }
.rank-subtabs .tab { padding: 12rpx 0; font-size: 23rpx; border-radius: 18rpx; }
.rank-panel-actions { margin-bottom: 12rpx; }
