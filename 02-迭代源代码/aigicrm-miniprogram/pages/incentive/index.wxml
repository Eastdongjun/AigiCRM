<wxs src="./thumb.wxs" module="thumb" />
<view class="page incentive-workbench">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">四项服务应用</view>
        <view class="hero-sub">分类 · 上传 · 学分 · 统计 · 阅读</view>
      </view>
      <button class="ghost-btn" bindtap="refresh" loading="{{incentiveView.refreshLoading}}">{{incentiveView.refreshText}}</button>
    </view>
    <view wx:if="{{canUploadEvidence}}" class="upload-entry-row">
      <button class="upload-entry-btn" bindtap="goUpload">＋ 上传激励</button>
      <text class="upload-entry-hint">大类 → 子类 → 槽位佐证,与 PC 上传同口径</text>
    </view>
  </view>

  <!-- 【2026-10-21 用户令】隐藏客户/记录/文件/学分四块汇总卡(数据加载保留: 未读数等仍被
       下方统计区消费), 只移除展示层 -->
  <!--
  <view class="summary-grid">
    <view class="summary-cell"><text>{{summary.customers}}</text><text>客户</text></view>
    <view class="summary-cell"><text>{{summary.records}}</text><text>记录</text></view>
    <view class="summary-cell"><text>{{summary.files}}</text><text>文件</text></view>
    <view class="summary-cell"><text>{{summary.score}}</text><text>学分</text></view>
  </view>
  -->

  <view class="mobile-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="mobile-tab {{item.className}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <view wx:if="{{incentiveView.showRecords}}">
    <view class="card incentive-search-card">
      <view class="incentive-search-row">
        <input class="incentive-search-input" value="{{keyword}}" placeholder="搜索客户 / 产品 / 关键字" confirm-type="search" bindinput="inputKeyword" bindconfirm="searchRecords" />
        <button class="mini-action" bindtap="searchRecords" loading="{{incentiveView.searchLoading}}">{{incentiveView.searchText}}</button>
        <button class="mini-action secondary" bindtap="resetRecordFilters">清空</button>
      </view>
      <view class="incentive-advanced-filters">
        <picker mode="selector" range="{{industries}}" value="{{selectedIndustryIndex}}" bindchange="chooseIndustry">
          <view class="filter-chip">{{incentiveView.industryText}}</view>
        </picker>
        <picker mode="selector" range="{{devTypes}}" value="{{selectedDevTypeIndex}}" bindchange="chooseDevType">
          <view class="filter-chip">{{incentiveView.devTypeText}}</view>
        </picker>
        <picker mode="selector" range="{{productOptions}}" value="{{selectedProductIndex}}" bindchange="chooseProduct">
          <view class="filter-chip">{{incentiveView.productText}}</view>
        </picker>
        <picker mode="selector" range="{{orgOptions}}" range-key="label" value="{{selectedOrgIndex}}" bindchange="chooseOrg">
          <view class="filter-chip">{{incentiveView.orgText}}</view>
        </picker>
        <picker mode="date" value="{{startDate}}" bindchange="chooseStartDate">
          <view class="filter-chip">{{incentiveView.startDateText}}</view>
        </picker>
        <picker mode="date" value="{{endDate}}" bindchange="chooseEndDate">
          <view class="filter-chip">{{incentiveView.endDateText}}</view>
        </picker>
      </view>
    </view>
    <view class="incentive-filter-head">
      <view class="section-title no-margin">客户维度明细</view>
      <view class="incentive-filter-actions">
        <picker mode="selector" range="{{categories}}" bindchange="chooseCategory">
          <view class="ranking-tab active">{{category}}⌄</view>
        </picker>
        <picker mode="selector" range="{{userNames}}" value="{{selectedUserIndex}}" bindchange="chooseUser">
          <view class="ranking-tab">{{incentiveView.userText}}</view>
        </picker>
        <picker mode="selector" range="{{orderOptions}}" value="{{selectedOrderIndex}}" bindchange="chooseOrder">
          <view class="ranking-tab">{{incentiveView.orderText}}</view>
        </picker>
      </view>
    </view>
    <view wx:if="{{incentiveView.showLoading}}" class="card muted">{{incentiveView.loadingText}}</view>
    <!-- 【2026-11-02 用户令·PC 同构表格】查询区从客户封面卡改为横向表格: 每行一条记录,
         列=客户/分类/产品/时间/上传人/文件/学分, 横向滚动直接看全部列(与 PC 激励查询表格同构);
         点行直达记录详情(拨盘页)。原 10-16 需求B+C 封面卡形态退役 -->
    <scroll-view class="rec-table-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="rec-table">
        <view class="rec-tr rec-th">
          <view class="rec-td c-cust">客户</view>
          <view class="rec-td c-cat">分类</view>
          <view class="rec-td c-prod">产品</view>
          <view class="rec-td c-date">时间</view>
          <view class="rec-td c-user">上传人</view>
          <view class="rec-td c-file">文件</view>
          <view class="rec-td c-score">学分</view>
        </view>
        <view wx:for="{{pagedTableRows}}" wx:key="id" class="rec-tr" data-id="{{item.id}}" bindtap="openRecordDetail">
          <view class="rec-td c-cust">{{item.customerName}}</view>
          <view class="rec-td c-cat">{{item.categoryName}}</view>
          <view class="rec-td c-prod">{{item.productText || '—'}}</view>
          <view class="rec-td c-date">{{item.timeText}}</view>
          <view class="rec-td c-user">{{item.uploaderName || '—'}}</view>
          <view class="rec-td c-file">{{item.fileCount}}</view>
          <view class="rec-td c-score">{{item.score}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="incentive-pager">
      <pager wx:if="{{pagerTotal > 10}}" page="{{page}}" pageSize="{{pageSize}}" total="{{pagerTotal}}" loading="{{incentiveView.pagerLoading}}" bind:change="onPagerChange" />
    </view>
    <view wx:if="{{incentiveView.showRecordEmpty}}" class="card muted">暂无四项服务记录</view>
    <video wx:if="{{previewVideoPath}}" src="{{previewVideoPath}}" controls class="record-file-video"></video>
  </view>

  <view wx:if="{{incentiveView.showCategories}}" class="card category-panel">
    <view class="category-head">
      <view>
        <view class="category-title">分类树</view>
        <view class="category-sub">点击分类筛选记录，再次点击取消</view>
      </view>
      <view class="category-count">{{categoryTreeView.length}} 个分类</view>
    </view>
    <view class="category-all {{category === '全部' ? 'is-active' : ''}}" hover-class="category-all-hover" bindtap="onCategoryAllTap">
      <view class="category-all-icon">全</view>
      <view class="category-all-main"><text>全部分类</text><text>查看所有激励记录</text></view>
      <text wx:if="{{category === '全部'}}" class="category-active-tag">全部</text>
      <text wx:else class="category-chevron">›</text>
    </view>
    <view class="category-tree">
      <view wx:for="{{categoryTreeView}}" wx:key="id" class="category-node level-{{item.level}} {{item.name === category ? 'is-active' : ''}}" hover-class="category-node-hover" bindtap="onCategoryRowTap" data-index="{{index}}">
        <view class="category-node-dot"></view>
        <view class="category-node-main">
          <text class="category-node-name">{{item.name}}</text>
          <view class="category-node-meta">
            <text wx:if="{{item.score}}" class="category-chip score">{{item.score}} 分</text>
            <text class="category-chip">{{item.count}} 条</text>
          </view>
        </view>
        <text wx:if="{{item.name === category}}" class="category-active-tag">筛选中</text>
        <text wx:else class="category-chevron">›</text>
      </view>
    </view>
    <view wx:if="{{incentiveView.showCategoryEmpty}}" class="muted">暂无分类</view>
  </view>

  <view wx:if="{{incentiveView.showStats}}" class="card">
    <view class="section-title">分类统计</view>
    <view class="stats-row">
      <text>覆盖分类</text><text>{{summary.categories}}</text>
    </view>
    <view class="stats-row">
      <text>未读客户</text><text>{{summary.unread}}</text>
    </view>
    <view wx:for="{{categoryStatsPaged}}" wx:key="name" class="stats-row stat-drill-row" data-index="{{index}}" bindtap="openStatDetail">
      <view>
        <view class="stat-name">{{item.name}}</view>
        <view wx:if="{{item.parentName}}" class="stat-parent">{{item.parentName}}</view>
      </view>
      <view class="stat-value">{{item.count}} 文件 / {{item.score}} 分 ›</view>
    </view>
    <pager wx:if="{{categoryStatsTotal > 10}}" page="{{categoryStatsPage}}" pageSize="{{categoryStatsPageSize}}" total="{{categoryStatsTotal}}" loading="{{incentiveView.pagerLoading}}" bind:change="onCategoryStatsPagerChange" />
    <view wx:if="{{incentiveView.showCategoryStatsEmpty}}" class="muted">暂无统计</view>
    <view wx:if="{{statDetail.visible}}" class="stats-detail-mask" catchtap="closeStatDetail">
      <view class="stats-detail-sheet" catchtap="noop">
        <view class="stats-sheet-handle"></view>
        <view class="stats-detail-sheet-head">
          <view>
            <view class="stats-detail-sheet-title">{{statDetail.name}} 明细</view>
            <view class="stats-detail-meta">{{statDetailView.metaText}}</view>
          </view>
          <button class="mini-action secondary" bindtap="closeStatDetail">收起</button>
        </view>
        <view class="stats-detail-search">
          <text class="stats-detail-search-icon">⌕</text>
          <input value="{{statDetail.keyword}}" bindinput="onStatDetailKeywordInput" confirm-type="search" bindconfirm="onStatDetailKeywordInput" placeholder="搜索客户 / 人员 / 备注" />
          <text wx:if="{{statDetail.keyword}}" class="stats-detail-clear" bindtap="clearStatDetailKeyword">清空</text>
        </view>
        <scroll-view scroll-y class="stats-detail-scroll">
          <view wx:if="{{statDetail.loading}}" class="muted compact-muted">明细加载中...</view>
      <block wx:for="{{statDetailView.pagedRecords}}" wx:for-item="detail" wx:key="id">
        <view class="stats-detail-card">
          <view class="stats-detail-head">
            <view>
              <view class="stats-detail-customer">{{detail.customerName}}</view>
              <view class="stats-detail-sub">{{detail.metaText}}</view>
            </view>
            <view class="ranking-score">{{detail.scoreText}}</view>
          </view>
          <view class="stats-detail-remark">{{detail.remarkText}}</view>
          <view class="record-file-wall compact grouped" wx:if="{{detail.showFiles}}">
            <view wx:for="{{detail.fileGroupsView}}" wx:for-item="group" wx:for-index="wallGroupIdx" wx:key="key" class="record-file-group">
              <view class="record-file-group-head">
                <text>{{group.label}}</text>
                <text>{{group.countText}}</text>
              </view>
              <view class="wall-grid">
                <view wx:for="{{group.files}}" wx:for-item="file" wx:for-index="wallFileIdx" wx:key="id" class="wall-tile">
                  <image wx:if="{{file.type === 'image' && file.id}}" class="wall-thumb" src="{{thumb.thumbSrc(file, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" catchtap="previewStatDetailAttachment" data-detail-index="{{detail.sourceIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}" />
                  <view wx:elif="{{file.type === 'video'}}" class="wall-video-face" catchtap="previewStatDetailAttachment" data-detail-index="{{detail.sourceIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">
                    <view class="wall-play-icon">▶</view>
                    <text class="wall-face-name">{{file.name}}</text>
                  </view>
                  <view wx:else class="wall-doc-face" catchtap="previewStatDetailAttachment" data-detail-index="{{detail.sourceIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">
                    <text class="wall-doc-type">{{file.typeText}}</text>
                    <text class="wall-face-name">{{file.name}}</text>
                  </view>
                  <text wx:if="{{file.showTag}}" class="wall-tag" style="color: {{file.tagColor}}; border-color: {{file.tagColor}};">{{file.tagText}}</text>
                  <view class="wall-acts">
                    <button class="wall-act-btn" loading="{{incentiveView.previewLoading}}" catchtap="previewStatDetailAttachment" data-detail-index="{{detail.sourceIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">打开</button>
                    <button class="wall-act-btn secondary" catchtap="downloadStatDetailAttachment" data-detail-index="{{detail.sourceIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">下载</button>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <pager wx:if="{{statDetailView.total > 0}}" page="{{statDetailView.page}}" pageSize="{{statDetailView.pageSize}}" total="{{statDetailView.total}}" loading="{{statDetailView.loading}}" bind:change="onStatDetailPagerChange" />
      <view wx:if="{{statDetailView.showEmpty}}" class="muted compact-muted">{{statDetailView.emptyText}}</view>
        </scroll-view>
      </view>
    </view>
  </view>

  <view wx:if="{{incentiveView.showRanking}}">
    <view class="card ranking-panel">
      <view class="section-row">
        <view class="section-title no-margin">个人学分榜</view> <!-- 【工作流复核确认修复】数据源为按人员聚合的 scoreboard, 原名"客户学分榜"名实不符 -->
        <button class="stats-refresh-btn" bindtap="loadScoreboard">↻</button>
      </view>
      <!-- 【2026-11-02 用户令·PC 同款排行】排名(前3奖牌徽章🥇🥈🥉)+首字头像(前3彩色渐变)+姓名/办事处
           +激励总额胶囊(蓝底白字)+合计, 与 PC PersonRankTableView 同构 -->
      <view class="rank-table-head">
        <text class="rth rth-rank">排名</text>
        <text class="rth rth-name">人员</text>
        <text class="rth rth-score">激励总额</text>
        <text class="rth rth-total">合计</text>
      </view>
      <block wx:for="{{scoreboardPaged}}" wx:key="id">
        <view class="rank-table-row">
          <view class="rtd rtd-rank">
            <text wx:if="{{item.rank <= 3}}" class="rank-medal rank-medal-{{item.rank}}">{{item.rank === 1 ? '🥇' : item.rank === 2 ? '🥈' : '🥉'}}</text>
            <text wx:else class="rank-num">{{item.rank}}</text>
          </view>
          <view class="rtd rtd-name">
            <view class="name-wrap">
              <text class="name-avatar av-{{item.rank <= 3 ? item.rank : 4}}">{{item.avatarChar}}</text>
              <view class="name-col">
                <text class="{{item.rank <= 3 ? 'name-top' : 'name-cell'}}">{{item.name}}</text>
                <text class="name-office">{{item.officeText}}</text>
              </view>
            </view>
          </view>
          <view class="rtd rtd-score"><text class="score-pill">{{item.scoreNum}}<text class="pill-unit">分</text></text></view>
          <view class="rtd rtd-total">{{item.recordCountText}}</view>
        </view>
      </block>
      <pager wx:if="{{scoreboardTotal > 10}}" page="{{scoreboardPage}}" pageSize="{{scoreboardPageSize}}" total="{{scoreboardTotal}}" loading="{{incentiveView.pagerLoading}}" bind:change="onScoreboardPagerChange" />
      <view wx:if="{{incentiveView.showScoreboardEmpty}}" class="muted">暂无个人学分排行</view>
    </view>
    <view class="card ranking-panel">
      <view class="section-title">部门排行</view>
      <!-- 【2026-11-02 PC 同款】部门排行同表格化: 排名/部门/总分胶囊/人数/均分 -->
      <view class="rank-table-head">
        <text class="rth rth-rank">排名</text>
        <text class="rth rth-name">部门</text>
        <text class="rth rth-score">总学分</text>
        <text class="rth rth-total">均分</text>
      </view>
      <block wx:for="{{deptPaged}}" wx:key="id">
        <view class="rank-table-row">
          <view class="rtd rtd-rank">
            <text wx:if="{{item.rank <= 3}}" class="rank-medal rank-medal-{{item.rank}}">{{item.rank === 1 ? '🥇' : item.rank === 2 ? '🥈' : '🥉'}}</text>
            <text wx:else class="rank-num">{{item.rank}}</text>
          </view>
          <view class="rtd rtd-name"><text class="name-cell dept-name">{{item.name}}</text></view>
          <view class="rtd rtd-score"><text class="score-pill dept-pill">{{item.scoreNum}}<text class="pill-unit">分</text></text></view>
          <view class="rtd rtd-total">{{item.avgText}}</view>
        </view>
      </block>
      <pager wx:if="{{deptTotal > 10}}" page="{{deptPage}}" pageSize="{{deptPageSize}}" total="{{deptTotal}}" loading="{{incentiveView.pagerLoading}}" bind:change="onDeptPagerChange" />
      <view wx:if="{{incentiveView.showDeptRankingEmpty}}" class="muted">暂无部门排行</view>
    </view>
  </view>

  <view wx:if="{{incentiveView.showReads}}">
    <view class="read-period-row">
      <text>统计月份</text>
      <picker mode="selector" range="{{readPeriodOptions}}" range-key="label" value="{{selectedReadPeriodIndex}}" bindchange="chooseReadPeriod">
        <view class="filter-chip">{{incentiveView.readPeriodText}}</view>
      </picker>
    </view>
    <view wx:if="{{incentiveView.showReadStatsPanel}}" class="card read-panel refined-read-panel">
      <view class="section-row">
        <view class="section-title no-margin">阅读统计</view>
        <button class="stats-refresh-btn" bindtap="loadReadStats">↻</button>
      </view>
      <block wx:for="{{readStatsPaged}}" wx:key="userId">
        <view class="stat-row"><text>{{item.rankText}}</text><text>{{item.countText}}</text></view>
      </block>
      <pager wx:if="{{readStatsTotal > 10}}" page="{{readStatsPage}}" pageSize="{{readStatsPageSize}}" total="{{readStatsTotal}}" loading="{{incentiveView.pagerLoading}}" bind:change="onReadStatsPagerChange" />
      <view wx:if="{{incentiveView.showReadStatsEmpty}}" class="muted compact-muted">暂无统计</view>
    </view>
    <view wx:if="{{incentiveView.showReadRankingPanel}}" class="card read-panel">
      <view class="section-title">阅读排行</view>
      <block wx:for="{{readRankingPaged}}" wx:key="userId">
        <view class="stat-row"><text>{{item.rankText}}</text><text>{{item.countText}}</text></view>
      </block>
      <pager wx:if="{{readRankingTotal > 10}}" page="{{readRankingPage}}" pageSize="{{readRankingPageSize}}" total="{{readRankingTotal}}" loading="{{incentiveView.pagerLoading}}" bind:change="onReadRankingPagerChange" />
      <!-- 【I5】请求失败≠没有数据: 失败给错误态+重试, 空态只在成功且无数据时出现 -->
      <view wx:if="{{incentiveView.showReadRankingError}}" class="muted">阅读排行加载失败，<text bindtap="loadReadRanking">点击重试</text></view>
      <view wx:if="{{incentiveView.showReadRankingEmpty}}" class="muted">暂无排行</view>
    </view>
    <view wx:if="{{incentiveView.showNoReadPermission}}" class="card muted">暂无阅读统计权限</view>
  </view>
</view>
