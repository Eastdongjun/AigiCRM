<wxs src="./thumb.wxs" module="thumb" />
<view class="page incentive-workbench">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">四项激励</view>
        <view class="hero-sub">分类 · 上传 · 积分 · 统计 · 阅读</view>
      </view>
      <button class="ghost-btn" bindtap="refresh" loading="{{incentiveView.refreshLoading}}">{{incentiveView.refreshText}}</button>
    </view>
    <view wx:if="{{canUploadEvidence}}" class="upload-entry-row">
      <button class="upload-entry-btn" bindtap="goUpload">＋ 上传激励</button>
      <text class="upload-entry-hint">大类 → 子类 → 槽位佐证,与 PC 上传同口径</text>
    </view>
  </view>

  <view class="summary-grid">
    <view class="summary-cell"><text>{{summary.customers}}</text><text>客户</text></view>
    <view class="summary-cell"><text>{{summary.records}}</text><text>记录</text></view>
    <view class="summary-cell"><text>{{summary.files}}</text><text>文件</text></view>
    <view class="summary-cell"><text>{{summary.score}}</text><text>积分</text></view>
  </view>

  <view class="mobile-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="mobile-tab {{item.className}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <view wx:if="{{incentiveView.showRecords}}">
    <view class="card incentive-search-card">
      <view class="incentive-search-row">
        <input class="incentive-search-input" value="{{keyword}}" placeholder="搜索客户 / 产品 / 关键字" confirm-type="search" bindinput="inputKeyword" bindconfirm="searchRecords" />
        <button class="mini-action" bindtap="searchRecords" loading="{{incentiveView.searchLoading}}">{{incentiveView.searchText}}</button>
        <button class="mini-action secondary" bindtap="resetRecordFilters">清空</button>
      </view>
      <view class="incentive-advanced-filters">
        <picker mode="selector" range="{{industries}}" value="{{selectedIndustryIndex}}" bindchange="chooseIndustry">
          <view class="filter-chip">{{incentiveView.industryText}}</view>
        </picker>
        <picker mode="selector" range="{{devTypes}}" value="{{selectedDevTypeIndex}}" bindchange="chooseDevType">
          <view class="filter-chip">{{incentiveView.devTypeText}}</view>
        </picker>
        <picker mode="selector" range="{{productOptions}}" value="{{selectedProductIndex}}" bindchange="chooseProduct">
          <view class="filter-chip">{{incentiveView.productText}}</view>
        </picker>
        <picker mode="selector" range="{{orgOptions}}" range-key="label" value="{{selectedOrgIndex}}" bindchange="chooseOrg">
          <view class="filter-chip">{{incentiveView.orgText}}</view>
        </picker>
        <picker mode="date" value="{{startDate}}" bindchange="chooseStartDate">
          <view class="filter-chip">{{incentiveView.startDateText}}</view>
        </picker>
        <picker mode="date" value="{{endDate}}" bindchange="chooseEndDate">
          <view class="filter-chip">{{incentiveView.endDateText}}</view>
        </picker>
      </view>
    </view>
    <view class="incentive-filter-head">
      <view class="section-title no-margin">客户维度明细</view>
      <view class="incentive-filter-actions">
        <picker mode="selector" range="{{categories}}" bindchange="chooseCategory">
          <view class="ranking-tab active">{{category}}⌄</view>
        </picker>
        <picker mode="selector" range="{{userNames}}" value="{{selectedUserIndex}}" bindchange="chooseUser">
          <view class="ranking-tab">{{incentiveView.userText}}</view>
        </picker>
        <picker mode="selector" range="{{orderOptions}}" value="{{selectedOrderIndex}}" bindchange="chooseOrder">
          <view class="ranking-tab">{{incentiveView.orderText}}</view>
        </picker>
      </view>
    </view>
    <view wx:if="{{incentiveView.showLoading}}" class="card muted">{{incentiveView.loadingText}}</view>
    <!-- 【需求B+C 2026-10-16】客户维度=紧凑封面卡: 列表页只留识别信息(封面/名称/行业·大类/积分/未读/NEW),
         全部明细与操作下沉到客户激励详情页(openCustomerDetail);原红圈①②③④从列表页消失 -->
    <block wx:for="{{records}}" wx:key="id">
      <view class="cust-card" data-index="{{index}}" bindtap="openCustomerDetail">
        <view class="cust-cover">
          <image wx:if="{{item.coverFile.id}}" class="cust-cover-img" src="{{thumb.thumbSrc(item.coverFile, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" />
          <view wx:else class="cust-cover-fallback"><text>{{item.coverChar}}</text></view>
          <view wx:if="{{item.showNewTag}}" class="cust-new">NEW</view>
        </view>
        <view class="cust-body">
          <view class="cust-name-row">
            <text class="cust-name">{{item.name}}</text>
            <text wx:if="{{item.unread}}" class="cust-unread-dot"></text>
          </view>
          <view class="cust-meta">
            <text class="cust-pill">{{item.industry}}</text>
            <text wx:if="{{item.category}}" class="cust-pill blue">{{item.category}}</text>
          </view>
          <view class="cust-nums">{{item.countText}} · {{item.fileCountText}}</view>
        </view>
        <view class="cust-score">
          <text class="cust-score-num">{{item.score}}</text>
          <text class="cust-score-unit">分</text>
        </view>
        <view class="cust-arrow">›</view>
      </view>
    </block>
    <view wx:if="{{incentiveView.showRecordEmpty}}" class="card muted">暂无四项激励记录</view>
    <video wx:if="{{previewVideoPath}}" src="{{previewVideoPath}}" controls class="record-file-video"></video>
  </view>

  <view wx:if="{{incentiveView.showCategories}}" class="card">
    <view class="section-title">分类树 · 点击筛选</view>
    <view wx:for="{{categoryTreeView}}" wx:key="id" class="category-row level-{{item.level}} {{item.name === category ? 'category-row-active' : ''}}" hover-class="category-row-hover" bindtap="onCategoryRowTap" data-index="{{index}}">
      <text>{{item.name}}</text>
      <text>{{item.metaText}}</text>
    </view>
    <view wx:if="{{incentiveView.showCategoryEmpty}}" class="muted">暂无分类</view>
  </view>

  <view wx:if="{{incentiveView.showStats}}" class="card">
    <view class="section-title">分类统计</view>
    <view class="stats-row">
      <text>覆盖分类</text><text>{{summary.categories}}</text>
    </view>
    <view class="stats-row">
      <text>未读客户</text><text>{{summary.unread}}</text>
    </view>
    <view wx:for="{{categoryStats}}" wx:key="name" class="stats-row stat-drill-row" data-index="{{index}}" bindtap="openStatDetail">
      <view>
        <view class="stat-name">{{item.name}}</view>
        <view wx:if="{{item.parentName}}" class="stat-parent">{{item.parentName}}</view>
      </view>
      <view class="stat-value">{{item.count}} 文件 / {{item.score}} 分 ›</view>
    </view>
    <view wx:if="{{incentiveView.showCategoryStatsEmpty}}" class="muted">暂无统计</view>
    <view wx:if="{{statDetail.visible}}" class="stats-detail-panel">
      <view class="section-row">
        <view>
          <view class="section-title no-margin">{{statDetail.name}} 明细</view>
          <view class="stats-detail-meta">{{statDetailView.metaText}}</view>
        </view>
        <button class="mini-action secondary" bindtap="closeStatDetail">收起</button>
      </view>
      <view wx:if="{{statDetail.loading}}" class="muted compact-muted">明细加载中...</view>
      <block wx:for="{{statDetail.records}}" wx:for-item="detail" wx:for-index="detailIndex" wx:key="id">
        <view class="stats-detail-card">
          <view class="stats-detail-head">
            <view>
              <view class="stats-detail-customer">{{detail.customerName}}</view>
              <view class="stats-detail-sub">{{detail.metaText}}</view>
            </view>
            <view class="ranking-score">{{detail.scoreText}}</view>
          </view>
          <view class="stats-detail-remark">{{detail.remarkText}}</view>
          <view class="record-file-wall compact grouped" wx:if="{{detail.showFiles}}">
            <view wx:for="{{detail.fileGroupsView}}" wx:for-item="group" wx:for-index="wallGroupIdx" wx:key="key" class="record-file-group">
              <view class="record-file-group-head">
                <text>{{group.label}}</text>
                <text>{{group.countText}}</text>
              </view>
              <view class="wall-grid">
                <view wx:for="{{group.files}}" wx:for-item="file" wx:for-index="wallFileIdx" wx:key="id" class="wall-tile">
                  <image wx:if="{{file.type === 'image' && file.id}}" class="wall-thumb" src="{{thumb.thumbSrc(file, apiBase, dlToken)}}" mode="aspectFill" lazy-load="{{true}}" catchtap="previewStatDetailAttachment" data-detail-index="{{detailIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}" />
                  <view wx:elif="{{file.type === 'video'}}" class="wall-video-face" catchtap="previewStatDetailAttachment" data-detail-index="{{detailIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">
                    <view class="wall-play-icon">▶</view>
                    <text class="wall-face-name">{{file.name}}</text>
                  </view>
                  <view wx:else class="wall-doc-face" catchtap="previewStatDetailAttachment" data-detail-index="{{detailIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">
                    <text class="wall-doc-type">{{file.typeText}}</text>
                    <text class="wall-face-name">{{file.name}}</text>
                  </view>
                  <text wx:if="{{file.showTag}}" class="wall-tag" style="color: {{file.tagColor}}; border-color: {{file.tagColor}};">{{file.tagText}}</text>
                  <view class="wall-acts">
                    <button class="wall-act-btn" loading="{{incentiveView.previewLoading}}" catchtap="previewStatDetailAttachment" data-detail-index="{{detailIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">打开</button>
                    <button class="wall-act-btn secondary" catchtap="downloadStatDetailAttachment" data-detail-index="{{detailIndex}}" data-group-index="{{group.groupIndex}}" data-file-index="{{file.fileIndex}}">下载</button>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{statDetailView.showEmpty}}" class="muted compact-muted">该分类暂无激励明细</view>
    </view>
  </view>

  <view wx:if="{{incentiveView.showRanking}}">
    <view class="card ranking-panel">
      <view class="section-row">
        <view class="section-title no-margin">个人积分榜</view> <!-- 【工作流复核确认修复】数据源为按人员聚合的 scoreboard, 原名"客户积分榜"名实不符 -->
        <button class="stats-refresh-btn" bindtap="loadScoreboard">↻</button>
      </view>
      <block wx:for="{{scoreboard}}" wx:key="id">
        <view class="score-row">
          <view class="score-rank">{{item.rank}}</view>
          <view class="score-main">
            <view class="score-name">{{item.name}}</view>
            <view class="score-meta">{{item.metaText}}</view>
          </view>
          <view class="score-value">{{item.scoreText}}</view>
        </view>
      </block>
      <view wx:if="{{incentiveView.showScoreboardEmpty}}" class="muted">暂无个人积分排行</view>
    </view>
    <view class="card ranking-panel">
      <view class="section-title">部门排行</view>
      <block wx:for="{{deptRanking}}" wx:key="id">
        <view class="score-row">
          <view class="score-rank dept">{{item.rank}}</view>
          <view class="score-main">
            <view class="score-name">{{item.name}}</view>
            <view class="score-meta">{{item.metaText}}</view>
          </view>
          <view class="score-value">{{item.scoreText}}</view>
        </view>
      </block>
      <view wx:if="{{incentiveView.showDeptRankingEmpty}}" class="muted">暂无部门排行</view>
    </view>
  </view>

  <view wx:if="{{incentiveView.showReads}}">
    <view class="read-period-row">
      <text>统计月份</text>
      <picker mode="selector" range="{{readPeriodOptions}}" range-key="label" value="{{selectedReadPeriodIndex}}" bindchange="chooseReadPeriod">
        <view class="filter-chip">{{incentiveView.readPeriodText}}</view>
      </picker>
    </view>
    <view wx:if="{{incentiveView.showReadStatsPanel}}" class="card read-panel refined-read-panel">
      <view class="section-row">
        <view class="section-title no-margin">阅读统计</view>
        <button class="stats-refresh-btn" bindtap="loadReadStats">↻</button>
      </view>
      <block wx:for="{{readStatsView}}" wx:key="userId">
        <view class="stat-row"><text>{{item.rankText}}</text><text>{{item.countText}}</text></view>
      </block>
      <view wx:if="{{incentiveView.showReadStatsEmpty}}" class="muted compact-muted">暂无统计</view>
    </view>
    <view wx:if="{{incentiveView.showReadRankingPanel}}" class="card read-panel">
      <view class="section-title">阅读排行</view>
      <block wx:for="{{readRankingView}}" wx:key="userId">
        <view class="stat-row"><text>{{item.rankText}}</text><text>{{item.countText}}</text></view>
      </block>
      <view wx:if="{{incentiveView.showReadRankingEmpty}}" class="muted">暂无排行</view>
    </view>
    <view wx:if="{{incentiveView.showNoReadPermission}}" class="card muted">暂无阅读统计权限</view>
  </view>
</view>
