<view class="page">
  <view class="hero"><view class="row"><view><view class="hero-title">价值服务案例</view><view class="hero-sub">真实客户 · 现场见证</view></view><button class="ghost-btn" bindtap="refresh" loading="{{loading}}">刷新</button></view></view>
  <view wx:if="{{canViewReadStats}}" class="card read-panel"><view class="row"><view class="section-title" style="margin:0">阅读统计</view><button class="text-btn" bindtap="loadReadStats">更新</button></view><block wx:for="{{readStats}}" wx:key="userId"><view class="stat-row"><text>{{index + 1}}. {{item.realName}}</text><text>已读 {{item.readCount}} / 未读 {{item.unreadCount}}</text></view></block><view wx:if="{{readStats.length===0}}" class="muted" style="margin-top:16rpx">暂无统计</view></view>
  <view class="row" style="margin:28rpx 0 16rpx"><view class="section-title" style="margin:0">激励查询</view><view class="row"><picker mode="selector" range="{{categories}}" bindchange="chooseCategory"><view class="pill">{{category}}⌄</view></picker><picker mode="selector" range="{{['默认排序','分值从高到低','分值从低到高']}}" bindchange="choose"><view class="pill" style="margin-left:12rpx">{{order==='asc'?'分值从低到高':order==='desc'?'分值从高到低':'默认排序'}}⌄</view></picker></view></view>
  <view wx:if="{{loading}}" class="card muted">加载中...</view>
  <block wx:for="{{records}}" wx:key="name"><view class="card" style="margin-bottom:20rpx" bindtap="showDetail" data-index="{{index}}"><view class="row"><view style="font-size:30rpx;font-weight:700;flex:1">{{item.name}}</view><view class="num" style="font-size:40rpx;color:#2563eb">{{item.score}}</view></view><view style="margin-top:14rpx"><text class="pill">{{item.industry}}</text><text class="pill" style="margin-left:10rpx">{{item.category}}</text><text class="pill" style="margin-left:10rpx">{{item.count}}条</text><text wx:if="{{item.isNew}}" class="tag-new" style="margin-left:10rpx">NEW</text><text wx:if="{{item.unread}}" class="tag-unread" style="margin-left:10rpx">未读</text></view><view style="margin-top:18rpx;font-size:27rpx">{{item.summary}}</view><view class="row" style="margin-top:16rpx"><view class="muted">点击查看详情，查看后自动标记为已读</view><button wx:if="{{item.customerId}}" class="text-btn" catchtap="openCustomer" data-index="{{index}}">客户卡片</button></view></view></block>
  <view wx:if="{{!loading && records.length===0}}" class="card muted">暂无激励记录</view>
  <view wx:if="{{selected}}" class="card" style="margin-top:24rpx;border:2rpx solid #2563eb"><view class="row"><view class="section-title" style="margin:0;flex:1">激励详情</view><button class="text-btn" bindtap="closeDetail">关闭</button></view><view style="margin-top:18rpx">客户：{{selected.name}}</view><view style="margin-top:12rpx">行业：{{selected.industry}} · 分类：{{selected.category}} · 分值：{{selected.score}}</view><view style="margin-top:12rpx">说明：{{selected.summary}}</view><button wx:if="{{canUploadEvidence}}" class="btn" style="margin-top:20rpx" bindtap="uploadEvidence">上传佐证文件</button></view>
</view>
