<!-- 【2026-10-23 四项服务拆分·用户令】轻量客户记录页: 上下滚动的记录列表,
     不进一客一册档案(无封面/书页/翻页/左右滑动); 点记录进既有详情页(附件查看/下载/删除保留)。 -->
<view class="page">
  <view class="rec-hero">
    <view class="rec-hero-name">{{customer.name || '客户'}}</view>
    <view class="rec-hero-meta" wx:if="{{customer.industry || customer.category}}">{{customer.industry}}{{customer.category ? ' · ' + customer.category : ''}}</view>
    <view class="rec-hero-score">{{customer.countText}} · {{customer.fileCountText}} · {{customer.scoreText}}</view>
  </view>

  <view class="rec-list">
    <view wx:if="{{loading}}" class="card muted">加载中...</view>
    <view wx:for="{{pagedChildren}}" wx:key="id" class="rec-item" data-index="{{index}}" bindtap="openRecord">
      <view class="rec-item-head">
        <text class="rec-item-title">{{item.titleText}}</text>
        <text class="rec-item-score">{{item.scoreText}}</text>
      </view>
      <view class="rec-item-meta">{{item.metaText}}</view>
      <view wx:if="{{item.showSummary}}" class="rec-item-summary">{{item.summaryText}}</view>
      <view wx:if="{{item.showFiles}}" class="rec-item-files">
        <text>{{item.fileCountText}} 个附件</text>
        <text wx:for="{{item.fileGroupsView}}" wx:for-item="group" wx:key="key">{{group.label}} {{group.countText}}</text>
      </view>
    </view>
    <view wx:if="{{!loading && pagedChildren.length === 0}}" class="card muted">该客户暂无服务记录</view>
    <view wx:if="{{hasMore}}" class="rec-more">上滑加载更多（{{pagedChildren.length}}/{{children.length}}）</view>
  </view>
</view>
