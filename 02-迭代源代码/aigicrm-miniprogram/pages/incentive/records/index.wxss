/* 【2026-10-23 四项服务拆分】轻量客户记录页: 页头客户信息条 + 纵向记录列表。
   刻意不引入一客一册的封面/书页/翻页样式——本页只有上下滚动。 */
@import "../index.wxss";

.rec-hero {
  padding: 26rpx 28rpx 20rpx;
  background: linear-gradient(135deg, #1d3fae, #2f6bf0 60%, #4d8cf5);
  color: #fff;
}
.rec-hero-name { font-size: 34rpx; font-weight: 800; }
.rec-hero-meta { margin-top: 8rpx; font-size: 22rpx; opacity: .88; }
.rec-hero-score { margin-top: 6rpx; font-size: 22rpx; opacity: .95; }

.rec-list { padding: 20rpx 24rpx 48rpx; }
.rec-item {
  background: #fff;
  border: 1rpx solid rgba(210, 220, 235, .82);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 26rpx rgba(35, 57, 96, .06);
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}
.rec-item-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12rpx; }
.rec-item-title { font-size: 28rpx; font-weight: 700; color: #172033; }
.rec-item-score { font-size: 24rpx; font-weight: 800; color: #1d4ed8; white-space: nowrap; }
.rec-item-meta { margin-top: 8rpx; font-size: 22rpx; color: #7c8ba1; }
.rec-item-summary { margin-top: 10rpx; font-size: 24rpx; color: #33415c; line-height: 1.5; }
.rec-item-files { margin-top: 12rpx; display: flex; align-items: center; gap: 10rpx; }
.rec-item-files text { font-size: 20rpx; color: #2563eb; background: rgba(37, 99, 235, .08); border-radius: 999rpx; padding: 4rpx 14rpx; }
.rec-more { text-align: center; color: #7c8ba1; font-size: 22rpx; padding: 10rpx 0 20rpx; }
