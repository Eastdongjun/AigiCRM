<view class="page">
  <view class="hero upload-hero">
    <view class="hero-title">四项激励上传</view>
    <view class="hero-sub">提交四项激励记录，关联客户、分类与现场佐证。</view>
  </view>
  <view class="card form-card">
    <view class="form-section-title">基础信息</view>
    <view class="field">
      <text class="label">客户 *</text>
      <picker mode="selector" range="{{customerNames}}" bindchange="chooseCustomer">
        <view class="picker-card">
          <text class="{{uploadView.customerPicker.className}}">{{uploadView.customerPicker.text}}</text>
          <text class="picker-arrow">⌄</text>
        </view>
      </picker>
      <view wx:if="{{uploadView.showCustomerConfirm}}" class="customer-confirm">
        <text class="customer-confirm-name">{{uploadView.selectedCustomerName}}</text>
        <text class="customer-confirm-meta">{{uploadView.selectedCustomerMeta}}</text>
      </view>
    </view>
    <view class="field">
      <text class="label">激励大类 *</text>
      <picker mode="selector" range="{{uploadView.categoryParentNames}}" bindchange="chooseCategoryParent">
        <view class="picker-card">
          <text class="{{uploadView.categoryParentPicker.className}}">{{uploadView.categoryParentPicker.text}}</text>
          <text class="picker-arrow">⌄</text>
        </view>
      </picker>
      <picker wx:if="{{uploadView.showCategoryChild}}" class="category-child-picker" mode="selector" range="{{uploadView.categoryChildNames}}" bindchange="chooseCategoryChild">
        <view class="picker-card">
          <text class="{{uploadView.categoryChildPicker.className}}">{{uploadView.categoryChildPicker.text}}</text>
          <text class="picker-arrow">⌄</text>
        </view>
      </picker>
      <view wx:if="{{uploadView.showCategorySummary}}" class="category-summary">
        <text>{{uploadView.categorySectionTitle}}</text>
        <text>{{uploadView.categoryScoreText}}</text>
      </view>
    </view>
    <view class="field">
      <text class="label">行业</text>
      <picker mode="selector" range="{{industryOptions}}" bindchange="chooseIndustry">
        <view class="picker-card">
          <text class="{{uploadView.industryPicker.className}}">{{uploadView.industryPicker.text}}</text>
          <text class="picker-arrow">⌄</text>
        </view>
      </picker>
    </view>
    <view class="field">
      <text class="label">记录周期 *</text>
      <picker mode="selector" range="{{periodOptions}}" value="{{selectedPeriodIndex}}" bindchange="choosePeriod" disabled="{{uploadView.periodDisabled}}">
        <view class="{{uploadView.periodPickerClass}}">
          <text>{{uploadView.periodPickerText}}</text>
          <text wx:if="{{uploadView.showPeriodArrow}}" class="picker-arrow">⌄</text>
        </view>
      </picker>
      <view wx:if="{{uploadView.showPeriodPreserveHint}}" class="field-hint">追加文件时保留原记录周期，与 PC 端编辑逻辑一致。</view>
    </view>
    <view class="field">
      <text class="label">相关产品</text>
      <view class="inline-pickers">
        <picker mode="selector" range="{{relatedCatOptions}}" bindchange="chooseRelatedCat">
          <view class="picker-card compact">
            <text class="{{uploadView.relatedCatPicker.className}}">{{uploadView.relatedCatPicker.text}}</text>
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>
        <picker mode="selector" range="{{relatedSubOptions}}" bindchange="chooseRelatedSub" disabled="{{uploadView.relatedSubDisabled}}">
          <view class="{{uploadView.relatedSubPickerClass}}">
            <text class="{{uploadView.relatedSubPicker.className}}">{{uploadView.relatedSubPicker.text}}</text>
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>
      </view>
      <input class="input" value="{{relatedProducts}}" bindinput="inputRelatedProducts" placeholder="可手动补充，如：涂层类-防腐" />
    </view>
    <view wx:if="{{uploadView.showSpecificProduct}}" class="field">
      <text class="label">具体产品</text>
      <input class="input" value="{{specificProduct}}" bindinput="inputSpecificProduct" placeholder="产品试点可填写具体产品或型号" />
    </view>
    <view class="field">
      <text class="label">{{uploadView.detailLabel}}</text>
      <textarea class="textarea" value="{{preInstallQuestion}}" bindinput="inputPreInstallQuestion" placeholder="{{uploadView.detailPlaceholder}}" />
    </view>
    <view wx:if="{{uploadView.showRemarkField}}" class="field">
      <text class="label">{{uploadView.remarkLabel}}</text>
      <textarea class="textarea" value="{{remark}}" bindinput="inputRemark" placeholder="{{uploadView.remarkPlaceholder}}" />
    </view>
    <view class="field switch-row">
      <view>
        <text class="label no-gap">团队共享</text>
        <view class="field-hint">开启后团队成员可见；关闭后仅本人、管理员或授权人员可见。</view>
        <view wx:if="{{uploadView.shareLocked}}" class="field-hint">仅上传人可修改共享状态，追加他人记录时保持原值。</view>
      </view>
      <switch checked="{{shared}}" disabled="{{uploadView.shareLocked}}" bindchange="toggleShared" color="#2563eb" />
    </view>
    <view wx:if="{{uploadView.showAudit}}" class="audit-panel">
      <view class="form-section-title compact-title">审计信息</view>
      <view class="audit-grid">
        <view wx:for="{{uploadView.auditRows}}" wx:key="label" class="audit-item">
          <text class="audit-label">{{item.label}}</text>
          <text class="audit-value">{{item.valueText}}</text>
        </view>
      </view>
    </view>
    <view class="field">
      <text class="label">文件槽位 *</text>
      <view class="slot-selector">
        <view wx:for="{{uploadView.slotOptionsView}}" wx:key="key" wx:if="{{item.visible}}" class="{{item.className}}" data-index="{{item.originalIndex}}" bindtap="chooseSlot">
          <text>{{item.label}}</text>
          <text wx:if="{{item.ready}}" class="slot-ready">{{item.countText}}</text>
        </view>
      </view>
      <view class="upload-slot">
        <view class="upload-icon">＋</view>
        <view class="upload-copy">
          <view class="upload-title">{{uploadView.currentSlotTitle}}</view>
          <view class="upload-hint">{{uploadView.currentSlotHint}}</view>
          <view class="upload-actions">
            <button class="upload-action primary" catchtap="chooseImage">选图片</button>
            <button class="upload-action" catchtap="chooseFile">选文件</button>
          </view>
        </view>
      </view>
    </view>
    <view class="selected-file-list">
      <view wx:for="{{uploadView.selectedFileSlotsView}}" wx:for-item="slot" wx:key="key" class="selected-slot-group">
        <view wx:for="{{slot.files}}" wx:for-item="file" wx:key="fileKey" class="selected-file-row">
          <image wx:if="{{file.isImage}}" class="selected-file-thumb" src="{{file.filePath}}" mode="aspectFill" catchtap="previewSelectedFile" data-index="{{slot.slotIndex}}" data-file-index="{{file.fileIndex}}" />
          <view class="selected-file-main">
            <text class="selected-file-label">{{slot.label}} {{file.displayIndex}}</text>
            <text class="selected-file-name">{{file.fileName}}</text>
            <!-- PR-13 首批:逐文件上传状态(待上传/上传中/已上传/失败原因) -->
            <text wx:if="{{file.uploadStateText}}" class="{{file.uploadStateClass}}">{{file.uploadStateText}}</text>
          </view>
          <view class="selected-file-actions">
            <button class="file-action" loading="{{uploadView.fileActionLoading}}" catchtap="previewSelectedFile" data-index="{{slot.slotIndex}}" data-file-index="{{file.fileIndex}}">预览</button>
            <button class="file-action secondary" loading="{{uploadView.fileActionLoading}}" catchtap="downloadSelectedFile" data-index="{{slot.slotIndex}}" data-file-index="{{file.fileIndex}}">下载</button>
            <button class="file-action danger" catchtap="removeSelectedFile" data-index="{{slot.slotIndex}}" data-file-index="{{file.fileIndex}}">移除</button>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{uploadView.showUploadProgress}}" class="upload-progress-panel">
      <view class="upload-progress-track">
        <view class="upload-progress-fill" style="width: {{uploadView.uploadProgressWidth}};"></view>
      </view>
      <view class="upload-progress-text">{{uploadView.uploadProgressText}}</view>
    </view>
    <view class="form-actions">
      <button class="form-action cancel-action" bindtap="cancelUpload" disabled="{{uploadView.cancelDisabled}}">{{uploadView.cancelText}}</button>
      <!-- M18: disabled 只表达"提交中";表单未就绪保持可点(submitIncomplete 置灰样式),点击由 submit() toast 缺失原因。
           disabled 绑定名 submitDisabled 为契约脚本钉住的字面量, 勿改 -->
      <button class="form-action submit-action {{uploadView.submitIncomplete ? 'action-disabled' : ''}}" bindtap="submit" loading="{{uploadView.submitLoading}}" disabled="{{uploadView.submitDisabled}}">{{uploadView.submitText}}</button>
    </view>
  </view>
</view>
