<!-- 【2026-11-03 用户令·PC 逻辑对齐+纯表单页】点"激励上传"直接进本表单页(不再有浏览式四大类Tab/
     左右分栏/右侧记录表格); 表单分节与字段语义对齐 PC UploadDialog: 基本信息→安装详情→
     安装文件(每槽独立区块,不再有"先选槽位再上传")→跟踪记录(trial)→审计→共享→吸底提交。 -->
<view class="page upload-form-page">
  <!-- 编辑态头(对齐 PC 弹窗头: 追加文件+子分类tag; 新增态由导航栏"激励上传"承载) -->
  <view wx:if="{{uploadView.editCategoryName}}" class="edit-header">
    <text class="edit-title">追加文件</text>
    <text class="edit-cat-tag">{{uploadView.editCategoryName}}</text>
  </view>

  <!-- ①基本信息 -->
  <view class="form-section">
    <view class="form-section-title">基本信息</view>
    <view class="field">
      <text class="label">激励大类 *</text>
      <picker mode="selector" range="{{uploadView.categoryParentNames}}" bindchange="chooseCategoryParent" disabled="{{uploadView.categoryLocked}}">
        <view class="picker-card {{uploadView.categoryLocked ? 'disabled' : ''}}">
          <text class="{{uploadView.categoryParentPicker.className}}">{{uploadView.categoryParentPicker.text}}</text>
          <text wx:if="{{!uploadView.categoryLocked}}" class="picker-arrow">⌄</text>
        </view>
      </picker>
    </view>
    <view wx:if="{{uploadView.showCategoryChild}}" class="field">
      <text class="label">激励子类 *</text>
      <picker mode="selector" range="{{uploadView.categoryChildNames}}" bindchange="chooseCategoryChild" disabled="{{uploadView.categoryLocked}}">
        <view class="picker-card {{uploadView.categoryLocked ? 'disabled' : ''}}">
          <text class="{{uploadView.categoryChildPicker.className}}">{{uploadView.categoryChildPicker.text}}</text>
          <text wx:if="{{!uploadView.categoryLocked}}" class="picker-arrow">⌄</text>
        </view>
      </picker>
    </view>
    <view wx:if="{{uploadView.categoryLocked}}" class="field-hint">追加文件时保留原分类，与 PC 端编辑逻辑一致。</view>
    <view wx:if="{{uploadView.showCategorySummary}}" class="category-summary">
      <text>子类分值</text>
      <text>{{uploadView.categoryScoreText}}</text>
    </view>
    <view class="field">
      <text class="label">客户 *</text>
      <view class="picker-card" bindtap="openCustomerSheet">
        <text class="{{uploadView.customerPicker.className}}">{{uploadView.customerPicker.text}}</text>
        <text class="picker-arrow">⌄</text>
      </view>
      <view wx:if="{{uploadView.showCustomerConfirm}}" class="customer-confirm">
        <text class="customer-confirm-name">{{uploadView.selectedCustomerName}}</text>
        <text class="customer-confirm-meta">{{uploadView.selectedCustomerMeta}}</text>
      </view>
    </view>
    <view class="field">
      <text class="label">行业</text>
      <picker mode="selector" range="{{industryOptions}}" bindchange="chooseIndustry">
        <view class="picker-card">
          <text class="{{uploadView.industryPicker.className}}">{{uploadView.industryPicker.text}}</text>
          <text class="picker-arrow">⌄</text>
        </view>
      </picker>
    </view>
    <view class="field">
      <text class="label">相关产品</text>
      <view class="inline-pickers">
        <picker mode="selector" range="{{relatedCatOptions}}" bindchange="chooseRelatedCat">
          <view class="picker-card compact">
            <text class="{{uploadView.relatedCatPicker.className}}">{{uploadView.relatedCatPicker.text}}</text>
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>
        <picker mode="selector" range="{{relatedSubOptions}}" bindchange="chooseRelatedSub" disabled="{{uploadView.relatedSubDisabled}}">
          <view class="{{uploadView.relatedSubPickerClass}}">
            <text class="{{uploadView.relatedSubPicker.className}}">{{uploadView.relatedSubPicker.text}}</text>
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>
      </view>
    </view>
    <view wx:if="{{uploadView.showSpecificProduct}}" class="field">
      <text class="label">具体产品</text>
      <input class="input" value="{{specificProduct}}" bindinput="inputSpecificProduct" placeholder="产品试点可填写具体产品或型号" />
    </view>
  </view>

  <!-- ②安装详情(标题随品类: 安装详情/参观详情/方案详情, 与 PC secTitle 同源) -->
  <view class="form-section">
    <view class="form-section-title">{{uploadView.categorySectionTitle}}</view>
    <view class="field">
      <text class="label">{{uploadView.detailLabel}}</text>
      <textarea class="textarea" value="{{preInstallQuestion}}" bindinput="inputPreInstallQuestion" placeholder="{{uploadView.detailPlaceholder}}" />
    </view>
    <view wx:if="{{uploadView.showRemarkField}}" class="field">
      <text class="label">{{uploadView.remarkLabel}}</text>
      <textarea class="textarea" value="{{remark}}" bindinput="inputRemark" placeholder="{{uploadView.remarkPlaceholder}}" />
    </view>
  </view>

  <!-- ③安装文件: 每槽独立区块(与 PC FileSlotPager 同语义; 无"槽位选择器"两步式) -->
  <block wx:if="{{uploadView.showCategorySummary}}">
    <view class="form-section">
      <view class="form-section-title-row">
        <text class="form-section-title">{{uploadView.filesSectionTitle}}</text>
        <text class="section-tip">{{uploadView.filesSectionTip}}</text>
      </view>
      <!-- 【2026-11-04 用户报"又跳微信"】平台限制说明: 微信小程序无法直调手机文件管理器(官方仅
           chooseMessageFile 从聊天选), 文档文件需先经微信聊天。手机文件直传=后端 H5 选择器改造(待用户拍板)。 -->
      <view class="field-hint">文档文件（PDF/Word 等）受微信平台限制：请先把文件发送到任意微信聊天（如「文件传输助手」），再点「从聊天选择」；现场照片请用「选图片」。</view>
      <view wx:for="{{uploadView.installSlotBlocks}}" wx:for-item="block" wx:key="key" class="slot-block">
        <view class="slot-block-head">
          <text wx:if="{{block.dotClass}}" class="slot-dot {{block.dotClass}}"></text>
          <text class="slot-block-label">{{block.label}}</text>
          <text wx:if="{{block.pageText}}" class="selected-slot-page">{{block.pageText}}</text>
          <text class="slot-block-count">{{block.countText}}</text>
        </view>
        <swiper wx:if="{{block.files.length}}" class="slot-swiper" current="{{block.current}}"
                data-list="install" data-view-index="{{block.viewIndex}}" data-slot-index="{{block.slotIndex}}"
                data-count="{{block.files.length}}" bindchange="onSlotPageChange">
          <swiper-item wx:for="{{block.files}}" wx:for-item="file" wx:key="fileKey">
            <view class="slot-file-page">
              <image wx:if="{{file.isImage}}" class="selected-file-thumb" src="{{file.thumbUrl || file.filePath}}" mode="aspectFill" catchtap="previewSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}" />
              <view wx:else class="slot-type-thumb" catchtap="previewSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}">
                <text class="slot-type-text">{{file.kindText}}</text>
              </view>
              <view class="slot-file-meta">
                <text class="selected-file-name">{{file.fileName}}</text>
                <text wx:if="{{file.uploadStateText}}" class="{{file.uploadStateClass}}">{{file.uploadStateText}}</text>
              </view>
              <view class="slot-file-actions">
                <button class="file-action" loading="{{uploadView.fileActionLoading}}" catchtap="previewSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}">预览</button>
                <button class="file-action secondary" loading="{{uploadView.fileActionLoading}}" catchtap="downloadSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}">下载</button>
                <button class="file-action danger" catchtap="removeSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}">移除</button>
              </view>
            </view>
          </swiper-item>
        </swiper>
        <view wx:if="{{!block.full}}" class="slot-add-row">
          <button class="upload-action primary" catchtap="chooseImage" data-slot-key="{{block.key}}">选图片</button>
          <button class="upload-action" catchtap="chooseFile" data-slot-key="{{block.key}}">从聊天选择</button>
        </view>
        <view wx:else class="slot-full-hint">该槽位已满（每槽最多 5 个文件）</view>
      </view>
    </view>

    <!-- 跟踪记录(仅 trial, 与 PC 同款"不加分"提示) -->
    <view wx:if="{{uploadView.trackSlotBlocks.length}}" class="form-section">
      <view class="form-section-title-row">
        <text class="form-section-title">跟踪记录</text>
        <text class="section-tip">不加分</text>
      </view>
      <view wx:for="{{uploadView.trackSlotBlocks}}" wx:for-item="block" wx:key="key" class="slot-block">
        <view class="slot-block-head">
          <text class="slot-block-label">{{block.label}}</text>
          <text wx:if="{{block.pageText}}" class="selected-slot-page">{{block.pageText}}</text>
          <text class="slot-block-count">{{block.countText}}</text>
        </view>
        <swiper wx:if="{{block.files.length}}" class="slot-swiper" current="{{block.current}}"
                data-list="track" data-view-index="{{block.viewIndex}}" data-slot-index="{{block.slotIndex}}"
                data-count="{{block.files.length}}" bindchange="onSlotPageChange">
          <swiper-item wx:for="{{block.files}}" wx:for-item="file" wx:key="fileKey">
            <view class="slot-file-page">
              <image wx:if="{{file.isImage}}" class="selected-file-thumb" src="{{file.thumbUrl || file.filePath}}" mode="aspectFill" catchtap="previewSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}" />
              <view wx:else class="slot-type-thumb" catchtap="previewSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}">
                <text class="slot-type-text">{{file.kindText}}</text>
              </view>
              <view class="slot-file-meta">
                <text class="selected-file-name">{{file.fileName}}</text>
                <text wx:if="{{file.uploadStateText}}" class="{{file.uploadStateClass}}">{{file.uploadStateText}}</text>
              </view>
              <view class="slot-file-actions">
                <button class="file-action" loading="{{uploadView.fileActionLoading}}" catchtap="previewSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}">预览</button>
                <button class="file-action secondary" loading="{{uploadView.fileActionLoading}}" catchtap="downloadSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}">下载</button>
                <button class="file-action danger" catchtap="removeSelectedFile" data-index="{{block.slotIndex}}" data-file-index="{{file.fileIndex}}">移除</button>
              </view>
            </view>
          </swiper-item>
        </swiper>
        <view wx:if="{{!block.full}}" class="slot-add-row">
          <button class="upload-action primary" catchtap="chooseImage" data-slot-key="{{block.key}}">选图片</button>
          <button class="upload-action" catchtap="chooseFile" data-slot-key="{{block.key}}">从聊天选择</button>
        </view>
        <view wx:else class="slot-full-hint">该槽位已满（每槽最多 5 个文件）</view>
      </view>
    </view>
  </block>
  <view wx:else class="form-section">
    <view class="pick-category-first">选择激励大类与子类后上传文件</view>
  </view>

  <!-- ④审计信息(编辑/追加时, 与 PC 弹窗审计区同款) -->
  <view wx:if="{{uploadView.showAudit}}" class="audit-panel">
    <view class="form-section-title compact-title">审计信息</view>
    <view class="audit-grid">
      <view wx:for="{{uploadView.auditRows}}" wx:key="label" class="audit-item">
        <text class="audit-label">{{item.label}}</text>
        <text class="audit-value">{{item.valueText}}</text>
      </view>
    </view>
  </view>

  <!-- ⑤团队共享 + 格式提示(对齐 PC 弹窗提示文案) -->
  <view class="field switch-row">
    <view>
      <text class="label no-gap">团队共享</text>
      <view class="field-hint">开启后团队成员可见；关闭后仅本人、管理员或授权人员可见。</view>
      <view wx:if="{{uploadView.shareLocked}}" class="field-hint">仅上传人可修改共享状态，追加他人记录时保持原值。</view>
    </view>
    <switch checked="{{shared}}" disabled="{{uploadView.shareLocked}}" bindchange="toggleShared" color="#2563eb" />
  </view>
  <view class="dlg-tip">单文件最大 500MB，支持图片、视频、PDF、Word、Excel、压缩包等格式</view>

  <!-- 上传进度(提交中逐文件反馈) -->
  <view wx:if="{{uploadView.showUploadProgress}}" class="upload-progress-panel">
    <view class="upload-progress-track">
      <view class="upload-progress-fill" style="width: {{uploadView.uploadProgressWidth}};"></view>
    </view>
    <view class="upload-progress-text">{{uploadView.uploadProgressText}}</view>
  </view>

  <!-- 吸底操作条(文案对齐 PC: 上传并提交/追加提交) -->
  <view class="fixed-actions">
    <button class="form-action cancel-action" bindtap="cancelUpload" disabled="{{uploadView.cancelDisabled}}">{{uploadView.cancelText}}</button>
    <button class="form-action submit-action {{uploadView.submitIncomplete ? 'action-disabled' : ''}}" bindtap="submit" loading="{{uploadView.submitLoading}}" disabled="{{uploadView.submitDisabled}}">{{uploadView.submitText}}</button>
  </view>
  <view class="actions-spacer"></view>
</view>

<!-- 【#3 2026-10-12】客户选择半屏搜索层: 关键字过滤客户名称,替代滚轮 picker -->
<!-- 【C2 2026-10-21】真实模式改服务端搜索+分页(getCustomerList keyword/current/size): 滚到底
     追加下一页, total=服务端匹配总数; 选中按 customerId 定位(翻页后下标会错位) -->
<view wx:if="{{customerSheet.open}}" class="cs-mask" bindtap="closeCustomerSheet">
  <view class="cs-sheet" catchtap="noop">
    <view class="cs-sheet-head">
      <text class="cs-sheet-title">选择客户</text>
      <text class="cs-sheet-close" bindtap="closeCustomerSheet">✕</text>
    </view>
    <view class="cs-search-row">
      <input class="cs-search-input" value="{{customerSheet.keyword}}" placeholder="输入关键字搜索客户名称" confirm-type="search" bindinput="inputCustomerKeyword" />
      <text wx:if="{{customerSheet.keyword}}" class="cs-search-clear" bindtap="clearCustomerKeyword">清空</text>
    </view>
    <view class="cs-count-row">{{customerSheet.keyword ? '匹配 ' : '共 '}}{{customerSheet.total}} 个客户</view>
    <scroll-view scroll-y class="cs-list" bindscrolltolower="loadMoreCustomers">
      <view wx:for="{{customerSheet.filtered}}" wx:key="id" class="cs-item {{item.id === selectedCustomerId ? 'on' : ''}}" data-id="{{item.id}}" bindtap="pickCustomer">
        <view class="cs-item-name">{{item.name}}</view>
        <view wx:if="{{item.meta}}" class="cs-item-meta">{{item.meta}}</view>
      </view>
      <view wx:if="{{customerSheet.loading}}" class="cs-more">加载中…</view>
      <view wx:if="{{!customerSheet.loading && customerSheet.finished && customerSheet.filtered.length}}" class="cs-more">没有更多了</view>
      <view wx:if="{{!customerSheet.loading && !customerSheet.filtered.length}}" class="cs-empty">没有匹配「{{customerSheet.keyword}}」的客户</view>
    </scroll-view>
  </view>
</view>
