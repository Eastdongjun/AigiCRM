<view class="page">
  <view class="hero"><view class="hero-title">激励上传</view><view class="hero-sub">选择客户、激励分类，填写说明并上传佐证文件</view></view>
  <view class="card form-card">
    <view class="field"><text class="label">客户 *</text><picker mode="selector" range="{{customerNames}}" bindchange="chooseCustomer"><view class="pill">{{selectedCustomerIndex >= 0 ? customerNames[selectedCustomerIndex] : '请选择客户'}}⌄</view></picker></view>
    <view class="field"><text class="label">激励分类 *</text><picker mode="selector" range="{{categoryNames}}" bindchange="chooseCategory"><view class="pill">{{selectedCategoryIndex >= 0 ? categoryNames[selectedCategoryIndex] : '请选择分类'}}⌄</view></picker></view>
    <view class="field"><text class="label">说明 *</text><textarea value="{{description}}" bindinput="inputDescription" placeholder="请输入价值服务说明、现场情况或客户反馈" /></view>
    <view class="field"><text class="label">佐证文件 *</text><button class="secondary-btn" bindtap="chooseFile">{{fileName || '选择文件'}}</button></view>
    <button class="btn" bindtap="submit" loading="{{loading}}">提交激励</button>
  </view>
</view>
