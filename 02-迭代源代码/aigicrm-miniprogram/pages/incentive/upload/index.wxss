.form-card{margin-top:24rpx}.field-label{margin:24rpx 0 12rpx;color:#475569;font-size:26rpx;font-weight:700}.picker-card{display:flex;align-items:center;justify-content:space-between;min-height:78rpx;padding:0 22rpx;border:1rpx solid #dbeafe;border-radius:18rpx;background:#f8fbff;color:#172b4d;font-size:27rpx}.textarea{width:100%;min-height:150rpx;box-sizing:border-box;padding:20rpx;border:1rpx solid #dbeafe;border-radius:18rpx;background:#f8fbff;font-size:27rpx}.upload-grid{display:grid;grid-template-columns:1fr;gap:16rpx;margin-top:22rpx}.upload-slot{padding:22rpx;border:1rpx dashed #bcd5ff;border-radius:20rpx;background:#f8fbff}.upload-title{font-size:27rpx;font-weight:700;color:#2563eb;margin-bottom:8rpx}.submit-btn{width:100%;margin-top:28rpx}
