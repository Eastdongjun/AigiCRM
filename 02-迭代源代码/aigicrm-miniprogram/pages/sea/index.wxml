<view class="page sea-page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">公海池</view>
        <view class="hero-sub">同后端池级可见范围，可按权限发起捞取审批</view>
      </view>
      <button class="ghost-btn" bindtap="refresh" loading="{{seaView.refreshLoading}}">{{seaView.refreshText}}</button>
    </view>
  </view>
  <view class="grid">
    <view wx:for="{{seaView.statsCards}}" wx:key="key" class="card"><view class="num">{{item.valueText}}</view><view class="muted">{{item.label}}</view></view>
  </view>
  <view class="search-bar">
    <input class="search-input" placeholder="搜索客户名称" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
    <button class="sea-search-action" bindtap="searchTap">搜索</button>
  </view>
  <!-- 【2026-11-06 骨架】激活态条件化(原五枚写死 active 全蓝)+横滚防挤压 -->
  <view class="tabs">
    <picker mode="selector" range="{{['全部状态','待捞取','审批中','已捞取']}}" bindchange="chooseStatus"><view class="{{seaView.statusActive ? 'tab active' : 'tab'}}">{{seaView.statusText}}</view></picker>
    <picker mode="selector" range="{{pools}}" range-key="poolName" bindchange="choosePool"><view class="{{seaView.poolActive ? 'tab active' : 'tab'}}">{{seaView.poolText}}</view></picker>
    <picker mode="selector" range="{{deptOptions}}" range-key="label" value="{{selectedDeptIndex}}" bindchange="chooseDept"><view class="{{seaView.deptActive ? 'tab active' : 'tab'}}">{{seaView.deptText}}</view></picker>
    <picker mode="selector" range="{{industryPickerOptions}}" bindchange="chooseIndustry"><view class="{{seaView.industryActive ? 'tab active' : 'tab'}}">{{seaView.industryText}}</view></picker>
    <picker mode="selector" range="{{enterReasonOptions}}" range-key="label" bindchange="chooseEnterReason"><view class="{{seaView.reasonActive ? 'tab active' : 'tab'}}">{{seaView.enterReasonText}}</view></picker>
  </view>
  <view wx:if="{{seaView.showLoading}}" class="card muted">{{seaView.loadingText}}</view>
  <block wx:for="{{seaView.records}}" wx:key="id">
    <view class="card sea-record-card">
      <view data-index="{{index}}" bindtap="openCustomer">
        <view class="sea-record-head"><view class="sea-record-title">{{item.customerNameText}}</view><text class="pill">{{item.statusText}}</text></view>
        <view class="sea-record-tags"><text class="pill">{{item.industryText}}</text><text>{{item.regionText}}</text></view>
        <view class="detail-row"><text>编号</text><text>{{item.customerCodeText}}</text></view>
        <view class="detail-row"><text>原负责人</text><text>{{item.ownerNameText}}</text></view>
        <view class="detail-row"><text>入池原因</text><text>{{item.enterReasonText}}</text></view>
        <view class="detail-row"><text>入池时间</text><text>{{item.enterDateText}}</text></view>
        <!-- 【2026-11-06 去重】权限行只在无按钮(仅查看)时显示解释空态; 按钮齐全时与按钮重复故隐藏 -->
        <view wx:if="{{!item.canShowActions}}" class="sea-permission">可操作权限：{{item.permissionText}}</view>
      </view>
      <view wx:if="{{item.canShowActions}}" class="sea-actions">
        <button wx:if="{{item.canClaimNow}}" class="sea-claim-action" data-index="{{index}}" bindtap="claim" loading="{{item.claimLoading}}">捞取</button>
        <button wx:if="{{item.canEdit}}" class="sea-edit-action" data-index="{{index}}" bindtap="editSeaCustomer">编辑</button>
        <button wx:if="{{item.canDeleteNow}}" class="sea-delete-action" data-index="{{index}}" bindtap="deleteSeaCustomer" loading="{{item.deleteLoading}}">删除</button>
      </view>
    </view>
  </block>
  <pager wx:if="{{total > 10}}" page="{{page}}" pageSize="{{pageSize}}" total="{{total}}" loading="{{seaView.showLoading}}" bind:change="onPagerChange" />
  <view wx:if="{{seaView.showEmpty}}" class="card muted">暂无公海客户</view>
  <view class="card sea-claim-card">
    <view class="row">
      <view class="section-title">我的捞取申请</view>
      <button wx:if="{{seaView.showLatestClaim}}" class="text-btn" data-index="0" bindtap="openClaimDetail">最新申请</button>
    </view>
    <block wx:for="{{seaView.claimRecords}}" wx:key="id"><view class="detail-row"><text>{{item.titleText}}</text><text>{{item.statusText}}</text></view></block>
    <view wx:if="{{seaView.showClaimEmpty}}" class="muted">暂无捞取申请</view>
  </view>
</view>
