.sea-record-card{margin-top:20rpx}
.sea-record-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.sea-record-title{flex:1;min-width:0;color:#172033;font-size:30rpx;font-weight:760;line-height:1.35}
.sea-record-tags{display:flex;align-items:center;gap:12rpx;margin-top:14rpx;color:#64748b;font-size:24rpx}
.sea-permission{margin-top:18rpx;color:#94a3b8;font-size:23rpx;line-height:1.45}
.sea-search-action,.sea-claim-action,.sea-edit-action,.sea-delete-action{height:50rpx;line-height:48rpx;margin:0;padding:0 16rpx;border-radius:14rpx;font-size:22rpx;font-weight:720}
.sea-search-action::after,.sea-claim-action::after,.sea-edit-action::after,.sea-delete-action::after{border:0}
.sea-search-action{min-width:92rpx;border:0;background:#2563eb;color:#fff}
.sea-actions{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;margin-top:20rpx;flex-wrap:wrap}
.sea-claim-action{min-width:96rpx;border:0;background:#2563eb;color:#fff;box-shadow:0 8rpx 18rpx rgba(37,99,235,.16)}
.sea-edit-action{min-width:96rpx;border:1rpx solid #d8e1ee;background:#f8fafc;color:#475569}
.sea-delete-action{min-width:96rpx;border:1rpx solid #fecaca;background:#fff7f7;color:#dc2626}
.sea-claim-card{margin-top:22rpx}
