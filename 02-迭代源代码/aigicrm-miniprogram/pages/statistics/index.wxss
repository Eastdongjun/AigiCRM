.statistics-page {
  padding-bottom: 40rpx;
}

/* 【2026-10-26 用户令"统计分析页面 注意骨架"】hero 压单行细条: 与四项服务/应用中心顶部统一
   (26rpx 圆角+深蓝渐变+同款阴影), 覆盖 app.wxss .stats-hero 的四行排版与装饰圆 */
.stats-hero-bar {
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #0d1733 0%, #16337a 58%, #1d4ed8 100%);
  box-shadow: 0 18rpx 38rpx rgba(13, 23, 51, .22);
}

.stats-hero-bar:after {
  display: none;
}

.stats-bar-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.stats-detail-action {
  display: flex;
  width: 236rpx;
  height: 52rpx;
  margin: 26rpx 0 0 auto;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c7d7ee;
  border-radius: 8rpx;
  background: #f8fbff;
  color: #1d4ed8;
  font-size: 23rpx;
  font-weight: 760;
  line-height: 50rpx;
}

.stats-detail-action::after {
  border: 0;
}

.stats-filter-card {
  padding: 22rpx;
}

.stats-filter-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.stats-filter-head > text {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 26rpx;
}

.statistics-page .stats-section-head .text-btn {
  min-width: 72rpx;
  height: 42rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid #d8e4f2;
  border-radius: 8rpx;
  background: #fff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.statistics-page .stats-section-head .text-btn::after {
  border: 0;
}

.stats-filter-title {
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.stats-filter-summary {
  margin-top: 6rpx;
  color: #172033;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 38rpx;
}

.stats-filter-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.stats-filter-chip {
  min-width: 0;
  overflow: hidden;
  padding: 14rpx 16rpx;
  border: 1rpx solid #dbe4f0;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #334155;
}

.stats-filter-chip text {
  display: block;
  color: #7c8ba1;
  font-size: 20rpx;
  line-height: 26rpx;
}

.stats-filter-chip view {
  margin-top: 6rpx;
  overflow: hidden;
  color: #172033;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-signal-card {
  margin: 20rpx 0;
  padding: 22rpx;
  border: 1rpx solid #dbe7f5;
  border-radius: 18rpx;
  background: #fbfdff;
}

.stats-signal-card.warning {
  border-color: #fed7aa;
  background: #fffaf4;
}

.stats-signal-card.stable {
  border-color: #bbf7d0;
  background: #f7fef9;
}

.stats-signal-card.watch {
  border-color: #fde68a;
  background: #fffdf2;
}

.stats-signal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.stats-signal-head > text {
  flex: none;
  max-width: 220rpx;
  overflow: hidden;
  color: #64748b;
  font-size: 21rpx;
  line-height: 30rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-signal-head view text {
  display: block;
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 850;
  line-height: 28rpx;
}

.stats-signal-head view view {
  margin-top: 6rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.stats-signal-sub {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 32rpx;
}

.stats-signal-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.stats-signal-item {
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  background: #fff;
  text-align: center;
}

.stats-signal-item text {
  display: block;
  overflow: hidden;
  color: #7c8ba1;
  font-size: 19rpx;
  line-height: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-signal-item view {
  margin-top: 6rpx;
  overflow: hidden;
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-signal-item.blue view {
  color: #2563eb;
}

.stats-signal-item.green view {
  color: #047857;
}

.stats-signal-item.orange view {
  color: #c2410c;
}

.stats-signal-item.red view {
  color: #dc2626;
}

.statistics-page .stats-primary-badge {
  flex-shrink: 0;
  background: #ecfdf5;
  color: #047857;
}

.statistics-page .stats-progress-bar {
  transition: width .2s ease;
}

.stats-risk-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid;
  border-radius: 16rpx;
}

.stats-risk-note text {
  display: block;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 32rpx;
}

.stats-risk-note view {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 30rpx;
}

.stats-risk-note.warning {
  border-color: #fed7aa;
  background: #fff7ed;
  color: #c2410c;
}

.stats-risk-note.stable {
  border-color: #bbf7d0;
  background: #f0fdf4;
  color: #047857;
}

.stats-insight-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.stats-insight-item {
  min-width: 0;
  padding: 16rpx 14rpx;
  border: 1rpx solid #e5edf6;
  border-radius: 18rpx;
  background: #f8fbff;
}

.stats-insight-item text {
  display: block;
  overflow: hidden;
  color: #7c8ba1;
  font-size: 21rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-insight-item view {
  margin-top: 8rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.stats-trend-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stats-trend-card {
  padding: 24rpx;
}

.trend-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
}

.trend-card-head text:last-child {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
}

.trend-bars {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  align-items: end;
  gap: 8rpx;
  height: 210rpx;
  margin-top: 22rpx;
}

.trend-bar-col {
  display: flex;
  min-width: 0;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.trend-bar-value {
  min-height: 24rpx;
  color: #475569;
  font-size: 20rpx;
  line-height: 24rpx;
}

.trend-bar-track {
  position: relative;
  width: 100%;
  height: 120rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f7;
}

.trend-bar-fill {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 10rpx;
  border-radius: 999rpx;
}

.trend-bar-fill.customer {
  background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%);
}

.trend-bar-fill.file {
  background: linear-gradient(180deg, #10b981 0%, #059669 100%);
}

.trend-bar-label {
  color: #94a3b8;
  font-size: 18rpx;
  line-height: 22rpx;
  white-space: nowrap;
  transform: scale(0.9);
}

.trend-foot {
  margin-top: 18rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 32rpx;
}

.stats-status-card {
  padding: 24rpx;
}

.status-row + .status-row {
  margin-top: 22rpx;
}

.status-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #334155;
  font-size: 25rpx;
  font-weight: 600;
}

.status-row-head text:last-child {
  color: #64748b;
  font-size: 23rpx;
  font-weight: 500;
}

.status-track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f7;
}

.status-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
}

.status-fill.green {
  background: #10b981;
}

.status-fill.orange {
  background: #f59e0b;
}

.status-fill.red {
  background: #ef4444;
}

.stats-industry-card,
.stats-score-card {
  padding: 24rpx;
}

.industry-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.industry-row + .industry-row {
  margin-top: 22rpx;
}

.industry-rank {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
}

.industry-main {
  min-width: 0;
  flex: 1;
}

.industry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #334155;
  font-size: 25rpx;
  font-weight: 700;
}

.industry-head text:last-child {
  color: #64748b;
  font-size: 23rpx;
  font-weight: 500;
  white-space: nowrap;
}

.industry-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f7;
}

.industry-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #60a5fa 0%, #2563eb 100%);
}

.score-row {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  gap: 18rpx;
}

.score-row + .score-row {
  margin-top: 12rpx;
}

.score-rank {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #cbd5e1;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.rank-1 {
  background: #f59e0b;
}

.rank-2 {
  background: #3b82f6;
}

.rank-3 {
  background: #10b981;
}

.score-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #334155;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-value {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 800;
  white-space: nowrap;
}

/* 经营分析/保护期雷达区块卡化后的外间距与内边距 */
.stats-risk-panel { margin-top: 22rpx; padding: 24rpx 24rpx 26rpx; }

/* 「更新」重设计: 圆形图标按钮 */
.stats-refresh-btn { width: 56rpx; height: 56rpx; min-width: 0; margin: 0; padding: 0; border-radius: 50%;
  border: 1rpx solid #cfe0f7; background: #f5f9ff; color: #1d4ed8; font-size: 30rpx; line-height: 54rpx;
  display: flex; align-items: center; justify-content: center; }
.stats-refresh-btn::after { border: none; }
