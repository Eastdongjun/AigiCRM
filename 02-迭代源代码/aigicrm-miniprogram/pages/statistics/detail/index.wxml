<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">统计明细</view>
        <view class="hero-sub">当前用户数据范围内的经营摘要</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>
  <scroll-view class="tabs" scroll-x="true">
    <view class="tab {{section==='customer'?'active':''}}" data-section="customer" bindtap="switchSection">客户</view>
    <view class="tab {{section==='approval'?'active':''}}" data-section="approval" bindtap="switchSection">审批</view>
    <view class="tab {{section==='sea'?'active':''}}" data-section="sea" bindtap="switchSection">公海</view>
    <view class="tab {{section==='activity'?'active':''}}" data-section="activity" bindtap="switchSection">团队动态</view>
    <view class="tab {{section==='trend'?'active':''}}" data-section="trend" bindtap="switchSection">趋势</view>
  </scroll-view>
  <view wx:if="{{loading}}" class="card muted">加载中...</view>
  <view wx:if="{{!loading && section==='customer'}}" class="card">
    <view class="detail-row"><text>我的客户</text><text>{{stats.myCustomers || 0}}</text></view>
    <view class="detail-row"><text>保护期客户</text><text>{{stats.inProtection || 0}}</text></view>
    <view class="detail-row"><text>即将到期</text><text>{{stats.expiring || 0}}</text></view>
    <view class="detail-row"><text>今日到期</text><text>{{stats.todayExpiring || 0}}</text></view>
    <view class="detail-row"><text>已过期</text><text>{{stats.expired || 0}}</text></view>
    <view class="detail-row"><text>本月新增</text><text>{{stats.monthNew || 0}}</text></view>
  </view>
  <view wx:if="{{!loading && section==='approval'}}" class="card">
    <view class="detail-row"><text>待审批</text><text>{{stats.approvalStats.pending || 0}}</text></view>
    <view class="detail-row"><text>已通过</text><text>{{stats.approvalStats.approved || 0}}</text></view>
    <view class="detail-row"><text>已驳回</text><text>{{stats.approvalStats.rejected || 0}}</text></view>
  </view>
  <view wx:if="{{!loading && section==='sea'}}" class="card">
    <view class="detail-row"><text>公海客户</text><text>{{stats.seaStats.total || stats.seaStats.count || 0}}</text></view>
    <view class="detail-row"><text>可捞取</text><text>{{stats.seaStats.available || 0}}</text></view>
  </view>
  <view wx:if="{{!loading && section==='activity'}}" class="card">
    <view wx:if="{{activities.length === 0}}" class="muted">暂无团队动态</view>
    <view wx:for="{{activities}}" wx:key="index" class="activity-row">
      <view class="activity-main"><text class="activity-type">{{item.type || '动态'}}</text><text>{{item.content || item.description || '-'}}</text></view>
      <view class="activity-meta"><text>{{item.actor || item.userName || '-'}}</text><text>{{item.createdAt || item.time || '-'}}</text></view>
    </view>
  </view>
  <view wx:if="{{!loading && section==='trend'}}" class="card">
    <view class="section-title">本月日报</view>
    <view wx:if="{{daily.customerDays.length === 0 && daily.fileDays.length === 0}}" class="muted">暂无日报数据</view>
    <view wx:for="{{daily.customerDays}}" wx:key="date" class="detail-row"><text>{{item.date || item.day}}</text><text>新增客户 {{item.value || 0}}</text></view>
    <view wx:for="{{daily.fileDays}}" wx:key="date" class="detail-row"><text>{{item.date || item.day}}</text><text>文件 {{item.value || 0}}</text></view>
    <view class="section-title">本月周报</view>
    <view wx:if="{{weekly.customerWeeks.length === 0 && weekly.fileWeeks.length === 0}}" class="muted">暂无周报数据</view>
    <view wx:for="{{weekly.customerWeeks}}" wx:key="label" class="detail-row"><text>{{item.label || item.week || '-'}}</text><text>新增客户 {{item.value || 0}}</text></view>
    <view wx:for="{{weekly.fileWeeks}}" wx:key="label" class="detail-row"><text>{{item.label}}</text><text>文件 {{item.value || 0}}</text></view>
  </view>
  <button class="secondary-btn" style="margin:20rpx auto" bindtap="refresh">刷新数据</button>
</view>
