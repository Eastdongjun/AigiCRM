<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">经营统计</view><view class="hero-sub">统一数据范围 · 只读摘要</view></view><button class="ghost-btn" bindtap="refresh" loading="{{loading}}">刷新</button></view></view><view wx:if="{{loading}}" class="card muted">加载中...</view><view class="grid" style="margin-top:24rpx"><view class="card stat-card"><view class="num">{{stats.myCustomers || 0}}</view><view class="muted">我的客户</view></view><view class="card stat-card"><view class="num">{{stats.inProtection || 0}}</view><view class="muted">保护期客户</view></view><view class="card stat-card"><view class="num">{{stats.expiring || 0}}</view><view class="muted">即将到期</view></view><view class="card stat-card"><view class="num">{{stats.todayExpiring || 0}}</view><view class="muted">今日到期</view></view><view class="card stat-card"><view class="num">{{stats.monthNew || 0}}</view><view class="muted">本月新增</view></view></view><view class="card" style="margin-top:20rpx"><view class="section-title">审批摘要</view><view class="detail-row"><text>待审批</text><text>{{stats.approvalStats.pending || 0}}</text></view><view class="detail-row"><text>已通过</text><text>{{stats.approvalStats.approved || 0}}</text></view><view class="detail-row"><text>已驳回</text><text>{{stats.approvalStats.rejected || 0}}</text></view></view><view class="card" style="margin-top:20rpx"><view class="section-title">到期预警</view><block wx:for="{{expiringDetails}}" wx:key="customerName"><view class="detail-row"><text>{{item.customerName}}</text><text>剩 {{item.daysLeft}} 天</text></view></block><view wx:if="{{expiringDetails.length===0}}" class="muted">暂无到期预警</view></view></view>
<button class="secondary-btn" style="margin:20rpx auto" bindtap="openDetail">查看统计明细</button>
