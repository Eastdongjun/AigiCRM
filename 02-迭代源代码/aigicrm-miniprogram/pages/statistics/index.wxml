<view class="page statistics-page">
  <!-- 【2026-10-26 用户令"统计分析页面 注意骨架"】顶部四行 hero(看板语/副标题/指标胶囊)压成单行细条,
       统一深蓝语言; 指标胶囊数字与下方经营信号区重复(本月新增/待审批), 删之不丢数据 -->
  <view class="stats-hero stats-hero-bar">
    <text class="stats-bar-title">统计分析</text>
    <button class="stats-refresh" bindtap="refresh" loading="{{statsView.refreshLoading}}">{{statsView.refreshText}}</button>
  </view>

  <view wx:if="{{statsView.showLoading}}" class="card loading-card">{{statsView.loadingText}}</view>

  <view class="card stats-filter-card">
    <view class="stats-filter-head">
      <view>
        <view class="stats-filter-title">分析筛选</view>
        <view class="stats-filter-summary">{{statsView.filterSummary}}</view>
      </view>
      <text>当前口径</text>
    </view>
    <view class="stats-filter-row">
      <picker mode="selector" range="{{yearOptions}}" value="{{selectedYearIndex}}" bindchange="chooseYear">
        <view class="stats-filter-chip">
          <text>{{statsView.filterChips[0].label}}</text>
          <view>{{statsView.filterChips[0].value}}⌄</view>
        </view>
      </picker>
      <picker mode="selector" range="{{deptOptions}}" range-key="label" value="{{selectedDeptIndex}}" bindchange="chooseDept">
        <view class="stats-filter-chip">
          <text>{{statsView.filterChips[1].label}}</text>
          <view>{{statsView.filterChips[1].value}}⌄</view>
        </view>
      </picker>
    </view>
  </view>

  <view class="{{statsView.signalSummary.className}}">
    <view class="stats-signal-head">
      <view>
        <text>经营信号</text>
        <view>{{statsView.signalSummary.title}}</view>
      </view>
      <text>{{statsView.filterSummary}}</text>
    </view>
    <view class="stats-signal-sub">{{statsView.signalSummary.subtitle}}</view>
    <view class="stats-signal-grid">
      <view wx:for="{{statsView.signalSummary.rows}}" wx:key="key" class="stats-signal-item {{item.tone}}">
        <text>{{item.label}}</text>
        <view>{{item.value}}</view>
      </view>
    </view>
  </view>

  <view class="stats-primary-card">
    <view class="stats-primary-top">
      <view>
        <view class="stats-primary-label">客户资产</view>
        <view class="stats-primary-value">{{statsView.customerAsset.total}}<text>家</text></view>
      </view>
      <view class="stats-primary-badge">保护率 {{statsView.customerAsset.protectionRate}}%</view>
    </view>
    <view class="stats-progress-track">
      <view class="stats-progress-bar" style="width: {{statsView.customerAsset.protectionWidth}};"></view>
    </view>
    <view class="{{statsView.customerAsset.riskClass}}">
      <text>{{statsView.customerAsset.riskTitle}}</text>
      <view>{{statsView.customerAsset.riskText}}</view>
    </view>
    <view class="stats-primary-meta">
      <text wx:for="{{statsView.customerAsset.meta}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="stats-insight-row">
      <view wx:for="{{statsView.customerAsset.insights}}" wx:key="label" class="stats-insight-item">
        <text>{{item.label}}</text>
        <view>{{item.value}}</view>
      </view>
    </view>
  </view>

  <view class="stats-section-head"><text>保护期雷达</text><button class="text-btn" bindtap="openDetail">展开</button></view>
  <view class="card stats-risk-panel">
    <view class="stats-grid">
      <view wx:for="{{statsView.riskTiles}}" wx:key="label" class="stats-tile {{item.tone}}"><view>{{item.value}}</view><text>{{item.label}}</text></view>
    </view>
  </view>

  <view class="stats-section-head"><text>业务总览</text><button class="stats-refresh-btn" bindtap="refresh">↻</button></view>
  <view class="card stats-risk-panel">
    <view class="stats-grid">
      <view wx:for="{{statsView.analysisTiles}}" wx:key="label" class="stats-tile {{item.tone}}"><view>{{item.value}}</view><text>{{item.label}}</text></view>
    </view>
  </view>

  <view class="stats-section-head"><text>月度趋势</text><button class="text-btn" bindtap="openDetail">明细</button></view>
  <view class="stats-trend-grid">
    <view class="card stats-trend-card">
      <view class="trend-card-head">
        <text>月度新增客户</text>
        <text>{{statsView.monthlyCustomer.totalText}}</text>
      </view>
      <view class="trend-bars">
        <view wx:for="{{statsView.monthlyCustomer.bars}}" wx:key="label" class="trend-bar-col">
          <view class="trend-bar-value">{{item.value}}</view>
          <view class="trend-bar-track">
            <view class="trend-bar-fill customer" style="height: {{item.height}}%;"></view>
          </view>
          <view class="trend-bar-label">{{item.label}}</view>
        </view>
      </view>
      <view class="trend-foot">{{statsView.monthlyCustomer.footText}}</view>
    </view>

    <view class="card stats-trend-card">
      <view class="trend-card-head">
        <text>月度文件上传</text>
        <text>{{statsView.monthlyFile.totalText}}</text>
      </view>
      <view class="trend-bars">
        <view wx:for="{{statsView.monthlyFile.bars}}" wx:key="label" class="trend-bar-col">
          <view class="trend-bar-value">{{item.value}}</view>
          <view class="trend-bar-track">
            <view class="trend-bar-fill file" style="height: {{item.height}}%;"></view>
          </view>
          <view class="trend-bar-label">{{item.label}}</view>
        </view>
      </view>
      <view class="trend-foot">{{statsView.monthlyFile.footText}}</view>
    </view>
  </view>

  <view class="stats-section-head"><text>客户状态分布</text><button class="text-btn" bindtap="openDetail">客户</button></view>
  <view class="card stats-status-card">
    <view wx:for="{{statusRows}}" wx:key="key" class="status-row">
      <view class="status-row-head">
        <text>{{item.label}}</text>
        <text>{{item.value}} · {{item.pct}}%</text>
      </view>
      <view class="status-track">
        <view class="status-fill {{item.tone}}" style="width: {{item.pct}}%;"></view>
      </view>
    </view>
  </view>

  <view class="stats-section-head"><text>行业分布</text><button class="text-btn" bindtap="openDetail">分布</button></view>
  <view class="card stats-industry-card">
    <block wx:for="{{statsView.industryRows}}" wx:key="name">
      <view class="industry-row">
        <view class="industry-rank">{{item.rank}}</view>
        <view class="industry-main">
          <view class="industry-head">
            <text>{{item.name}}</text>
            <text>{{item.count}} 家 · {{item.pct}}%</text>
          </view>
          <view class="industry-track">
            <view class="industry-fill" style="width: {{item.pct}}%;"></view>
          </view>
        </view>
      </view>
    </block>
    <view wx:if="{{statsView.showIndustryEmpty}}" class="empty-state compact-empty"><view class="empty-icon">⌁</view><text>暂无行业分布</text></view>
  </view>

  <view class="stats-section-head"><text>办事处对比</text><button class="text-btn" bindtap="openDetail">趋势</button></view>
  <view class="card">
    <block wx:for="{{statsView.officeRows}}" wx:key="id">
      <view class="stats-warning-row">
        <view>
          <view class="warning-name">{{item.officeName}}</view>
          <text>{{item.summaryText}}</text>
        </view>
        <text class="warning-countdown">{{item.customerText}}</text>
      </view>
    </block>
    <view wx:if="{{statsView.showOfficeEmpty}}" class="empty-state compact-empty"><view class="empty-icon">⌁</view><text>暂无办事处对比</text></view>
  </view>

  <view class="stats-section-head"><text>人员学分 Top5</text><button class="text-btn" bindtap="openDetail">排行</button></view>
  <view class="card stats-score-card">
    <block wx:for="{{statsView.scoreRows}}" wx:key="id">
      <view class="score-row">
        <view class="{{item.rankClass}}">{{item.rank}}</view>
        <text class="score-name">{{item.realName}}</text>
        <text class="score-value">{{item.scoreText}}</text>
      </view>
    </block>
    <view wx:if="{{statsView.showScoreEmpty}}" class="empty-state compact-empty"><view class="empty-icon">⌁</view><text>暂无学分数据</text></view>
  </view>

  <view class="stats-section-head"><text>审批摘要</text><button class="text-btn" bindtap="openDetail">明细</button></view>
  <view class="stats-approval-card">
    <view wx:for="{{statsView.approvalRows}}" wx:key="label" class="{{item.className}}"><text>{{item.value}}</text><view>{{item.label}}</view></view>
  </view>

  <view class="stats-section-head"><text>到期预警</text><button class="text-btn" bindtap="openDetail">全部</button></view>
  <view class="card stats-warning-card">
    <block wx:for="{{statsView.expiringRows}}" wx:key="id">
      <view class="stats-warning-row">
        <view><view class="warning-name">{{item.customerName}}</view><text>保护期即将到期</text></view>
        <text class="warning-countdown">{{item.countdownText}}</text>
      </view>
    </block>
    <view wx:if="{{statsView.showExpiringEmpty}}" class="empty-state compact-empty"><view class="empty-icon">✓</view><text>暂无到期预警</text></view>
  </view>

  <button class="stats-detail-action" bindtap="openDetail">查看统计明细</button>
</view>
