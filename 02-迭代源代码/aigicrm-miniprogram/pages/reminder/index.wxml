<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">提醒中心</view><view class="hero-sub">同 PC 待办提醒 · 当前待处理 {{pendingCount}} 条</view></view><button class="ghost-btn" bindtap="refresh" loading="{{loading}}">刷新</button></view></view><view class="tabs"><button class="tab" data-mode="pending" bindtap="switchView">待处理</button><button class="tab" data-mode="expiring" bindtap="switchView">到期客户</button></view><view class="search-bar"><input class="search-input" placeholder="搜索客户或提醒内容" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" /><button class="btn compact-btn" bindtap="search">查询</button></view><view wx:if="{{loading}}" class="card muted" style="margin-top:24rpx">加载中...</view><block wx:for="{{reminders}}" wx:key="id"><view class="card" style="margin-top:20rpx"><view class="row"><view style="font-size:30rpx;font-weight:700;flex:1">{{item.customerName}}</view><text class="pill">{{item.type}}</text></view><view class="muted" style="margin-top:14rpx">{{item.content}}</view><view class="detail-row"><text>到期时间</text><text>{{item.expireDate || '-'}}</text></view><view class="row action-row"><button class="secondary-btn" data-index="{{index}}" bindtap="openDetail">查看详情</button><button class="secondary-btn" data-index="{{index}}" bindtap="openCustomer">客户详情</button><button class="btn compact-btn" data-index="{{index}}" bindtap="process">已处理</button></view></view></block><view wx:if="{{!loading && reminders.length===0}}" class="card muted" style="margin-top:24rpx">暂无待处理提醒</view><view wx:if="{{selectedReminder}}" class="modal-mask"><view class="card reminder-modal"><view class="row"><view class="hero-title">提醒详情</view><button class="ghost-btn close-btn" bindtap="closeDetail">关闭</button></view><view class="detail-row"><text>客户</text><text>{{selectedReminder.customerName}}</text></view><view class="detail-row"><text>类型</text><text>{{selectedReminder.type}}</text></view><view class="detail-row"><text>到期时间</text><text>{{selectedReminder.expireDate || '-'}}</text></view><view class="reminder-content">{{selectedReminder.content}}</view><view class="action-row"><button class="btn compact-btn" data-index="{{reminders.indexOf(selectedReminder)}}" bindtap="process">已处理</button></view></view></view></view>
