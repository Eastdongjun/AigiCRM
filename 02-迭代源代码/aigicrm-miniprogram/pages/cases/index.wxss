.case-detail-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.case-detail-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  color: #64748b;
  border-bottom: 1rpx solid #e2e8f0;
}
