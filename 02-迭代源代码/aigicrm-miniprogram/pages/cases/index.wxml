<view class="page cases-page">
  <view class="page-head">
    <view>
      <view class="eyebrow">VALUE SERVICE</view>
      <view class="page-title">价值服务案例</view>
      <view class="page-subtitle">沉淀客户合作成果，推动下一次增长</view>
    </view>
    <button class="head-add" bindtap="openAdd">＋</button>
  </view>

  <view class="summary-grid">
    <view class="summary-item"><view class="summary-value">{{summary.total}}</view><view class="summary-label">全部案例</view></view>
    <view class="summary-item"><view class="summary-value blue">{{summary.active}}</view><view class="summary-label">进行中</view></view>
    <view class="summary-item"><view class="summary-value green">{{summary.completed}}</view><view class="summary-label">已完成</view></view>
    <view class="summary-item"><view class="summary-value orange">{{summary.score}}</view><view class="summary-label">平均评分</view></view>
  </view>

  <view class="search-box"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索客户、案例或负责人" /></view>
  <scroll-view scroll-x class="category-scroll" enable-flex>
    <view class="category-list">
      <view wx:for="{{categories}}" wx:key="*this" class="category {{activeCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="onCategoryTap">{{item}}</view>
    </view>
  </scroll-view>

  <view class="section-row"><view class="section-title">案例清单</view><view class="section-count">{{filteredCases.length}} 条记录</view></view>
  <view wx:if="{{filteredCases.length}}" class="case-list">
    <view wx:for="{{filteredCases}}" wx:key="id" class="case-card" data-item="{{item}}" bindtap="openDetail">
      <view class="case-accent"></view>
      <view class="case-main">
        <view class="case-top"><text class="case-category">{{item.category}}</text><text class="case-status {{item.status === '已完成' ? 'done' : ''}}">{{item.status}}</text></view>
        <view class="case-title">{{item.title}}</view>
        <view class="case-customer">{{item.customerName}}</view>
        <view class="tag-row"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text></view>
        <view class="case-meta"><text>负责人：{{item.ownerName}}</text><text>{{item.updatedAt}}</text></view>
      </view>
      <view class="score"><text>{{item.score}}</text><text class="score-label">价值评分</text></view>
    </view>
  </view>
  <view wx:else class="empty-state"><text class="empty-icon">⌁</text><text>暂未找到匹配案例</text></view>

  <view wx:if="{{selectedCase}}" class="case-detail-mask" bindtap="closeDetail">
    <view class="case-detail-panel" catchtap="noop">
      <view class="section-row"><view class="section-title">案例详情</view><text bindtap="closeDetail">关闭</text></view>
      <view class="case-title">{{selectedCase.title}}</view>
      <view class="case-customer">{{selectedCase.customerName}}</view>
      <view class="detail-row"><text>分类</text><text>{{selectedCase.category}}</text></view>
      <view class="detail-row"><text>状态</text><text>{{selectedCase.status}}</text></view>
      <view class="detail-row"><text>负责人</text><text>{{selectedCase.ownerName}}</text></view>
      <view class="detail-row"><text>价值评分</text><text>{{selectedCase.score}}</text></view>
    </view>
  </view>

</view>
