.approval-tab-scroll{margin:24rpx 0 16rpx;white-space:nowrap}
.approval-tab-list{display:flex;gap:14rpx}
.approval-tab{display:inline-flex;align-items:center;height:58rpx;padding:0 22rpx;border-radius:999rpx;background:#fff;color:#475569;font-size:24rpx;box-shadow:0 6rpx 18rpx rgba(41,72,125,.06)}
.approval-tab.active{background:#2563eb;color:#fff;font-weight:700}
.approval-tab-count{display:inline-flex;min-width:30rpx;height:28rpx;margin-left:8rpx;padding:0 8rpx;align-items:center;justify-content:center;border-radius:999rpx;background:#eef2ff;color:#2563eb;font-size:19rpx;line-height:28rpx}
.approval-tab.active .approval-tab-count{background:rgba(255,255,255,.22);color:#fff}
.approval-filter-card{margin-bottom:18rpx;padding:18rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(41,72,125,.07)}
.approval-search-row{display:flex;align-items:center;gap:14rpx}
.approval-search-input{flex:1;min-width:0;height:64rpx;padding:0 18rpx;border:1rpx solid #dbeafe;border-radius:18rpx;background:#f8fbff;color:#172033;font-size:25rpx}
.approval-search-btn{width:92rpx;height:50rpx;line-height:50rpx;margin:0;padding:0;border-radius:999rpx;background:#2563eb;color:#fff;font-size:22rpx}
.approval-search-btn::after{border:0}
.approval-filter-row{display:flex;gap:14rpx;margin-top:14rpx}
.approval-filter-row picker{flex:1;min-width:0}
.approval-filter-chip{height:58rpx;line-height:58rpx;padding:0 18rpx;border:1rpx solid #dbeafe;border-radius:18rpx;background:#fff;color:#334155;font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.approval-queue-card{margin:0 0 18rpx;padding:20rpx 22rpx;border-radius:20rpx;background:#f8fbff}
.approval-queue-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.approval-queue-head view{min-width:0}
.approval-queue-head view text{display:block;color:#2563eb;font-size:21rpx;font-weight:850;line-height:28rpx}
.approval-queue-head view view{margin-top:5rpx;overflow:hidden;color:#172033;font-size:28rpx;font-weight:900;line-height:36rpx;text-overflow:ellipsis;white-space:nowrap}
.approval-queue-head>text{flex:none;padding:6rpx 12rpx;border-radius:999rpx;background:#eff6ff;color:#1d4ed8;font-size:20rpx;font-weight:800;line-height:26rpx}
.approval-queue-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:16rpx}
.approval-queue-grid>view{min-width:0;padding:12rpx 14rpx;border-radius:14rpx;background:#fff}
.approval-queue-grid text{display:block;overflow:hidden;color:#7c8ba1;font-size:20rpx;line-height:26rpx;text-overflow:ellipsis;white-space:nowrap}
.approval-queue-grid view view{margin-top:4rpx;overflow:hidden;color:#334155;font-size:23rpx;font-weight:800;line-height:30rpx;text-overflow:ellipsis;white-space:nowrap}
.approval-action-row{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;margin-top:18rpx;flex-wrap:wrap}
.approval-action-row button{min-width:96rpx;height:50rpx;line-height:48rpx;margin:0;padding:0 18rpx;border-radius:14rpx;font-size:22rpx;font-weight:700}
.approval-action-row button::after{border:0}
.approval-link-action{border:1rpx solid #d8e1ee;background:#f8fafc;color:#475569}
.approval-reject-action{border:1rpx solid #fecaca;background:#fff7f7;color:#dc2626}
.approval-approve-action{border:0;background:#2563eb;color:#fff;box-shadow:0 8rpx 18rpx rgba(37,99,235,.16)}
