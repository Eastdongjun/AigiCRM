<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">审批中心</view>
        <view class="hero-sub">PC 与移动端同一审批流</view>
      </view>
      <button class="ghost-btn" bindtap="refresh" loading="{{approvalView.refreshLoading}}">{{approvalView.refreshText}}</button>
    </view>
  </view>
  <view class="grid">
    <view wx:for="{{approvalView.statsCards}}" wx:key="key" class="card approval-stat-card"><view class="num">{{item.valueText}}</view><view class="muted">{{item.label}}</view></view>
  </view>
  <scroll-view scroll-x class="approval-tab-scroll" enable-flex>
    <view class="approval-tab-list">
      <view wx:for="{{approvalView.tabs}}" wx:key="key" class="approval-tab {{item.activeClass}}" data-tab="{{item.key}}" bindtap="changeTab">{{item.label}}<text class="approval-tab-count">{{item.countText}}</text></view>
    </view>
  </scroll-view>
  <view class="approval-filter-card">
    <view class="approval-search-row">
      <input class="approval-search-input" placeholder="搜索编号、客户名、申请人" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
      <button class="approval-search-btn" bindtap="search">查询</button>
    </view>
    <view class="approval-filter-row">
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{selectedTypeIndex}}" bindchange="chooseType">
        <view class="approval-filter-chip">{{approvalView.typeText}}</view>
      </picker>
      <picker mode="selector" range="{{deptOptions}}" range-key="name" value="{{selectedDeptIndex}}" bindchange="chooseDept">
        <view class="approval-filter-chip">{{approvalView.deptText}}</view>
      </picker>
    </view>
  </view>
  <view class="approval-queue-card">
    <view class="approval-queue-head">
      <view>
        <text>当前审批队列</text>
        <view>{{approvalView.queueSummary}}</view>
      </view>
      <text>{{approvalView.queueResultText}}</text>
    </view>
    <view class="approval-queue-grid">
      <view wx:for="{{approvalView.queueChips}}" wx:key="key">
        <text>{{item.label}}</text>
        <view>{{item.value}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{approvalView.showLoading}}" class="card muted">{{approvalView.loadingText}}</view>
  <block wx:for="{{approvalView.list}}" wx:key="id">
    <view class="card approval-list-card">
      <view class="approval-list-head"><view class="approval-list-title">{{item.titleText}}</view><text class="pill">{{item.statusText}}</text></view>
      <view class="approval-list-meta"><text>编号 {{item.codeText}}</text><text class="pill">{{item.typeText}}</text><text>{{item.applicantText}}</text></view>
      <view class="approval-list-meta"><text>当前节点 {{item.currentNodeText}}</text><text>通过后动作 {{item.actionAfterApproveText}}</text></view>
      <view wx:if="{{item.showCustomer}}" class="approval-list-meta"><text>客户 {{item.customerNameText}}</text><text>{{item.customerIndustryText}}</text></view>
      <view class="approval-list-reason">{{item.reasonText}}</view>
      <view class="approval-list-time">{{item.timeText}}</view>
      <view class="approval-action-row">
        <button class="approval-link-action" data-index="{{index}}" bindtap="openDetail">查看详情</button>
        <button wx:if="{{item.showCustomerAction}}" class="approval-link-action" data-index="{{index}}" bindtap="openCustomer">客户档案</button>
        <button wx:if="{{item.showRejectAction}}" class="approval-reject-action" data-index="{{index}}" bindtap="reject">驳回</button>
        <button wx:if="{{item.showApproveAction}}" class="approval-approve-action" data-index="{{index}}" bindtap="approve">通过</button>
      </view>
    </view>
  </block>
  <view wx:if="{{approvalView.showEmpty}}" class="card muted">暂无审批事项</view>
  <view class="card approval-submit-card">
    <view class="section-title">发起客户释放审批</view>
    <input class="search-input approval-input" placeholder="输入客户ID" value="{{submitCustomerId}}" bindinput="onSubmitCustomerId"/>
    <button class="btn approval-submit-btn" bindtap="submitReleaseApproval">提交审批</button>
  </view>
</view>

