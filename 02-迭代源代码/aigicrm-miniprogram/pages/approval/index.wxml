<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">审批中心</view><view class="hero-sub">PC 与移动端同一审批流</view></view><button class="ghost-btn" bindtap="refresh" loading="{{loading}}">刷新</button></view></view><view class="grid"><view class="card"><view class="num">{{stats.pending || 0}}</view><view class="muted">待审批</view></view><view class="card"><view class="num">{{stats.approved || 0}}</view><view class="muted">已通过</view></view></view><view class="tabs"><view class="tab {{tab==='pending'?'active':''}}" data-tab="pending" bindtap="changeTab">待我处理</view><view class="tab {{tab==='all'?'active':''}}" data-tab="all" bindtap="changeTab">全部</view><view class="tab {{tab==='approved'?'active':''}}" data-tab="approved" bindtap="changeTab">已通过</view></view><view wx:if="{{loading}}" class="card muted">加载中...</view><block wx:for="{{approvals}}" wx:key="id"><view class="card" style="margin-bottom:20rpx"><view class="row"><view style="font-size:30rpx;font-weight:700;flex:1">{{item.title}}</view><text class="pill">{{item.status}}</text></view><view style="margin-top:14rpx"><text class="pill">{{item.type}}</text><text class="muted" style="margin-left:12rpx">{{item.applicant}}</text></view><view style="margin-top:18rpx;font-size:27rpx">{{item.reason}}</view><view class="muted" style="margin-top:16rpx">{{item.createdAt}}</view><view class="row action-row"><button class="secondary-btn" data-index="{{index}}" bindtap="openDetail">查看详情</button><button wx:if="{{canReject && (item.status==='pending' || item.status==='PENDING' || item.status==='WAITING' || item.status==='待审批')}}" class="btn secondary-btn" data-index="{{index}}" bindtap="reject">驳回</button><button wx:if="{{canApprove && (item.status==='pending' || item.status==='PENDING' || item.status==='WAITING' || item.status==='待审批')}}" class="btn compact-btn" data-index="{{index}}" bindtap="approve">通过</button></view></view></block><view wx:if="{{!loading && approvals.length===0}}" class="card muted">暂无审批事项</view></view>
<view wx:if="{{selectedApproval}}" class="modal-mask"><view class="card modal-card"><view class="row"><view class="hero-title">审批详情</view><button class="ghost-btn" bindtap="closeDetail">关闭</button></view><view class="detail-row"><text>事项</text><text>{{selectedApproval.title}}</text></view><view class="detail-row"><text>申请人</text><text>{{selectedApproval.applicant}}</text></view><view class="detail-row"><text>状态</text><text>{{selectedApproval.status}}</text></view><view class="muted" style="margin-top:16rpx">{{selectedApproval.reason}}</view><view wx:if="{{selectedApproval.nodes.length}}" style="margin-top:20rpx"><view class="hero-sub">节点时间线</view><block wx:for="{{selectedApproval.nodes}}" wx:key="id"><view class="detail-row"><text>{{item.nodeOrder}}. {{item.approverName || '审批人'}}</text><text>{{item.status}} {{item.action || ''}}</text></view><view class="muted">{{item.comment || '暂无意见'}}</view></block></view><textarea class="comment-input" value="{{comment}}" bindinput="onCommentInput" placeholder="填写审批意见（可选）"></textarea><view class="row action-row"><button wx:if="{{canReject && (selectedApproval.status==='pending' || selectedApproval.status==='PENDING' || selectedApproval.status==='WAITING' || selectedApproval.status==='待审批')}}" class="btn secondary-btn" data-id="{{selectedApproval.id}}" bindtap="reject">驳回</button><button wx:if="{{canApprove && (selectedApproval.status==='pending' || selectedApproval.status==='PENDING' || selectedApproval.status==='WAITING' || selectedApproval.status==='待审批')}}" class="btn compact-btn" data-id="{{selectedApproval.id}}" bindtap="approve">通过</button></view></view></view>
<view class="card" style="margin-top:20rpx"><view class="section-title">发起客户释放审批</view><input class="search-input" style="margin-top:12rpx" placeholder="输入客户ID" value="{{submitCustomerId}}" bindinput="onSubmitCustomerId"/><button class="btn" style="margin-top:12rpx" bindtap="submitReleaseApproval">提交审批</button></view>
