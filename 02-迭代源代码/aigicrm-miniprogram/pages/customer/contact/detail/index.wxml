<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">联系人详情</view><view class="hero-sub">客户关系与关键人信息</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view class="card"><view class="profile-avatar">{{name.slice(0, 1)}}</view><view class="section-title" style="margin-top:18rpx">{{name || '未命名联系人'}}</view><view class="detail-row"><text>职位</text><text>{{position || '-'}}</text></view><view class="detail-row"><text>手机号</text><text>{{mobile || '-'}}</text></view><view class="detail-row"><text>邮箱</text><text>{{email || '-'}}</text></view><button class="btn" style="margin-top:28rpx" bindtap="call">拨打电话</button></view></view>
