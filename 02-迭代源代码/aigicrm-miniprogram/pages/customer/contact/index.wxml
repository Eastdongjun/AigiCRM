<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">联系人</view>
        <view class="hero-sub">客户关系与关键人信息</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>
  <view wx:if="{{contactView.showLoading}}" class="card muted">加载中...</view>
  <block wx:for="{{contactView.contacts}}" wx:key="viewId">
    <view class="card contact-card" data-index="{{index}}" bindtap="openDetail">
      <view class="row"><view class="contact-name">{{item.nameText}}</view><text class="pill">{{item.positionText}}</text></view>
      <view class="detail-row"><text>手机号</text><text>{{item.phoneText}}</text></view>
      <view class="contact-actions">
        <button class="contact-call-action" data-phone="{{item.phoneValue}}" catchtap="call">拨打电话</button>
        <button wx:if="{{canEdit}}" class="contact-edit-action" data-index="{{index}}" catchtap="editContact">编辑</button>
        <button wx:if="{{canEdit}}" class="contact-delete-action" data-index="{{index}}" catchtap="deleteContact">删除</button>
      </view>
      <view class="muted contact-hint">点击卡片查看详情</view>
    </view>
  </block>
  <view wx:if="{{contactView.showEmpty}}" class="card muted">暂无联系人</view>
  <button wx:if="{{contactView.showAddAction}}" class="btn contact-add-btn" bindtap="openForm">新增联系人</button>
</view>
