<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">联系人</view><view class="hero-sub">客户关系与关键人信息</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view wx:if="{{loading}}" class="card muted">加载中...</view><block wx:for="{{contacts}}" wx:key="id"><view class="card contact-card" data-index="{{index}}" bindtap="openDetail"><view class="row"><view class="contact-name">{{item.name || item.contactName || '未命名联系人'}}</view><text class="pill">{{item.position || item.title || '联系人'}}</text></view><view class="detail-row"><text>手机号</text><text>{{item.mobile || item.phone || '-'}}</text></view><view class="detail-row"><text>邮箱</text><text>{{item.email || '-'}}</text></view><button class="secondary-btn call-btn" data-phone="{{item.mobile || item.phone}}" catchtap="call">拨打电话</button><view class="muted" style="margin-top:10rpx">点击卡片查看详情</view></view></block><view wx:if="{{!loading && contacts.length===0}}" class="card muted">暂无联系人</view></view>
<button wx:if="{{canEdit}}" class="btn" style="margin:20rpx 0" bindtap="openForm">新增联系人</button>
