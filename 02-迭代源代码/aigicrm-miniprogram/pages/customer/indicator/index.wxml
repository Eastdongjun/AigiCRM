<view class="page indicator-edit-page">
  <view class="hero">
    <view class="hero-title">编辑客户指标</view>
    <view class="hero-sub">开票回款硬性门槛 + 五项评分，每项 0-3 分</view>
  </view>

  <view wx:if="{{indicatorView.showLoading}}" class="card muted">{{indicatorView.loadingText}}</view>

  <view wx:if="{{indicatorView.showForm}}" class="card form-card polished-form-card">
    <view class="form-section-title">核心客户六项指标</view>
    <view class="threshold-card refined-threshold">
      <view class="threshold-title">硬性指标</view>
      <view class="muted">{{coreThresholdTip}}</view><!-- D25 2026-10-04: 门槛数字由 shared 常量拼装，不再硬编码 -->
    </view>

    <block wx:for="{{indicatorItems}}" wx:key="field">
      <view class="metric-option refined-metric-option">
        <view class="metric-head">
          <view>
            <view class="metric-name">{{index + 1}}. {{item.name}}</view>
            <view class="muted">{{item.desc}}</view>
          </view>
          <text class="pill">{{item.value}} 分</text>
        </view>
        <view class="score-grid refined-score-grid">
          <block wx:for="{{item.optionsView}}" wx:for-item="option" wx:key="score">
            <view class="{{option.className}}" data-field="{{item.field}}" data-score="{{option.score}}" bindtap="selectScore">
              <text>{{option.score}}分</text>
              <view>{{option.label}}</view>
            </view>
          </block>
        </view>
      </view>
    </block>

    <button class="btn submit-btn polished-submit" loading="{{indicatorView.submitLoading}}" bindtap="submit">{{indicatorView.submitText}}</button>
    <button class="text-btn back-btn polished-back" bindtap="goBack">取消</button>
  </view>
</view>
