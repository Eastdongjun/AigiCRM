<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">高级筛选</view>
        <view class="hero-sub">组合条件查询客户</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>
  <view class="card polished-form-card">
    <view class="field-label">客户名称 / 编号</view>
    <input class="search-input polished-input" value="{{filterView.keywordValue}}" bindinput="onKeywordInput" placeholder="输入关键词"/>
    <view class="field-label filter-field-label">开发类型</view>
    <picker mode="selector" range="{{devTypes}}" value="{{selectedDevTypeIndex}}" bindchange="chooseDevType">
      <view class="select-row polished-select">{{filterView.devTypeText}}<text>⌄</text></view>
    </picker>
    <view class="field-label filter-field-label">行业</view>
    <picker mode="selector" range="{{industryOptions}}" range-key="label" value="{{selectedIndustryIndex}}" bindchange="chooseIndustry">
      <view class="select-row polished-select">{{filterView.industryText}}<text>⌄</text></view>
    </picker>
    <view class="field-label filter-field-label">客户状态</view>
    <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{selectedStatusIndex}}" bindchange="chooseStatus">
      <view class="select-row polished-select">{{filterView.statusText}}<text>⌄</text></view>
    </picker>
    <view class="field-label filter-field-label">保护状态</view>
    <picker mode="selector" range="{{protectOptions}}" range-key="label" value="{{selectedProtectIndex}}" bindchange="chooseProtect">
      <view class="select-row polished-select">{{filterView.protectText}}<text>⌄</text></view>
    </picker>
    <view class="field-label filter-field-label">省</view>
    <input class="search-input polished-input" value="{{filterView.provinceValue}}" bindinput="onProvinceInput" placeholder="如：山西"/>
    <view class="field-label filter-field-label">市</view>
    <input class="search-input polished-input" value="{{filterView.cityValue}}" bindinput="onCityInput" placeholder="如：太原"/>
    <view class="field-label filter-field-label">部门</view>
    <picker mode="selector" range="{{deptOptions}}" range-key="name" value="{{selectedDeptIndex}}" bindchange="chooseDept">
      <view class="select-row polished-select">{{filterView.deptText}}<text>⌄</text></view>
    </picker>
    <view class="field-label filter-field-label">负责人</view>
    <picker mode="selector" range="{{ownerOptions}}" range-key="name" value="{{selectedOwnerIndex}}" bindchange="chooseOwner">
      <view class="select-row polished-select">{{filterView.ownerText}}<text>⌄</text></view>
    </picker>
    <view class="filter-action-row">
      <button class="filter-reset-action" bindtap="reset">重置</button>
      <button class="filter-apply-action" bindtap="apply">应用筛选</button>
    </view>
  </view>
</view>
