<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">高级筛选</view><view class="hero-sub">组合条件查询客户</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view class="card"><view class="field-label">客户名称 / 编号</view><input class="search-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="输入关键词"/><view class="field-label" style="margin-top:28rpx">开发类型</view><picker mode="selector" range="{{devTypes}}" value="{{devTypes.indexOf(devType)}}" bindchange="chooseDevType"><view class="select-row">{{devType}}<text>⌄</text></view></picker><view class="row" style="margin-top:28rpx"><button class="secondary-btn" bindtap="reset">重置</button><button class="btn" bindtap="apply">应用筛选</button></view></view></view>
