<view class="page customer-page"><view class="customer-top"><view><view class="customer-title">客户</view><view class="muted" style="margin-top:8rpx">全部 {{countCards[0].value}} · 我的 {{countCards[1].value}} · 共享 {{countCards[2].value}}</view></view><view class="home-actions"><text wx:if="{{canViewSea}}" class="home-icon" bindtap="openSea">海</text><text class="home-icon" bindtap="resetFilters">↺</text></view></view><view class="customer-search"><text class="search-symbol">⌕</text><input class="customer-search-input" placeholder="搜索客户名称 / 编号" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search"/><button class="filter-btn" bindtap="search">筛选</button></view><view class="filter-scroll"><picker mode="selector" range="{{filters}}" bindchange="chooseFilter"><view class="filter-pill active">{{filter}}⌄</view></picker><button class="text-btn" wx:if="{{keyword || filter !== '全部'}}" bindtap="resetFilters">清空</button><view class="filter-count">共 {{customers.length || 0}} 家</view></view><view wx:if="{{loading}}" class="card muted" style="margin-top:20rpx">加载中...</view><block wx:for="{{customers}}" wx:key="id"><view class="customer-card" bindtap="openDetail" data-id="{{item.id}}"><view class="customer-accent {{item.status==='保护期'?'blue-accent':item.status==='超期'?'red-accent':'green-accent'}}"></view><view class="customer-card-main"><view class="row"><view class="customer-name">{{item.name}}</view><text class="status-pill">{{item.devType}}</text></view><view class="customer-meta">{{item.id ? 'C' + item.id : '-'}} · {{item.industry}} · 产能信息</view><view class="customer-divider"></view><view class="row"><view class="owner-line">● {{item.ownerName}} · {{item.officeName}}</view><text class="due-line">{{item.status}}</text></view></view></view></block><view wx:if="{{!loading && customers.length===0}}" class="card muted" style="margin-top:24rpx">暂无客户</view><view wx:if="{{canAdd}}" class="customer-fab" bindtap="addCustomer">＋</view></view>
<button class="secondary-btn" style="margin:20rpx 0" bindtap="openAdvancedFilter">高级筛选</button>
