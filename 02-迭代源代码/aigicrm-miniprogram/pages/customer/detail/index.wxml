<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">客户详情</view><view class="hero-sub">同 PC 客户详情 · 后端统一权限</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view wx:if="{{loading}}" class="card muted" style="margin-top:24rpx">加载中...</view><view wx:if="{{detail}}" class="card" style="margin-top:24rpx"><view class="row"><view style="font-size:34rpx;font-weight:800;flex:1">{{detail.customerName}}</view><text class="pill">{{detail.status}}</text></view><view style="margin-top:16rpx"><text class="pill">{{detail.industry}}</text><text class="pill" style="margin-left:10rpx">{{detail.devType}}</text></view><view class="detail-row"><text>客户编号</text><text>{{detail.customerCode || '-'}}</text></view><view class="detail-row"><text>开票名称</text><text>{{detail.invoiceName || '-'}}</text></view><view class="detail-row"><text>集团</text><text>{{detail.groupName || '-'}}</text></view><view class="detail-row"><text>负责人</text><text>{{detail.ownerName || '-'}}</text></view><view class="detail-row"><text>大区</text><text>{{detail.regionName || '-'}}</text></view><view class="detail-row"><text>办事处</text><text>{{detail.officeName || '-'}}</text></view><view class="detail-row"><text>保护到期</text><text>{{detail.expireDate || '-'}}</text></view><view class="detail-row"><text>地址</text><text>{{detail.address || '-'}}</text></view></view><view wx:if="{{detail && canViewContacts}}" class="card" style="margin-top:20rpx"><view class="section-title">联系人</view><block wx:for="{{contacts}}" wx:key="id"><view class="detail-row"><text>{{item.name || item.contactName}}</text><text>{{item.mobile || item.phone || '-'}}</text></view></block><view wx:if="{{contacts.length===0}}" class="muted">暂无联系人</view></view><view wx:if="{{detail}}" class="card" style="margin-top:20rpx"><view class="section-title">跟进日志</view><block wx:for="{{logs}}" wx:key="id"><view style="padding:16rpx 0;border-bottom:1rpx solid #e5e7eb"><view>{{item.content || item.remark || '跟进记录'}}</view><view class="muted" style="margin-top:8rpx">{{item.createdAt || item.createTime || '-'}}</view></view></block><view wx:if="{{logs.length===0}}" class="muted">暂无跟进日志</view></view><view wx:if="{{!loading && !detail}}" class="card muted" style="margin-top:24rpx">暂无客户详情</view></view>
<view wx:if="{{detail && canViewFinance}}" class="card" style="margin-top:20rpx"><view class="row"><view class="section-title">财务摘要</view><button class="text-btn" bindtap="openFinance">查看明细</button></view><view class="detail-row"><text>开票金额</text><text>{{invoiceSummary.totalAmount || invoiceSummary.invoiceAmount || '-'}}</text></view><view class="detail-row"><text>回款金额</text><text>{{paymentSummary.totalAmount || paymentSummary.paidAmount || '-'}}</text></view><view class="detail-row"><text>待回款</text><text>{{paymentSummary.unpaidAmount || paymentSummary.pendingAmount || '-'}}</text></view></view>
<button class="btn" style="margin:20rpx 0" bindtap="submitExtendApproval">申请保护期延期</button>
<view wx:if="{{detail}}" class="card" style="margin-top:20rpx"><view class="section-title">客情.商务关系深度</view><view class="detail-row"><text>高层（客情程度）</text><text>{{indicator.relationshipScore || 0}} / 3</text></view></view>
<view wx:if="{{detail}}" class="card" style="margin-top:20rpx"><view class="section-title">核心客户六项指标</view><view class="detail-row"><text>开票回款</text><text>均大于100万</text></view><view class="detail-row"><text>高层（客情程度）</text><text>{{indicator.relationshipScore || 0}} / 3</text></view><view class="detail-row"><text>渠道（编码数量）</text><text>{{indicator.indicator02 || 0}} / 3</text></view><view class="detail-row"><text>基层（分厂车间）</text><text>{{indicator.indicator03 || 0}} / 3</text></view><view class="detail-row"><text>产品（密封润滑防腐）</text><text>{{indicator.indicator04 || 0}} / 3</text></view><view class="detail-row"><text>项目（项目资金）</text><text>{{indicator.indicator05 || 0}} / 3</text></view><button wx:if="{{canEdit}}" class="btn" style="margin:20rpx auto 0" bindtap="openIndicatorForm">编辑六项指标</button></view>
<view wx:if="{{detail && from !== 'sea' && canEdit}}" class="card" style="margin-top:20rpx"><button class="btn" bindtap="releaseToSea">释放到公海</button></view>
<button wx:if="{{detail && canViewContacts}}" class="secondary-btn" style="margin:20rpx auto" bindtap="openContacts">查看全部联系人</button>
<button wx:if="{{detail}}" class="secondary-btn" style="margin:20rpx auto" bindtap="openShares">查看客户分享</button>

<button wx:if="{{detail && canEdit}}" class="btn" style="margin:20rpx auto" bindtap="openLogForm">新增跟进记录</button>
<button wx:if="{{detail}}" class="secondary-btn" style="margin:20rpx auto" bindtap="openTimeline">查看完整跟进记录</button>
