<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">新增{{mode==='invoice'?'开票':'回款'}}</view><view class="hero-sub">与 PC 财务记录共用同一接口和权限</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view class="card form-card"><block wx:if="{{mode==='invoice'}}"><view class="label">开票日期 *</view><input class="input" data-field="invoiceDate" value="{{form.invoiceDate}}" bindinput="input" placeholder="YYYY-MM-DD"/><view class="label">发票号码 *</view><input class="input" data-field="invoiceNumber" value="{{form.invoiceNumber}}" bindinput="input" placeholder="请输入发票号码"/><view class="label">开票金额 *</view><input class="input" type="digit" data-field="amount" value="{{form.amount}}" bindinput="input" placeholder="请输入金额"/><view class="label">开票单位</view><input class="input" data-field="invoiceCompany" value="{{form.invoiceCompany}}" bindinput="input" placeholder="请输入开票单位"/></block><block wx:else><view class="label">回款日期 *</view><input class="input" data-field="paymentDate" value="{{form.paymentDate}}" bindinput="input" placeholder="YYYY-MM-DD"/><view class="label">回款金额 *</view><input class="input" type="digit" data-field="paymentAmount" value="{{form.paymentAmount}}" bindinput="input" placeholder="请输入金额"/><view class="label">回款方式</view><input class="input" data-field="paymentMethod" value="{{form.paymentMethod}}" bindinput="input" placeholder="请输入回款方式"/><view class="label">备注</view><textarea class="textarea" data-field="remark" value="{{form.remark}}" bindinput="input" placeholder="请输入备注"/></block><button class="btn submit-btn" loading="{{saving}}" bindtap="submit">保存</button></view></view>
