.finance-row{margin-top:20rpx}.finance-no{font-size:29rpx;font-weight:700;color:#172b4d}.finance-row .detail-row{margin-top:18rpx}.finance-actions{display:flex;justify-content:flex-end;margin-top:22rpx}.finance-delete-btn{min-width:96rpx;height:50rpx;line-height:48rpx;margin:0;padding:0 16rpx;border:1rpx solid #fecaca;border-radius:14rpx;background:#fff7f7;color:#dc2626;font-size:22rpx;font-weight:720}.finance-delete-btn::after{border:0}

/* ===== 【裁决 2026-10-10】阶段总额制样式 ===== */
.text-btn{min-width:88rpx;height:48rpx;line-height:46rpx;margin:0;padding:0 18rpx;border:1rpx solid #bfdbfe;border-radius:14rpx;background:#eff6ff;color:#1d4ed8;font-size:22rpx;font-weight:600}.text-btn::after{border:0}
.stage-verdict-card{display:flex;flex-direction:row;justify-content:space-between;align-items:center;gap:16rpx}
.stage-verdict-row{display:flex;flex-direction:column;gap:6rpx;font-size:24rpx;color:#475569}
.stage-verdict-amounts{font-size:26rpx;color:#172b4d;font-weight:600}
.stage-core-tag{padding:8rpx 22rpx;border-radius:999rpx;font-size:24rpx;font-weight:700;flex-shrink:0}
.stage-core-tag.core{background:#dcfce7;color:#15803d}
.stage-core-tag.quasi{background:#fef3c7;color:#b45309}
.stage-core-tag.none{background:#f1f5f9;color:#64748b}
.stage-row-card .stage-row-head{justify-content:space-between;align-items:center}
.stage-period{font-size:30rpx;font-weight:700;color:#172b4d}
.stage-note{color:#94a3b8;font-size:22rpx;line-height:1.8}
.history-toggle-card{display:flex;flex-direction:row;justify-content:space-between;align-items:center}
.history-toggle-title{font-size:26rpx;font-weight:600;color:#475569}

/* ===== 【2026-10-26 用户令"布局合理化】顶部统一深蓝圆角卡 + 阶段三指标一行 + 更新时间入头部 ===== */
.finance-page{padding-bottom:56rpx}
.fin-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx 24rpx;border-radius:26rpx;background:linear-gradient(135deg,#0d1733 0%,#16337a 58%,#1d4ed8 100%);box-shadow:0 18rpx 38rpx rgba(13,23,51,.22);color:#fff}
.fin-top-copy{flex:1;min-width:0}
.fin-top-title{font-size:32rpx;font-weight:800;letter-spacing:1rpx}
.fin-top-sub{margin-top:6rpx;font-size:19rpx;color:rgba(255,255,255,.6)}
.fin-top-back{flex-shrink:0;height:54rpx;min-height:54rpx;line-height:52rpx;margin:0;padding:0 22rpx;border-radius:999rpx;border:1rpx solid rgba(255,255,255,.24);background:rgba(255,255,255,.14);color:#fff;font-size:21rpx;font-weight:600}
.fin-top-back::after{border:0}
.stage-head-right{display:flex;align-items:center;gap:12rpx}
.stage-upd-text{font-size:20rpx;color:#94a3b8}
.stage-metrics{display:flex;gap:14rpx;margin-top:18rpx}
.stage-metric{flex:1;min-width:0;background:#f8fafd;border-radius:18rpx;padding:16rpx 8rpx;text-align:center}
.stage-metric-label{display:block;font-size:19rpx;color:#64748b}
.stage-metric-value{margin-top:6rpx;font-size:30rpx;font-weight:700;color:#172b4d}
.stage-metric-value text{margin-left:4rpx;font-size:19rpx;font-weight:400;color:#94a3b8}

/* 【体检 P2 2026-10-12】作废行灰显(与 PC ledger-voided 同语义) */
.pill-voided{background:#f1f5f9;color:#94a3b8}
