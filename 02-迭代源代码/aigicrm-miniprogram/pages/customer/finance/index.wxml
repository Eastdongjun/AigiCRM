<view class="page finance-page">
  <!-- 【2026-10-26 用户令"布局合理化"】顶部统一深蓝圆角卡(与文件页/详情页同族) +
       阶段卡三指标一行化(原四行 label:value) + 规则长文改折叠(与历史明细同款) -->
  <view class="fin-top">
    <view class="fin-top-copy">
      <view class="fin-top-title">阶段性开票回款</view>
      <view class="fin-top-sub">半年末 / 年末录入总额（2026-10-10 起总额制）</view>
    </view>
    <button class="fin-top-back" bindtap="goBack">返回</button>
  </view>

  <view wx:if="{{stageView.showLoading}}" class="card muted">加载中...</view>

  <!-- 判定摘要条: 年度金额与三态(真核心/争核心/非核心)由后端按阶段总额算好 -->
  <view wx:if="{{stageView.hasVerdict}}" class="card stage-verdict-card">
    <view class="stage-verdict-row">
      <text>{{stageView.verdictText}}</text>
      <text class="stage-verdict-amounts">开票 {{stageView.invoiceText}} 万 · 回款 {{stageView.paymentText}} 万</text>
    </view>
    <text class="{{stageView.coreTagClass}}">{{stageView.coreTagText}}</text>
  </view>

  <block wx:for="{{stageView.stageRows}}" wx:key="id">
    <view class="card stage-row-card">
      <view class="row stage-row-head">
        <text class="stage-period">{{item.periodLabel}}</text>
        <view class="stage-head-right">
          <text class="stage-upd-text">{{item.updText}}</text>
          <button wx:if="{{stageView.showAddAction}}" class="text-btn" data-year="{{item.periodYear}}" data-type="{{item.periodType}}" catchtap="openForm">编辑</button>
        </view>
      </view>
      <view class="stage-metrics">
        <view class="stage-metric">
          <text class="stage-metric-label">阶段内开票</text>
          <view class="stage-metric-value">{{item.invoiceText}}<text>万</text></view>
        </view>
        <view class="stage-metric">
          <text class="stage-metric-label">阶段性回款</text>
          <view class="stage-metric-value">{{item.paymentText}}<text>万</text></view>
        </view>
        <view class="stage-metric">
          <text class="stage-metric-label">差额(开票−回款)</text>
          <view class="stage-metric-value">{{item.gapText}}<text>万</text></view>
        </view>
      </view>
    </view>
  </block>
  <view wx:if="{{stageView.emptyText}}" class="card muted">{{stageView.emptyText}}</view>

  <button wx:if="{{stageView.showAddAction}}" class="btn finance-add-btn" bindtap="openForm">录入阶段数据</button>

  <!-- 录入与保护期规则(原文)折叠: 默认收起, 点标题行展开 -->
  <view class="card history-toggle-card" bindtap="toggleNote">
    <view class="row">
      <text class="history-toggle-title">录入与保护期规则</text>
      <text class="muted">{{noteOpen ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
  </view>
  <!-- 【2026-11-03 门槛配置化】规则长文由 js 拼装(门槛数字随摘要回传, 不落死值) -->
  <view wx:if="{{noteOpen}}" class="card stage-note">{{stageView.stageNoteText}}</view>

  <!-- 历史逐笔明细(只读): 2026-10-10 逐笔录入制时期的台账, 首次展开懒加载 -->
  <view class="card history-toggle-card" bindtap="toggleHistory">
    <view class="row">
      <text class="history-toggle-title">历史逐笔明细（只读）</text>
      <text class="muted">开票 {{stageView.invoiceCount}} 笔 · 回款 {{stageView.paymentCount}} 笔 {{stageView.historyOpen ? '▲' : '▼'}}</text>
    </view>
  </view>
  <block wx:if="{{stageView.historyOpen}}">
    <block wx:for="{{stageView.invoiceRows}}" wx:key="id">
      <view class="card finance-row">
        <view class="row">
          <text class="finance-no">{{item.invoiceNumber}}</text>
          <text class="pill {{item.voided ? 'pill-voided' : ''}}">{{item.status}}</text>
        </view>
        <view class="detail-row"><text>金额</text><text>{{item.amountText}}</text></view>
        <view class="detail-row"><text>日期</text><text>{{item.invoiceDateText}}</text></view>
        <view class="detail-row"><text>发票类型</text><text>{{item.invoiceType}}</text></view>
        <view class="detail-row"><text>开票单位</text><text>{{item.invoiceCompany}}</text></view>
      </view>
    </block>
    <view wx:if="{{stageView.invoiceCount === 0}}" class="card muted">暂无历史开票记录</view>
    <block wx:for="{{stageView.paymentRows}}" wx:key="id">
      <view class="card finance-row">
        <view class="row">
          <text class="finance-no">{{item.paymentNumber}}</text>
          <text class="pill {{item.voided ? 'pill-voided' : ''}}">{{item.status}}</text>
        </view>
        <view class="detail-row"><text>金额</text><text>{{item.paymentAmountText}}</text></view>
        <view class="detail-row"><text>日期</text><text>{{item.paymentDateText}}</text></view>
        <view class="detail-row"><text>回款方式</text><text>{{item.paymentMethod}}</text></view>
        <view class="detail-row"><text>备注</text><text>{{item.remark}}</text></view>
      </view>
    </block>
    <view wx:if="{{stageView.paymentCount === 0}}" class="card muted">暂无历史回款记录</view>
  </block>
</view>
