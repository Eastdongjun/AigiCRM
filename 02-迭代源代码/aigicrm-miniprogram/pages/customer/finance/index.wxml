<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">开票回款</view>
        <view class="hero-sub">客户开票与回款记录</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>
  <view class="tabs">
    <view wx:for="{{financeListView.tabs}}" wx:key="key" class="{{item.className}}" data-tab="{{item.key}}" bindtap="switchTab">{{item.text}}</view>
  </view>
  <view wx:if="{{financeListView.showLoading}}" class="card muted">加载中...</view>
  <block wx:if="{{financeListView.showInvoices}}">
    <block wx:for="{{financeListView.invoiceRows}}" wx:key="id">
      <view class="card finance-row">
        <view class="row">
          <text class="finance-no">{{item.invoiceNumber}}</text>
          <text class="pill">{{item.status}}</text>
        </view>
        <view class="detail-row"><text>金额</text><text>{{item.amountText}}</text></view>
        <view class="detail-row"><text>日期</text><text>{{item.invoiceDateText}}</text></view>
        <view class="detail-row"><text>发票类型</text><text>{{item.invoiceType}}</text></view>
        <view class="detail-row"><text>开票单位</text><text>{{item.invoiceCompany}}</text></view>
        <view wx:if="{{financeListView.showDeleteAction}}" class="finance-actions">
          <button class="finance-delete-btn" data-mode="invoice" data-index="{{index}}" catchtap="deleteRecord">删除</button>
        </view>
      </view>
    </block>
    <view wx:if="{{financeListView.invoiceEmptyText}}" class="card muted">{{financeListView.invoiceEmptyText}}</view>
  </block>
  <block wx:if="{{financeListView.showPayments}}">
    <block wx:for="{{financeListView.paymentRows}}" wx:key="id">
      <view class="card finance-row">
        <view class="row">
          <text class="finance-no">{{item.paymentNumber}}</text>
          <text class="pill">{{item.status}}</text>
        </view>
        <view class="detail-row"><text>金额</text><text>{{item.paymentAmountText}}</text></view>
        <view class="detail-row"><text>日期</text><text>{{item.paymentDateText}}</text></view>
        <view class="detail-row"><text>回款方式</text><text>{{item.paymentMethod}}</text></view>
        <view class="detail-row"><text>备注</text><text>{{item.remark}}</text></view>
        <view wx:if="{{financeListView.showDeleteAction}}" class="finance-actions">
          <button class="finance-delete-btn" data-mode="payment" data-index="{{index}}" catchtap="deleteRecord">删除</button>
        </view>
      </view>
    </block>
    <view wx:if="{{financeListView.paymentEmptyText}}" class="card muted">{{financeListView.paymentEmptyText}}</view>
  </block>
  <button wx:if="{{financeListView.showAddAction}}" class="btn finance-add-btn" bindtap="openForm">{{financeListView.addText}}</button>
</view>
