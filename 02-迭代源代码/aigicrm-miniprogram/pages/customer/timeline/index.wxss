.timeline-month{position:relative;margin-top:20rpx;padding-left:26rpx}
.timeline-month::before{content:"";position:absolute;left:11rpx;top:46rpx;bottom:-14rpx;width:2rpx;background:#dbe7f5}
.timeline-month:last-of-type::before{bottom:20rpx}
.timeline-month-head{display:flex;align-items:center;gap:12rpx;margin:0 0 16rpx}
.timeline-month-dot{width:22rpx;height:22rpx;border-radius:50%;background:#2563eb;box-shadow:0 0 0 8rpx rgba(37,99,235,.12);flex-shrink:0}
.timeline-month-label{font-size:28rpx;font-weight:900;color:#172033}
.timeline-month-count{margin-left:auto;padding:6rpx 14rpx;border-radius:999rpx;background:#eef5ff;color:#2563eb;font-size:22rpx;font-weight:800}
.timeline-item{position:relative;margin:0 0 18rpx 28rpx}
/* 【P2-7 2026-10-19】时间轴条目卡(automator 选择器锚点)+内容正文排版 */
.timeline-card{overflow:hidden}
.timeline-content{margin-top:8rpx;color:#334155;font-size:24rpx;line-height:1.6}
.timeline-dot{position:absolute;left:-44rpx;top:34rpx;width:18rpx;height:18rpx;border-radius:50%;background:#8ea3c0;box-shadow:0 0 0 7rpx #f5f8fc}
.timeline-dot.incentive{background:#059669}
.timeline-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx;gap:16rpx}
.timeline-type{padding:6rpx 14rpx;border-radius:999rpx;background:#eef5ff;color:#2563eb;font-size:22rpx;font-weight:800}
.timeline-type.incentive{background:#ecfdf5;color:#059669}
.timeline-time{min-width:0;color:#8ea3c0;font-size:23rpx;text-align:right}
.timeline-meta{display:flex;flex-wrap:wrap;gap:10rpx;margin:4rpx 0 12rpx}
.timeline-meta text{max-width:100%;padding:7rpx 12rpx;border-radius:999rpx;background:#f1f5f9;color:#475569;font-size:22rpx;line-height:1.3}
.timeline-detail-block{margin-top:14rpx;padding:18rpx 20rpx;border-left:6rpx solid #2563eb;border-radius:18rpx;background:#f8fbff}
.timeline-detail-block.remark{border-left-color:#f59e0b;background:#fffaf3}
.timeline-detail-label{color:#334155;font-size:23rpx;font-weight:850}
.timeline-detail-text{margin-top:8rpx;color:#172033;font-size:25rpx;line-height:1.6;word-break:break-word}
.timeline-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:16rpx}
.timeline-foot .muted{flex:1;min-width:0}
.timeline-detail-action{width:86rpx;height:48rpx;padding:0;border-radius:14rpx;background:#eff6ff;color:#1d4ed8;font-size:22rpx;font-weight:800;line-height:48rpx}
.timeline-files{margin-top:18rpx;border:1rpx solid #e5edf6;border-radius:22rpx;overflow:hidden;background:#fbfdff}
.timeline-files.grouped{border:0;border-radius:0;overflow:visible;background:transparent}
.timeline-file-group{margin-top:12rpx;border:1rpx solid #e5edf6;border-radius:20rpx;overflow:hidden;background:#fbfdff}
.timeline-file-group:first-child{margin-top:0}
.timeline-file-group-head{display:flex;align-items:center;justify-content:space-between;padding:14rpx 18rpx;background:#f8fbff;border-bottom:1rpx solid #eef3f9;color:#334155;font-size:22rpx;font-weight:850}
.timeline-file-row{display:flex;align-items:center;gap:14rpx;padding:18rpx;border-top:1rpx solid #eef3f9}
.timeline-file-group-head+.timeline-file-row,.timeline-file-row:first-child{border-top:0}
.timeline-file-icon{width:64rpx;height:64rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#eef5ff;color:#2563eb;font-size:21rpx;font-weight:800}
.timeline-file-icon.image{background:#ecfdf5;color:#059669}
.timeline-file-icon.video{background:#fff7ed;color:#d97706}
.timeline-file-icon.document{background:#eff6ff;color:#2563eb}
.timeline-file-main{flex:1;min-width:0}
.timeline-file-name{font-size:26rpx;font-weight:800;color:#172033;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.timeline-file-meta{margin-top:6rpx;color:#7c8ba1;font-size:22rpx}
.timeline-file-action{width:78rpx;height:50rpx;padding:0;border-radius:15rpx;background:#2563eb;color:#fff;font-size:22rpx;line-height:50rpx}
.timeline-file-action.secondary{background:#f1f5f9;color:#1f3f7a}
.timeline-video{width:100%;height:360rpx;margin-top:20rpx;border-radius:24rpx;background:#0f172a;overflow:hidden}
