<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">跟进记录</view><view class="hero-sub">{{customerName}}</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view wx:if="{{loading}}" class="card muted">加载中...</view><view wx:if="{{!loading && logs.length===0}}" class="card muted">暂无跟进记录</view><view wx:for="{{logs}}" wx:key="id" class="timeline-item"><view class="timeline-dot"></view><view class="card timeline-card"><view class="timeline-content">{{item.content || item.remark || '跟进记录'}}</view><view class="muted">{{item.createdAt || item.createTime || '-'}}</view><view wx:if="{{item.creatorName || item.userName}}" class="muted">记录人：{{item.creatorName || item.userName}}</view></view></view></view>
