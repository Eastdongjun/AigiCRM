/* 客户模块共享表单按钮样式（2026-10-04 评审 D24 抽取）。
   此前 customer/form、contact/form、finance/form、log 四处 wxss 各有一份相同副本，
   统一收敛到此文件，各页 @import 引用；页面特有差异（如 log 的间距）在页面内覆盖。 */

.form-top-cancel {
  flex: none;
  height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, .55);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .18);
  color: #fff;
  font-size: 23rpx;
  font-weight: 760;
  line-height: 54rpx;
  box-sizing: border-box;
}

.form-top-cancel::after {
  border: 0;
}

.form-actions {
  display: grid;
  grid-template-columns: 176rpx minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.form-cancel-btn,
.form-submit-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 70rpx;
  box-sizing: border-box;
}

.form-cancel-btn::after,
.form-submit-btn::after {
  border: 0;
}

.form-cancel-btn {
  border: 1rpx solid #dbe4f0;
  background: #fff;
  color: #475569;
}

.form-submit-btn {
  background: #2563eb;
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, .18);
}

.form-cancel-btn[disabled],
.form-top-cancel[disabled] {
  opacity: .55;
}

.form-submit-btn[disabled] {
  background: #d8e1ed !important;
  color: #7c8ba1 !important;
  box-shadow: none !important;
}
