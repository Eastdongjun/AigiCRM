/* 客户表单页（2026-09-13 对齐 PC 字段）：沿用 app.wxss 全局 .card/.btn/.row，
   这里只覆盖表单密度与新增的 picker/只读行/入口行样式（与 contact/form 同风格） */
.form-card { margin-top: 20rpx; }
.form-card .section-title { margin: 0 0 6rpx; font-size: 30rpx; }
.label { display: block; margin-top: 20rpx; color: #475569; font-size: 26rpx; }
.input { width: 100%; box-sizing: border-box; height: 76rpx; margin-top: 10rpx; padding: 0 20rpx; border: 1rpx solid #dbeafe; border-radius: 14rpx; background: #f8fbff; font-size: 27rpx; }
.textarea { width: 100%; box-sizing: border-box; height: 180rpx; margin-top: 10rpx; padding: 18rpx 20rpx; border: 1rpx solid #dbeafe; border-radius: 14rpx; background: #f8fbff; font-size: 27rpx; line-height: 1.6; }

.picker-value { margin-top: 10rpx; height: 76rpx; padding: 0 20rpx; line-height: 76rpx; border: 1rpx solid #dbeafe; border-radius: 14rpx; background: #f8fbff; font-size: 27rpx; color: #1f2937; }
.picker-value.placeholder { color: #94a3b8; }

.tip { margin-top: 10rpx; color: #94a3b8; font-size: 23rpx; line-height: 1.5; }

.readonly-row { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #eef2f7; }
.readonly-row .label { margin-top: 0; }
.readonly-value { color: #1f2937; font-size: 26rpx; }

.entry-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 22rpx 24rpx; border: 1rpx solid #dbeafe; border-radius: 16rpx; background: #f8fbff; font-size: 27rpx; color: #1f2937; }
.entry-arrow { color: #94a3b8; font-size: 34rpx; line-height: 1; }

.action-row { margin-top: 26rpx; }
.action-row .secondary-btn { width: 220rpx; margin-left: 0; padding: 18rpx 0; text-align: center; }
.action-row .btn { width: 260rpx; padding: 18rpx 0; text-align: center; }
