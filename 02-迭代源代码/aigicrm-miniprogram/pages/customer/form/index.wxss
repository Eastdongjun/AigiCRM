/* 客户表单页（2026-09-13 对齐 PC 字段）：沿用 app.wxss 全局 .card/.btn/.row，
   这里只覆盖表单密度与新增的 picker/只读行/入口行样式（与 contact/form 同风格） */
/* 【D24 2026-10-04】返回/取消/提交按钮样式与组内各表单完全相同，统一 @import 共享副本 */
@import "../shared.wxss";

.form-card { margin-top: 20rpx; }
.form-card .section-title { margin: 0 0 6rpx; font-size: 30rpx; }
.label { display: block; margin-top: 20rpx; color: #475569; font-size: 26rpx; }
.input { width: 100%; box-sizing: border-box; height: 76rpx; margin-top: 10rpx; padding: 0 20rpx; border: 1rpx solid #dbeafe; border-radius: 14rpx; background: #f8fbff; font-size: 27rpx; }
.textarea { width: 100%; box-sizing: border-box; height: 180rpx; margin-top: 10rpx; padding: 18rpx 20rpx; border: 1rpx solid #dbeafe; border-radius: 14rpx; background: #f8fbff; font-size: 27rpx; line-height: 1.6; }

.picker-value { margin-top: 10rpx; height: 76rpx; padding: 0 20rpx; line-height: 76rpx; border: 1rpx solid #dbeafe; border-radius: 14rpx; background: #f8fbff; font-size: 27rpx; color: #1f2937; }
.picker-value.placeholder { color: #94a3b8; }
/* 裁决 2026-09-24: 推导字段只读展示(灰底弱化,视觉区分可编辑 picker) */
.picker-value.derived-value { background: #f1f5f9; border-color: #e2e8f0; color: #64748b; }

.tip { margin-top: 10rpx; color: #94a3b8; font-size: 23rpx; line-height: 1.5; }
.warning-tip { padding: 12rpx 16rpx; border: 1rpx solid #fed7aa; border-radius: 12rpx; background: #fff7ed; color: #c2410c; }

.readonly-row { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #eef2f7; }
.readonly-row .label { margin-top: 0; }
.readonly-value { color: #1f2937; font-size: 26rpx; }

.entry-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 22rpx 24rpx; border: 1rpx solid #dbeafe; border-radius: 16rpx; background: #f8fbff; font-size: 27rpx; color: #1f2937; }
.entry-arrow { color: #94a3b8; font-size: 34rpx; line-height: 1; }

.indicator-inline-card .section-title { align-items: center; justify-content: space-between; }
.indicator-total { color: #2563eb; font-size: 24rpx; font-weight: 800; }
.indicator-item { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #e2e8f0; border-radius: 16rpx; background: #f8fbff; }
.indicator-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.indicator-name { color: #1e293b; font-size: 27rpx; font-weight: 760; }
.score-pill { flex: none; min-width: 78rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: #e0ecff; color: #1d4ed8; font-size: 22rpx; font-weight: 800; text-align: center; }
.score-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10rpx; margin-top: 16rpx; }
.score-option { min-height: 86rpx; padding: 10rpx 6rpx; border: 1rpx solid #dbeafe; border-radius: 14rpx; background: #fff; color: #64748b; font-size: 21rpx; line-height: 1.25; text-align: center; box-sizing: border-box; }
.score-option text { display: block; margin-bottom: 4rpx; color: #334155; font-size: 22rpx; font-weight: 780; }
.score-option.active { border-color: #2563eb; background: #eff6ff; color: #1d4ed8; box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, .12); }
.score-option.active text { color: #1d4ed8; }

.customer-form-actions {
  display: grid;
  grid-template-columns: 176rpx minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 26rpx;
  padding: 18rpx 0 24rpx;
}

/* .form-cancel-btn/.form-submit-btn 基础与禁用态样式见顶部 @import shared.wxss */

/* 必填标记: 红色星号 */
.required-star { color: #ef4444; font-weight: 800; margin-left: 4rpx; }
