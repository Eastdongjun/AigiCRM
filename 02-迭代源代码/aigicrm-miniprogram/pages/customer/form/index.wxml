<view class="page"><view class="hero"><view class="hero-title">{{isEdit ? '编辑客户' : '新增客户'}}</view><view class="hero-sub">沿用 PC 客户接口、账号与数据范围</view></view><view class="card form-card"><view class="field"><text class="label">客户全称 *</text><input value="{{form.customerName}}" data-field="customerName" bindinput="onInput" placeholder="请输入客户全称" /></view><view class="field"><text class="label">开票名称</text><input value="{{form.invoiceName}}" data-field="invoiceName" bindinput="onInput" placeholder="选填" /></view><view class="field"><text class="label">行业</text><input value="{{form.industry}}" data-field="industry" bindinput="onInput" placeholder="如：煤矿、化工" /></view><view class="field"><text class="label">开发类型</text><input value="{{form.devType}}" data-field="devType" bindinput="onInput" placeholder="如：成熟创新" /></view><view class="field"><text class="label">地址</text><input value="{{form.address}}" data-field="address" bindinput="onInput" placeholder="选填" /></view><view class="field"><text class="label">备注</text><textarea value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="选填" /></view><view class="row action-row"><button class="secondary-btn" bindtap="cancel">取消</button><button class="btn" bindtap="submit" loading="{{loading}}">保存</button></view></view></view>
