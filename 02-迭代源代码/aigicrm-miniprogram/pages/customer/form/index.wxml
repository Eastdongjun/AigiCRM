<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">{{formView.title}}</view>
        <view class="hero-sub">沿用 PC 客户接口、账号与数据范围</view>
      </view>
      <button class="form-top-cancel" bindtap="cancel" disabled="{{formView.cancelDisabled}}">返回</button>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card form-card">
    <view class="section-title">基本信息</view>

    <view class="label">客户全称 *</view>
    <input class="input" data-field="customerName" value="{{form.customerName}}" bindinput="onInput" bindblur="checkDuplicateName" placeholder="请输入订货客户全称" />
    <view wx:if="{{checkingName}}" class="tip">正在检测客户名称...</view>
    <view class="form-field">
      <text class="field-label">别名/简称</text>
      <input class="field-input" value="{{form.alias}}" bindinput="onFieldInput" data-field="alias" placeholder="简称、曾用名(可选)" />
    </view>
    <view wx:if="{{dupInfo.exists}}" class="tip warning-tip">{{formView.duplicateTip}}</view>

    <view class="label">开票名称</view>
    <input class="input" data-field="invoiceName" value="{{form.invoiceName}}" bindinput="onInput" placeholder="发票抬头，与客户全称相同可留空" />

    <view class="label">所属集团</view>
    <picker mode="selector" range="{{groupPickerOptions}}" value="{{groupIndex}}" bindchange="chooseGroup">
      <view class="{{formView.groupPicker.className}}">{{formView.groupPicker.text}}</view>
    </picker>

    <view class="label">所属分公司</view>
    <input class="input" data-field="branchCompany" value="{{form.branchCompany}}" bindinput="onInput" placeholder="例如：榆林化学" />

    <view class="label">所属单位</view>
    <input class="input" data-field="unitName" value="{{form.unitName}}" bindinput="onInput" placeholder="例如：选煤厂" />

    <view class="label">产能（万吨）</view>
    <input class="input" data-field="capacity" value="{{form.capacity}}" bindinput="onInput" placeholder="例如：500" />
  </view>

  <!-- 业务分类 -->
  <view class="card form-card">
    <view class="section-title">业务分类</view>

    <view class="label">行业 *</view>
    <picker mode="selector" range="{{industryOptions}}" value="{{industryIndex}}" bindchange="chooseIndustry">
      <view class="{{formView.industryPicker.className}}">{{formView.industryPicker.text}}</view>
    </picker>

    <view class="label">开发类型 *</view>
    <picker mode="selector" range="{{devTypeOptions}}" value="{{devTypeIndex}}" bindchange="chooseDevType">
      <view class="{{formView.devTypePicker.className}}">{{formView.devTypePicker.text}}</view>
    </picker>

    <view class="label">终端</view>
    <picker mode="selector" range="{{terminalOptions}}" value="{{terminalIndex}}" bindchange="chooseTerminal">
      <view class="picker-value">{{formView.terminalText}}</view>
    </picker>
    <view class="tip">是否终端客户（是=终端客户，否=非终端客户）</view>
  </view>

  <!-- 归属与负责人 -->
  <view class="card form-card">
    <view class="section-title">归属与负责人</view>

    <view class="label">所属大区 *</view>
    <picker mode="selector" range="{{regionOptions}}" range-key="deptName" value="{{regionIndex}}" bindchange="chooseRegion">
      <view class="{{formView.regionPicker.className}}">{{formView.regionPicker.text}}</view>
    </picker>

    <view class="label">所属办事处 *</view>
    <picker mode="selector" range="{{officeOptions}}" range-key="deptName" value="{{officeIndex}}" bindchange="chooseOffice" disabled="{{!form.regionId}}">
      <view class="{{formView.officePicker.className}}">{{formView.officePicker.text}}</view>
    </picker>

    <view class="label">第一负责人 *</view>
    <picker mode="selector" range="{{userOptions}}" range-key="realName" value="{{ownerIndex}}" bindchange="chooseOwner" disabled="{{isPoolCustomer}}">
      <view class="{{formView.ownerPicker.className}}">{{formView.ownerPicker.text}}</view>
    </picker>
    <view wx:if="{{isPoolCustomer}}" class="tip">公海池内客户负责人不可修改，请通过捞取流程变更</view>

    <view class="label">管理上级</view>
    <picker mode="selector" range="{{userOptions}}" range-key="realName" value="{{managerIndex}}" bindchange="chooseManager">
      <view class="{{formView.managerPicker.className}}">{{formView.managerPicker.text}}</view>
    </picker>

    <view wx:if="{{isEdit}}" class="readonly-row">
      <text class="label">所属部门</text>
      <text class="readonly-value">{{formView.deptText}}</text>
    </view>
  </view>

  <!-- 地址与日期 -->
  <view class="card form-card">
    <view class="section-title">地址与日期</view>

    <view class="label">省/市/区</view>
    <picker mode="region" value="{{region}}" bindchange="chooseArea">
      <view class="{{formView.areaPicker.className}}">{{formView.areaPicker.text}}</view>
    </picker>

    <view class="label">厂址</view>
    <input class="input" data-field="address" value="{{form.address}}" bindinput="onInput" placeholder="例如：榆神工业区" />

    <view class="label">注册日</view>
    <picker mode="date" value="{{form.registerDate}}" data-field="registerDate" bindchange="chooseDate" disabled="{{!canEditDates}}">
      <view class="{{formView.registerDatePicker.className}}">{{formView.registerDatePicker.text}}</view>
    </picker>

    <view class="label">最近开票日</view>
    <picker mode="date" value="{{form.lastInvoiceDate}}" data-field="lastInvoiceDate" bindchange="chooseDate" disabled="{{!canEditDates}}">
      <view class="{{formView.lastInvoiceDatePicker.className}}">{{formView.lastInvoiceDatePicker.text}}</view>
    </picker>
    <view class="tip">{{formView.dateTip}}</view>
  </view>

  <!-- 关联信息：复用已有页面，避免在两端重复实现联系人/指标 CRUD -->
  <view class="card form-card">
    <view class="section-title">关联信息</view>
    <block wx:if="{{isEdit}}">
      <view class="entry-row" bindtap="openContacts">
        <text>联系人管理</text><text class="entry-arrow">›</text>
      </view>
    </block>
    <view wx:else class="tip">客户保存后可继续添加联系人</view>
  </view>

  <!-- 客情五项指标：与 PC 新增/编辑表单同口径，保存客户后同步保存 -->
  <view class="card form-card indicator-inline-card">
    <view class="section-title row">
      <text>客情五项指标</text>
      <text class="indicator-total">{{indicatorTotal}} / 15 分</text>
    </view>
    <view class="tip">开票、回款均 >= 100 万；五项总分 >= 12 分为核心客户。</view>

    <block wx:for="{{indicatorItems}}" wx:key="field">
      <view class="indicator-item">
        <view class="indicator-head">
          <view>
            <view class="indicator-name">{{index + 1}}. {{item.name}}</view>
            <view class="tip">{{item.desc}}</view>
          </view>
          <text class="score-pill">{{item.value}} 分</text>
        </view>
        <view class="score-grid">
          <block wx:for="{{item.optionsView}}" wx:for-item="option" wx:key="score">
            <view class="{{option.className}}" data-field="{{item.field}}" data-score="{{option.score}}" bindtap="selectIndicatorScore">
              <text>{{option.score}}分</text>
              <view>{{option.label}}</view>
            </view>
          </block>
        </view>
      </view>
    </block>
  </view>

  <!-- 备注 -->
  <view class="card form-card">
    <view class="section-title">备注</view>
    <textarea class="textarea" data-field="remark" value="{{form.remark}}" bindinput="onInput" placeholder="备注信息（选填）" />
  </view>

  <view class="customer-form-actions">
    <button class="form-cancel-btn" bindtap="cancel" disabled="{{formView.cancelDisabled}}">{{formView.cancelText}}</button>
    <button class="form-submit-btn" bindtap="submit" loading="{{formView.submitLoading}}">{{formView.submitText}}</button>
  </view>
</view>
