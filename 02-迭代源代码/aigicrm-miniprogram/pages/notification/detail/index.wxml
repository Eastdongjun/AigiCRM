<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">消息详情</view><view class="hero-sub">业务通知与待处理提醒</view></view><button class="ghost-btn" bindtap="goBack">返回</button></view></view><view class="card"><view class="section-title">{{title}}</view><view class="notification-content">{{content || '暂无通知内容'}}</view><view class="detail-row"><text>关联客户</text><text>{{customer || '-'}}</text></view><view class="row action-row"><button wx:if="{{customerId}}" class="secondary-btn" bindtap="openCustomer">查看客户</button><button class="btn compact-btn" loading="{{processing}}" bindtap="process">标记已处理</button></view></view></view>
