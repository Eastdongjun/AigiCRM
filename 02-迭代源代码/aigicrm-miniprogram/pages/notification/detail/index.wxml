<view class="page notification-detail-page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">消息详情</view>
        <view class="hero-sub">业务通知与待处理提醒</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>
  <view class="card detail-info-card">
    <view class="approval-detail-title">{{notificationDetailView.titleText}}</view>
    <view class="notification-content refined-reason">{{notificationDetailView.contentText}}</view>
    <view class="detail-row"><text>关联客户</text><text>{{notificationDetailView.customerText}}</text></view>
    <view class="notification-detail-actions">
      <button wx:if="{{notificationDetailView.showCustomerAction}}" class="notification-link-action" bindtap="openCustomer">查看客户完整档案</button>
      <button class="notification-primary-action" loading="{{notificationDetailView.processLoading}}" bindtap="process">{{notificationDetailView.processText}}</button>
    </view>
  </view>
</view>
