<view class="page notification-page">
  <view class="hero">
    <view class="hero-title">消息中心</view>
    <view class="hero-sub">业务通知与待处理提醒</view>
  </view>
  <view wx:if="{{notificationView.showLoading}}" class="card muted">{{notificationView.loadingText}}</view>
  <block wx:for="{{notificationView.rows}}" wx:key="id">
    <view class="card notification-card refined-notification-card">
      <view class="notification-head"><view class="notification-title">{{item.titleText}}</view><text class="pill">待处理</text></view>
      <view class="notification-content">{{item.contentText}}</view>
      <view class="notification-customer">{{item.customerText}}</view>
      <view class="notification-actions">
        <button class="notification-link-action" data-index="{{index}}" catchtap="openDetail">详情</button>
        <button wx:if="{{item.showCustomerAction}}" class="notification-link-action" data-index="{{index}}" catchtap="openCustomer">客户档案</button>
        <button class="notification-primary-action" data-index="{{index}}" bindtap="process">{{item.processText}}</button>
      </view>
    </view>
  </block>
  <view wx:if="{{notificationView.showEmpty}}" class="card empty-state compact-empty"><view class="empty-icon">{{notificationView.emptyIcon}}</view><text>{{notificationView.emptyText}}</text></view>
</view>
