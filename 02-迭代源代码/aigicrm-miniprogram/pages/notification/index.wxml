<view class="page"><view class="hero"><view class="hero-title">消息中心</view><view class="hero-sub">业务通知与待处理提醒</view></view><view wx:if="{{loading}}" class="card muted">加载中...</view><block wx:for="{{notifications}}" wx:key="id"><view class="card notification-card"><view class="row"><view class="notification-title">{{item.title}}</view><text class="pill">待处理</text></view><view class="notification-content">{{item.content}}</view><view class="muted">关联客户：{{item.customerName}}</view><view class="action-row"><button class="secondary-btn" data-index="{{index}}" catchtap="openDetail">查看详情</button><button wx:if="{{item.customerId}}" class="secondary-btn" data-index="{{index}}" catchtap="openCustomer">查看客户</button><button class="btn compact-btn" data-index="{{index}}" bindtap="process">标记已处理</button></view></view></block><view wx:if="{{!loading && notifications.length===0}}" class="card muted">暂无未处理消息</view></view>
