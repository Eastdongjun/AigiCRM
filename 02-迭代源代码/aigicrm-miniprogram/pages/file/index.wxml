<view class="page"><view class="hero"><view class="row"><view><view class="hero-title">文件</view><view class="hero-sub">统一后端权限 · 移动端预览</view></view><button class="ghost-btn" bindtap="refresh" loading="{{loading}}">刷新</button></view></view><view class="row" style="margin-top:20rpx"><button class="btn compact-btn" data-mode="all" bindtap="switchMode">全部文件</button><button class="btn compact-btn" data-mode="shared" bindtap="switchMode">共享给我</button><button wx:if="{{mode !== 'shared'}}" class="btn compact-btn" bindtap="chooseAndUpload">上传</button></view><view wx:if="{{mode !== 'shared'}}" class="card" style="margin-top:20rpx"><view class="muted">当前位置：{{selectedFolderName}}</view><scroll-view scroll-x="true" style="white-space:nowrap;margin-top:16rpx"><text class="pill" style="margin-right:12rpx" bindtap="clearFolder">全部</text><text wx:for="{{folders}}" wx:key="id" class="pill" style="margin-right:12rpx" data-index="{{index}}" bindtap="selectFolder">{{item.folderName || item.name}}</text></scroll-view></view><view class="search-bar"><input class="search-input" placeholder="搜索文件名" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" /><button class="btn compact-btn" bindtap="search">查询</button></view><view wx:if="{{loading}}" class="card muted" style="margin-top:24rpx">加载中...</view><block wx:for="{{files}}" wx:key="id"><view class="card" style="margin-top:20rpx"><view class="row"><view style="font-size:30rpx;font-weight:700;flex:1">{{item.name}}</view><text class="pill">{{item.type}}</text></view><view class="muted" style="margin-top:14rpx">{{item.folderName}} · {{item.sizeText}}</view><view class="row" style="margin-top:20rpx"><text class="muted">{{item.createdAt}}</text><button class="btn compact-btn" bindtap="previewFile" data-index="{{index}}">打开</button><button wx:if="{{canShare && mode !== 'shared'}}" class="secondary-btn compact-btn" bindtap="shareFile" data-index="{{index}}">分享</button></view></view></block><view wx:if="{{!loading && files.length===0}}" class="card muted" style="margin-top:24rpx">暂无文件</view></view>
