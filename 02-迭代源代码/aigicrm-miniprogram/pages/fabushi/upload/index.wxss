@import "../fabushi-v7.wxss";

/* 发布页(原型 B2 每日诵读 / B3 每日随施 / B4 再读一本 / B5 提交成功 · 木鱼)。公共的设计变量与组件样式在 ../fabushi-v7.wxss,
   这里的规则同样限定在 .fb-page 之下(原因见那个文件的文件头)。
   【例外】文件末尾的木鱼那一组(.muyu-*)保持原样的单类名: PC 端的 FabushiMuyu 测试逐条读这里的规则对账;
   这些类名在全局 app.wxss 里没有同名的, 不存在被盖掉的问题。 */
.fb-page.upload-page { padding-bottom: 220rpx; }
.fb-page .scope-chips { margin: 4rpx 0 18rpx; }
.fb-page .channel-tabs, .fb-page .section-tabs { margin: 0 0 16rpx; }

/* 选书(原型 B4): 一行合并的选择器 —— 三列选择器(类别 / 书目 / 版本)占满一行, 右侧是“换版本 ›” */
.fb-page .select-card { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 16rpx; }
.fb-page .select-card > picker:first-child { flex: 1; min-width: 0; }
.fb-page .polished-select { margin-top: 0; }
.fb-page .sel-value { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; color: var(--mp-ink); }
.fb-page .sel-value.placeholder { color: var(--mp-ink4); }
.fb-page .polished-select .go { flex-shrink: 0; margin-left: 10rpx; }
.fb-page .swap-edition { flex-shrink: 0; padding: 10rpx 6rpx; color: #2364d8; font-size: 24rpx; font-weight: 700; white-space: nowrap; }
.fb-page .form-field { box-sizing: border-box; width: 100%; height: 78rpx; padding: 0 22rpx; border: 2rpx solid var(--mp-card-line); border-radius: 18rpx; font-size: 26rpx; color: var(--mp-ink); background: var(--mp-tile); }

/* 内容: 文字 + 九宫格 + 工具行 */
.fb-page .composer { padding: 18rpx 22rpx 8rpx; }
.fb-page .composer-title { height: 64rpx; font-size: 28rpx; font-weight: 700; color: var(--mp-ink); }
.fb-page .composer-text { width: 100%; min-height: 150rpx; font-size: 25rpx; line-height: 1.7; color: var(--mp-ink); }
.fb-page .composer-cell { overflow: hidden; }
.fb-page .composer-img { display: block; width: 100%; height: 100%; }
.fb-page .tool-item.rec { color: #fff; border-color: #e11d48; background: #e11d48; }
.fb-page .composer-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; font-size: 20rpx; color: var(--mp-ink3); }
.fb-page .foot-link { flex-shrink: 0; color: var(--accent); }

/* 附件清单 */
.fb-page .attach-item { font-size: 23rpx; }
.fb-page .attach-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--mp-ink2); }
.fb-page .attach-name.playable { color: var(--accent); }
.fb-page .attach-name.playing { font-weight: 800; }
.fb-page .attach-remove { flex-shrink: 0; height: 44rpx; padding: 0 14rpx; font-size: 20rpx; color: #e11d48; border-color: #fecdd3; background: #fff1f2; }

/* 选图后先编辑: 开关 */
.fb-page .edit-toggle { margin-top: 6rpx; }
.fb-page .switch { position: relative; flex-shrink: 0; width: 84rpx; height: 48rpx; border-radius: 999rpx; background: var(--accent); transition: background .2s; }
.fb-page .switch::after { content: ''; position: absolute; top: 5rpx; right: 5rpx; width: 38rpx; height: 38rpx; border-radius: 50%; background: #fff; box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, .2); transition: transform .2s; }
.fb-page .switch.off { background: #cbd5e1; }
.fb-page .switch.off::after { transform: translateX(-36rpx); }
.fb-page .rec-hint { color: var(--amber-deep); }

/* 底部的提交按钮 */
.fb-page .submit-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--mp-card-line); background: var(--mp-card); }
.fb-page .submit-bar .detail-primary-action { margin-top: 0; }
.fb-page .detail-primary-action.green { background: linear-gradient(135deg, #047857, #10b981); box-shadow: 0 14rpx 26rpx rgba(4, 120, 87, .22); }

/* 提交成功页 */
.fb-page.success-page { padding-top: 36rpx; padding-bottom: 60rpx; text-align: center; }
.fb-page .knock-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30rpx 0 26rpx; border-radius: 32rpx; background: radial-gradient(circle at 50% 42%, #f7e9c9 0%, #f2dfb4 46%, #e9d196 100%); }
.fb-page .sfx { margin-top: 4rpx; font-size: 26rpx; font-weight: 800; letter-spacing: 6rpx; color: #7d4e22; }
.fb-page .merit { margin-top: 14rpx; }
.fb-page .merit-pill { display: inline-block; padding: 10rpx 26rpx; border: 2rpx solid #e6cf9a; border-radius: 999rpx; font-size: 24rpx; font-weight: 800; color: #a16207; background: var(--mp-card); }
.fb-page .success-card { margin-top: 22rpx; padding: 22rpx 26rpx; text-align: left; }
.fb-page .success-card .feed-summary { margin-top: 10rpx; }
.fb-page .success-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.fb-page .success-actions .secondary-btn, .fb-page .success-actions .detail-primary-action { flex: 1; width: auto; margin: 0; }
.fb-page .success-back { margin-top: 20rpx; font-size: 24rpx; color: var(--mp-ink2); }
.fb-page .success-note { margin-top: 30rpx; padding: 0 40rpx; font-size: 20rpx; line-height: 1.7; color: var(--mp-ink3); }

/* ===== 木鱼(发布成功页那只)。这一组保持原样, 理由见文件头 ===== */
.muyu-stage { position: relative; width: 300rpx; height: 260rpx; margin: 0 auto; }
.muyu-glow { position: absolute; left: 50%; top: 50%; width: 240rpx; height: 240rpx; margin: -120rpx 0 0 -120rpx; border-radius: 50%; background: radial-gradient(circle, rgba(251,191,36,.28), rgba(251,191,36,0) 68%); opacity: 0; }
.muyu-body { position: absolute; left: 50%; top: 62rpx; width: 170rpx; height: 118rpx; margin-left: -85rpx; border-radius: 50% 50% 46% 46%; background: linear-gradient(160deg, #b45309, #92400e); box-shadow: inset 0 12rpx 18rpx rgba(255,255,255,.18), 0 18rpx 28rpx rgba(146,64,14,.26); }
.muyu-body:after { content: ''; position: absolute; left: 50%; top: 34rpx; width: 96rpx; height: 38rpx; margin-left: -48rpx; border-radius: 50%; border: 5rpx solid rgba(255,255,255,.28); }
.muyu-cushion { position: absolute; left: 50%; bottom: 22rpx; width: 190rpx; height: 44rpx; margin-left: -95rpx; border-radius: 50%; background: #f59e0b; opacity: .5; }
.muyu-mallet { position: absolute; right: 22rpx; top: 38rpx; width: 16rpx; height: 130rpx; border-radius: 10rpx; background: #78350f; transform: rotate(22deg); transform-origin: 50% 100%; }
.muyu-mallet:before { content: ''; position: absolute; left: -14rpx; top: -26rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: #92400e; }
.muyu-ripple { position: absolute; left: 50%; top: 50%; width: 80rpx; height: 80rpx; margin: -40rpx 0 0 -40rpx; border: 2rpx solid rgba(245,158,11,.7); border-radius: 50%; opacity: 0; }
.muyu-plus { position: absolute; right: 25rpx; top: 24rpx; color: #f59e0b; font-size: 44rpx; font-weight: 900; opacity: 0; }
.muyu-stage.go .muyu-mallet { animation: muyu-hit .55s ease-out; }
.muyu-stage.go .muyu-ripple { animation: muyu-ripple .8s ease-out; }
.muyu-stage.go .muyu-plus { animation: muyu-plus .8s ease-out; }
.muyu-stage.go .muyu-glow { animation: muyu-glow .8s ease-out; }
@keyframes muyu-hit { 0% { transform: rotate(22deg); } 45% { transform: rotate(-18deg); } 100% { transform: rotate(22deg); } }
@keyframes muyu-ripple { 0% { opacity: .8; transform: scale(.5); } 100% { opacity: 0; transform: scale(2.4); } }
@keyframes muyu-plus { 0% { opacity: 0; transform: translateY(14rpx); } 35% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-42rpx); } }
@keyframes muyu-glow { 0% { opacity: .2; } 40% { opacity: 1; } 100% { opacity: 0; } }
