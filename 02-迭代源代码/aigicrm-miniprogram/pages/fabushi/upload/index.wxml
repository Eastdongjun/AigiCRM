<block wx:if="{{!success}}">
  <view class="scope-row">
    <view class="scope-chip {{scopeType === item.value ? 'active' : ''}}"
          wx:for="{{scopeOptions}}" wx:key="value"
          data-value="{{item.value}}" bindtap="onScope">{{item.label}}</view>
  </view>

  <!-- 【PROTO-AUDIT-20261123 P6】每日诵读双通道：A 先写后读 / B 按书诵一段 -->
  <view wx:if="{{scopeType === 'songdu'}}" class="scope-row">
    <view class="scope-chip {{channel === 'A' ? 'active' : ''}}" data-value="A" bindtap="onChannel">A · 先写后读</view>
    <view class="scope-chip {{channel === 'B' ? 'active' : ''}}" data-value="B" bindtap="onChannel">B · 按书诵一段</view>
  </view>

  <view class="form-card">
    <!-- 【PROTO-AUDIT-20261123 P8】三级选书：类别 → 书目 → 版本 -->
    <block wx:if="{{scopeType !== 'suishi'}}">
      <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="form-row">
          <text class="form-label">① 类别</text>
          <text class="form-value">{{categoryIndex >= 0 ? categories[categoryIndex].name : '全部类别'}}</text>
        </view>
      </picker>
      <picker mode="selector" range="{{titles}}" value="{{titleIndex}}" bindchange="onTitleChange">
        <view class="form-row">
          <text class="form-label">② 书目 *</text>
          <text class="form-value">{{titleIndex >= 0 ? titles[titleIndex] : '请选择书目'}}</text>
        </view>
      </picker>
      <picker mode="selector" range="{{editions}}" range-key="editionName" value="{{editionIndex}}" bindchange="onEditionChange">
        <view class="form-row">
          <text class="form-label">③ 版本</text>
          <text class="form-value">{{editionIndex >= 0 ? editions[editionIndex].editionName : '请选择版本'}}</text>
        </view>
      </picker>
    </block>

    <!-- 再读一本：② 确定章节（选择已有 / 自我录入） -->
    <block wx:if="{{scopeType === 'zaidu'}}">
      <view class="scope-row" style="margin: 4px 0 8px">
        <view class="scope-chip {{!useManualSection ? 'active' : ''}}" bindtap="toggleManualSection">选择已有章节</view>
        <view class="scope-chip {{useManualSection ? 'active' : ''}}" bindtap="toggleManualSection">自我录入章节</view>
      </view>
      <picker wx:if="{{!useManualSection}}" mode="selector" range="{{sectionNames}}" value="{{sectionIndex}}" bindchange="onSectionChange">
        <view class="form-row">
          <text class="form-label">章节 *</text>
          <text class="form-value">{{sectionIndex >= 0 ? sectionNames[sectionIndex] : (sectionNames.length ? '请选择章节' : '本书暂无章节，请切到「自我录入章节」')}}</text>
        </view>
      </picker>
      <input wx:else class="form-input" placeholder="例如：第八章 · 上善若水" value="{{manualSection}}" bindinput="onManualSection" />
    </block>

    <!-- 每日诵读 B 通道：具体段落 -->
    <picker wx:if="{{scopeType === 'songdu' && channel === 'B'}}" mode="selector" range="{{sectionNames}}" value="{{sectionIndex}}" bindchange="onSectionChange">
      <view class="form-row">
        <text class="form-label">具体段落 *</text>
        <text class="form-value">{{sectionIndex >= 0 ? sectionNames[sectionIndex] : (sectionNames.length ? '请选择段落' : '本书暂无章节')}}</text>
      </view>
    </picker>

    <input wx:if="{{scopeType === 'zaidu'}}" class="form-input" placeholder="标题（可选）" value="{{title}}" bindinput="onTitle" />
    <textarea class="form-textarea" placeholder="{{scopeType === 'suishi' ? '随手施：一句话/一页书/一张照片都行…' : scopeType === 'songdu' ? '今日诵读内容（可留空，以语音为主）…' : '写下本章节的精读记录…'}}" value="{{content}}" bindinput="onContent" maxlength="2000" />
    <view wx:if="{{scopeType === 'suishi'}}" class="suishi-tip">不关联书目 · 不设标题 · 全员可见 · 附件归档「文件中心 › 法布施」，像发朋友圈一样简单</view>
  </view>

  <!-- 【PROTO-AUDIT-20261123 P7】已选图片九宫格预览 -->
  <view wx:if="{{imageAttachments.length}}" class="img-grid">
    <view wx:for="{{imageAttachments}}" wx:key="fileId" class="img-cell">
      <image class="img-thumb" src="{{item.preview}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
    </view>
  </view>

  <view class="attach-card">
    <view class="attach-head"><text>附件</text><text class="attach-count">{{attachHint}}</text></view>
    <view class="attach-btns">
      <view class="attach-btn" data-source="album" bindtap="chooseMedia">图片</view>
      <view class="attach-btn" data-source="camera" bindtap="chooseMedia">拍摄</view>
      <view class="attach-btn" bindtap="chooseVideo">视频</view>
      <view class="attach-btn {{recording ? 'rec' : ''}}" bindtap="toggleRecord">{{recording ? '停止 · ' + recordSeconds + 's' : '录制语音'}}</view>
      <view class="attach-btn" bindtap="choosePhoneFile">手机文件</view>
    </view>
    <view wx:if="{{recording}}" class="attach-hint rec-hint">录音中…每段最长 60 秒，到时自动保存；不足 1 秒丢弃</view>
    <view class="attach-sub" bindtap="chooseAudio">从聊天文件选音频（备选入口）</view>
    <view wx:for="{{attachments}}" wx:key="fileId" class="attach-item">
      <text class="attach-name {{item.fileType === 'audio' ? 'playable' : ''}} {{playingIndex === index ? 'playing' : ''}}" data-index="{{index}}" catchtap="playAttachment">{{item.fileType === 'audio' ? (playingIndex === index ? '⏸ ' : '▶ ') : ''}}{{item.name}}</text>
      <text class="attach-remove" data-index="{{index}}" bindtap="removeAttachment">移除</text>
    </view>
    <view wx:if="{{uploading}}" class="attach-hint">上传中…</view>
  </view>
  <view class="tip">附件上传到法布施空间，计入个人配额。</view>
  <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
    {{submitting ? '发布中…' : (scopeType === 'suishi' ? '随手一发' : scopeType === 'songdu' ? '提交每日诵读' : '发布再读一本')}}
  </view>
</block>

<block wx:else>
  <view class="success-page">
    <view class="muyu-stage {{muyuAnim ? 'go' : ''}}">
      <view class="muyu-glow"></view>
      <view class="muyu-ripple"></view>
      <view class="muyu-body"></view>
      <view class="muyu-cushion"></view>
      <view class="muyu-mallet"></view>
      <view class="muyu-plus">+1</view>
    </view>
    <view class="success-title">发布成功</view>
    <view class="success-sub">已进入法布施分享广场，30 天内展示 NEW。</view>
    <view class="success-actions">
      <view class="success-btn ghost" bindtap="replayMuyu">再敲一下</view>
      <view class="success-btn primary" bindtap="goDetail">查看作品</view>
    </view>
    <view class="success-back" bindtap="goBack">返回</view>
    <view class="success-note">木鱼 = 点赞，同一资产两用；音效在「我的」设置中可关闭。</view>
  </view>
</block>
