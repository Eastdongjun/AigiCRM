<view class="fb-detail">
  <view wx:if="{{loading}}" class="fb-loading">加载中...</view>
  <block wx:else>
    <view class="fb-card">
      <view class="fb-title">{{post.title || '无标题'}}</view>
      <view class="fb-content">{{post.content}}</view>
      <view class="fb-meta">
        <text>{{post.userName || '法布施'}}</text>
        <text>{{post.createdAt}}</text>
      </view>
      <view class="fb-actions">
        <view class="fb-action {{liked ? 'active' : ''}}" bindtap="toggleLike">🐟 {{likeCount}}</view>
        <text class="fb-action">💬 {{comments.length}}</text>
      </view>
    </view>

    <view wx:if="{{attachments.length}}" class="fb-card">
      <view class="fb-section-title">附件</view>
      <view wx:for="{{attachments}}" wx:key="id" class="fb-attachment">
        <image wx:if="{{item.fileType === 'image'}}" class="fb-attach-image" src="{{item.url}}" mode="widthFix" />
        <video wx:elif="{{item.fileType === 'video'}}" class="fb-attach-video" src="{{item.url}}" controls />
        <audio wx:elif="{{item.fileType === 'audio'}}" class="fb-attach-audio" src="{{item.url}}" controls />
        <view class="fb-attach-name">{{item.fileName || item.fileType}}</view>
      </view>
    </view>

    <view class="fb-card">
      <view class="fb-section-title">评论（{{comments.length}}）</view>
      <view wx:if="{{!comments.length}}" class="fb-empty">还没有评论</view>
      <view wx:for="{{comments}}" wx:key="id" class="fb-comment {{item.type === 'highlight' ? 'highlight' : ''}}">
        <view class="fb-comment-name">{{item.userName || '同事'}}<text wx:if="{{item.type === 'highlight'}}" class="fb-comment-badge">重点</text></view>
        <view wx:if="{{item.content}}" class="fb-comment-content">{{item.content}}</view>
        <audio wx:if="{{item.type === 'audio' && item.audioUrl}}" class="fb-comment-audio" src="{{item.audioUrl}}" controls />
      </view>
      <view wx:if="{{canCreate && !voiceMode}}" class="fb-comment-form">
        <input class="fb-input" value="{{commentText}}" placeholder="写评论..." bindinput="onCommentInput" />
        <view class="fb-chip {{highlightChecked ? 'on' : ''}}" bindtap="toggleHighlight">重点</view>
        <view class="fb-chip" bindtap="enterVoice">🎤</view>
        <button class="fb-send" size="mini" bindtap="submitComment" loading="{{submitting}}">发送</button>
      </view>
      <view wx:if="{{canCreate && voiceMode}}" class="fb-comment-form">
        <input class="fb-input" value="{{commentText}}" placeholder="语音标题（可选）" bindinput="onCommentInput" />
        <view class="fb-chip rec" bindtap="stopVoice">{{recSeconds}}s ⏹ 发送</view>
      </view>
    </view>
  </block>
</view>
