/* 【书卷改版 2026-11-16】作品详情页: 纸色底/宋体标题/墨绿互动 */
page { background: #f7f3ec; }
.fb-detail { padding: 16rpx; background: #f7f3ec; min-height: 100vh; box-sizing: border-box; }
/* 【D13 计划切片 2】作者本人管理条（修改/删除，仅作者可见） */
.fb-owner-bar { background: #fffdf8; border: 1rpx dashed #cdbfa8; border-radius: 16rpx; padding: 18rpx 22rpx; margin-bottom: 16rpx; }
.fb-owner-btn { display: inline-block; padding: 8rpx 26rpx; margin-right: 14rpx; border-radius: 999rpx; border: 1rpx solid #2d5a4a; color: #2d5a4a; font-size: 26rpx; font-weight: 700; }
.fb-owner-btn.danger { border-color: #b5543a; color: #b5543a; }
.fb-owner-btn.primary { background: #2d5a4a; color: #fff; }
.fb-owner-note { font-size: 20rpx; color: #a89a80; }
.fb-edit-area { width: 100%; min-height: 200rpx; margin: 12rpx 0; padding: 16rpx; box-sizing: border-box; border: 1rpx solid #e8e0d3; border-radius: 12rpx; font-size: 27rpx; color: #4a4238; }
.fb-owner-actions { display: flex; justify-content: flex-end; }
.fb-card { background: #fffdf8; border: 1rpx solid #e8e0d3; border-radius: 16rpx; padding: 26rpx; margin-bottom: 16rpx; }
.fb-title { font-family: 'Songti SC', 'STSong', serif; font-size: 36rpx; font-weight: 800; color: #2e2a24; line-height: 1.5; }
.fb-content { font-size: 29rpx; color: #4a4238; line-height: 1.9; margin-top: 18rpx; white-space: pre-wrap; }
.fb-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: #9c9184; margin-top: 22rpx; }
.fb-actions { display: flex; gap: 40rpx; margin-top: 20rpx; font-size: 28rpx; color: #6b6257; }
.fb-action.active { color: #b5543a; font-weight: 700; }
.fb-section-title { font-family: 'Songti SC', 'STSong', serif; font-size: 28rpx; font-weight: 700; color: #2e2a24; margin-bottom: 12rpx; }
.fb-comment { padding: 12rpx 0; border-bottom: 1rpx dashed #e8e0d3; }
.fb-comment-name { font-size: 24rpx; color: #2d5a4a; font-weight: 600; }
.fb-comment-content { font-size: 26rpx; color: #4a4238; margin-top: 4rpx; }
.fb-comment-form { display: flex; gap: 12rpx; align-items: center; margin-top: 16rpx; }
.fb-input { flex: 1; background: #faf6ee; border: 1rpx solid #e0d5c2; border-radius: 999rpx; padding: 12rpx 20rpx; font-size: 24rpx; color: #2e2a24; }
.fb-send { background: #2d5a4a; color: #fff7ee; border-radius: 999rpx; }
.fb-empty, .fb-loading { text-align: center; color: #9c9184; font-size: 24rpx; padding: 32rpx 0; }
.fb-attachment { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 14rpx; }
.fb-attach-image { width: 100%; border-radius: 14rpx; }
.fb-attach-video { width: 100%; height: 380rpx; border-radius: 14rpx; }
.fb-attach-audio { width: 100%; }
.fb-attach-name { color: #9c9184; font-size: 19rpx; }
/* 【F2 2026-11-19 拍板③】highlight 重点评论(徽标+描边底)与 audio 语音诵读评论 */
.fb-comment.highlight { border-left: 6rpx solid #b5543a; padding-left: 14rpx; background: #fdf6f0; border-radius: 8rpx; }
.fb-comment-badge { margin-left: 8rpx; padding: 1rpx 8rpx; border-radius: 6rpx; background: #b5543a; color: #fff7ee; font-size: 16rpx; font-weight: 700; }
.fb-comment-audio { margin-top: 8rpx; width: 100%; }
.fb-chip { padding: 8rpx 16rpx; border-radius: 999rpx; background: #efe7d8; color: #6b6257; font-size: 22rpx; flex-shrink: 0; }
.fb-chip.on { background: #b5543a; color: #fff7ee; font-weight: 700; }
.fb-chip.rec { background: #b5543a; color: #fff7ee; font-weight: 700; min-width: 120rpx; text-align: center; }
/* 【D14 计划切片 3】复诵条 */
.fb-action.recite { border: 1rpx solid #2d5a4a; border-radius: 999rpx; padding: 4rpx 18rpx; color: #2d5a4a; }
.fb-action.recite.reciting { background: #b5543a; border-color: #b5543a; color: #fff; }
.fb-recite-row { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; border-top: 1rpx solid #efe7d8; }
.fb-recite-name { font-size: 24rpx; font-weight: 700; color: #2e2a24; flex-shrink: 0; }
.fb-recite-dur { font-size: 20rpx; color: #a89a80; flex-shrink: 0; }
.fb-more { padding: 10px 0; color: #8a6a45; font-size: 12px; text-align: center; }
