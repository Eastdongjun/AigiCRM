@import "../fabushi-v7.wxss";

/* 整页是一个滚动容器(落点靠 scroll-into-view): 页面本身不留内边距, 内边距放在容器里的内容层上 */
.fb-page.detail-page { padding: 0; }
.fb-page .detail-scroll { height: 100vh; }
.fb-page .detail-body { padding: 24rpx 28rpx 60rpx; }

/* 作品详情(原型 A4 · 作品详情 + 互动)。公共的设计变量与组件样式在 ../fabushi-v7.wxss, 这里的规则同样限定在 .fb-page 之下
   (原因见那个文件的文件头)。 */
/* 来源条: 类型 + 书目 › 章节 */
.fb-page .src-strip { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 20rpx; border: 2rpx solid var(--mp-card-line); border-radius: 18rpx; font-size: 20rpx; color: var(--mp-ink2); background: var(--mp-tile); }
.fb-page .src-strip .src-book { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; color: #2364d8; }
.fb-page .type-tag.cyan { color: var(--cyan); background: var(--cyan-bg); }

/* 作者 + 正文 + 附件 + 木鱼 */
.fb-page .head-card { margin-top: 16rpx; padding: 20rpx 24rpx; }
.fb-page .detail-title { margin-top: 14rpx; font-size: 30rpx; font-weight: 800; line-height: 1.5; color: var(--mp-ink); }
.fb-page .detail-text { margin-top: 10rpx; font-size: 25rpx; line-height: 1.8; color: var(--mp-ink); white-space: pre-wrap; word-break: break-all; }
.fb-page .attach-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.fb-page .attach-thumb { width: 172rpx; height: 120rpx; border-radius: 16rpx; background: var(--mp-tile); }
.fb-page .attach-video { width: 100%; height: 380rpx; margin-top: 16rpx; border-radius: 16rpx; }
.fb-page .attach-audio { width: 100%; margin-top: 12rpx; }
.fb-page .attach-note { margin-top: 10rpx; font-size: 18rpx; color: var(--mp-ink4); }
.fb-page .detail-acts { display: flex; gap: 16rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 2rpx dashed var(--mp-card-line); }

/* 作者本人: 修改 / 删除 */
.fb-page .owner-card { padding: 20rpx 24rpx; }
.fb-page .owner-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.fb-page .owner-note { font-size: 18rpx; color: var(--mp-ink4); }
.fb-page .mini-action.danger { color: #e11d48; border-color: #fecdd3; background: #fff1f2; }
.fb-page .edit-area { box-sizing: border-box; width: 100%; min-height: 200rpx; padding: 16rpx; border: 2rpx solid var(--mp-card-line); border-radius: 16rpx; font-size: 26rpx; color: var(--mp-ink); background: var(--mp-tile); }
.fb-page .owner-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 12rpx; }

/* 复诵条与复诵列表 */
.fb-page .recite-strip { margin-top: 16rpx; }
.fb-page .recite-main { flex: 1; min-width: 0; }
.fb-page .recite-title { font-size: 22rpx; font-weight: 800; color: var(--mp-ink); }
.fb-page .recite-sub { margin-top: 2rpx; font-size: 19rpx; line-height: 1.5; color: var(--mp-ink3); }
.fb-page .recite-list { margin-top: 14rpx; padding: 4rpx 24rpx; }
.fb-page .recite-audio { flex: 1; width: auto; min-width: 0; }
/* 【FABUSHI-DELTA-20261128 R5】仅发起人本人可见的移除入口 */
.fb-page .recite-remove { flex-shrink: 0; align-self: center; margin-left: 12rpx; font-size: 22rpx; color: #b3402a; }

/* 评论 */
.fb-page .comment-card { padding: 4rpx 24rpx 8rpx; }
.fb-page .comment-row { display: flex; align-items: flex-start; gap: 14rpx; padding: 16rpx 0; border-top: 2rpx solid var(--mp-card-line-soft); }
.fb-page .comment-row:first-child { border-top: 0; }
.fb-page .comment-ico { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 14rpx; font-size: 20rpx; font-weight: 800; color: var(--primary); background: var(--mp-blue-bg); }
.fb-page .comment-ico.highlight { color: var(--cyan); background: var(--cyan-bg); }
.fb-page .comment-main { flex: 1; min-width: 0; }
.fb-page .comment-name { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; font-weight: 800; color: var(--mp-ink); }
.fb-page .comment-content { margin-top: 4rpx; font-size: 23rpx; line-height: 1.6; color: var(--mp-ink2); word-break: break-all; }
.fb-page .comment-audio { width: 100%; margin-top: 8rpx; }
.fb-page .more-row { padding: 16rpx 0; border-top: 2rpx solid var(--mp-card-line-soft); text-align: center; font-size: 21rpx; color: var(--accent); }
.fb-page .comment-form { display: flex; align-items: center; gap: 10rpx; padding: 16rpx 0 20rpx; border-top: 2rpx solid var(--mp-card-line-soft); }
.fb-page .comment-input { flex: 1; min-width: 0; box-sizing: border-box; height: 58rpx; padding: 0 20rpx; border: 2rpx solid var(--mp-card-line); border-radius: 999rpx; font-size: 24rpx; color: var(--mp-ink); background: var(--mp-tile); }
