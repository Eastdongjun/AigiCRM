<view class="fb-tabs">
  <view
    wx:for="{{tabs}}"
    wx:key="value"
    class="fb-tab {{active === item.value ? 'active' : ''}}"
    data-value="{{item.value}}"
    bindtap="onTabTap"
  >{{item.label}}</view>
</view>

<!-- 【D15 2026-11-23】再读一本分区：按书罗列，点书下钻 A3 按书浏览页 -->
<view wx:if="{{active === 'zaidu'}}" class="fb-book-strip">
  <view class="fb-book-head">
    <text class="fb-book-title">按书浏览</text>
    <text class="fb-book-tip">点书看这本书里每个人传了什么</text>
  </view>
  <scroll-view scroll-x class="fb-book-scroll">
    <view
      wx:for="{{books}}" wx:key="id"
      class="fb-book-chip"
      data-id="{{item.id}}" bindtap="onBookTap"
    >{{item.title}}<text class="fb-book-count">{{item.memberCount || 0}} 人 · {{item.postCount || 0}} 条</text></view>
  </scroll-view>
</view>

<view class="fb-list">
  <view wx:if="{{!loading && !posts.length}}" class="fb-empty">暂无法布施内容</view>
  <view wx:for="{{posts}}" wx:key="id" class="fb-card" data-id="{{item.id}}" bindtap="goDetail">
    <view class="fb-card-title">{{item.title || '无标题'}}<text wx:if="{{item.isNew}}" class="fb-new">NEW</text></view>
    <view class="fb-card-content">{{item.content}}</view>
    <view class="fb-card-meta">
      <text>{{item.userName || '法布施'}}</text>
      <text>{{item.createdAt}}</text>
    </view>
    <view class="fb-card-stats">
      <text>🐟 {{item.likeCount || 0}}</text>
      <text>💬 {{item.commentCount || 0}}</text>
      <text wx:if="{{item.readByMe}}">已读</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="fb-loading">加载中...</view>
  <view wx:elif="{{posts.length && posts.length >= total}}" class="fb-end">没有更多了</view>
</view>

<view wx:if="{{canCreate}}" class="fb-fab" bindtap="goUpload">＋</view>
