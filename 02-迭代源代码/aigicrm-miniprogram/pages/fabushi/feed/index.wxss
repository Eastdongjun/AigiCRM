.fb-tabs { display: flex; background: #fff; padding: 16rpx 24rpx; position: sticky; top: 0; z-index: 2; }
.fb-tab { flex: 1; text-align: center; padding: 14rpx 0; font-size: 28rpx; color: #606266; border-radius: 999rpx; }
.fb-tab.active { background: #1d4ed8; color: #fff; font-weight: 600; }
.fb-list { padding: 16rpx; }
.fb-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.fb-card-title { font-size: 30rpx; font-weight: 600; color: #1f2d3d; }
.fb-card-content { font-size: 26rpx; color: #4b5563; line-height: 1.6; margin-top: 12rpx; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.fb-card-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: #9aa4b2; margin-top: 16rpx; }
.fb-card-stats { display: flex; gap: 28rpx; font-size: 24rpx; color: #6b7280; margin-top: 12rpx; }
.fb-empty, .fb-loading, .fb-end { text-align: center; color: #9aa4b2; font-size: 24rpx; padding: 40rpx 0; }
.fb-fab { position: fixed; right: 36rpx; bottom: 120rpx; width: 96rpx; height: 96rpx; border-radius: 50%; background: #1d4ed8; color: #fff; font-size: 52rpx; line-height: 96rpx; text-align: center; box-shadow: 0 10rpx 30rpx rgba(29,78,216,.35); }
