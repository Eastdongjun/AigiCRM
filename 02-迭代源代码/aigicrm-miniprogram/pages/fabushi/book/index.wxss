@import "../fabushi-v7.wxss";

/* 书目浏览(原型 A5 · 类别 → 书目 → 版本)。公共的设计变量与组件样式在 ../fabushi-v7.wxss, 这里的规则同样限定在 .fb-page 之下
   (原因见那个文件的文件头)。 */
.fb-page.book-page { padding-bottom: 80rpx; }
.fb-page .cat-scroll { width: 100%; margin-bottom: 14rpx; white-space: nowrap; }
.fb-page .cat-row { display: inline-flex; gap: 10rpx; }
.fb-page .book-list { padding: 8rpx; }
.fb-page .expand-hint { margin-left: 10rpx; color: var(--accent); }

/* 行内展开的版本面板 */
.fb-page .version-panel { padding: 0 14rpx 18rpx; }
.fb-page .version-chips { display: flex; flex-wrap: wrap; gap: 10rpx; padding: 16rpx; border: 2rpx solid var(--mp-blue-line); border-radius: 20rpx 20rpx 0 0; background: var(--mp-blue-bg); }
.fb-page .version-meta { padding: 10rpx 16rpx 0; font-size: 21rpx; color: var(--mp-ink3); }
.fb-page .version-acts { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 14rpx 16rpx 16rpx; border: 2rpx solid var(--mp-blue-line); border-top: 0; border-radius: 0 0 20rpx 20rpx; background: var(--mp-blue-bg); }
.fb-page .mini-action.disabled { opacity: .45; }
.fb-page .sub-title { margin: 18rpx 4rpx 6rpx; font-size: 25rpx; font-weight: 800; color: var(--mp-ink); }
.fb-page .section-row { display: flex; gap: 12rpx; padding: 10rpx 6rpx; font-size: 23rpx; color: var(--mp-ink2); }
.fb-page .section-level { flex-shrink: 0; padding: 0 10rpx; border-radius: 8rpx; font-size: 18rpx; color: var(--mp-ink3); background: var(--mp-tile); }
.fb-page .post-row { padding: 12rpx 6rpx; border-top: 2rpx solid var(--mp-card-line-soft); }
.fb-page .post-title { font-size: 24rpx; font-weight: 700; color: var(--mp-ink); }

/* 页脚 */
.fb-page .lib-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; }
.fb-page .lib-hint { font-size: 21rpx; color: var(--mp-ink3); }

/* 提交书目表单 */
.fb-page .form-body { padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom)); }
.fb-page .form-row { display: flex; align-items: center; gap: 18rpx; padding: 14rpx 0; border-top: 2rpx solid var(--mp-card-line-soft); }
.fb-page .form-row:first-child { border-top: 0; }
.fb-page .form-label { flex-shrink: 0; width: 120rpx; font-size: 24rpx; color: var(--mp-ink2); }
.fb-page .form-flex { flex: 1; min-width: 0; }
.fb-page .form-row .polished-select { margin-top: 0; }
.fb-page .form-field { flex: 1; min-width: 0; box-sizing: border-box; height: 72rpx; padding: 0 20rpx; border: 2rpx solid var(--mp-card-line); border-radius: 16rpx; font-size: 25rpx; color: var(--mp-ink); background: var(--mp-tile); }
.fb-page .submit-btn { margin-top: 16rpx; }
