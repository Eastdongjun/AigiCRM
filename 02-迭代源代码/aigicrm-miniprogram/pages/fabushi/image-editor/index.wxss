@import "../fabushi-v7.wxss";

/* 【GL-12 2026-11-24】法布施图片编辑页: 深色舞台衬托图片。
   【2026-11-25 用户裁决】小程序法布施界面按原型 v7 重做外观: 工具栏从“书卷暖色”换成原型那一套配色。
   公共的设计变量在 ../fabushi-v7.wxss; 这里的规则同样限定在 .fb-page 之下(原因见那个文件的文件头)。 */
page { background: #1f1c18; height: 100vh; overflow: hidden; }
.fb-page.editor { display: flex; flex-direction: column; height: 100vh; padding: 0; }
.fb-page .stage-wrap { position: relative; flex: 1; min-height: 0; }
.fb-page .stage { width: 100%; height: 100%; }
.fb-page .position { position: absolute; top: 20rpx; left: 0; width: 100%; text-align: center; color: rgba(255, 255, 255, .8); font-size: 23rpx; pointer-events: none; }
.fb-page .stage-mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 26rpx; }
.fb-page .toolbar { flex: 0 0 auto; padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--mp-card-line); background: var(--mp-bg); }
/* 面板切换: 裁剪 / 标注 */
.fb-page .panels { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.fb-page .panel-tab { flex: 1; padding: 16rpx 0; border-radius: 18rpx; background: var(--mp-card); color: var(--mp-ink3); text-align: center; font-size: 27rpx; box-shadow: 0 12rpx 32rpx rgba(35, 57, 96, .07); }
.fb-page .panel-tab.active { background: var(--accent); color: #fff; font-weight: 700; }
/* 标注: 工具、颜色、粗细 */
.fb-page .tools { white-space: nowrap; }
.fb-page .tool-chip { display: inline-block; padding: 12rpx 30rpx; margin-right: 12rpx; border: 2rpx solid var(--mp-card-line); border-radius: 999rpx; background: var(--mp-card); color: var(--mp-ink2); font-size: 26rpx; }
.fb-page .tool-chip.active { border-color: var(--accent); background: var(--accent); color: #fff; font-weight: 600; }
.fb-page .mark-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.fb-page .swatches { display: flex; align-items: center; }
.fb-page .swatch { width: 56rpx; height: 56rpx; margin-right: 16rpx; border-radius: 50%; border: 4rpx solid transparent; box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, .12); }
.fb-page .swatch.active { border-color: var(--accent); }
.fb-page .widths { display: flex; }
.fb-page .width-chip { min-width: 72rpx; padding: 12rpx 0; margin-left: 10rpx; border-radius: 12rpx; background: var(--mp-chip-bg); color: var(--mp-ink2); text-align: center; font-size: 24rpx; }
.fb-page .width-chip.active { background: var(--accent); color: #fff; font-weight: 600; }
.fb-page .ratios { white-space: nowrap; }
.fb-page .ratio-chip { display: inline-block; padding: 12rpx 30rpx; margin-right: 12rpx; border: 2rpx solid var(--mp-card-line); border-radius: 999rpx; background: var(--mp-card); color: var(--mp-ink2); font-size: 26rpx; }
.fb-page .ratio-chip.active { border-color: var(--accent); background: var(--accent); color: #fff; font-weight: 600; }
.fb-page .hint { margin-top: 16rpx; color: var(--mp-ink3); font-size: 21rpx; }
.fb-page .actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.fb-page .act-btn { flex: 1; padding: 16rpx 0; border: 2rpx solid var(--mp-card-line); border-radius: 14rpx; background: var(--mp-card); color: var(--accent); text-align: center; font-size: 25rpx; }
.fb-page .act-btn.disabled { opacity: .4; }
.fb-page .act-btn.danger { color: #e11d48; }
.fb-page .decide { display: flex; gap: 14rpx; margin-top: 20rpx; }
.fb-page .decide-btn { flex: 1; padding: 22rpx 0; border-radius: 18rpx; text-align: center; font-size: 27rpx; font-weight: 700; }
.fb-page .decide-btn.primary { background: linear-gradient(135deg, #2364d8, #3e8df3); color: #fff; box-shadow: 0 14rpx 26rpx rgba(35, 100, 216, .22); }
.fb-page .decide-btn.primary.disabled { opacity: .5; }
.fb-page .decide-btn.ghost { background: var(--mp-tile); color: var(--mp-ink2); border: 2rpx solid var(--mp-card-line); }
.fb-page .export-canvas { position: fixed; left: -9999px; top: 0; }
