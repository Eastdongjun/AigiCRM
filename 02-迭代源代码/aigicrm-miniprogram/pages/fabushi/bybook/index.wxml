<!-- 【MP-PARITY 2026-11-23】A3 按书浏览：书头卡 + 三种排列 + 分组内容列表 -->
<view class="bb-page">
  <view wx:if="{{book}}" class="bb-head">
    <view class="bb-title-row">
      <text class="bb-title">《{{book.title}}》</text>
      <text wx:if="{{book.pdfFileId}}" class="bb-tag">电子书</text>
    </view>
    <view wx:if="{{versionText}}" class="bb-meta">{{versionText}}</view>
    <view class="bb-stats">
      <text>{{statsText}}</text>
      <text wx:if="{{book.otherVersions}}"> · 另有 {{book.otherVersions}} 版本</text>
    </view>
    <view class="bb-acts">
      <button class="bb-btn primary" bindtap="openReader" disabled="{{!book.pdfFileId}}">在线阅读</button>
      <button wx:if="{{canCreate}}" class="bb-btn" bindtap="goUpload">我也传</button>
    </view>
  </view>

  <view class="bb-sorts">
    <view
      wx:for="{{sorts}}" wx:key="value"
      class="bb-sort {{sort === item.value ? 'active' : ''}}"
      data-value="{{item.value}}" bindtap="onSortTap"
    >{{item.label}}</view>
    <text class="bb-count">{{loadedCount}}/{{total}} 条</text>
  </view>

  <view wx:if="{{loading}}" class="bb-loading">加载中...</view>
  <view wx:elif="{{!groups.length}}" class="bb-empty">这本书还没有人上传内容</view>

  <view wx:for="{{groups}}" wx:for-item="g" wx:key="key" class="bb-group">
    <view wx:if="{{g.title}}" class="bb-group-head">
      <text class="bb-group-title">{{g.title}}</text>
      <text class="bb-group-count">{{g.count}} 条</text>
    </view>
    <view
      wx:for="{{g.items}}" wx:for-item="item" wx:for-index="itemIdx" wx:key="id"
      class="bb-item" data-id="{{item.id}}" bindtap="goDetail"
    >
      <view class="bb-avatar">{{item.avatar}}</view>
      <view class="bb-item-main">
        <view class="bb-item-name">
          <text class="bb-name">{{item.userName || '法布施'}}</text>
          <text wx:if="{{item.isNew}}" class="bb-new">NEW</text>
          <text wx:if="{{item.formText}}" class="bb-form">· {{item.formText}}</text>
        </view>
        <view class="bb-item-summary">{{item.summary}}</view>
        <view class="bb-item-meta">
          <text>{{item.timeText}}</text>
          <text> · 木鱼 {{item.likeCount || 0}}</text>
          <text wx:if="{{item.recitationCount}}"> · 复诵 {{item.recitationCount}}</text>
        </view>
      </view>
      <view class="bb-detail">详情</view>
    </view>
  </view>

  <!-- 【S4.2】分页状态：加载中 / 可上拉 / 已全部加载 -->
  <view wx:if="{{loadingMore}}" class="bb-more">加载中...</view>
  <view wx:elif="{{hasMore}}" class="bb-more">上拉加载更多</view>
  <view wx:elif="{{loadedCount}}" class="bb-more">已全部加载</view>

  <view class="bb-foot">书=书名+作者+版本唯一确定（D2）；不同版本各自成册</view>
</view>
