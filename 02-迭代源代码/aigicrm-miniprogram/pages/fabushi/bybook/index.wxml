<!-- 【MP-PARITY 2026-11-23】A3 按书浏览: 书头卡 + 三种排列 + 分组内容列表 -->
<!-- 【2026-11-25 用户裁决】小程序法布施界面按原型 v7 重做外观: 本页 = 原型 A3 按书浏览(再读一本 · 按书下钻), 版式按原型重排。 -->
<view class="fb-page">
  <!-- 书头卡: 封面 + 书名 + 版本信息 + 参与 / 内容 + 在线阅读 / 我也传 -->
  <view wx:if="{{book}}" class="card bb-head">
    <view class="bb-head-row">
      <view class="cover {{coverTone}}"><text class="cover-text">{{coverText}}</text></view>
      <view class="bb-head-main">
        <view class="book-name">《{{book.title}}》<text wx:if="{{book.pdfFileId}}" class="type-tag songdu">电子书</text></view>
        <view wx:if="{{versionText}}" class="book-meta">{{versionText}}</view>
        <view class="book-meta">参与 <text class="bb-strong">{{memberCount}}</text> 人 · 再读内容 <text class="bb-strong">{{total}}</text> 条<text wx:if="{{otherVersions}}"> · 另有 {{otherVersions}} 版本</text></view>
      </view>
    </view>
    <view class="bb-acts">
      <view class="detail-primary-action {{book.pdfFileId ? '' : 'disabled'}}" bindtap="openReader">在线阅读</view>
      <view wx:if="{{canCreate}}" class="secondary-btn" bindtap="goUpload">我也传</view>
    </view>
  </view>

  <!-- 三种排列: 按时间 / 按章节 / 按成员 -->
  <view class="filter-chips bb-sorts">
    <view wx:for="{{sorts}}" wx:key="value" class="filter-chip {{sort === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onSortTap">{{item.label}}</view>
    <text class="bb-count">{{loadedCount}}/{{total}} 条</text>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!groups.length}}" class="empty">这本书还没有人上传内容</view>

  <!-- 分组内容列表: 每组一个组头(章节名 / 成员名 + 条数), 下面是成员行 -->
  <view wx:for="{{groups}}" wx:for-item="g" wx:key="key" class="card bb-group">
    <view wx:if="{{g.title}}" class="bb-group-head"><text>{{g.title}}</text><text>{{g.count}} 条</text></view>
    <view wx:for="{{g.items}}" wx:for-item="item" wx:for-index="itemIdx" wx:key="id" class="book-row" data-id="{{item.id}}" bindtap="goDetail">
      <view class="book-ico {{item.avatarTone}}">{{item.avatarText}}</view>
      <view class="book-main">
        <view class="book-name">{{item.userName || '法布施'}}<text wx:if="{{item.formText}}" class="bb-form"> · {{item.formText}}</text><text wx:if="{{item.isNew}}" class="badge-new">NEW</text></view>
        <view class="book-meta">{{item.timeText}} · 木鱼 {{item.likeCount || 0}}<text wx:if="{{item.recitationCount}}"> · 复诵 {{item.recitationCount}}</text></view>
        <view wx:if="{{item.summary}}" class="bb-summary">{{item.summary}}</view>
      </view>
      <text class="mini-action secondary">详情</text>
    </view>
  </view>

  <!-- 【S4.2】分页状态: 加载中 / 可上拉 / 已全部加载 -->
  <view wx:if="{{loadingMore}}" class="empty">加载中…</view>
  <view wx:elif="{{hasMore}}" class="empty">上拉加载更多</view>
  <view wx:elif="{{loadedCount}}" class="empty">已全部加载</view>

  <view class="bb-foot">书=书名+作者+版本唯一确定（D2）；不同版本各自成册</view>
</view>
