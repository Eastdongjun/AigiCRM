@import "../fabushi-v7.wxss";

/* 按书浏览(原型 A3 · 再读一本 · 按书下钻)。公共的设计变量与组件样式在 ../fabushi-v7.wxss, 这里的规则同样限定在 .fb-page 之下
   (原因见那个文件的文件头)。 */
/* 书头卡 */
.fb-page .bb-head { padding: 22rpx 26rpx; }
.fb-page .bb-head-row { display: flex; align-items: center; gap: 20rpx; }
.fb-page .bb-head-main { flex: 1; min-width: 0; }
.fb-page .bb-head-main .book-name { font-size: 27rpx; }
.fb-page .bb-head-main .book-meta { margin-top: 4rpx; }
.fb-page .bb-strong { font-weight: 800; color: var(--mp-ink); }
.fb-page .bb-acts { display: flex; gap: 14rpx; margin-top: 18rpx; }
.fb-page .bb-acts .detail-primary-action, .fb-page .bb-acts .secondary-btn { flex: 1; width: auto; height: 68rpx; margin: 0; font-size: 25rpx; }

/* 三种排列 */
.fb-page .bb-sorts { margin-top: 20rpx; }
.fb-page .bb-count { align-self: center; margin-left: auto; font-size: 21rpx; color: var(--mp-ink3); }

/* 分组内容列表 */
.fb-page .bb-group { padding: 8rpx; }
.fb-page .bb-group-head { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 18rpx; border-radius: 16rpx 16rpx 0 0; font-size: 20rpx; font-weight: 800; color: var(--mp-ink2); background: var(--mp-tile); }
.fb-page .bb-group .book-row:first-child, .fb-page .bb-group-head + .book-row { border-top: 0; }
.fb-page .bb-form { font-size: 21rpx; font-weight: 400; color: var(--mp-ink2); }
.fb-page .bb-summary { display: -webkit-box; margin-top: 6rpx; overflow: hidden; font-size: 23rpx; line-height: 1.5; color: var(--mp-ink); -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.fb-page .bb-foot { margin-top: 18rpx; padding: 0 40rpx; text-align: center; font-size: 19rpx; line-height: 1.6; color: var(--mp-ink4); }
