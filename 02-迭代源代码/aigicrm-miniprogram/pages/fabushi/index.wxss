@import "fabushi-v7.wxss";

/* 法布施主页(原型 A1 + 五个页签; 书架页签 = C1/C2, 统计页签 = C5)。公共的设计变量与组件样式在 fabushi-v7.wxss。
   【2026-11-25 用户裁决】此前 11-16 的“书卷暖色”画法已整体换成原型 v7 的样子。
   这里的规则同样都限定在 .fb-page 之下(原因见 fabushi-v7.wxss 文件头)。 */

/* ===== 觉醒页签 ===== */
.fb-page .me-strip + .card { margin-top: 18rpx; }
.fb-page .remind-card { padding: 20rpx 24rpx; }
.fb-page .remind-card .feed-title { font-size: 24rpx; }
.fb-page .remind-card .book-meta { margin-top: 6rpx; text-align: center; }
.fb-page .current-card { padding: 20rpx 24rpx; }
.fb-page .current-card .feed-title { font-size: 24rpx; }
.fb-page .current-row { display: flex; align-items: center; gap: 18rpx; margin-top: 12rpx; }
.fb-page .current-card .cover { width: 72rpx; height: 96rpx; }
.fb-page .current-main { flex: 1; min-width: 0; }
.fb-page .current-note { margin-top: 6rpx; font-size: 19rpx; font-weight: 800; color: #2364d8; }
/* 原型 A1 没有“认知广场 / 提醒设置”的入口(原型里从应用中心进); 小程序里这两个页面只从这里进, 所以留两个小按钮 */
.fb-page .home-links { display: flex; justify-content: flex-end; gap: 10rpx; }

/* ===== 广场页签 ===== */
.fb-page .feed-title-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fb-page .home-link-row { display: flex; align-items: center; justify-content: center; gap: 6rpx; padding: 20rpx 0; font-size: 22rpx; font-weight: 700; color: var(--accent); }

/* ===== 书库页签 ===== */
.fb-page .book-list { padding: 8rpx; }
.fb-page .book-list .book-row:first-child { border-top: 0; }
.fb-page .lib-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; }
.fb-page .lib-hint { font-size: 21rpx; color: var(--mp-ink3); }

/* ===== 书架页签(C1 / C2) ===== */
.fb-page .shelf-head { display: flex; justify-content: flex-end; margin-bottom: 14rpx; }
.fb-page .shelf-head + .current-card .cover { width: 88rpx; height: 120rpx; }
.fb-page .group-scroll { width: 100%; margin-bottom: 16rpx; white-space: nowrap; }
.fb-page .group-row { display: inline-flex; gap: 10rpx; }
.fb-page .manage-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.fb-page .manage-count { font-size: 22rpx; font-weight: 700; color: var(--mp-ink2); }
.fb-page .manage-hint { font-size: 19rpx; color: var(--mp-ink4); }
.fb-page .batch-card { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; padding: 18rpx 22rpx; }
.fb-page .batch-title { font-size: 22rpx; font-weight: 800; color: var(--mp-ink); }
.fb-page .batch-actions { display: flex; flex-wrap: wrap; gap: 10rpx; }
.fb-page .card-hint { font-size: 19rpx; font-weight: 400; color: var(--mp-ink4); }
.fb-page .card-hint.center { display: block; margin: 24rpx 0; text-align: center; }
.fb-page .row-main-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--mp-ink2); }
.fb-page .row-action { flex: 1; font-weight: 700; color: var(--accent); }
.fb-page .row-name.dept { max-width: 260rpx; }
.fb-page .row-name.book { max-width: 220rpx; }

/* ===== 统计页签(C5) ===== */
.fb-page .stats-hero { margin-bottom: 4rpx; }
.fb-page .stats-list-row .row-main .row-name { color: var(--mp-ink); }
