.fb-hero {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
  color: #fff;
  padding: 24rpx 32rpx;
}
.fb-hero-title { font-size: 34rpx; font-weight: 600; }
.fb-hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 4rpx; }
.fb-stats { display: flex; background: #fff; margin: 16rpx; border-radius: 12rpx; padding: 20rpx 0; }
.fb-stat { flex: 1; text-align: center; }
.fb-stat-num { font-size: 34rpx; font-weight: 600; color: #1d4ed8; }
.fb-stat-label { font-size: 22rpx; color: #8a94a6; margin-top: 4rpx; }
.fb-entry { display: flex; align-items: center; background: #fff; margin: 16rpx; border-radius: 12rpx; padding: 24rpx; }
.fb-entry-icon { font-size: 40rpx; margin-right: 20rpx; }
.fb-entry-body { flex: 1; }
.fb-entry-title { font-size: 30rpx; font-weight: 500; }
.fb-entry-sub { font-size: 22rpx; color: #8a94a6; margin-top: 4rpx; }
.fb-entry-arrow { color: #c0c8d4; font-size: 36rpx; }
