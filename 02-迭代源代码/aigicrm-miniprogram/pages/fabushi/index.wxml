<view class="fb-page">
  <view class="fb-hero">
    <view>
      <view class="fb-hero-title">法布施</view>
      <view class="fb-hero-sub">读书 · 心得 · 正能量</view>
    </view>
    <view class="fb-hero-actions">
      <view class="fb-hero-btn ghost" bindtap="refresh">刷新</view>
      <view class="fb-hero-btn solid" bindtap="goUpload" wx:if="{{canCreate}}">＋ 上传</view>
    </view>
  </view>

  <view class="me-strip">
    <view class="me-cell"><text class="me-num">{{personal.myReadCount || 0}}</text><text class="me-label">本月已读</text></view>
    <view class="me-cell"><text class="me-num">{{personal.myPosts || 0}}</text><text class="me-label">本月发布</text></view>
    <view class="me-cell"><text class="me-num">{{personal.myLikesReceived || 0}}</text><text class="me-label">获木鱼</text></view>
    <view class="me-cell"><text class="me-num">{{personal.myComments || 0}}</text><text class="me-label">收评论</text></view>
  </view>

  <view class="mobile-tabs">
    <view wx:for="{{tabs}}" wx:key="value" class="mobile-tab {{activeTab === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onTab">
      {{item.label}}<text wx:if="{{item.phase}}" class="phase-chip">{{item.phase}}</text>
    </view>
  </view>

  <block wx:if="{{activeTab === 'lib' || activeTab === 'znl'}}">
    <view class="card search-card">
      <view class="search-input-wrap">
        <input class="search-input" placeholder="搜索书目 / 心得 / 关键字" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
        <view class="search-btn" bindtap="onSearch">搜索</view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'lib' && recommended}}" class="card recommend-card" bindtap="goBook">
      <view class="cover">{{recommended.title}}</view>
      <view class="recommend-main">
        <view class="recommend-title">今日推荐 · {{recommended.title}}</view>
        <view class="recommend-meta">{{recommended.author || '法布施书目'}}<text wx:if="{{recommended.pages}}"> · {{recommended.pages}} 页</text><text wx:if="{{recommended.pdfFileId}}"> · 电子书</text></view>
      </view>
      <view class="mini-action">查看</view>
    </view>

    <view wx:if="{{activeTab === 'lib' && activities.length}}" class="card">
      <view class="stats-title">共读活动</view>
      <view wx:for="{{activities}}" wx:key="id" class="activity-row">
        <view><view class="shelf-title">{{item.title}}</view><view class="shelf-meta">{{item.bookTitle || '—'}} · {{item.joinCount || 0}} 人参与</view></view>
        <text wx:if="{{item.joined}}" class="activity-joined">已参与</text>
        <view wx:elif="{{item.status === 'active'}}" class="mini-action" data-id="{{item.id}}" bindtap="joinActivity">参与</view>
        <text wx:else class="activity-joined">已结束</text>
      </view>
    </view>

    <view class="card feed-card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="openPost">
      <view class="feed-head">
        <view class="feed-title"><text class="type-tag {{item.scopeType}}">{{item.scopeType === 'znl' ? '正能量' : item.scopeType === 'recitation' ? '诵读' : '心得'}}</text>{{item.title || '无标题'}}</view>
        <text class="feed-time">{{item.createdAt}}</text>
      </view>
      <view class="feed-summary">{{item.content}}</view>
      <view class="feed-meta">
        <text>{{item.userName || '法布施'}}</text>
        <text>木鱼 {{item.likeCount || 0}}</text>
        <text>评论 {{item.commentCount || 0}}</text>
        <text class="read {{item.readByMe ? 'done' : 'unread'}}">{{item.readByMe ? '已读' : '未读'}}</text>
      </view>
    </view>
    <view wx:if="{{!loading && posts.length === 0}}" class="empty">暂无法布施内容</view>
  </block>

  <block wx:if="{{activeTab === 'shelf'}}">
    <view wx:if="{{shelf.length === 0}}" class="card ghost-panel"><view class="ghost-sub">书架还是空的，去书目浏览加入一本吧。</view></view>
    <view wx:for="{{shelf}}" wx:key="id" class="card shelf-item" data-id="{{item.bookId}}" bindtap="goShelfBook">
      <view class="cover">{{item.title}}</view>
      <view class="shelf-main">
        <view class="shelf-title">{{item.title}}</view>
        <view class="shelf-meta">{{item.author || '—'}}<text wx:if="{{item.pages}}"> · {{item.pages}} 页</text><text wx:if="{{item.lastPage}}"> · 读到第 {{item.lastPage}} 页</text></view>
        <view class="shelf-progress"><view style="width: {{item.totalPages ? (item.lastPage * 100 / item.totalPages) : 0}}%;"></view></view>
      </view>
      <text class="shelf-status">{{item.status === 'finished' ? '已读完' : item.status === 'favorite' ? '收藏' : '在读'}}</text>
    </view>
  </block>

  <block wx:if="{{activeTab === 'rec'}}">
    <view class="card">
      <view class="rec-head"><text>本月阅读</text><text class="rec-sum">{{records.readDays || 0}} 天 · {{records.readCount || 0}} 次</text></view>
      <view wx:if="{{!(records.days || []).length}}" class="ghost-sub">本月暂无阅读记录</view>
      <view wx:for="{{records.days}}" wx:key="date" class="rec-row"><text>{{item.date}}</text><b>{{item.count}} 次</b></view>
    </view>
  </block>

  <block wx:if="{{activeTab === 'stats'}}">
    <view class="card stats-panel">
      <view class="stats-title">我的法布施</view>
      <view class="stats-grid">
        <view class="stats-cell"><text class="stats-num">{{personal.myPosts || 0}}</text><text class="stats-label">我的内容</text></view>
        <view class="stats-cell"><text class="stats-num">{{personal.myComments || 0}}</text><text class="stats-label">我的评论</text></view>
        <view class="stats-cell"><text class="stats-num">{{personal.myReadCount || 0}}</text><text class="stats-label">我的阅读</text></view>
        <view class="stats-cell"><text class="stats-num">{{personal.myLikesReceived || 0}}</text><text class="stats-label">获木鱼</text></view>
      </view>
      <view class="stats-link" bindtap="goSettings">提醒设置 ›</view>
    </view>
    <view wx:if="{{team}}" class="card">
      <view class="stats-title">团队阅读 · 本周</view>
      <view class="team-sum">今日已读 {{team.todayReadUsers || 0}} 人<text wx:if="{{team.coveragePct != null}}"> · 覆盖率 {{team.coveragePct}}%</text></view>
      <view wx:for="{{team.ranking}}" wx:key="userId" wx:if="{{index < 5}}" class="rank-row">
        <text class="rank-no">{{index + 1}}</text><text class="rank-name">{{item.userName}}</text><text class="rank-dept">{{item.deptName}}</text><b>{{item.postCount}}</b>
      </view>
      <view wx:if="{{!(team.ranking || []).length}}" class="ghost-sub">本周期暂无团队数据</view>
    </view>
  </block>

  <view class="fb-entries">
    <view class="fb-entry" bindtap="goFeed">
      <view class="fb-entry-icon">≡</view>
      <view class="fb-entry-body"><view class="fb-entry-title">内容流</view><view class="fb-entry-sub">心得 · 诵读 · 正能量</view></view>
      <view class="fb-entry-arrow">›</view>
    </view>
    <view class="fb-entry" bindtap="goBook">
      <view class="fb-entry-icon">书</view>
      <view class="fb-entry-body"><view class="fb-entry-title">书目浏览</view><view class="fb-entry-sub">按类别浏览书目与心得</view></view>
      <view class="fb-entry-arrow">›</view>
    </view>
  </view>
</view>
