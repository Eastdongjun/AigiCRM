<view class="fb-hero">
  <view class="fb-hero-title">法布施</view>
  <view class="fb-hero-sub">读书 · 心得 · 正能量</view>
</view>

<view class="fb-stats" wx:if="{{personal.myPosts != null}}">
  <view class="fb-stat">
    <view class="fb-stat-num">{{personal.myPosts || 0}}</view>
    <view class="fb-stat-label">我的内容</view>
  </view>
  <view class="fb-stat">
    <view class="fb-stat-num">{{personal.myReadCount || 0}}</view>
    <view class="fb-stat-label">我的阅读</view>
  </view>
  <view class="fb-stat">
    <view class="fb-stat-num">{{personal.myLikesReceived || 0}}</view>
    <view class="fb-stat-label">获木鱼</view>
  </view>
</view>

<view class="fb-entry" bindtap="goBook">
  <view class="fb-entry-icon">📚</view>
  <view class="fb-entry-body">
    <view class="fb-entry-title">书目浏览</view>
    <view class="fb-entry-sub">按类别浏览书目与心得</view>
  </view>
  <view class="fb-entry-arrow">›</view>
</view>

<view class="fb-entry" bindtap="goUpload" wx:if="{{canCreate}}">
  <view class="fb-entry-icon">✍️</view>
  <view class="fb-entry-body">
    <view class="fb-entry-title">发布</view>
    <view class="fb-entry-sub">心得 / 诵读 / 正能量</view>
  </view>
  <view class="fb-entry-arrow">›</view>
</view>
