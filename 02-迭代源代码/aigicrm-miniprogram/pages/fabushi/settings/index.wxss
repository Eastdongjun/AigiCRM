@import "../fabushi-v7.wxss";

/* 每日提醒(原型 C4)。公共的设计变量与组件样式在 ../fabushi-v7.wxss, 这里的规则同样限定在 .fb-page 之下(原因见那个文件的文件头)。 */
.fb-page .set-card { padding: 20rpx 24rpx 8rpx; }
.fb-page .time-head { display: flex; justify-content: center; margin: 4rpx 0 16rpx; }
.fb-page .time-pick { display: flex; align-items: center; gap: 16rpx; }
.fb-page .time-big { font-size: 76rpx; font-weight: 800; line-height: 1.1; letter-spacing: 2rpx; font-variant-numeric: tabular-nums; color: var(--mp-ink); }
.fb-page .freq-chips { justify-content: flex-end; margin-top: 0; }
.fb-page .set-value.done { font-weight: 800; color: var(--green); }
.fb-page .preview-card { padding: 22rpx 24rpx; }
.fb-page .preview-box { padding: 18rpx 22rpx; border: 2rpx solid var(--mp-card-line); border-radius: 20rpx; background: var(--mp-tile); }
.fb-page .preview-title { font-size: 24rpx; font-weight: 800; color: var(--mp-ink); }
.fb-page .preview-text { margin-top: 8rpx; font-size: 22rpx; line-height: 1.6; color: var(--mp-ink2); }
.fb-page .preview-meta { margin-top: 10rpx; font-size: 19rpx; color: var(--mp-ink4); }
