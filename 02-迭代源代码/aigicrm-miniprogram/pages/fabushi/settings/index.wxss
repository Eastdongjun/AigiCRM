/* 【书卷改版 2026-11-16】提醒设置页: 纸色底/墨绿保存钮 */
page { background: #f7f3ec; }
.settings-page { padding: 28rpx 24rpx 60rpx; box-sizing: border-box; }
.card { margin-bottom: 18rpx; padding: 8rpx 24rpx; border: 1rpx solid #e8e0d3; border-radius: 18rpx; background: #fffdf8; }
.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx dashed #e8e0d3; }
.setting-row:last-child { border-bottom: 0; }
.setting-title { color: #2e2a24; font-size: 26rpx; font-weight: 600; }
.setting-sub { margin-top: 5rpx; color: #9c9184; font-size: 20rpx; line-height: 1.5; }
.setting-value { flex-shrink: 0; color: #2d5a4a; font-size: 23rpx; font-weight: 600; }
.note-card { padding: 20rpx 24rpx; }
.save-btn { margin-top: 30rpx; padding: 22rpx 0; border-radius: 16rpx; color: #fff7ee; background: #2d5a4a; font-size: 27rpx; font-weight: 700; text-align: center; }
.save-btn.disabled { opacity: .6; }
