<view class="page indicator-page">
  <view class="hero">
    <view class="hero-title">核心客户六项指标</view>
    <view class="hero-sub">开票、回款门槛 + 五项客户质量评分</view>
  </view>
  <view wx:if="{{indicatorView.showLoading}}" class="card muted">加载中...</view>
  <view wx:if="{{indicatorView.showMetrics}}" class="grid indicator-grid">
    <view wx:for="{{indicatorView.metrics}}" wx:key="label" class="metric card"><text>{{item.label}}</text><text class="{{item.className}}">{{item.value}}</text></view>
  </view>
  <view class="card indicator-rank-card">
    <view class="section-title">客户排行</view>
    <block wx:for="{{indicatorView.ranking}}" wx:key="id">
      <view class="rank-row"><text class="rank-index">{{item.rank}}</text><text class="rank-name">{{item.customerName}}</text><text>{{item.coreText}}</text><text class="rank-score">{{item.totalScore}}</text></view>
    </block>
    <view wx:if="{{indicatorView.showRankingEmpty}}" class="muted">暂无排行数据</view>
  </view>
</view>
