.page { padding: 24rpx; }.hero { padding: 28rpx; background: #2563eb; color: #fff; border-radius: 16rpx; }.hero-title { font-size: 38rpx; font-weight: 800; }.hero-sub { margin-top: 10rpx; opacity: .82; font-size: 24rpx; }.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }.card { background: #fff; border-radius: 12rpx; padding: 24rpx; box-sizing: border-box; }.metric { display: flex; flex-direction: column; gap: 10rpx; color: #64748b; }.metric-value { color: #2563eb; font-size: 38rpx; font-weight: 800; }.metric-value.success { color: #16a34a; }.section { margin-top: 20rpx; }.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }.rank-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; border-bottom: 1rpx solid #e5e7eb; color: #64748b; }.rank-index { width: 38rpx; color: #2563eb; font-weight: 700; }.rank-name { flex: 1; color: #1e293b; }.rank-score { color: #2563eb; font-weight: 700; }.muted { color: #94a3b8; }
