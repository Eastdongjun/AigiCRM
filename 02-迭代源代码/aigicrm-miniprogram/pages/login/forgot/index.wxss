.steps{display:flex;justify-content:space-between;margin:24rpx 0;color:#94a3b8;font-size:22rpx}.step.active{color:#2563eb;font-weight:700}.form-card{margin-top:24rpx}.label{margin-top:20rpx;color:#475569;font-size:26rpx}.input{width:100%;box-sizing:border-box;margin-top:10rpx;padding:0 20rpx;height:76rpx;border:1rpx solid #dbeafe;border-radius:14rpx;background:#f8fbff;font-size:27rpx}.code-row{display:flex;align-items:center;gap:12rpx}.code-row .input{flex:1}.code-row .secondary-btn{width:190rpx;margin:10rpx 0 0;padding:14rpx 8rpx}.submit-btn{margin-top:30rpx}.back-btn{display:block;margin:18rpx auto 0}
