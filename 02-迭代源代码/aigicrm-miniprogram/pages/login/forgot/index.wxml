<view class="page"><view class="hero"><view class="hero-title">找回密码</view><view class="hero-sub">验证账号后设置新密码</view></view><view class="steps"><text class="step {{step>=1?'active':''}}">1 验证账号</text><text class="step {{step>=2?'active':''}}">2 验证身份</text><text class="step {{step>=3?'active':''}}">3 重置密码</text></view><view class="card form-card"><block wx:if="{{step===1}}"><view class="label">登录账号</view><input class="input" data-field="username" value="{{username}}" bindinput="input" placeholder="请输入账号"/></block><block wx:elif="{{step===2}}"><view class="muted">验证码将发送至 {{maskedPhone || '已绑定手机'}}</view><view class="code-row"><input class="input" data-field="code" value="{{code}}" bindinput="input" placeholder="请输入验证码" maxlength="6"/><button class="secondary-btn" bindtap="sendCode">{{countdown ? countdown + 's' : '获取验证码'}}</button></view></block><block wx:else><view class="label">新密码</view><input class="input" password data-field="newPassword" value="{{newPassword}}" bindinput="input" placeholder="至少 6 位"/><view class="label">确认密码</view><input class="input" password data-field="confirmPassword" value="{{confirmPassword}}" bindinput="input" placeholder="再次输入新密码"/></block><button class="btn submit-btn" loading="{{loading}}" bindtap="next">{{step===3?'确认重置':'下一步'}}</button><button class="text-btn back-btn" bindtap="back">{{step===1?'返回登录':'上一步'}}</button></view></view>
