<view class="page login-page">
  <view class="login-orb login-orb-one"></view>
  <view class="login-orb login-orb-two"></view>
  <view class="login-panel">
    <view class="login-brand-mark">AI</view>
    <view class="login-kicker">智能客户运营工作台</view>
    <view class="hero-title login-title">运筹马年·市场资源管理系统</view>
    <view class="login-copy">{{loginView.copyText}}</view>
    <view wx:if="{{loginView.showAccountFields}}" class="login-field">
      <text class="field-label">用户名</text>
      <input class="input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view wx:if="{{loginView.showAccountFields}}" class="login-field">
      <text class="field-label">密码</text>
      <input class="input" placeholder="请输入密码" password value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <button class="btn login-btn" loading="{{loginView.submitLoading}}" bindtap="submit">{{loginView.submitText}}</button>
    <button wx:if="{{loginView.showForgotAction}}" class="text-btn forgot-btn" bindtap="openForgot">忘记密码？</button>
  </view>
  <!-- ICP 备案(工信部要求展示;小程序无法直接跳转外部网页,点击复制备案系统网址) -->
  <view class="icp-line" bindtap="copyBeianUrl">陕ICP备2024024412号</view>
</view>
