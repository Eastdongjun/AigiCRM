<view class="page login-page"><view class="login-panel"><view class="hero-title">AIGICRM</view><view class="muted">{{demoMode ? '当前为演示模式，无需账号密码' : '使用 PC 端同一账号登录'}}</view><input wx:if="{{!demoMode}}" class="input" placeholder="用户名" value="{{username}}" bindinput="onUsernameInput" /><input wx:if="{{!demoMode}}" class="input" placeholder="密码" password value="{{password}}" bindinput="onPasswordInput" /><button class="btn login-btn" loading="{{loading}}" bindtap="submit">{{demoMode ? '进入原型' : '登录'}}</button></view></view>
<button wx:if="{{!demoMode}}" class="text-btn forgot-btn" bindtap="openForgot">忘记密码？</button>
