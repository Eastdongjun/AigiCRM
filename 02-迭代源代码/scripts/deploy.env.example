# ============================================================
# AIGICRM 部署环境变量模板(deploy.env.example)
# 【2026-11-05 产品化批】部署凭据/目标参数模板化——每个部署目标(生产/测试/客户实例)
# 复制本文件为独立 env 文件(仓库外, 如 ~/.aigicrm-deploy.env), 只填值, 不改键名。
# 铁律: 本文件只允许占位符, 任何真实凭据不得写入仓库(含注释示例)。
# 消费方: scripts/deploy-lib.sh 及 deploy-*.sh; 缺键时的行为见各脚本头注。
# ============================================================

# ---- 通用 ----
APP_NAME=请填入系统显示名          # 例: 某某建材销售管理系统(登录页/浏览器标题)
APP_SLUG=请填入部署槽位名          # 容器/目录前缀, 例: aigicrm
DEPLOY_DIR=请填入远端部署目录      # 生产: /data/ycmn 一类
DB_NAME=请填入业务库名

# ---- 生产目标(ssh_prod 走这里) ----
PROD_HOST=请填入生产主机
PROD_USER=请填入生产SSH用户
PROD_PASS=请填入生产SSH口令        # 或改用 PROD_KEY 指密钥路径, 二选一
PROD_KEY=
DEPLOY_DATA_DIR=请填入生产数据盘目录
NAS_DIST_DIR=请填入NAS制品目录
NAS_BACKUP_DIR=请填入NAS备份目录
DB_PASSWORD=请填入生产MySQL口令    # deploy-db.sh 生产迁移用(root)

# ---- 测试目标(ssh_test 走这里) ----
TEST_HOST=请填入测试主机
TEST_USER=请填入测试SSH用户
TEST_PASS=请填入测试SSH口令        # 已配免密钥时可留空注释
TEST_DB_NAME=aigicrm_prod_20261016 # 测试库=生产快照库(2026-10-16 起)
TEST_DB_CONTAINER=shared-mysql
TEST_DB_NETWORK=shopjoy-net        # shared-mysql 无宿主端口, flyway 须挂网直连
# 测试库专用凭据(可选; 缺省时自动从远端容器 Env 派生 root 口令, 不落盘)
#TEST_DB_ADMIN_USER=root
#TEST_DB_ADMIN_PASSWORD=

# ---- 应用运行时(backend 容器 env 源) ----
JWT_SECRET=请填入JWT签名密钥
HEALTH_CHECK_USER=请填入冒烟账号
HEALTH_CHECK_PASS=请填入冒烟口令
OSS_ACCESS_KEY_ID=请填入对象存储AK
OSS_ACCESS_KEY_SECRET=请填入对象存储SK
OSS_BUCKET_NAME=请填入对象存储桶

# ---- 告警(ops-alert-check.sh) ----
# 填了才真告警: 企业微信/钉钉/飞书 Incoming Webhook 地址, 留空=只落本地日志文件
AIGI_ALERT_WEBHOOK=
AIGI_ALERT_AUTOHEAL=0              # 自愈重启默认关, 开启前必须人工评估
AIGI_BACKEND_CONTAINER=请填入后端容器名
