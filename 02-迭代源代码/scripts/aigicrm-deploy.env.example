# AIGICRM 部署配置(建议复制为 ~/.aigicrm-deploy.env 并填写)
APP_NAME=AIGICRM
APP_SLUG=aigicrm
DB_NAME=aigicrm
DEPLOY_DIR=/root/aigicrm
DEPLOY_DATA_DIR=/data/aigicrm
PROD_HOST=39.99.35.218
PROD_USER=root
PROD_PASS=你的生产密码
TEST_HOST=111.229.37.220
TEST_USER=ubuntu
TEST_PASS=你的测试密码
# 测试服数据字典生成所需的数据库管理员凭据（不与 SSH 账号混用）
TEST_DB_ADMIN_USER=
TEST_DB_ADMIN_PASSWORD=
NAS_DIST_DIR=/Aigicrm/files/aigicrm-dist
NAS_BACKUP_DIR=/Aigicrm/files/backup
SSH_OPTS="-o ConnectTimeout=20 -o StrictHostKeyChecking=no"
# 深度冒烟凭据(可选;2026-09-23 起部署/交付门禁均为无凭据探活,不依赖本组变量)
# 仅 smoke-test / check-prod-perf 等深度诊断工具使用;admin 初口令首登强制改密后即失效,
# 须填当前有效口令(或专用冒烟账号)。
# HEALTH_CHECK_USER=admin
# HEALTH_CHECK_PASS=你的当前口令
