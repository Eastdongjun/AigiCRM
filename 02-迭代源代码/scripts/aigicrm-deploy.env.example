# AIGICRM 部署配置(建议复制为 ~/.aigicrm-deploy.env 并填写)
APP_NAME=AIGICRM
APP_SLUG=aigicrm
DB_NAME=aigicrm
DEPLOY_DIR=/root/aigicrm
DEPLOY_DATA_DIR=/data/aigicrm
PROD_HOST=39.99.35.218
PROD_USER=root
# 【D4 2026-10-21】生产通道仅公钥认证：必须显式注入 PROD_KEY（密码回退已移除，PROD_PASS 不再使用）
PROD_KEY=/path/to/aigicrm.com.pem
TEST_HOST=111.229.37.220
TEST_USER=ubuntu
TEST_PASS=你的测试密码
# 测试服数据字典生成所需的数据库管理员凭据（不与 SSH 账号混用）
TEST_DB_ADMIN_USER=
TEST_DB_ADMIN_PASSWORD=
NAS_DIST_DIR=/Aigicrm/files/aigicrm-dist
NAS_BACKUP_DIR=/Aigicrm/files/backup
# 【D4 2026-10-21】SSH 主机密钥校验由脚本强制：StrictHostKeyChecking=yes + BatchMode + 固定
# known_hosts（用户在此填写的校验类选项会被剔除并告警——OpenSSH 同参数取第一个值，脚本值优先）。
# 此处仅保留非安全类选项（如连接超时）。
SSH_OPTS="-o ConnectTimeout=20 -o StrictHostKeyChecking=yes"
# 固定 known_hosts（可选；缺省 ~/.ssh/known_hosts）。
# 首次采集：离线核对主机指纹后执行
#   ssh-keyscan -t ed25519,ecdsa,rsa 39.99.35.218 111.229.37.220 >> ~/.ssh/known_hosts
# 再把文件路径写到这里（文件缺失时所有部署/备份脚本 fail-closed 拒连）。
# AIGICRM_KNOWN_HOSTS=/path/to/pinned/known_hosts
# 深度冒烟凭据(可选;2026-09-23 起部署/交付门禁均为无凭据探活,不依赖本组变量)
# 仅 smoke-test / check-prod-perf 等深度诊断工具使用;admin 初口令首登强制改密后即失效,
# 须填当前有效口令(或专用冒烟账号)。
# HEALTH_CHECK_USER=admin
# HEALTH_CHECK_PASS=你的当前口令
