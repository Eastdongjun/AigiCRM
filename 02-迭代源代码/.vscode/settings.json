{
  // ===== Java 环境锁定（本机默认 JDK 25 与 Lombok 不兼容，必须锁定 21） =====
  // JDK 统一归位：固定目录 /Users/donglai/Agent/Agent Tools/jdk/（不依赖 brew/Oracle 路径）
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/Users/donglai/Agent/Agent Tools/jdk/openjdk-21",
      "default": true
    }
  ],
  // 语言服务器本身也跑在 21 上，避免 JDTLS 在 25 下初始化失败
  "java.jdt.ls.java.home": "/Users/donglai/Agent/Agent Tools/jdk/openjdk-21",
  "java.debug.settings.onBuildFailureProceed": true,
  // 项目纯 Maven，关闭 Gradle 导入减少噪音
  "java.import.gradle.enabled": false,
  // 保存时自动整理 import（降低无用 import 类告警）
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // ===== 测试链路（vscjava.vscode-java-test） =====
  "java.test.config": {},
  "java.test.defaultConfig": "",

  // ===== 静态分析 SonarLint：默认规则全开，这里显式强调关键 Bug 类规则 =====
  "sonarlint.rules": {
    // Java：空指针解引用（最高频 Bug 源）
    "java:S2259": "on",
    // Java：吞异常/不保留原始异常（本项目编码规范明确禁止）
    "java:S1166": "on",
    // Java：抛泛型异常 Exception/RuntimeException
    "java:S112": "on",
    // Java：捕获不需要的宽泛异常
    "java:S2221": "on",
    // Java：空 catch 块
    "java:S2486": "on",
    // JS：死代码（赋值后从未使用）
    "javascript:S1854": "on",
    // TS：未使用的私有方法/重复代码提示
    "typescript:S1144": "on",
    // 跨语言：TODO/FIXME 跟踪
    "javascript:S1135": "on"
  },
  "sonarlint.disableTelemetry": true,
  // 问题整行高亮（配 Error Lens 显示内联问题）
  "sonarlint.ls.javaHome": "/Users/donglai/Agent/Agent Tools/jdk/openjdk-21",

  // ===== 覆盖率可视化（Coverage Gutters） =====
  "coverage-gutters.coverageFileNames": [
    "lcov.info",
    "cov.xml",
    "coverage.xml",
    "jacoco.xml",
    "coverage-final.json"
  ],
  // 后端 JaCoCo 报告在 ycmn-backend/target/site/jacoco，前端 vitest 在 ycmn-ui/coverage
  "coverage-gutters.coverageBaseDir": "**",
  "coverage-gutters.showGutterCoverage": true,
  "coverage-gutters.showLineCoverage": true,

  // ===== Git 历史对比能力（内置 Git + GitLens） =====
  // 当前行 blame 悬停 + 行内作者
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": true,
  // 提交图可视化（查看历史演进）
  "git.enableCommitGraph": true,
  // GitLens：悬停显示提交详情、文件历史、CodeLens
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.hovers.enabled": true,
  "gitlens.views.fileHistory.enabled": true,
  "gitlens.views.lineHistory.enabled": true,
  "gitlens.views.repositories.enabled": true,

  // ===== 搜索/工作区噪音控制（查历史代码时聚焦源码） =====
  "files.exclude": {
    "**/target": true,
    "**/dist": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/target": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/*.log": true,
    "ycmn-backend/uploads": true
  },
  "search.useIgnoreFiles": true,

  // ===== 问题面板：内联显示 Bug（Error Lens） =====
  "errorLens.enabled": true,
  "errorLens.enabledDiagnosticLevels": ["error"], // 2026-08-15: 仅错误级内联显示,警告/信息不刷屏(SonarLint 清理走 Problems 面板分批)
  "problems.decorations.enabled": true,
  "problems.autoReveal": true
}
