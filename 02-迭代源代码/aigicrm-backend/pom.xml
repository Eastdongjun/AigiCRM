<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Spring Boot 4 升级（2026-08-15，消除 3.5.x OSS 支持期告警）：
             4.1.x 为当前免费支持线（OSS 至 ~2027-06）；Spring Framework 7 / Jakarta EE 11
             【P0-3 2026-11-12 外部审计】4.1.0→4.1.2 补丁: 带 Tomcat 11.0.25(修 5 条 CRITICAL CVE,
             11.0.22 基线)+Spring Framework 7.0.10(修 7.0.8 两条)+netty 4.2.17 线 -->
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.aigicrm</groupId>
    <artifactId>aigicrm-backend</artifactId>
    <version>1.0.0</version>
    <name>aigicrm-backend</name>
    <description>AIGICRM - 市场资源管理系统</description>

    <properties>
        <java.version>21</java.version>
        <!-- 【供应链修复 2026-11-12】osv-scanner CI 首跑实证: Boot 4.1.0 默认 jackson-bom 3.1.4 的
             jackson-databind 存在多个 GHSA(最高 7.5, GHSA-wv8q-qhhj-9h54 等)——覆盖 BOM 到 3.1.7 修复版 -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <!-- 【P0-3】Jackson 2 线(jjwt 传递引入)同步覆盖到 2.21.7(2.21.4 有 HIGH CVE) -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- Boot 4 升级（2026-08-15）：MyBatis-Plus 换 Boot 4 专用 starter（3.5.17 官方支持 Spring 7） -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- mybatis-plus 3.5.9 起 jsqlparser 拆分为 mybatis-plus-jsqlparser 独立模块（项目代码直接用 net.sf.jsqlparser.*） -->
        <jjwt.version>0.13.0</jjwt.version>
        <aliyun-oss.version>3.17.4</aliyun-oss.version>
        <easyexcel.version>3.3.4</easyexcel.version>
        <!-- knife4j 已移除（4.5.0 停更、内嵌 springdoc 2.3.0 与 Spring 7 不兼容）：
             接口文档直用 springdoc 3.1.0（Spring 7 线），UI 为 swagger-ui -->
        <springdoc.version>3.1.0</springdoc.version>
        <!-- archunit 1.3.x 对应 JUnit 5.11 时代，Boot 3.5 管理 JUnit 5.12+，升到 1.4.2（规则 API 不变） -->
        <archunit.version>1.4.2</archunit.version>
        <!-- Flyway：插件必须与 flyway-core 同版本（官方硬约束）。
             Boot 4.1.0 BOM 管理 flyway-core 12.4.0（2026-08-15 实测依赖树），插件同步 12.4.0。
             ⚠️ 生产 deploy-db.sh 的 docker 镜像仍锁 flyway:9.22.3，与运行期 12.4.0 存在版本偏斜，
             需治理任务评估后同步（迁移校验和跨大版本兼容，但解析/行为差异需验证） -->
        <flyway-maven-plugin.version>12.4.0</flyway-maven-plugin.version>
        <!-- Mockito 版本随 Boot 4.1 BOM 更新（待依赖树实测后同步）；
             surefire 用它把 mockito-core 作为 -javaagent 预挂载 -->
        <mockito.version>5.17.0</mockito.version>
    </properties>

    <dependencies>
        <!-- 分层架构约束（Controller/Service/Mapper 依赖方向） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- MyBatis-Plus（Boot 4 专用 starter，2026-08-15 升级） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MyBatis-Plus 3.5.9+ 起 jsqlparser 独立成模块：PaginationInnerInterceptor/TenantLineInnerInterceptor
             及其依赖的 net.sf.jsqlparser.* 均在此模块（MybatisPlusConfig 直接引用），升级必须补充 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- AOP（Boot 4 移除了 spring-boot-starter-aop：直接依赖 BOM 管理的 aspectjweaver，
             配合 spring-core 的 @Aspect 支持，ActionGuardAspect 等切面照常工作） -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 迁移工具（2026-08-09 引入时由 Boot 3.2.12 BOM 管 10.x；现版本随 Boot 4.1.0 BOM 12.4.0）
             MySQL 8 需 flyway-mysql 分离模块；应用运行时 spring.flyway.enabled=false(生产 aigicrm_app 无 DDL 权限)，
             迁移经 Maven 插件 / CLI 以管理账号执行(deploy-db.sh)。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Alibaba Cloud OSS -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>${aliyun-oss.version}</version>
        </dependency>

        <!-- Alibaba Cloud SMS -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>dysmsapi20170525</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- EasyExcel -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>${easyexcel.version}</version>
        </dependency>

        <!-- 接口文档：knife4j 已移除（停更且内嵌 springdoc 与 Spring 7 不兼容），
             springdoc 3.1.0 为 Spring 7 / Boot 4 线（2026-08-15 升级） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Lombok (1.18.46: 支持 JDK25 编译; 向后兼容, 运行时 JDK21 不受影响) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 【底座收敛 P2 2026-11-11】权限行为矩阵(@WebMvcTest + @WithMockUser)专用;
             @WithMockUser/SecurityMockMvcRequestPostProcessors 来自此依赖, 无运行时影响 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 【P2】Boot 4 切片测试模块化: @WebMvcTest 从 starter-test 迁至 spring-boot-webmvc-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Mockito 预挂载 agent（2026-08-15）：按官方文档把 mockito-core 作为 -javaagent 预挂载，
                 替代运行时 self-attach —— 消除 JDK21+「Dynamic loading of agents will be disallowed」
                 警告，未来 JDK 禁止动态加载后测试仍可运行。版本与 BOM 管理对齐（${mockito.version}）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} 前缀拼接 jacoco prepare-agent 注入的探针参数
                         （2026-11-01 AR-AIGI-01 覆盖链清偿）；@{} 延迟求值保证
                         prepare-agent 后写入的属性生效，mockito 预挂载语义不变。 -->
                    <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
            <!-- JaCoCo 覆盖链（2026-11-01 AR-AIGI-01）：prepare-agent 产出
                 target/jacoco.exec（mvn test 即生成）；report 绑定 verify 出
                 target/site/jacoco。SonarQube 恢复后直接吃 exec（sonar.coverage.jacoco.xmlReportPaths）。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Flyway 迁移插件（2026-08-09 引入）: 经 deploy-db.sh 以管理账号执行迁移。
                 生产/测试连接参数由 deploy-db.sh 传入(-Dflyway.*), 不在此硬编码。 -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway-maven-plugin.version}</version>
                <configuration>
                    <locations>filesystem:${project.basedir}/src/main/resources/db/migration</locations>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
