.statistics-page{padding-top:30rpx}
.stats-hero{position:relative;overflow:hidden;display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:34rpx 30rpx;border-radius:30rpx;background:linear-gradient(135deg,#16356f,#2364d8 58%,#0f9ba8);color:#fff;box-shadow:0 20rpx 44rpx rgba(35,100,216,.22)}
.stats-hero:after{content:"";position:absolute;right:-54rpx;bottom:-72rpx;width:210rpx;height:210rpx;border-radius:50%;border:28rpx solid rgba(255,255,255,.12)}
.stats-hero.compact{padding:30rpx}
.stats-kicker{font-size:20rpx;font-weight:800;opacity:.72}
.stats-title{margin-top:8rpx;font-size:42rpx;font-weight:900;line-height:1.1}
.stats-sub{margin-top:12rpx;font-size:24rpx;line-height:1.5;opacity:.86}
.stats-hero-metrics{display:flex;gap:10rpx;margin-top:20rpx;flex-wrap:wrap}
.stats-hero-metrics text{padding:8rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.16);font-size:21rpx;color:rgba(255,255,255,.92)}
.stats-refresh{flex-shrink:0;min-width:96rpx;height:58rpx;line-height:56rpx;padding:0 18rpx;border:1rpx solid rgba(255,255,255,.38);border-radius:999rpx;background:rgba(255,255,255,.16);color:#fff;font-size:23rpx}
.stats-primary-card{margin-top:24rpx;padding:30rpx;border-radius:28rpx;background:#fff;border:1rpx solid rgba(210,220,235,.82);box-shadow:0 12rpx 32rpx rgba(35,57,96,.07)}
.stats-primary-top{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.stats-primary-label{color:#697991;font-size:24rpx}
.stats-primary-value{margin-top:8rpx;color:#172033;font-size:64rpx;font-weight:900;line-height:1}
.stats-primary-value text{margin-left:8rpx;color:#7c8ba1;font-size:25rpx;font-weight:650}
.stats-primary-badge{padding:9rpx 16rpx;border-radius:999rpx;background:#eef6ff;color:#2364d8;font-size:22rpx;font-weight:700}
.stats-progress-track{height:12rpx;margin-top:26rpx;border-radius:999rpx;background:#eef3f9;overflow:hidden}
.stats-progress-bar{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#2364d8,#10b981)}
.stats-primary-meta{display:flex;gap:14rpx;margin-top:22rpx;color:#52627a;font-size:22rpx}
.stats-primary-meta text{padding:8rpx 14rpx;border-radius:999rpx;background:#f1f5f9}
.stats-risk-panel{margin-top:22rpx;padding:22rpx;border-radius:28rpx;background:#fff;border:1rpx solid rgba(210,220,235,.82);box-shadow:0 12rpx 32rpx rgba(35,57,96,.06)}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:18rpx}
.stats-tile{padding:22rpx;border-radius:22rpx;background:#f8fbff;border:1rpx solid rgba(210,220,235,.82)}
.stats-tile view{font-size:42rpx;font-weight:900;line-height:1;color:#172033}
.stats-tile text{display:block;margin-top:12rpx;color:#697991;font-size:23rpx}
.stats-tile.blue{border-left:6rpx solid #2364d8}.stats-tile.orange{border-left:6rpx solid #f59e0b}.stats-tile.red{border-left:6rpx solid #ef4444}.stats-tile.green{border-left:6rpx solid #10b981}
.stats-section-head{display:flex;align-items:center;justify-content:space-between;margin:34rpx 4rpx 16rpx;color:#172033;font-size:31rpx;font-weight:850}
.stats-section-head.slim{margin:0 2rpx 4rpx}
.stats-approval-card{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;padding:18rpx;border-radius:24rpx;background:#fff;border:1rpx solid rgba(210,220,235,.82);box-shadow:0 12rpx 32rpx rgba(35,57,96,.07)}
.stats-approval-card>view{text-align:center;padding:16rpx 8rpx;border-radius:18rpx;background:#f8fbff}
.stats-approval-card>view.pending{background:#fff7ed}.stats-approval-card>view.approved{background:#ecfdf5}.stats-approval-card>view.rejected{background:#fff1f2}
.stats-approval-card text{color:#172033;font-size:38rpx;font-weight:900}
.stats-approval-card view view{margin-top:8rpx;color:#7c8ba1;font-size:22rpx}
.stats-warning-card{padding:8rpx 24rpx}
.stats-warning-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #eef2f7}
.stats-warning-row:last-child{border-bottom:0}
.warning-name{color:#253653;font-size:27rpx;font-weight:750}
.stats-warning-row text{color:#8b9ab0;font-size:22rpx}
.warning-countdown{white-space:nowrap;padding:8rpx 14rpx;border-radius:999rpx;background:#fff1f2;color:#ef4444!important;font-weight:750}
.stats-detail-btn{display:block;margin:24rpx auto 0}
.stats-tabs{margin:22rpx 0 20rpx;white-space:nowrap}
.stats-tab{display:inline-flex;align-items:center;justify-content:center;min-width:116rpx;height:62rpx;margin-right:12rpx;padding:0 20rpx;border-radius:999rpx;background:#fff;border:1rpx solid #dbe4f0;color:#52627a;font-size:24rpx;font-weight:650}
.stats-tab.active{background:#172033;color:#fff;border-color:#172033}
.stats-list-card{padding:24rpx}
.stats-card-title{position:relative;margin-bottom:10rpx;padding-left:18rpx;color:#172033;font-size:29rpx;font-weight:850}
.stats-card-title:before{content:"";position:absolute;left:0;top:8rpx;width:6rpx;height:26rpx;border-radius:999rpx;background:#2364d8}
.stats-list-row{display:flex;align-items:center;justify-content:space-between;min-height:86rpx;border-bottom:1rpx solid #eef2f7;color:#52627a;font-size:26rpx}
.stats-list-row:last-child{border-bottom:0}
.stats-list-row text:last-child{color:#172033;font-size:30rpx;font-weight:850}
.stats-subtitle{margin:22rpx 0 8rpx;color:#172033;font-size:28rpx;font-weight:850}
.files-smoke-btn{margin-bottom:20rpx}
.files-manage-card{margin-top:24rpx;padding:22rpx 24rpx;border:1rpx solid rgba(210,220,235,.82);border-radius:24rpx;background:#fff;box-shadow:0 12rpx 32rpx rgba(35,57,96,.06)}
.files-manage-head{display:flex;align-items:center;justify-content:space-between;color:#172033;font-size:28rpx;font-weight:850}
.files-manage-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:78rpx;border-top:1rpx solid #eef2f7;color:#52627a;font-size:25rpx}
.files-manage-row:first-of-type{margin-top:14rpx}
.files-manage-row button{margin-left:14rpx}
.scope-note{margin-left:20rpx}
.profile-action-row{display:flex;gap:16rpx;margin-top:24rpx}
.compact-logout{flex:1;margin-top:0}
.profile-action-row .secondary-btn{flex:0 0 180rpx;height:76rpx;line-height:74rpx;border-radius:20rpx}
.contact-add-btn{margin-top:24rpx;width:100%;height:82rpx;min-height:82rpx}
.share-revoke-btn{margin-top:18rpx;margin-left:0}
.share-submit-btn{margin-top:24rpx;width:100%}
.contact-detail-card,.file-detail-card{margin-top:24rpx}
.contact-detail-name,.file-detail-name{margin-top:18rpx}
.file-preview-video{width:100%;margin-top:24rpx;border-radius:16rpx;background:#000;overflow:hidden}
.file-preview-btn{margin-top:28rpx;width:100%}
.approval-submit-card{margin-top:20rpx}
.approval-input{margin-top:12rpx}
.approval-submit-btn{margin-top:16rpx;width:100%}
.finance-add-btn,.customer-action-btn{margin-top:22rpx;width:100%}
.customer-action-btn.flat{margin-top:0}
.incentive-detail-card{margin-top:24rpx;border:2rpx solid #bfdbfe;background:linear-gradient(180deg,#ffffff,#f8fbff)}
.incentive-detail-title{margin:0;flex:1}
.incentive-detail-row{margin-top:18rpx;color:#172033;font-size:28rpx;font-weight:750}
.incentive-detail-meta,.incentive-detail-summary{margin-top:12rpx;color:#52627a;font-size:25rpx;line-height:1.55}
.incentive-upload-btn{margin-top:22rpx;width:100%}
.polished-form-card{margin-top:24rpx}
.polished-input{margin-top:10rpx}
.polished-textarea{width:100%;box-sizing:border-box;min-height:220rpx;margin-top:0;padding:22rpx;border:1rpx solid #d8e3f1;border-radius:20rpx;background:#f8fbff;color:#172033;font-size:27rpx;line-height:1.6}
.polished-submit{margin-top:24rpx;width:100%}
.polished-back{display:block;margin:20rpx auto 0}
.filter-field-label{margin-top:28rpx}
.polished-select{display:flex;align-items:center;justify-content:space-between;margin-top:10rpx;height:78rpx;padding:0 22rpx;border:1rpx solid #d8e3f1;border-radius:18rpx;background:#f8fbff;color:#172033;font-size:27rpx}
.filter-action-row{display:flex;gap:16rpx;margin-top:28rpx}
.filter-reset-btn{flex:0 0 170rpx;height:76rpx;line-height:74rpx;margin-left:0;border-radius:20rpx}
.filter-apply-btn{flex:1;height:76rpx;min-height:76rpx}
.form-section-title{position:relative;margin:2rpx 0 24rpx;padding-left:18rpx;color:#172033;font-size:30rpx;font-weight:850}
.form-section-title:before{content:"";position:absolute;left:0;top:8rpx;width:6rpx;height:28rpx;border-radius:999rpx;background:#2364d8}
.compact-textarea{min-height:170rpx}
.reminder-mode-card{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:22rpx;padding:8rpx;border-radius:24rpx;background:#eaf1f8}
.reminder-mode{height:68rpx;line-height:66rpx;border-radius:18rpx;background:transparent;color:#64748b;font-size:25rpx;font-weight:700}
.reminder-mode.active{background:#fff;color:#172033;box-shadow:0 8rpx 18rpx rgba(35,57,96,.08)}
.refined-search{margin-top:20rpx}
.reminder-loading{margin-top:24rpx}
.reminder-card{margin-top:20rpx;padding:24rpx;border:1rpx solid #e5edf6}
.reminder-card-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.reminder-customer{flex:1;color:#172033;font-size:30rpx;font-weight:850}
.reminder-summary{margin-top:14rpx;color:#52627a;font-size:25rpx;line-height:1.55}
.reminder-date{display:flex;justify-content:space-between;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #eef2f7;color:#7c8ba1;font-size:24rpx}
.reminder-date text:last-child{color:#172033;font-weight:750}
.reminder-actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:20rpx}
.modal-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
