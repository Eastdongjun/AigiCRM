.refined-metric-option:first-of-type{border-top:0}
.refined-score-grid{margin-top:18rpx}
.approval-detail-card,.incentive-detail-card{margin-top:22rpx;border:1rpx solid #e5edf6}
.approval-detail-head,.incentive-detail-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin-bottom:8rpx}
