.file-upload-mini{width:118rpx;height:68rpx;line-height:66rpx;border-radius:18rpx;background:#2364d8;color:#fff;font-size:24rpx;font-weight:750}
.legacy-folder-card{margin-top:20rpx;border:1rpx solid #e5edf6}
.legacy-folder-scroll{margin-top:16rpx;white-space:nowrap}
.legacy-folder-pill{display:inline-flex;margin-right:12rpx;padding:10rpx 16rpx;border-radius:999rpx;background:#eef6ff;color:#2364d8;font-size:22rpx}
.legacy-file-card{margin-top:20rpx;border:1rpx solid #e5edf6}
.legacy-file-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.legacy-file-name{flex:1;color:#172033;font-size:30rpx;font-weight:850;line-height:1.35}
.legacy-file-meta{margin-top:14rpx;color:#7c8ba1;font-size:24rpx}
.legacy-file-actions{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:20rpx}
.legacy-file-actions>view{display:flex;gap:12rpx}
.no-margin{margin:0}
.compact-muted{margin-top:16rpx}
.approval-stat-card{position:relative;overflow:hidden}
.approval-stat-card:before{content:"";position:absolute;left:0;top:0;width:100%;height:6rpx;background:linear-gradient(90deg,#2364d8,#10b981)}
.approval-list-card{margin-bottom:20rpx;border:1rpx solid #e5edf6}
.approval-list-head,.sea-record-head,.incentive-record-head,.customer-overview-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.approval-list-title,.sea-record-title,.incentive-record-title,.customer-overview-title{flex:1;color:#172033;font-size:30rpx;font-weight:850;line-height:1.35}
