.refined-reason{margin-top:20rpx;padding:20rpx;border-radius:18rpx;background:#f8fbff;color:#52627a;font-size:25rpx;line-height:1.6}
.approval-node-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:78rpx;border-bottom:1rpx solid #eef2f7;color:#52627a;font-size:25rpx}
.approval-node-row:last-child{border-bottom:0}
.approval-node-row text:last-child{color:#172033;font-weight:750;text-align:right}
.approval-detail-actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:22rpx}
.ranking-tabs{display:flex;gap:12rpx;margin:24rpx 0 18rpx;overflow-x:auto;white-space:nowrap}
.ranking-tab{flex-shrink:0;padding:14rpx 22rpx;border-radius:999rpx;background:#eef4fb;color:#52627a;font-size:23rpx;font-weight:750}
.ranking-tab.active{background:#172033;color:#fff}
.ranking-card{margin-bottom:16rpx;border:1rpx solid #e5edf6}
.ranking-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
