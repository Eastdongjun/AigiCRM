.steps{display:flex;justify-content:space-between;gap:10rpx;margin:24rpx 0;color:#94a3b8;font-size:22rpx}.step{flex:1;text-align:center;padding:12rpx 8rpx;border-radius:999rpx;background:#eef4fb}.step.active{color:#2563eb;font-weight:800;background:#eef6ff}.form-card{margin-top:24rpx}.label{margin-top:20rpx;color:#475569;font-size:26rpx}.code-row{display:flex;align-items:center;gap:12rpx}.code-row .input{flex:1}.code-action{flex-shrink:0;width:190rpx;height:54rpx;line-height:52rpx;margin:10rpx 0 0;padding:0 10rpx;border:1rpx solid #bfdbfe;border-radius:14rpx;background:#eff6ff;color:#2563eb;font-size:22rpx;font-weight:740}.code-action::after{border:0}.submit-btn{margin-top:30rpx}.back-btn{display:block;margin:18rpx auto 0}
