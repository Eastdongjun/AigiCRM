.indicator-page{padding:28rpx;background:#f5f8fc;min-height:100vh;box-sizing:border-box}.hero{padding:34rpx 30rpx;border-radius:30rpx;background:linear-gradient(135deg,#173b86,#2364d8 58%,#0ea5b7);color:#fff;box-shadow:0 20rpx 44rpx rgba(35,100,216,.22)}.hero-title{font-size:40rpx;font-weight:900}.hero-sub{margin-top:12rpx;opacity:.86;font-size:24rpx;line-height:1.5}.indicator-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.card{background:#fff;border-radius:24rpx;padding:24rpx;box-sizing:border-box;border:1rpx solid #e5edf6;box-shadow:0 10rpx 26rpx rgba(35,57,96,.05)}.metric{display:flex;flex-direction:column;gap:10rpx;color:#64748b}.metric-value{color:#2563eb;font-size:38rpx;font-weight:900}.metric-value.success{color:#16a34a}.indicator-rank-card{margin-top:22rpx}.section-title{font-size:30rpx;font-weight:850;margin-bottom:12rpx;color:#172033}.rank-row{display:flex;align-items:center;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid #eef2f7;color:#64748b;font-size:24rpx}.rank-row:last-child{border-bottom:0}.rank-index{width:38rpx;color:#2563eb;font-weight:800}.rank-name{flex:1;color:#1e293b;font-weight:750}.rank-score{color:#2563eb;font-weight:850}.muted{color:#94a3b8}
