.share-form{margin-top:20rpx}.user-option{display:flex;align-items:center;gap:12rpx;padding:18rpx 0;border-bottom:1rpx solid #eef2f7;color:#475569}.share-card{margin-top:20rpx}.share-name{font-size:30rpx;font-weight:700;color:#172b4d}.share-card .detail-row{margin-top:18rpx}.notice{margin-top:24rpx;padding:24rpx;color:#7b8ca5;font-size:25rpx;line-height:1.7}
.share-revoke-btn{height:50rpx;line-height:48rpx;margin:20rpx 0 0 auto;padding:0 18rpx;border:1rpx solid #fecaca;border-radius:14rpx;background:#fff7f7;color:#dc2626;font-size:22rpx;font-weight:720}
.share-top-cancel{flex:none;height:56rpx;margin:0;padding:0 20rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:999rpx;background:rgba(255,255,255,.18);color:#fff;font-size:23rpx;font-weight:760;line-height:54rpx;box-sizing:border-box}
.share-actions{display:grid;grid-template-columns:176rpx minmax(0,1fr);gap:14rpx;margin-top:22rpx}
.share-cancel-btn,.share-submit-btn{height:64rpx;line-height:62rpx;margin:0;padding:0 18rpx;border-radius:18rpx;font-size:24rpx;font-weight:760;box-sizing:border-box}
.share-cancel-btn{border:1rpx solid #dbe4f0;background:#fff;color:#475569}
.share-submit-btn{border:0;background:#2563eb;color:#fff;box-shadow:0 10rpx 22rpx rgba(37,99,235,.16)}
.share-revoke-btn::after,.share-submit-btn::after,.share-cancel-btn::after,.share-top-cancel::after{border:0}
.share-cancel-btn[disabled],.share-top-cancel[disabled]{opacity:.55}
.share-submit-btn[disabled]{background:#d8e1ed!important;color:#7c8ba1!important;box-shadow:none!important}
