<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">新增跟进记录</view>
        <view class="hero-sub">记录本次客户沟通和下一步动作</view>
      </view>
      <button class="form-top-cancel" bindtap="goBack" disabled="{{logFormView.cancelDisabled}}">返回</button>
    </view>
  </view>
  <view class="card form-card polished-form-card">
    <textarea class="content-input polished-textarea" maxlength="{{logFormView.contentMaxLength}}" value="{{logFormView.contentValue}}" bindinput="onContentInput" placeholder="{{logFormView.placeholder}}"/>
    <view class="counter">{{logFormView.counterText}}</view>
    <view class="form-actions">
      <button class="form-cancel-btn" bindtap="goBack" disabled="{{logFormView.cancelDisabled}}">{{logFormView.cancelText}}</button>
      <button class="form-submit-btn" loading="{{logFormView.submitLoading}}" bindtap="submit">{{logFormView.submitText}}</button>
    </view>
  </view>
</view>
