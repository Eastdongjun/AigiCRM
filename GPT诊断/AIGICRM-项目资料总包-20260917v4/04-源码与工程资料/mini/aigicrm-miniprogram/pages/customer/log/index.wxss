.form-card{margin-top:24rpx}.content-input{width:100%;min-height:300rpx;box-sizing:border-box;padding:22rpx;border:1rpx solid #dbeafe;border-radius:16rpx;background:#f8fbff;color:#172b4d;font-size:28rpx;line-height:1.7}.counter{margin-top:12rpx;color:#94a3b8;text-align:right;font-size:23rpx}.submit-btn{margin-top:28rpx}
.form-top-cancel{flex:none;height:56rpx;margin:0;padding:0 20rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:999rpx;background:rgba(255,255,255,.18);color:#fff;font-size:23rpx;font-weight:760;line-height:54rpx;box-sizing:border-box}.form-top-cancel::after{border:0}
.form-actions{display:grid;grid-template-columns:176rpx minmax(0,1fr);gap:14rpx;margin-top:28rpx}.form-cancel-btn,.form-submit-btn{height:72rpx;margin:0;padding:0 18rpx;border-radius:18rpx;font-size:25rpx;font-weight:750;line-height:70rpx;box-sizing:border-box}.form-cancel-btn::after,.form-submit-btn::after{border:0}.form-cancel-btn{border:1rpx solid #dbe4f0;background:#fff;color:#475569}.form-submit-btn{background:#2563eb;color:#fff;box-shadow:0 10rpx 22rpx rgba(37,99,235,.18)}.form-cancel-btn[disabled],.form-top-cancel[disabled]{opacity:.55}.form-submit-btn[disabled]{background:#d8e1ed!important;color:#7c8ba1!important;box-shadow:none!important}
