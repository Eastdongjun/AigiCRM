<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">{{financeFormView.title}}</view>
        <view class="hero-sub">与 PC 财务记录共用同一接口和权限</view>
      </view>
      <button class="form-top-cancel" bindtap="goBack" disabled="{{financeFormView.cancelDisabled}}">返回</button>
    </view>
  </view>

  <view class="card form-card polished-form-card">
    <view class="form-section-title">{{financeFormView.sectionTitle}}</view>
    <block wx:if="{{financeFormView.isInvoice}}">
      <block wx:for="{{financeFormView.invoicePrimaryFields}}" wx:key="field">
        <view class="label">{{item.label}}</view>
        <input class="input polished-input" type="{{item.type}}" data-field="{{item.field}}" value="{{item.value}}" bindinput="input" placeholder="{{item.placeholder}}"/>
      </block>
      <view class="label">发票类型</view>
      <picker mode="selector" range="{{invoiceTypeOptions}}" value="{{invoiceTypeIndex}}" bindchange="chooseInvoiceType">
        <view class="input polished-input picker-input">{{financeFormView.invoiceTypeText}}</view>
      </picker>
      <block wx:for="{{financeFormView.invoiceAmountFields}}" wx:key="field">
        <view class="label">{{item.label}}</view>
        <input class="input polished-input" type="{{item.type}}" data-field="{{item.field}}" value="{{item.value}}" bindinput="input" placeholder="{{item.placeholder}}"/>
      </block>
    </block>
    <block wx:else>
      <block wx:for="{{financeFormView.paymentFields}}" wx:key="field">
        <view class="label">{{item.label}}</view>
        <input class="input polished-input" type="{{item.type}}" data-field="{{item.field}}" value="{{item.value}}" bindinput="input" placeholder="{{item.placeholder}}"/>
      </block>
      <view class="label">备注</view>
      <textarea class="textarea polished-textarea compact-textarea" data-field="remark" value="{{financeFormView.remarkValue}}" bindinput="input" placeholder="{{financeFormView.remarkPlaceholder}}"/>
    </block>
    <view class="form-actions">
      <button class="form-cancel-btn" bindtap="goBack" disabled="{{financeFormView.cancelDisabled}}">{{financeFormView.cancelText}}</button>
      <button class="form-submit-btn" loading="{{financeFormView.submitLoading}}" bindtap="submit">{{financeFormView.submitText}}</button>
    </view>
  </view>
</view>
