.form-card{margin-top:24rpx}.threshold-card{padding:20rpx;border-radius:18rpx;background:#f8fbff;border:1rpx solid #dbeafe}.threshold-title{font-size:28rpx;font-weight:800;color:#2563eb;margin-bottom:8rpx}.metric-option{padding:24rpx 0;border-bottom:1rpx solid #eef2f7}.metric-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.metric-name{font-size:30rpx;font-weight:800;color:#172b4d}.score-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:18rpx}.score-option{min-height:96rpx;box-sizing:border-box;padding:16rpx;border:1rpx solid #dbeafe;border-radius:18rpx;background:#f8fbff;color:#475569;font-size:24rpx}.score-option text{display:block;color:#2563eb;font-size:22rpx;font-weight:800;margin-bottom:6rpx}.score-option.active{background:#2563eb;color:#fff;border-color:#2563eb}.score-option.active text{color:#fff}.submit-btn{margin-top:28rpx}.back-btn{display:block;margin:18rpx auto 0}
