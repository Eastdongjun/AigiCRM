<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">联系人详情</view>
        <view class="hero-sub">客户关系与关键人信息</view>
      </view>
      <button class="ghost-btn" bindtap="goBack">返回</button>
    </view>
  </view>
  <view class="card contact-detail-card">
    <view class="profile-avatar">{{contactDetailView.nameInitial}}</view>
    <view class="section-title contact-detail-name">{{contactDetailView.nameText}}</view>
    <view class="detail-row"><text>职位</text><text>{{contactDetailView.positionText}}</text></view>
    <view class="detail-row"><text>手机号</text><text>{{contactDetailView.mobileText}}</text></view>
    <view class="detail-row"><text>备注</text><text>{{contactDetailView.remarkText}}</text></view>
    <button class="btn contact-add-btn" bindtap="call">拨打电话</button>
  </view>
</view>
