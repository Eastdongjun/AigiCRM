<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="hero-title">{{contactFormView.titleText}}</view>
        <view class="hero-sub">{{contactFormView.subtitleText}}</view>
      </view>
      <button class="form-top-cancel" bindtap="goBack" disabled="{{contactFormView.cancelDisabled}}">返回</button>
    </view>
  </view>

  <view class="card form-card polished-form-card">
    <view class="form-section-title">基础信息</view>
    <block wx:for="{{contactFormView.fields}}" wx:key="field">
      <view class="label">{{item.label}}</view>
      <input class="input polished-input" type="{{item.type}}" data-field="{{item.field}}" value="{{item.value}}" bindinput="input" placeholder="{{item.placeholder}}"/>
    </block>
    <view class="label">备注</view>
    <textarea class="textarea polished-textarea compact-textarea" data-field="remark" value="{{contactFormView.remarkValue}}" bindinput="input" placeholder="{{contactFormView.remarkPlaceholder}}"/>
    <view class="form-actions">
      <button class="form-cancel-btn" bindtap="goBack" disabled="{{contactFormView.cancelDisabled}}">{{contactFormView.cancelText}}</button>
      <button class="form-submit-btn" loading="{{contactFormView.submitLoading}}" bindtap="submit">{{contactFormView.submitText}}</button>
    </view>
  </view>
</view>
