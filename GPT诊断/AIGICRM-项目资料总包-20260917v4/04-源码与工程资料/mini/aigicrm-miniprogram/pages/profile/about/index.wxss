.profile-doc-page{min-height:100vh;padding:36rpx 28rpx;background:#f5f8fc;box-sizing:border-box}.doc-brand-card{display:flex;flex-direction:column;align-items:center;padding:44rpx 32rpx;margin-bottom:22rpx;border-radius:28rpx;background:#fff;border:1rpx solid #e5edf6;box-shadow:0 12rpx 32rpx rgba(35,57,96,.07)}.logo{width:112rpx;height:112rpx;border-radius:30rpx;background:linear-gradient(135deg,#2364d8,#0ea5b7);color:#fff;font-size:64rpx;font-weight:800;line-height:112rpx;text-align:center}.title{display:block;margin-top:24rpx;font-size:40rpx;font-weight:850;color:#172033}.version,.updated{display:block;margin-top:12rpx;color:#8ea3c0;font-size:24rpx}.doc-section{padding:30rpx;margin-top:20rpx;border-radius:24rpx;background:#fff;border:1rpx solid #e5edf6;box-shadow:0 10rpx 26rpx rgba(35,57,96,.05)}.heading{display:block;color:#172033;font-size:30rpx;font-weight:800;margin-bottom:16rpx}.body{display:block;color:#5f718b;font-size:27rpx;line-height:1.85}
