<view class="page">
  <view class="hero">
    <view class="hero-title">{{folderFormView.titleText}}</view>
    <view class="hero-sub">创建后可在文件库中上传和管理资料</view>
  </view>
  <view class="card form-card polished-form-card">
    <view class="label">文件夹名称</view>
    <input class="input polished-input" value="{{folderFormView.nameValue}}" bindinput="input" placeholder="{{folderFormView.namePlaceholder}}" maxlength="{{folderFormView.nameMaxLength}}"/>
    <button class="btn submit-btn polished-submit" loading="{{folderFormView.submitLoading}}" bindtap="submit">{{folderFormView.submitText}}</button>
    <button class="text-btn back-btn polished-back" bindtap="back">取消</button>
  </view>
</view>
