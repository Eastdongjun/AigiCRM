.file-row-actions{display:flex;align-items:center;gap:8rpx;margin-left:auto;flex-shrink:0}
.files-page .search-box{display:flex;align-items:center;gap:14rpx;height:76rpx;margin:20rpx 0 18rpx;padding:0 18rpx;border:1rpx solid #dbeafe;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(41,72,125,.06)}
.files-page .search-box input{flex:1;min-width:0;font-size:26rpx;color:#172033}
.search-icon{color:#7c8aa5;font-size:30rpx;line-height:1}
.search-action{width:92rpx;height:48rpx;line-height:48rpx;margin:0;padding:0;border-radius:999rpx;background:#2563eb;color:#fff;font-size:22rpx}
.search-action::after{border:0}
.mini-action{height:48rpx;line-height:46rpx;margin:0;padding:0 14rpx;border:1rpx solid #bfdbfe;border-radius:999rpx;background:#eff6ff;color:#2563eb;font-size:21rpx}
.mini-action::after{border:0}
.mini-action.secondary{border-color:#d9e2ec;background:#fff;color:#475569}
.mini-action.danger{border-color:#fecaca;background:#fff7f7;color:#b91c1c}
.file-share-action,.folder-new-action{height:48rpx;line-height:46rpx;margin:0;padding:0 16rpx;border:1rpx solid #d9e2ec;border-radius:999rpx;background:#fff;color:#475569;font-size:21rpx;font-weight:700}
.file-share-action::after,.folder-new-action::after{border:0}
.file-share-action{margin-left:10rpx;flex-shrink:0}
.folder-new-action{color:#2563eb;border-color:#bfdbfe;background:#eff6ff}
.file-preview-video{width:100%;height:360rpx;margin-top:18rpx;border-radius:20rpx;overflow:hidden;background:#0f172a}
.tab-count{display:inline-flex;min-width:34rpx;height:30rpx;margin-left:8rpx;padding:0 9rpx;align-items:center;justify-content:center;border-radius:999rpx;background:#eef2ff;color:#2563eb;font-size:20rpx;font-weight:700;line-height:30rpx}
.file-tab.active .tab-count{background:#2563eb;color:#fff}
