.detail-info-card{margin-top:20rpx}
.approval-detail-title{color:#172033;font-size:31rpx;font-weight:760;line-height:1.35}
.notification-content{margin-top:18rpx;color:#475569;font-size:25rpx;line-height:1.6}
.notification-detail-actions{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;margin-top:22rpx;flex-wrap:wrap}
.notification-detail-actions button{height:52rpx;line-height:50rpx;margin:0;padding:0 18rpx;border-radius:14rpx;font-size:23rpx;font-weight:740}
.notification-detail-actions button::after{border:0}
.notification-link-action{border:1rpx solid #d8e1ee;background:#f8fafc;color:#475569}
.notification-primary-action{border:0;background:#2563eb;color:#fff;box-shadow:0 8rpx 18rpx rgba(37,99,235,.16)}
