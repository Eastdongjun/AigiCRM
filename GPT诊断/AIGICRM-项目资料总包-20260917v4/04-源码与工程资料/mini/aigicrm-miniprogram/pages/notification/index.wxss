.notification-card{margin-top:20rpx}
.notification-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}
.notification-title{flex:1;min-width:0;color:#172033;font-size:30rpx;font-weight:760;line-height:1.35}
.notification-content{margin-top:16rpx;color:#475569;font-size:25rpx;line-height:1.55}
.notification-customer{margin-top:14rpx;color:#94a3b8;font-size:23rpx}
.notification-actions{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;margin-top:18rpx;flex-wrap:wrap}
.notification-actions button{height:50rpx;line-height:48rpx;margin:0;padding:0 16rpx;border-radius:14rpx;font-size:22rpx;font-weight:720}
.notification-actions button::after{border:0}
.notification-link-action{border:1rpx solid #d8e1ee;background:#f8fafc;color:#475569}
.notification-primary-action{border:0;background:#2563eb;color:#fff;box-shadow:0 8rpx 18rpx rgba(37,99,235,.16)}
